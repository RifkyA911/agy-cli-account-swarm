<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:AgyAccountSwarm.Avalonia.Converters"
             x:Class="AgyAccountSwarm.Avalonia.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <conv:EqualityToBooleanConverter x:Key="EqualityConverter" />
        <conv:TierToBrushConverter x:Key="TierBrushConverter" />
        <conv:QuotaToBrushConverter x:Key="QuotaBrushConverter" />
        <conv:HexToBrushConverter x:Key="HexBrushConverter" />
        <conv:ActiveNavBackgroundConverter x:Key="ActiveNavBgConverter" />
        <conv:ActiveNavForegroundConverter x:Key="ActiveNavFgConverter" />
        <conv:PathToBitmapConverter x:Key="PathToBitmapConverter" />
        <conv:SwarmMessageTypeToBackgroundConverter x:Key="SwarmMsgBgConverter" />
        <conv:SwarmMessageTypeToBorderConverter x:Key="SwarmMsgBorderConverter" />
        <conv:ActiveTabBackgroundConverter x:Key="ActiveTabBgConverter" />
        <conv:CountToBooleanConverter x:Key="CountToBoolConverter" />

        <!-- Theme Color Brushes -->
        <SolidColorBrush x:Key="BrushBg" Color="#0B0F19" />
        <SolidColorBrush x:Key="BrushSidebar" Color="#0F172A" />
        <SolidColorBrush x:Key="BrushCard" Color="#111827" />
        <SolidColorBrush x:Key="BrushCardBorder" Color="#1F2937" />
        <SolidColorBrush x:Key="BrushSurface" Color="#162032" />
        <SolidColorBrush x:Key="BrushSurfaceHover" Color="#1E293B" />
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#F9FAFB" />
        <SolidColorBrush x:Key="BrushTextSecondary" Color="#9CA3AF" />
        <SolidColorBrush x:Key="BrushAccent" Color="#38BDF8" />
        <SolidColorBrush x:Key="BrushEmerald" Color="#10B981" />
        <SolidColorBrush x:Key="BrushAmber" Color="#F59E0B" />
        <SolidColorBrush x:Key="BrushCrimson" Color="#EF4444" />
        <SolidColorBrush x:Key="BrushViolet" Color="#A855F7" />

        <!-- Theme Alert Brushes -->
        <SolidColorBrush x:Key="BrushWarningAlertBg" Color="#241A06" />
        <SolidColorBrush x:Key="BrushWarningAlertBorder" Color="#D97706" />
        <SolidColorBrush x:Key="BrushWarningAlertText" Color="#FDE68A" />

        <SolidColorBrush x:Key="BrushErrorAlertBg" Color="#2A0E13" />
        <SolidColorBrush x:Key="BrushErrorAlertBorder" Color="#DC2626" />
        <SolidColorBrush x:Key="BrushErrorAlertText" Color="#FCA5A5" />

        <SolidColorBrush x:Key="BrushBadgeBg" Color="#1E293B" />
        <SolidColorBrush x:Key="BrushBadgeBorder" Color="#334155" />
        <SolidColorBrush x:Key="BrushBadgeText" Color="#93C5FD" />

        <StreamGeometry x:Key="HeroIconChatBubble">M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a.75.75 0 0 1-.974-.94 5.95 5.95 0 0 0 .974-2.82C3.593 15.688 3 13.935 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif" />
        </Style>
    </Application.Styles>
</Application>
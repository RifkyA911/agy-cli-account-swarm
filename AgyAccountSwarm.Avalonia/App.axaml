                    <SolidColorBrush x:Key="BrushQuotaExhaustedText" Color="#B91C1C" />
                    <SolidColorBrush x:Key="BrushAlertBg" Color="#EFF6FF" />
                    <SolidColorBrush x:Key="BrushAlertBorder" Color="#BFDBFE" />
                    <SolidColorBrush x:Key="BrushAlertText" Color="#1D4ED8" />
                </ResourceDictionary>

                <!-- DARK THEME (Obsidian Dark) -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BrushBg" Color="#0F1115" />
                    <SolidColorBrush x:Key="BrushSidebar" Color="#0F172A" />
                    <SolidColorBrush x:Key="BrushSurface" Color="#17191E" />
                    <SolidColorBrush x:Key="BrushSurfaceHover" Color="#1F222A" />
                    <SolidColorBrush x:Key="BrushSurfacePressed" Color="#252936" />
                    <SolidColorBrush x:Key="BrushDangerHoverBg" Color="#331418" />
                    <SolidColorBrush x:Key="BrushCard" Color="#13151A" />
                    <SolidColorBrush x:Key="BrushCardBorder" Color="#252832" />
                    <SolidColorBrush x:Key="BrushTextPrimary" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="BrushTextSecondary" Color="#9CA3AF" />
                    <SolidColorBrush x:Key="BrushTextMuted" Color="#6B7280" />
                    <SolidColorBrush x:Key="BrushPopupBg" Color="#17191E" />
                    <SolidColorBrush x:Key="BrushPrimary" Color="#2563EB" />
                    <SolidColorBrush x:Key="BrushPrimaryHover" Color="#1D4ED8" />
                    <SolidColorBrush x:Key="BrushAccent" Color="#38BDF8" />
                    <SolidColorBrush x:Key="BrushEmerald" Color="#10B981" />
                    <SolidColorBrush x:Key="BrushAmber" Color="#F59E0B" />
                    <SolidColorBrush x:Key="BrushCrimson" Color="#EF4444" />
                    <SolidColorBrush x:Key="BrushViolet" Color="#A855F7" />
                    <SolidColorBrush x:Key="BrushBadgeBg" Color="#1E293B" />
                    <SolidColorBrush x:Key="BrushBadgeBorder" Color="#334155" />
                    <SolidColorBrush x:Key="BrushBadgeText" Color="#93C5FD" />
                    <SolidColorBrush x:Key="BrushModelBadgeBg" Color="#1E293B" />
                    <SolidColorBrush x:Key="BrushModelBadgeBorder" Color="#334155" />
                    <SolidColorBrush x:Key="BrushModelBadgeText" Color="#93C5FD" />
                    <SolidColorBrush x:Key="BrushWarningAlertBg" Color="#241A06" />
                    <SolidColorBrush x:Key="BrushWarningAlertBorder" Color="#D97706" />
                    <SolidColorBrush x:Key="BrushWarningAlertText" Color="#FDE68A" />
                    <SolidColorBrush x:Key="BrushErrorAlertBg" Color="#2A0E13" />
                    <SolidColorBrush x:Key="BrushErrorAlertBorder" Color="#DC2626" />
                    <SolidColorBrush x:Key="BrushErrorAlertText" Color="#FCA5A5" />
                    <SolidColorBrush x:Key="BrushNavActiveBg" Color="#1E293B" />
                    <SolidColorBrush x:Key="BrushNavActiveBorder" Color="#3B82F6" />
                    <SolidColorBrush x:Key="BrushNavActiveText" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="BrushNavHoverBg" Color="#1F222A" />
                    <SolidColorBrush x:Key="BrushNavInactiveText" Color="#9CA3AF" />
                    <SolidColorBrush x:Key="BrushProgressTrack" Color="#1F2430" />
                    <SolidColorBrush x:Key="BrushMonoPath" Color="#60A5FA" />
                    <SolidColorBrush x:Key="BrushQuotaExhaustedBg" Color="#311118" />
                    <SolidColorBrush x:Key="BrushQuotaExhaustedBorder" Color="#DC2626" />
                    <SolidColorBrush x:Key="BrushQuotaExhaustedText" Color="#FCA5A5" />
                    <SolidColorBrush x:Key="BrushAlertBg" Color="#1E293B" />
                    <SolidColorBrush x:Key="BrushAlertBorder" Color="#3B82F6" />
                    <SolidColorBrush x:Key="BrushAlertText" Color="#93C5FD" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Permanent, easily grabbable scrollbars across all pages -->
        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="10" />
            <Setter Property="MinHeight" Value="10" />
        </Style>
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif" />
        </Style>

        <!-- Modern Clean Outline Button Style (1:1 with WPF ModernButton) -->
        <Style Selector="Button.outline, Button.modern">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.outline:pointerover, Button.modern:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}" />
        </Style>
        <Style Selector="Button.outline:pressed, Button.modern:pressed">
            <Setter Property="Background" Value="{DynamicResource BrushSurfacePressed}" />
        </Style>

        <!-- Danger Outline Button Style -->
        <Style Selector="Button.dangerOutline, Button.danger">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#EF4444" />
            <Setter Property="BorderBrush" Value="#EF4444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.dangerOutline:pointerover, Button.danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushDangerHoverBg}" />
            <Setter Property="BorderBrush" Value="#DC2626" />
            <Setter Property="Foreground" Value="#DC2626" />
        </Style>

        <!-- Primary Solid Button Style -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource BrushPrimary}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushPrimaryHover}" />
        </Style>

        <!-- Emerald Solid Button Style (Launch agy / Swarm) -->
        <Style Selector="Button.emerald">
            <Setter Property="Background" Value="{DynamicResource BrushEmerald}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.emerald:pointerover">
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <!-- Keyframe Spin Animation for Sync Loading State -->
        <Style Selector="Path.spin">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Keyframe Flowing Dashed Connector Animation for Live Workflow Topology -->
        <Style Selector="Line.flowing-connector">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="StrokeDashOffset" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="StrokeDashOffset" Value="-14"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Keyframe Pulsing Arrow Head Animation for Live Workflow Topology -->
        <Style Selector="Path.pulsing-arrow">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.6"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.6"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/favicon.ico" ToolTipText="Agy CLI Account Swarm" Clicked="OnTrayIconClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open Agy Swarm" Click="OnTrayOpenClicked" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Exit Application" Click="OnTrayExitClicked" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
            <!-- Mesh Dot-Grid Canvas Background Brush -->
            <DrawingBrush x:Key="MeshGridBrush" TileMode="Tile" SourceRect="0,0,24,24" DestinationRect="0,0,24,24">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="{DynamicResource BrushCardBorder}">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="12,12" RadiusX="1.2" RadiusY="1.2" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>


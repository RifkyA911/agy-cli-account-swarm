<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:AgyAccountSwarm.Avalonia.Views"
        x:Class="AgyAccountSwarm.Avalonia.Views.ProfileEditWindow"
        x:DataType="views:ProfileEditWindow"
        Title="{Binding Strings[Edit_Title]}"
        Width="660" Height="780"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushCard}">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="6" Background="#1538BDF8" BorderBrush="#3038BDF8" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="⚙️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Strings[Edit_Title]}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBlock Text="{Binding Strings[Edit_Subtitle]}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Margin="0,0,10,0">
                <!-- Name -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Strings[Edit_DisplayName]}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBox x:Name="TxtName" PlaceholderText="{Binding Strings[Edit_DisplayNamePlaceholder]}" />
                </StackPanel>

                <!-- Swarm Execution Archetype / Role -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Strings[Edit_Role]}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
                    <ComboBox x:Name="CmbRole" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Lead Architect (Decomposition &amp; Orchestration)" />
                        <ComboBoxItem Content="Backend Specialist (APIs, Database &amp; Services)" />
                        <ComboBoxItem Content="Frontend Specialist (UI/UX, Components &amp; Styles)" />
                        <ComboBoxItem Content="Security Auditor (Threat Modeling &amp; Sanitization)" />
                        <ComboBoxItem Content="QA Automation Engineer (Testing &amp; Verification)" />
                        <ComboBoxItem Content="DevOps &amp; Infrastructure (CI/CD &amp; Environments)" />
                        <ComboBoxItem Content="Generalist Worker (Full-stack Autonomous Tasks)" />
                    </ComboBox>
                </StackPanel>

                <!-- Description -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Strings[Edit_RoleNotes]}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBox x:Name="TxtDescription" PlaceholderText="{Binding Strings[Edit_RoleNotesPlaceholder]}" />
                </StackPanel>

                <!-- AI Model Provider, Model & Temperature Presets -->
                <Border Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="14" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Strings[Edit_ModelSection]}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
                        
                        <Grid ColumnDefinitions="*,*">
                            <!-- Model Provider Family -->
                            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Strings[Edit_ModelFamily]}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                <ComboBox x:Name="CmbModelFamily" HorizontalAlignment="Stretch" SelectionChanged="OnModelFamilySelectionChanged">
                                    <ComboBoxItem Content="Gemini Models (Google)" />
                                    <ComboBoxItem Content="Claude &amp; GPT Models (Anthropic / OSS)" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Temperature / Reasoning Effort -->
                            <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Strings[Edit_Preset]}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                <ComboBox x:Name="CmbTemperature" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Low (0.2 - Deterministic / Audit)" />
                                    <ComboBoxItem Content="Medium (0.7 - Balanced / Standard)" />
                                    <ComboBoxItem Content="High (1.0 - Creative / Architecture)" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Preferred Model Dropdown -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Strings[Edit_ModelId]}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" />
                            <ComboBox x:Name="CmbModel" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="gemini-2.5-flash" />
                                <ComboBoxItem Content="gemini-2.5-pro" />
                                <ComboBoxItem Content="gemini-3.1-pro-high" />
                                <ComboBoxItem Content="gemini-3.8-flash-high" />
                                <ComboBoxItem Content="claude-3.7-sonnet" />
                                <ComboBoxItem Content="claude-opus-4-6-thinking" />
                                <ComboBoxItem Content="gpt-oss-120b-medium" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Default Workspace with Browse Button -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Strings[Edit_Workspace]}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="TxtWorkspace" Grid.Column="0" PlaceholderText="e.g. D:\Works\Projects\App" Margin="0,0,8,0" />
                        <Button x:Name="BtnBrowseWorkspace" Grid.Column="1" Content="📁 Browse..." Click="OnBrowseWorkspaceClick" Padding="14,7" />
                    </Grid>
                </StackPanel>

                <!-- Custom Profile Sandbox Path with Browse Button -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Strings[Edit_CustomDir]}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="TxtCustomPath" Grid.Column="0" PlaceholderText="Default: ~/.gemini-profiles/{Name}" Margin="0,0,8,0" />
                        <Button x:Name="BtnBrowseCustomPath" Grid.Column="1" Content="📁 Browse..." Click="OnBrowseCustomPathClick" Padding="14,7" />
                    </Grid>
                </StackPanel>

                <!-- Dangerously Skip Permissions -->
                <Border Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="14" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Strings[Edit_SkipPerms]}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
                            <TextBlock Text="{Binding Strings[Edit_SkipPermsDesc]}"
                                       FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="ChkSkipPermissions" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <!-- Visual Appearance: Accent Color Swatch & Custom Hex + Swarm Inclusion -->
                <Border Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="14" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding Strings[Edit_VisualSection]}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />

                        <Grid ColumnDefinitions="*,*,Auto">
                            <!-- Preset Color Pick -->
                            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Strings[Edit_ColorPreset]}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                <ComboBox x:Name="CmbColor" HorizontalAlignment="Stretch" SelectionChanged="OnColorPresetSelectionChanged">
                                    <ComboBoxItem Content="#3B82F6 (Blue)" />
                                    <ComboBoxItem Content="#10B981 (Emerald)" />
                                    <ComboBoxItem Content="#8B5CF6 (Purple)" />
                                    <ComboBoxItem Content="#F59E0B (Amber)" />
                                    <ComboBoxItem Content="#EC4899 (Pink)" />
                                    <ComboBoxItem Content="#06B6D4 (Cyan)" />
                                    <ComboBoxItem Content="#EF4444 (Red)" />
                                    <ComboBoxItem Content="#64748B (Slate)" />
                                    <ComboBoxItem Content="Custom HEX" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Custom HEX Input -->
                            <StackPanel Grid.Column="1" Spacing="6" Margin="4,0,8,0">
                                <TextBlock Text="{Binding Strings[Edit_CustomHex]}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                <TextBox x:Name="TxtCustomHex" PlaceholderText="#3B82F6" TextChanged="OnCustomHexTextChanged" />
                            </StackPanel>

                            <!-- Live Color Swatch Preview Box -->
                            <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Strings[Edit_Preview]}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                <Border x:Name="ColorPreviewBorder" Width="38" Height="34" CornerRadius="6"
                                        Background="#3B82F6" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1.5"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Include in Swarm Launch -->
                        <Border BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,4,0,0">
                            <CheckBox x:Name="ChkIncludeInSwarm" Content="Include in Swarm Launch (batch execution pool)" IsChecked="True" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions Footer -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="{Binding Strings[Edit_BtnCancel]}" Click="OnCancelClick" Padding="16,8" />
                <Button Content="{Binding Strings[Edit_BtnSave]}" Click="OnSaveClick" Background="{DynamicResource BrushEmerald}" Foreground="#FFFFFF" FontWeight="Bold" Padding="18,8" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AgyAccountSwarm.ViewModels"
        xmlns:services="clr-namespace:AgyAccountSwarm.Services"
        x:Class="AgyAccountSwarm.Avalonia.Views.ImportChatWindow"
        x:DataType="vm:ImportChatViewModel"
        Title="Import Chat Conversations"
        Width="740" Height="620"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushTextPrimary}">

    <Border Padding="24">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

            <!-- Dialog Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Import Chat History"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBlock Text="Migrate conversation sessions and transcripts from another account into this profile."
                               FontSize="12"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#1A3B82F6"
                        BorderBrush="#403B82F6"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Target:" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                        <TextBlock Text="{Binding TargetProfile.Name}" FontSize="11" FontWeight="Bold" Foreground="#3B82F6" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Source Account Selector Bar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource BrushCard}"
                    BorderBrush="{DynamicResource BrushCardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Margin="0,0,0,16">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Source Account:"
                               FontWeight="SemiBold"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding SourceProfiles}"
                              SelectedItem="{Binding SelectedSourceProfile}"
                              DisplayMemberBinding="{Binding Name}"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="14,0,0,0">
                        <Button Content="Select All"
                                Command="{Binding SelectAllCommand}"
                                Classes="outline"
                                Padding="10,5"
                                FontSize="11" />
                        <Button Content="Deselect All"
                                Command="{Binding DeselectAllCommand}"
                                Classes="outline"
                                Padding="10,5"
                                FontSize="11" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Conversations List -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushCard}"
                    BorderBrush="{DynamicResource BrushCardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,14">
                <Grid>
                    <!-- Loading Indicator -->
                    <TextBlock Text="Scanning conversations..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               IsVisible="{Binding IsLoading}" />

                    <!-- List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Conversations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:TransferableConversation">
                                    <Border Margin="0,0,0,8"
                                            Padding="10,8"
                                            CornerRadius="6"
                                            Background="{DynamicResource BrushSurface}"
                                            BorderBrush="{DynamicResource BrushCardBorder}"
                                            BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <!-- Checkbox -->
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0" />

                                            <!-- Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding DisplayPrompt}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource BrushTextSecondary}" />
                                                    <TextBlock Text="{Binding Workspace}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource BrushTextSecondary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="300" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- ID Badge -->
                                            <Border Grid.Column="2"
                                                    Background="{DynamicResource BrushCard}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ConversationId}"
                                                           FontSize="10"
                                                           FontFamily="Consolas"
                                                           Foreground="{DynamicResource BrushTextSecondary}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Status and Notice -->
            <TextBlock Grid.Row="3"
                       Text="{Binding StatusMessage}"
                       FontSize="11"
                       Foreground="{DynamicResource BrushTextSecondary}"
                       Margin="4,0,4,12" />

            <!-- Footer Buttons -->
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Content="Cancel"
                            Click="OnCancelClick"
                            Classes="outline"
                            Padding="16,8"
                            FontSize="12" />
                    <Button Content="Import Selected"
                            Command="{Binding ImportCommand}"
                            Classes="primary"
                            Padding="20,8"
                            FontWeight="Bold"
                            FontSize="12" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

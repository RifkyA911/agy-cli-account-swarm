<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgyAccountSwarm.Avalonia.ViewModels"
        xmlns:models="using:AgyAccountSwarm.Models"
        xmlns:services="using:AgyAccountSwarm.Services"
        x:Class="AgyAccountSwarm.Avalonia.MainWindow"
        x:DataType="vm:AvaloniaMainViewModel"
        Title="Agy CLI Account Swarm — Antigravity CLI Orchestrator"
        Icon="/Assets/favicon.ico"
        Width="1240" Height="760"
        MinWidth="1050" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBg}">

    <Grid>
        <!-- ============================================================== -->
        <!-- MAIN APP LAYOUT (Sidebar + Main Content Area)                 -->
        <!-- ============================================================== -->
        <Grid ColumnDefinitions="Auto,*">
            <!-- ============================================================== -->
            <!-- 1. LEFT SIDEBAR NAVIGATION                                     -->
            <!-- ============================================================== -->
            <Border Grid.Column="0"
                    Width="{Binding SidebarWidth}"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushCardBorder}"
                    BorderThickness="0,0,1,0"
                    Padding="6,18">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header / Branding & Collapse Toggle -->
                    <Grid Grid.Row="0" Margin="4,0,4,22">
                        <!-- Expanded Header -->
                        <Grid IsVisible="{Binding !IsSidebarCollapsed}" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                <Image Source="/Assets/favicon.ico" Width="26" Height="26" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Agy CLI Swarm"
                                               FontSize="14.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource BrushTextPrimary}" />
                                    <TextBlock Text="Account Orchestrator"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource BrushTextMuted}" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding ToggleSidebarCommand}"
                                    Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BrushCardBorder}"
                                    CornerRadius="6" Padding="6,5"
                                    ToolTip.Tip="Collapse Sidebar">
                                <Path Data="{StaticResource HeroIconBars3}"
                                      Stroke="{DynamicResource BrushTextSecondary}"
                                      StrokeThickness="1.75" StrokeLineCap="Round"
                                      Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                            </Button>
                        </Grid>

                        <!-- Collapsed Header -->
                        <StackPanel IsVisible="{Binding IsSidebarCollapsed}" HorizontalAlignment="Center" Spacing="10">
                            <Image Source="/Assets/favicon.ico" Width="26" Height="26" HorizontalAlignment="Center" />
                            <Button Command="{Binding ToggleSidebarCommand}"
                                    Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BrushCardBorder}"
                                    CornerRadius="6" Padding="6,6" HorizontalAlignment="Center"
                                    ToolTip.Tip="Expand Sidebar">
                                <Path Data="{StaticResource HeroIconBars3}"
                                      Stroke="{DynamicResource BrushTextSecondary}"
                                      StrokeThickness="1.75" StrokeLineCap="Round"
                                      Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Navigation Menu Items -->
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="4">
                            <!-- /dashboard -->
                            <Border BorderThickness="1" CornerRadius="8"
                                    Background="{Binding CurrentPage, Converter={StaticResource ActiveNavBgConverter}, ConverterParameter=Dashboard}"
                                    BorderBrush="{Binding CurrentPage, Converter={StaticResource ActiveNavBorderConverter}, ConverterParameter=Dashboard}">
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                        Background="Transparent" BorderThickness="0" CornerRadius="8"
                                        Padding="8,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        ToolTip.Tip="Dashboard">
                                    <Grid HorizontalAlignment="Stretch">
                                        <!-- Expanded View -->
                                        <Grid IsVisible="{Binding !IsSidebarCollapsed}" ColumnDefinitions="Auto,*">
                                            <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                                    Background="#3B82F6" Margin="0,0,8,0"
                                                    IsVisible="{Binding CurrentPage, Converter={StaticResource EqualityConverter}, ConverterParameter=Dashboard}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                                <Path Data="{StaticResource HeroIconSquares2x2}"
                                                      Stroke="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Dashboard}"
                                                      StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                                      Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="Dashboard" FontSize="13"
                                                           FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Dashboard}"
                                                           Foreground="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Dashboard}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Collapsed View -->
                                        <Grid IsVisible="{Binding IsSidebarCollapsed}" Height="28" Width="44" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconSquares2x2}"
                                                  Stroke="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Dashboard}"
                                                  StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                                  Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Button>
                            </Border>

                            <!-- /accounts -->
                            <Border BorderThickness="1" CornerRadius="8"
                                    Background="{Binding CurrentPage, Converter={StaticResource ActiveNavBgConverter}, ConverterParameter=Accounts}"
                                    BorderBrush="{Binding CurrentPage, Converter={StaticResource ActiveNavBorderConverter}, ConverterParameter=Accounts}">
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Accounts"
                                        Background="Transparent" BorderThickness="0" CornerRadius="8"
                                        Padding="8,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        ToolTip.Tip="Accounts">
                                    <Grid HorizontalAlignment="Stretch">
                                        <!-- Expanded View -->
                                        <Grid IsVisible="{Binding !IsSidebarCollapsed}" ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                                    Background="#3B82F6" Margin="0,0,8,0"
                                                    IsVisible="{Binding CurrentPage, Converter={StaticResource EqualityConverter}, ConverterParameter=Accounts}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                                <Path Data="{StaticResource HeroIconUsers}"
                                                      Stroke="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Accounts}"
                                                      StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                                      Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="Accounts" FontSize="13"
                                                           FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Accounts}"
                                                           Foreground="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Accounts}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{DynamicResource BrushBadgeBg}"
                                                    BorderBrush="{DynamicResource BrushBadgeBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="10" Padding="8,2"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TotalCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushBadgeText}" />
                                            </Border>
                                        </Grid>

                                        <!-- Collapsed View -->
                                        <Grid IsVisible="{Binding IsSidebarCollapsed}" Height="28" Width="44" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconUsers}"
                                                  Stroke="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Accounts}"
                                                  StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                                  Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource BrushBadgeBg}" BorderBrush="{DynamicResource BrushBadgeBorder}" BorderThickness="1"
                                                    CornerRadius="7" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0">
                                                <TextBlock Text="{Binding TotalCount}" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource BrushBadgeText}" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Button>
                            </Border>

                            <!-- /dispatcher (Swarm Worker) -->
                            <Border BorderThickness="1" CornerRadius="8"
                                    Background="{Binding CurrentPage, Converter={StaticResource ActiveNavBgConverter}, ConverterParameter=Dispatcher}"
                                    BorderBrush="{Binding CurrentPage, Converter={StaticResource ActiveNavBorderConverter}, ConverterParameter=Dispatcher}">
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Dispatcher"
                                        Background="Transparent" BorderThickness="0" CornerRadius="8"
                                        Padding="8,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        ToolTip.Tip="Swarm Worker &amp; Multi-Agent Project Orchestrator (Experimental)">
                                    <Grid HorizontalAlignment="Stretch">
                                        <!-- Expanded View -->
                                        <Grid IsVisible="{Binding !IsSidebarCollapsed}" ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                                    Background="#3B82F6" Margin="0,0,8,0"
                                                    IsVisible="{Binding CurrentPage, Converter={StaticResource EqualityConverter}, ConverterParameter=Dispatcher}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                                <Path Data="{StaticResource HeroIconChatBubbleOvalLeftEllipsis}"
                                                      Stroke="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Dispatcher}"
                                                      StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                                      Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="Swarm Worker" FontSize="13"
                                                           FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Dispatcher}"
                                                           Foreground="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Dispatcher}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{DynamicResource BrushWarningAlertBg}" BorderBrush="{DynamicResource BrushWarningAlertBorder}" BorderThickness="1"
                                                    CornerRadius="7" Padding="5,1.5" VerticalAlignment="Center">
                                                <TextBlock Text="EXP" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource BrushWarningAlertText}" />
                                            </Border>
                                        </Grid>

                                        <!-- Collapsed View -->
                                        <Grid IsVisible="{Binding IsSidebarCollapsed}" Height="28" Width="44" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconChatBubbleOvalLeftEllipsis}"
                                                  Stroke="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Dispatcher}"
                                                  StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                                  Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource BrushWarningAlertBg}" BorderBrush="{DynamicResource BrushWarningAlertBorder}" BorderThickness="1"
                                                    CornerRadius="7" Padding="3,1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0">
                                                <TextBlock Text="EXP" FontSize="7" FontWeight="Bold" Foreground="{DynamicResource BrushWarningAlertText}" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Button>
                            </Border>

                            <!-- /analytics -->
                            <Border BorderThickness="1" CornerRadius="8"
                                    Background="{Binding CurrentPage, Converter={StaticResource ActiveNavBgConverter}, ConverterParameter=Analytics}"
                                    BorderBrush="{Binding CurrentPage, Converter={StaticResource ActiveNavBorderConverter}, ConverterParameter=Analytics}">
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Analytics"
                                        Background="Transparent" BorderThickness="0" CornerRadius="8"
                                        Padding="8,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        ToolTip.Tip="Analytics">
                                    <Grid HorizontalAlignment="Stretch">
                                        <!-- Expanded View -->
                                        <Grid IsVisible="{Binding !IsSidebarCollapsed}" ColumnDefinitions="Auto,*">
                                            <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                                    Background="#3B82F6" Margin="0,0,8,0"
                                                    IsVisible="{Binding CurrentPage, Converter={StaticResource EqualityConverter}, ConverterParameter=Analytics}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                                <Path Data="{StaticResource HeroIconChartBar}"
                                                      Stroke="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Analytics}"
                                                      StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                                      Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="Analytics" FontSize="13"
                                                           FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Analytics}"
                                                           Foreground="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Analytics}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Collapsed View -->
                                        <Grid IsVisible="{Binding IsSidebarCollapsed}" Height="28" Width="44" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconChartBar}"
                                                  Stroke="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Analytics}"
                                                  StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                                  Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Button>
                            </Border>

                            <!-- /mcp -->
                            <Border BorderThickness="1" CornerRadius="8"
                                    Background="{Binding CurrentPage, Converter={StaticResource ActiveNavBgConverter}, ConverterParameter=Mcp}"
                                    BorderBrush="{Binding CurrentPage, Converter={StaticResource ActiveNavBorderConverter}, ConverterParameter=Mcp}">
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Mcp"
                                        Background="Transparent" BorderThickness="0" CornerRadius="8"
                                        Padding="8,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        ToolTip.Tip="MCP Tools">
                                    <Grid HorizontalAlignment="Stretch">
                                        <!-- Expanded View -->
                                        <Grid IsVisible="{Binding !IsSidebarCollapsed}" ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                                    Background="#3B82F6" Margin="0,0,8,0"
                                                    IsVisible="{Binding CurrentPage, Converter={StaticResource EqualityConverter}, ConverterParameter=Mcp}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                                <Path Data="{StaticResource HeroIconCpuChip}"
                                                      Stroke="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Mcp}"
                                                      StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                                      Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="MCP Tools" FontSize="13"
                                                           FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Mcp}"
                                                           Foreground="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Mcp}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{DynamicResource BrushBadgeBg}"
                                                    BorderBrush="{DynamicResource BrushBadgeBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="10" Padding="8,2"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding McpServersCount}" FontSize="11" FontWeight="Bold" Foreground="#3B82F6" />
                                            </Border>
                                        </Grid>

                                        <!-- Collapsed View -->
                                        <Grid IsVisible="{Binding IsSidebarCollapsed}" Height="28" Width="44" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconCpuChip}"
                                                  Stroke="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Mcp}"
                                                  StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                                  Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource BrushBadgeBg}" BorderBrush="{DynamicResource BrushBadgeBorder}" BorderThickness="1"
                                                    CornerRadius="7" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0">
                                                <TextBlock Text="{Binding McpServersCount}" FontSize="8.5" FontWeight="Bold" Foreground="#3B82F6" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Button>
                            </Border>

                            <!-- /docs -->
                            <Border BorderThickness="1" CornerRadius="8"
                                    Background="{Binding CurrentPage, Converter={StaticResource ActiveNavBgConverter}, ConverterParameter=Docs}"
                                    BorderBrush="{Binding CurrentPage, Converter={StaticResource ActiveNavBorderConverter}, ConverterParameter=Docs}">
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Docs"
                                        Background="Transparent" BorderThickness="0" CornerRadius="8"
                                        Padding="8,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        ToolTip.Tip="Documentation">
                                    <Grid HorizontalAlignment="Stretch">
                                        <!-- Expanded View -->
                                        <Grid IsVisible="{Binding !IsSidebarCollapsed}" ColumnDefinitions="Auto,*">
                                            <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                                    Background="#3B82F6" Margin="0,0,8,0"
                                                    IsVisible="{Binding CurrentPage, Converter={StaticResource EqualityConverter}, ConverterParameter=Docs}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                                <Path Data="{StaticResource HeroIconBookOpen}"
                                                      Stroke="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Docs}"
                                                      StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                                      Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="Documentation" FontSize="13"
                                                           FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Docs}"
                                                           Foreground="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Docs}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Collapsed View -->
                                        <Grid IsVisible="{Binding IsSidebarCollapsed}" Height="28" Width="44" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconBookOpen}"
                                                  Stroke="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Docs}"
                                                  StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                                  Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Button>
                            </Border>

                            <!-- /logs -->
                            <Border BorderThickness="1" CornerRadius="8"
                                    Background="{Binding CurrentPage, Converter={StaticResource ActiveNavBgConverter}, ConverterParameter=Logs}"
                                    BorderBrush="{Binding CurrentPage, Converter={StaticResource ActiveNavBorderConverter}, ConverterParameter=Logs}">
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Logs"
                                        Background="Transparent" BorderThickness="0" CornerRadius="8"
                                        Padding="8,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        ToolTip.Tip="Logs">
                                    <Grid HorizontalAlignment="Stretch">
                                        <!-- Expanded View -->
                                        <Grid IsVisible="{Binding !IsSidebarCollapsed}" ColumnDefinitions="Auto,*">
                                            <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                                    Background="#3B82F6" Margin="0,0,8,0"
                                                    IsVisible="{Binding CurrentPage, Converter={StaticResource EqualityConverter}, ConverterParameter=Logs}" />
                                             <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                                <Path Data="{StaticResource HeroIconCommandLine}"
                                                      Stroke="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Logs}"
                                                      StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                                      Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="Logs" FontSize="13"
                                                           FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Logs}"
                                                           Foreground="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Logs}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Collapsed View -->
                                        <Grid IsVisible="{Binding IsSidebarCollapsed}" Height="28" Width="44" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconCommandLine}"
                                                  Stroke="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Logs}"
                                                  StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                                  Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Button>
                            </Border>

                            <!-- /settings -->
                            <Border BorderThickness="1" CornerRadius="8"
                                    Background="{Binding CurrentPage, Converter={StaticResource ActiveNavBgConverter}, ConverterParameter=Settings}"
                                    BorderBrush="{Binding CurrentPage, Converter={StaticResource ActiveNavBorderConverter}, ConverterParameter=Settings}">
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                        Background="Transparent" BorderThickness="0" CornerRadius="8"
                                        Padding="8,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        ToolTip.Tip="Settings">
                                    <Grid HorizontalAlignment="Stretch">
                                        <!-- Expanded View -->
                                        <Grid IsVisible="{Binding !IsSidebarCollapsed}" ColumnDefinitions="Auto,*">
                                            <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                                    Background="#3B82F6" Margin="0,0,8,0"
                                                    IsVisible="{Binding CurrentPage, Converter={StaticResource EqualityConverter}, ConverterParameter=Settings}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                                <Path Data="{StaticResource HeroIconCog6Tooth}"
                                                      Stroke="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Settings}"
                                                      StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                                      Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="Settings" FontSize="13"
                                                           FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Settings}"
                                                           Foreground="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Settings}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Collapsed View -->
                                        <Grid IsVisible="{Binding IsSidebarCollapsed}" Height="28" Width="44" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconCog6Tooth}"
                                                  Stroke="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=Settings}"
                                                  StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                                  Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Button>
                            </Border>

                            <!-- /about -->
                            <Border BorderThickness="1" CornerRadius="8"
                                    Background="{Binding CurrentPage, Converter={StaticResource ActiveNavBgConverter}, ConverterParameter=About}"
                                    BorderBrush="{Binding CurrentPage, Converter={StaticResource ActiveNavBorderConverter}, ConverterParameter=About}">
                                <Button Command="{Binding NavigateCommand}" CommandParameter="About"
                                        Background="Transparent" BorderThickness="0" CornerRadius="8"
                                        Padding="8,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        ToolTip.Tip="About">
                                    <Grid HorizontalAlignment="Stretch">
                                        <!-- Expanded View -->
                                        <Grid IsVisible="{Binding !IsSidebarCollapsed}" ColumnDefinitions="Auto,*">
                                            <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                                    Background="#3B82F6" Margin="0,0,8,0"
                                                    IsVisible="{Binding CurrentPage, Converter={StaticResource EqualityConverter}, ConverterParameter=About}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                                <Path Data="{StaticResource HeroIconInformationCircle}"
                                                      Stroke="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=About}"
                                                      StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                                      Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="About" FontSize="13"
                                                           FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=About}"
                                                           Foreground="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=About}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Collapsed View -->
                                        <Grid IsVisible="{Binding IsSidebarCollapsed}" Height="28" Width="44" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconInformationCircle}"
                                                  Stroke="{Binding CurrentPage, Converter={StaticResource ActiveNavFgConverter}, ConverterParameter=About}"
                                                  StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round"
                                                  Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Button>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Sidebar Controls -->
                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <Separator Background="{DynamicResource BrushCardBorder}" Margin="0,0,0,12" />

                        <!-- Expanded Bottom Controls -->
                        <StackPanel IsVisible="{Binding !IsSidebarCollapsed}" Spacing="6">
                            <!-- Language Selector Dropdown -->
                            <ComboBox ItemsSource="{Binding LanguageOptions}"
                                      SelectedItem="{Binding SelectedLanguageOption}"
                                      HorizontalAlignment="Stretch"
                                      ToolTip.Tip="Select Application Display Language">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Theme Appearance Palette Dropdown -->
                            <ComboBox ItemsSource="{Binding ThemeOptions}"
                                      SelectedItem="{Binding SelectedThemeOption}"
                                      HorizontalAlignment="Stretch"
                                      ToolTip.Tip="Select Theme Appearance Color Palette" />

                            <!-- Sound Toggle -->
                            <Button Command="{Binding ToggleSoundCommand}"
                                    Background="Transparent" BorderThickness="0" CornerRadius="6"
                                    Padding="8,6" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="🔊" FontSize="12" />
                                    <TextBlock Text="Sound:" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <TextBlock Text="ON" FontWeight="Bold" FontSize="12" Foreground="#10B981" IsVisible="{Binding SoundEnabled}" />
                                    <TextBlock Text="MUTED" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" IsVisible="{Binding !SoundEnabled}" />
                                </StackPanel>
                            </Button>

                            <!-- CLI Status Pill -->
                            <Border Background="{DynamicResource BrushCard}"
                                    BorderBrush="{DynamicResource BrushCardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                    <Ellipse Width="7" Height="7" Fill="{Binding IsAgyInstalled, Converter={StaticResource QuotaBrushConverter}}" VerticalAlignment="Center" />
                                    <TextBlock Text="CLI: " FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Text="CLI Ready" FontSize="11" FontWeight="Bold" Foreground="#10B981" IsVisible="{Binding IsAgyInstalled}" VerticalAlignment="Center" />
                                    <TextBlock Text="CLI Missing" FontSize="11" FontWeight="Bold" Foreground="#EF4444" IsVisible="{Binding !IsAgyInstalled}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Collapsed Bottom Controls -->
                        <StackPanel IsVisible="{Binding IsSidebarCollapsed}" HorizontalAlignment="Center" Spacing="8">
                            <Button Command="{Binding ToggleSoundCommand}"
                                    Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BrushCardBorder}"
                                    CornerRadius="6" Padding="7,6" ToolTip.Tip="Toggle Sound">
                                <TextBlock Text="🔊" FontSize="13" />
                            </Button>
                            <Border Background="{DynamicResource BrushCard}"
                                    BorderBrush="{DynamicResource BrushCardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Width="26" Height="26"
                                    HorizontalAlignment="Center"
                                    ToolTip.Tip="Antigravity CLI Status">
                                <Ellipse Width="8" Height="8" Fill="{Binding IsAgyInstalled, Converter={StaticResource QuotaBrushConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================== -->
            <!-- 2. MAIN CONTENT AREA                                           -->
            <!-- ============================================================== -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
                <!-- Top Header Bar -->
                <Border Grid.Row="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="24,14">
                    <Grid RowDefinitions="Auto,Auto">
                        <!-- Row 0: Page Title, Version & Main Action Buttons -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                <TextBlock Text="{Binding CurrentPageTitle}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           VerticalAlignment="Center" />
                                <!-- Version Badge -->
                                <Border Background="{DynamicResource BrushBadgeBg}"
                                        BorderBrush="{DynamicResource BrushBadgeBorder}"
                                        BorderThickness="1"
                                        CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppVersion}" Foreground="{DynamicResource BrushBadgeText}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>

                            <!-- Right CTA: Sync Swarm and Launch Swarm -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <!-- Refresh / Sync Swarm Button with Loading Animation -->
                                <Button Command="{Binding SyncSwarmCommand}"
                                        Classes="outline"
                                        Padding="12,8"
                                        IsEnabled="{Binding !IsSyncing}"
                                        ToolTip.Tip="Check profile tokens, detect model sessions, and verify quota limits">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="7">
                                        <!-- Spinning Arrow Path when Syncing -->
                                        <Path Data="{StaticResource HeroIconArrowPath}"
                                              Stroke="{DynamicResource BrushAccent}"
                                              StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                              IsVisible="{Binding IsSyncing}"
                                              Classes="spin" />

                                        <!-- Static Arrow Path when Idle -->
                                        <Path Data="{StaticResource HeroIconArrowPath}"
                                              Stroke="{DynamicResource BrushTextPrimary}"
                                              StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                              IsVisible="{Binding !IsSyncing}" />

                                        <TextBlock Text="Syncing Swarm..." FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" IsVisible="{Binding IsSyncing}" />
                                        <TextBlock Text="Sync Swarm" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" IsVisible="{Binding !IsSyncing}" />
                                    </StackPanel>
                                </Button>

                                <!-- Launch Swarm Button (When Swarm is Idle) -->
                                <Button Command="{Binding LaunchSwarmCommand}"
                                        Background="#059669"
                                        BorderThickness="0"
                                        CornerRadius="6"
                                        Padding="14,8"
                                        IsVisible="{Binding !IsSwarmRunning}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                        <Path Data="{StaticResource HeroIconBolt}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedSwarmCount, StringFormat='Launch Swarm ({0})'}" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Stop Swarm Button (When Swarm is Active) -->
                                <Button Command="{Binding StopSwarmCommand}"
                                        Background="#DC2626"
                                        BorderThickness="0"
                                        CornerRadius="6"
                                        Padding="14,8"
                                        IsVisible="{Binding IsSwarmRunning}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                        <Path Data="{StaticResource HeroIconStop}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedSwarmCount, StringFormat='Stop Swarm ({0} Active)'}" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: Subtitle & Dedicated Telemetry Sync Status Badges -->
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <TextBlock Grid.Column="0"
                                       Text="Isolated multi-session manager, rate-limit monitor &amp; quota tracker"
                                       FontSize="12"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <!-- Live Green Sync Dot -->
                                <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,2,0" />

                                <!-- Auto-Sync Status Badge -->
                                <Border Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="SUCCESS • AUTO-SYNC ACTIVE" Foreground="#10B981" FontSize="10" FontWeight="Bold" />
                                </Border>

                                <!-- Auto-Sync Countdown Tag -->
                                <Border Background="{DynamicResource BrushSurfaceHover}"
                                        BorderBrush="{DynamicResource BrushCardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AutoSyncCountdown, StringFormat='⏱️ Next: {0}'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                </Border>

                                <!-- Last Synced Tag with Timezone Indicator -->
                                <Border Background="{DynamicResource BrushSurfaceHover}"
                                        BorderBrush="{DynamicResource BrushCardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LastSyncedAtText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Toast Notification Banner -->
                <Border Grid.Row="1"
                        IsVisible="{Binding IsNotificationVisible}"
                        Background="{DynamicResource BrushAlertBg}"
                        BorderBrush="{DynamicResource BrushAlertBorder}"
                        BorderThickness="0,0,0,1"
                        Padding="18,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <TextBlock Text="ℹ️" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding NotificationMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushAlertText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- ====================================================== -->
                <!-- VIEW 0: DASHBOARD                                      -->
                <!-- ====================================================== -->
                <ScrollViewer Grid.Row="2"
                              IsVisible="{Binding CurrentPage, Converter={StaticResource EqualityConverter}, ConverterParameter=Dashboard}"
                              Padding="24,24,24,60">
                    <StackPanel Spacing="20">
                        <!-- Top KPI Metrics Header & Fold Toggle -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="📊 FLEET KEY PERFORMANCE INDICATORS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding ToggleDashboardKpiCommand}" Classes="outline" Padding="8,4" CornerRadius="6" ToolTip.Tip="Fold / Unfold Fleet KPIs">
                                <TextBlock Text="{Binding IsDashboardKpiExpanded, Converter={StaticResource BoolToChevronConverter}}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                            </Button>
                        </Grid>
                        <UniformGrid Columns="5" IsVisible="{Binding IsDashboardKpiExpanded}">
                            <!-- Card 1: Total Profiles -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="TOTAL PROFILES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,0" />
                                    <TextBlock Text="Sandboxed accounts" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Authenticated -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="AUTHENTICATED" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" />
                                    <TextBlock Text="{Binding AuthenticatedCount}" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0" />
                                    <TextBlock Text="Active Google credentials" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Swarm Workers -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="SWARM WORKERS" FontSize="10" FontWeight="SemiBold" Foreground="#3B82F6" />
                                    <TextBlock Text="{Binding SelectedSwarmCount}" FontSize="22" FontWeight="Bold" Foreground="#3B82F6" Margin="0,4,0,0" />
                                    <TextBlock Text="Selected for execution" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Saved Conversations -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="SAVED CONVERSATIONS" FontSize="10" FontWeight="SemiBold" Foreground="#8B5CF6" />
                                    <TextBlock Text="{Binding TotalSavedSessionsCount}" FontSize="22" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,4,0,0" />
                                    <TextBlock Text="Historical chat sessions" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 5: MCP Tools Active -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="MCP TOOLS &amp; SERVERS" FontSize="10" FontWeight="SemiBold" Foreground="#F59E0B" />
                                    <TextBlock Text="{Binding McpToolsTotalCount}" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0" />
                                    <TextBlock Text="Protocol integrations" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- ========================================== -->
                        <!-- DASHBOARD CHART (Bar, Line, Area Modes)    -->
                        <!-- ========================================== -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <!-- Chart Title & Action Row -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <!-- Chart Title & Subtitle -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Prompt &amp; Token Activity Distribution" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="Real-time telemetry parsed from local history.jsonl and session logs" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" />
                                    </StackPanel>

                                    <!-- Action Strip: Download PDF Report & Fold Toggle Button -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Command="{Binding ExportPdfReportCommand}"
                                                Background="{DynamicResource BrushSurface}"
                                                BorderBrush="{DynamicResource BrushCardBorder}"
                                                BorderThickness="1" CornerRadius="6"
                                                Padding="12,7" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <Path Data="{StaticResource HeroIconArrowDownTray}" Stroke="{DynamicResource BrushTextPrimary}" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,2.5,0,0" />
                                                <TextBlock Text="Download PDF Report" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ToggleDashboardChartCommand}"
                                                Classes="outline" Padding="8,6" CornerRadius="6"
                                                ToolTip.Tip="Fold / Unfold Analytics Chart">
                                            <TextBlock Text="{Binding IsDashboardChartExpanded, Converter={StaticResource BoolToChevronConverter}}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <StackPanel IsVisible="{Binding IsDashboardChartExpanded}" Spacing="16">
                                <!-- Dedicated Filter Toolbar Row -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                    <WrapPanel VerticalAlignment="Center">
                                        <!-- Chart Mode Switcher -->
                                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,4,14,4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <Button Content="📊 Bar" Command="{Binding SetChartModeCommand}" CommandParameter="Bar"
                                                        Background="{DynamicResource BrushSurface}" BorderThickness="0" CornerRadius="4" Padding="10,5" FontSize="12" />
                                                <Button Content="📈 Line" Command="{Binding SetChartModeCommand}" CommandParameter="Line"
                                                        Background="{DynamicResource BrushSurface}" BorderThickness="0" CornerRadius="4" Padding="10,5" FontSize="12" />
                                                <Button Content="🏔️ Area" Command="{Binding SetChartModeCommand}" CommandParameter="Area"
                                                        Background="{DynamicResource BrushSurface}" BorderThickness="0" CornerRadius="4" Padding="10,5" FontSize="12" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Zoom Controls -->
                                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,4,14,4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                                                <Button Content="➖" Command="{Binding ChartZoomOutCommand}" Classes="outline" Padding="7,4" FontSize="11" ToolTip.Tip="Zoom Out" />
                                                <TextBlock Text="{Binding ChartZoomText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="6,0" />
                                                <Button Content="➕" Command="{Binding ChartZoomInCommand}" Classes="outline" Padding="7,4" FontSize="11" ToolTip.Tip="Zoom In" />
                                                <Button Content="100%" Command="{Binding ChartZoomResetCommand}" Classes="outline" Padding="6,4" FontSize="10" ToolTip.Tip="Reset Zoom (100%)" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Account Filter -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,14,4" Spacing="6">
                                            <TextBlock Text="Account:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding AccountFilterOptions}"
                                                      SelectedItem="{Binding SelectedAccountFilter}"
                                                      Width="140" />
                                        </StackPanel>

                                        <!-- Period Filter -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,14,4" Spacing="6">
                                            <TextBlock Text="Period" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding TimeframeOptions}"
                                                      SelectedItem="{Binding SelectedTimeframe}"
                                                      Width="130" />
                                        </StackPanel>

                                        <!-- Model Filter -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,14,4" Spacing="6">
                                            <TextBlock Text="Model" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding ModelFilterOptions}"
                                                      SelectedItem="{Binding SelectedModelFilter}"
                                                      Width="180" />
                                        </StackPanel>

                                        <!-- Tier Filter -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4" Spacing="6">
                                            <TextBlock Text="Tier" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding TierFilterOptions}"
                                                      SelectedItem="{Binding SelectedChartTierFilter}"
                                                      Width="110" />
                                        </StackPanel>
                                    </WrapPanel>
                                </Border>

                                <!-- Visual Interactive Chart Canvas Area (Height 340) -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="14,14,14,10" Height="340">
                                    <Grid>
                                        <!-- No Data Placeholder -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !HasChartData}" Spacing="6">
                                            <TextBlock Text="📭" FontSize="32" HorizontalAlignment="Center" />
                                            <TextBlock Text="No recorded prompt activity found in session history yet." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Switch account or timeframe filter above to view historical prompt sessions." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Chart with Y-Axis, Horizontal Gridlines, and Horizontal ScrollViewer -->
                                        <Grid ColumnDefinitions="42,*" IsVisible="{Binding HasChartData}">
                                            <!-- Y-Axis Labels -->
                                            <Grid Grid.Column="0" Margin="0,18,6,38" RowDefinitions="*,*,*,*">
                                                <TextBlock Grid.Row="0" Text="{Binding YTick100}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="1" Text="{Binding YTick75}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="2" Text="{Binding YTick50}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="3" Text="{Binding YTick25}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="3" Text="{Binding YTick0}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                            </Grid>

                                            <!-- Plot Container (Gridlines + ScrollViewer) -->
                                            <Grid Grid.Column="1">
                                                <!-- Horizontal Background Gridlines & Baseline -->
                                                <Grid Margin="0,18,0,38" RowDefinitions="*,*,*,*">
                                                    <Line Grid.Row="0" StartPoint="0,0" EndPoint="1,0" Stretch="Fill" Stroke="{DynamicResource BrushCardBorder}" StrokeThickness="1" StrokeDashArray="3,3" Opacity="0.45" VerticalAlignment="Top" />
                                                    <Line Grid.Row="1" StartPoint="0,0" EndPoint="1,0" Stretch="Fill" Stroke="{DynamicResource BrushCardBorder}" StrokeThickness="1" StrokeDashArray="3,3" Opacity="0.45" VerticalAlignment="Top" />
                                                    <Line Grid.Row="2" StartPoint="0,0" EndPoint="1,0" Stretch="Fill" Stroke="{DynamicResource BrushCardBorder}" StrokeThickness="1" StrokeDashArray="3,3" Opacity="0.45" VerticalAlignment="Top" />
                                                    <Line Grid.Row="3" StartPoint="0,0" EndPoint="1,0" Stretch="Fill" Stroke="{DynamicResource BrushCardBorder}" StrokeThickness="1" StrokeDashArray="3,3" Opacity="0.45" VerticalAlignment="Top" />
                                                    <Rectangle Grid.Row="3" VerticalAlignment="Bottom" Height="1.5" Fill="{DynamicResource BrushCardBorder}" Opacity="0.8" />
                                                </Grid>

                                                <!-- Horizontal Scrollable Chart Content -->
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                    <Grid MinWidth="{Binding ChartCanvasWidth}" Height="300" HorizontalAlignment="Left">
                                                        <!-- 1. BAR CHART MODE -->
                                                        <ItemsControl ItemsSource="{Binding DashboardChartPoints}" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                                      Margin="10,0,10,12"
                                                                      IsVisible="{Binding SelectedChartMode, Converter={StaticResource EqualityConverter}, ConverterParameter=Bar}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Width="76" Margin="6,0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="Transparent">
                                                                        <ToolTip.Tip>
                                                                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                                                                <StackPanel Spacing="3">
                                                                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                                    <TextBlock Text="{Binding Value, StringFormat='Prompts: {0:N0}'}" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" />
                                                                                    <TextBlock Text="{Binding TokensLabel, StringFormat='Est. Tokens: {0}'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                                    <Separator Background="{DynamicResource BrushCardBorder}" Margin="0,4" />
                                                                                    <TextBlock Text="{Binding AccountContext, StringFormat='Account: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                    <TextBlock Text="{Binding ModelContext, StringFormat='Model: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </ToolTip.Tip>
                                                                        <TextBlock Text="{Binding Value}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                                                        <TextBlock Text="{Binding TokensLabel}" FontSize="9" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                                        <Border Height="{Binding Height}" Width="{Binding Width}" CornerRadius="4,4,0,0"
                                                                                Background="{Binding BarColor, Converter={StaticResource HexBrushConverter}}"
                                                                                HorizontalAlignment="Center" Cursor="Hand" />
                                                                        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- 2. LINE CHART MODE -->
                                                        <Grid IsVisible="{Binding SelectedChartMode, Converter={StaticResource EqualityConverter}, ConverterParameter=Line}"
                                                              Width="{Binding ChartCanvasWidth}" Height="290" VerticalAlignment="Center">
                                                            <Polyline Points="{Binding LinePoints}" Stroke="#3B82F6" StrokeThickness="3.5" StrokeJoin="Round" Margin="0,15,0,0" />
                                                        </Grid>

                                                        <!-- 3. AREA CHART MODE -->
                                                        <Grid IsVisible="{Binding SelectedChartMode, Converter={StaticResource EqualityConverter}, ConverterParameter=Area}"
                                                              Width="{Binding ChartCanvasWidth}" Height="290" VerticalAlignment="Center">
                                                            <Polygon Points="{Binding AreaPoints}" Fill="#253B82F6" Stroke="#3B82F6" StrokeThickness="2.5" Margin="0,15,0,0" />
                                                        </Grid>
                                                    </Grid>
                                                </ScrollViewer>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ============================================================== -->
                        <!-- SWARM QUICK LAUNCH ORCHESTRATOR CARD                           -->
                        <!-- ============================================================== -->
                        <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <!-- Orchestrator Header & Description -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="⚡ Concurrent Swarm Orchestrator" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                    <TextBlock Text="Launch multiple Antigravity AI accounts in parallel. Each session is completely isolated with its own credentials and workspace directory."
                                               FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Dedicated Controls & Actions Row -->
                                <Border Background="{DynamicResource BrushCardBorder}" Opacity="0.4" Height="1" />
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="Launch Mode:" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                        <ComboBox SelectedItem="{Binding SelectedSwarmMode}" Width="190" VerticalAlignment="Center">
                                            <models:SwarmLaunchMode>SplitPanes</models:SwarmLaunchMode>
                                            <models:SwarmLaunchMode>SeparateTabs</models:SwarmLaunchMode>
                                            <models:SwarmLaunchMode>SeparateWindows</models:SwarmLaunchMode>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Status / Info Badge in Middle -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource BrushBadgeBg}" BorderBrush="{DynamicResource BrushBadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" IsVisible="{Binding IsSwarmRunning}">
                                            <TextBlock Text="● Swarm Active" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Action Buttons Row Column -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Button Command="{Binding LaunchSwarmCommand}" Classes="emerald" Padding="18,10" VerticalAlignment="Center"
                                                IsVisible="{Binding !IsSwarmRunning}">
                                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <Path Data="{StaticResource HeroIconBolt}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="⚡ Run Swarm Now" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding StopSwarmCommand}" Classes="danger" Padding="18,10" VerticalAlignment="Center"
                                                IsVisible="{Binding IsSwarmRunning}">
                                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <Path Data="{StaticResource HeroIconStop}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="⏹ Stop Swarm Execution" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ============================================================== -->
                        <!-- ACTIVE SWARM ACCOUNTS GRID PREVIEW                             -->
                        <!-- ============================================================== -->
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Active Account Swarm Workers" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding ToggleDashboardAccountsCommand}"
                                        Classes="outline" Padding="8,4" CornerRadius="6"
                                        ToolTip.Tip="Fold / Unfold Swarm Accounts">
                                    <TextBlock Text="{Binding IsDashboardAccountsExpanded, Converter={StaticResource BoolToChevronConverter}}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                </Button>
                            </Grid>
                            <Border IsVisible="{Binding IsDashboardAccountsExpanded}">
                                <ItemsControl ItemsSource="{Binding Profiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:AvaloniaProfileItemViewModel">
                                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <!-- Color Accent Indicator -->
                                                    <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{Binding ColorTag, Converter={StaticResource HexBrushConverter}}" Margin="0,0,12,0" />

                                                    <!-- Info & Telemetry Column -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <!-- Row 1: Avatar, Name, Tier, Status, Model & Quota Badges -->
                                                        <WrapPanel VerticalAlignment="Center">
                                                            <Grid Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                <!-- Google Profile Picture clipped inside Ellipse -->
                                                                <Image Width="40" Height="40"
                                                                       Source="{Binding AvatarUrl, Converter={StaticResource PathToBitmapConverter}}"
                                                                       Stretch="UniformToFill"
                                                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                                                       IsVisible="{Binding HasAvatarUrl}">
                                                                    <Image.Clip>
                                                                        <EllipseGeometry Rect="0,0,40,40" />
                                                                    </Image.Clip>
                                                                </Image>
                                                                <Ellipse Width="40" Height="40"
                                                                         Stroke="{Binding ColorTag, Converter={StaticResource HexBrushConverter}}"
                                                                         StrokeThickness="1.5"
                                                                         IsHitTestVisible="False"
                                                                         IsVisible="{Binding HasAvatarUrl}" />

                                                                <Border Width="40" Height="40" CornerRadius="20"
                                                                        Background="{Binding ColorTag, Converter={StaticResource HexBrushConverter}}"
                                                                        IsVisible="{Binding !HasAvatarUrl}">
                                                                    <TextBlock Text="{Binding AvatarInitial}" FontWeight="Bold" FontSize="17" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>

                                                                <Border Width="13" Height="13" CornerRadius="6.5"
                                                                        Background="#FFFFFF" BorderBrush="#4285F4" BorderThickness="1.2"
                                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                        Margin="0,0,-1,-1">
                                                                    <TextBlock Text="G" FontSize="8" FontWeight="Bold" Foreground="#4285F4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                                                </Border>
                                                            </Grid>

                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                                        <Border CornerRadius="6" Padding="10,3" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                Background="{Binding TierBadgeBackground, Converter={StaticResource HexBrushConverter}}">
                                                            <TextBlock Text="{Binding TierBadgeText}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                        </Border>

                                                        <Border CornerRadius="6" Padding="9,3" Margin="0,0,8,0" VerticalAlignment="Center" Background="{DynamicResource BrushSurface}"
                                                                BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                                <Ellipse Width="8" Height="8" Fill="{Binding StatusBadgeColor, Converter={StaticResource HexBrushConverter}}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>

                                                        <Border CornerRadius="6" Padding="9,3" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                Background="{DynamicResource BrushBadgeBg}"
                                                                BorderBrush="{DynamicResource BrushBadgeBorder}"
                                                                BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                                                <TextBlock Text="🧠" FontSize="10.5" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding CurrentModel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushBadgeText}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>

                                                        <Border CornerRadius="6" Padding="9,3" VerticalAlignment="Center"
                                                                Background="{Binding QuotaStatusColor, Converter={StaticResource HexBrushConverter}}">
                                                            <TextBlock Text="{Binding QuotaStatusText}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                        </Border>
                                                    </WrapPanel>

                                                    <!-- Row 2: Activity Meter -->
                                                    <WrapPanel Margin="0,6,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding UsageLabel}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,4" />
                                                        <Border Background="#1538BDF8" BorderBrush="#3038BDF8" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,10,4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SessionUsageLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" />
                                                        </Border>
                                                        <ProgressBar Value="{Binding UsagePercentage}" Height="6" Width="140"
                                                                     Foreground="{Binding DailyUsageBarColor, Converter={StaticResource HexBrushConverter}}"
                                                                     BorderThickness="0" VerticalAlignment="Center" Margin="0,0,12,4" />
                                                        <TextBlock Text="{Binding QuotaResetCountdown}" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,0,4" />
                                                    </WrapPanel>

                                                    <!-- Row 3: Antigravity Model Quotas Preview -->
                                                    <WrapPanel Margin="0,4,0,0" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="7,2.5" Margin="0,0,8,4">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="Gemini: " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                <TextBlock Text="{Binding GeminiWeeklyRemainingPercent, StringFormat='{}W: {0:F0}%'}" FontSize="10" FontWeight="Bold" Foreground="{Binding GeminiWeeklyBarColor, Converter={StaticResource HexBrushConverter}}" Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding Gemini5HourRemainingPercent, StringFormat='{}5h: {0:F0}%'}" FontSize="10" FontWeight="Bold" Foreground="{Binding Gemini5HourBarColor, Converter={StaticResource HexBrushConverter}}" />
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="7,2.5" Margin="0,0,8,4">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="Claude/GPT: " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                <TextBlock Text="{Binding ClaudeGptWeeklyRemainingPercent, StringFormat='{}W: {0:F0}%'}" FontSize="10" FontWeight="Bold" Foreground="{Binding ClaudeGptWeeklyBarColor, Converter={StaticResource HexBrushConverter}}" Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding ClaudeGpt5HourRemainingPercent, StringFormat='{}5h: {0:F0}%'}" FontSize="10" FontWeight="Bold" Foreground="{Binding ClaudeGpt5HourBarColor, Converter={StaticResource HexBrushConverter}}" />
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="7,2.5" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding WeeklyRemainingLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- Quick Launch Action -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                    <Button Command="{Binding LaunchCommand}"
                                                            CommandParameter="{Binding $parent[Window].((vm:AvaloniaMainViewModel)DataContext).SelectedTerminal}"
                                                            Classes="emerald" Padding="12,6">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                                                            <Path Data="{StaticResource HeroIconPlay}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                                                            <TextBlock Text="Launch" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Command="{Binding OpenProfileFolderCommand}"
                                                            Classes="outline" Padding="8,6" ToolTip.Tip="Open Profile Folder">
                                                        <Path Data="{StaticResource HeroIconFolder}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.75" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </Border>
                        </StackPanel>

                        <!-- Bottom Breathing Room Spacer -->
                        <Border Height="60" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================================================== -->
                <!-- VIEW 1: ACCOUNTS (/accounts)                                   -->
                <!-- ============================================================== -->
                <Grid Grid.Row="2"
                      IsVisible="{Binding CurrentPage, Converter={StaticResource EqualityConverter}, ConverterParameter=Accounts}"
                      RowDefinitions="Auto,*">

                    <!-- Accounts Toolbar -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BrushSurfaceHover}"
                            BorderBrush="{DynamicResource BrushCardBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="24,10">
                        <Grid ColumnDefinitions="Auto,260,*,Auto">
                            <!-- Far-Left: Filters Toggle Button & Flyout (Col 0) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Button Classes="outline" Padding="11,6" FontSize="11">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                        <Path Data="{StaticResource HeroIconFunnel}"
                                              Stroke="{Binding HasActiveAccountsFilters, Converter={StaticResource BoolToFilterAccentConverter}}"
                                              StrokeThickness="1.75"
                                              Width="12" Height="12"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="Filters" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border Background="#3B82F6"
                                                CornerRadius="8"
                                                Padding="5,1"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasActiveAccountsFilters}">
                                            <TextBlock Text="{Binding ActiveAccountsFilterCount}"
                                                       FontSize="9.5"
                                                       FontWeight="Bold"
                                                       Foreground="#FFFFFF" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Filters Flyout -->
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <Border Background="{DynamicResource BrushCard}"
                                                    BorderBrush="{DynamicResource BrushCardBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="16"
                                                    Width="300">
                                                <StackPanel Spacing="10">
                                                    <!-- Title & Reset -->
                                                    <Grid>
                                                        <TextBlock Text="Filter &amp; Sort Accounts"
                                                                   FontWeight="Bold"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                                   VerticalAlignment="Center" />
                                                        <Button Command="{Binding ResetAccountsFiltersCommand}"
                                                                HorizontalAlignment="Right"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="4,2">
                                                            <TextBlock Text="Reset"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#3B82F6" />
                                                        </Button>
                                                    </Grid>

                                                    <!-- Filter: Subscription Tier -->
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="Subscription Tier"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrushTextMuted}" />
                                                        <ComboBox ItemsSource="{Binding AccountsTierFilterOptions}"
                                                                  SelectedItem="{Binding AccountsTierFilter}"
                                                                  Height="30" FontSize="11" HorizontalAlignment="Stretch" />
                                                    </StackPanel>

                                                    <!-- Filter: Account Health / Status -->
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="Status / Quota Health"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrushTextMuted}" />
                                                        <ComboBox ItemsSource="{Binding AccountsHealthFilterOptions}"
                                                                  SelectedItem="{Binding AccountsHealthFilter}"
                                                                  Height="30" FontSize="11" HorizontalAlignment="Stretch" />
                                                    </StackPanel>

                                                    <!-- Sort Order -->
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="Sort By"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrushTextMuted}" />
                                                        <ComboBox ItemsSource="{Binding AccountsSortOptions}"
                                                                  SelectedItem="{Binding AccountsSortBy}"
                                                                  Height="30" FontSize="11" HorizontalAlignment="Stretch" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>

                            <!-- Search (Col 1) -->
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchQuery, Mode=TwoWay}"
                                     PlaceholderText="Search accounts or emails..."
                                     VerticalAlignment="Center" />

                            <!-- Select All (Col 2) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                <Button Content="Select All"
                                        Command="{Binding SelectAllProfilesCommand}"
                                        Classes="outline"
                                        Padding="11,6"
                                        FontSize="11" />
                            </StackPanel>

                            <!-- Right Actions: New Profile (Col 3) -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding AddProfileCommand}"
                                        Classes="emerald" Padding="14,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                        <Path Data="{StaticResource HeroIconPlus}"
                                              Stroke="#FFFFFF" StrokeThickness="2.2" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                        <TextBlock Text="New Profile" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Accounts Cards List -->
                    <ScrollViewer Grid.Row="1" Padding="24,16,24,60">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding FilteredProfiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:AvaloniaProfileItemViewModel">
                                        <Border Background="{DynamicResource BrushCard}"
                                                BorderBrush="{DynamicResource BrushCardBorder}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Margin="0,0,0,16"
                                                ClipToBounds="True">
                                            <Grid ColumnDefinitions="5,*">
                                                <!-- Left Accent Border Stripe matching profile ColorTag -->
                                                <Border Grid.Column="0" Background="{Binding ColorTag, Converter={StaticResource HexBrushConverter}}" />

                                                <Border Grid.Column="1" Padding="18,16">
                                                <StackPanel>
                                                <!-- Row 1: Profile Header + Top-Right Swarm Checkbox -->
                                                <Grid Margin="0,0,0,10" ColumnDefinitions="Auto,*,Auto">
                                                    <!-- Col 0: Dedicated Circular Avatar (48x48) -->
                                                    <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Top">
                                                        <!-- Online Google Profile Picture clipped inside Ellipse -->
                                                        <Image Width="48" Height="48"
                                                               Source="{Binding AvatarUrl, Converter={StaticResource PathToBitmapConverter}}"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapInterpolationMode="HighQuality"
                                                               IsVisible="{Binding HasAvatarUrl}">
                                                            <Image.Clip>
                                                                <EllipseGeometry Rect="0,0,48,48" />
                                                            </Image.Clip>
                                                        </Image>
                                                        <Ellipse Width="48" Height="48"
                                                                 Stroke="{Binding ColorTag, Converter={StaticResource HexBrushConverter}}"
                                                                 StrokeThickness="1.5"
                                                                 IsHitTestVisible="False"
                                                                 IsVisible="{Binding HasAvatarUrl}" />

                                                        <!-- Fallback Google Circular Initial Badge -->
                                                        <Border Width="48" Height="48" CornerRadius="24"
                                                                Background="{Binding ColorTag, Converter={StaticResource HexBrushConverter}}"
                                                                IsVisible="{Binding !HasAvatarUrl}">
                                                            <TextBlock Text="{Binding AvatarInitial}"
                                                                       FontWeight="Bold" FontSize="19"
                                                                       Foreground="#FFFFFF"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>

                                                        <!-- Online / Offline Swarm Status Indicator Dot -->
                                                        <Border Width="14" Height="14" CornerRadius="7"
                                                                Background="{Binding SwarmStatusColor, Converter={StaticResource HexBrushConverter}}"
                                                                BorderBrush="{DynamicResource BrushCard}" BorderThickness="2"
                                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                Margin="0,0,-1,-1"
                                                                ToolTip.Tip="{Binding SwarmStatusTooltip}" />
                                                    </Grid>

                                                    <!-- Col 1: Identity & Badges in Structured Multi-Row Layout -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <!-- Row 1a: Name, Primary Default, Tier & Quota Health -->
                                                        <WrapPanel VerticalAlignment="Center" Margin="0,0,0,5">
                                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,10,2" />

                                                            <!-- Primary Default Badge -->
                                                            <Border CornerRadius="6" Padding="8,3" Margin="0,0,8,2" VerticalAlignment="Center"
                                                                    Background="#1510B981" BorderBrush="#3510B981" BorderThickness="1"
                                                                    IsVisible="{Binding IsDefaultProfile}">
                                                                <TextBlock Text="Primary Default" FontSize="10.5" FontWeight="Bold" Foreground="#10B981" />
                                                            </Border>

                                                            <!-- Tier Badge -->
                                                            <Border CornerRadius="6" Padding="10,3" Margin="0,0,8,2" VerticalAlignment="Center"
                                                                    Background="{Binding TierBadgeBackground, Converter={StaticResource HexBrushConverter}}">
                                                                <TextBlock Text="{Binding TierBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                            </Border>

                                                            <!-- Quota Health Badge -->
                                                            <Border CornerRadius="6" Padding="9,3" Margin="0,0,8,2" VerticalAlignment="Center"
                                                                    Background="{Binding QuotaStatusColor, Converter={StaticResource HexBrushConverter}}">
                                                                <TextBlock Text="{Binding QuotaStatusText}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                                            </Border>
                                                        </WrapPanel>

                                                        <!-- Row 1b: Account Status Email & Model Badge -->
                                                        <WrapPanel VerticalAlignment="Center">
                                                            <!-- Status Badge -->
                                                            <Border CornerRadius="6" Padding="9,3" Margin="0,0,8,2" VerticalAlignment="Center"
                                                                    Background="{DynamicResource BrushSurface}"
                                                                    BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                                    <Ellipse Width="8" Height="8" Fill="{Binding StatusBadgeColor, Converter={StaticResource HexBrushConverter}}" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Model Badge -->
                                                            <Border CornerRadius="6" Padding="9,3" Margin="0,0,8,2" VerticalAlignment="Center"
                                                                    Background="{DynamicResource BrushBadgeBg}"
                                                                    BorderBrush="{DynamicResource BrushBadgeBorder}" BorderThickness="1">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                                                    <TextBlock Text="🧠" FontSize="10" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding CurrentModel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushBadgeText}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <!-- Col 2: Top-Right Quick Sync Button & Swarm Checkbox Pill -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Spacing="6">
                                                        <Button Command="{Binding SingleSyncCommand}"
                                                                Classes="outline"
                                                                Padding="7,4"
                                                                ToolTip.Tip="Refresh credentials, tokens, and live quota telemetry for this account">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                                                <Path Data="{StaticResource HeroIconArrowPath}"
                                                                      Stroke="{DynamicResource BrushTextSecondary}"
                                                                      StrokeThickness="1.75" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                                                                <TextBlock Text="Sync" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Swarm Checkbox Pill -->
                                                        <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="9,4" VerticalAlignment="Center" ToolTip.Tip="Include profile in Swarm Launch (⚡ Launch Swarm)"
                                                                IsEnabled="{Binding IsAuthenticated}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                                <CheckBox IsChecked="{Binding IsSelectedForSwarm}"
                                                                          IsEnabled="{Binding IsAuthenticated}"
                                                                          VerticalAlignment="Center" />
                                                                <TextBlock Text="Swarm" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                        <!-- Fold Toggle Button -->
                                                        <Button Command="{Binding ToggleCardExpandedCommand}"
                                                                Classes="outline"
                                                                Padding="8,4"
                                                                CornerRadius="6"
                                                                ToolTip.Tip="Fold / Unfold Profile Card">
                                                            <TextBlock Text="{Binding IsCardExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                                                       FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Collapsible Body Container (Row 2+: Description, Sandboxes, Accent line, Details fold, Quota bar, Actions, etc.) -->
                                                <StackPanel IsVisible="{Binding IsCardExpanded}">

                                                <!-- Row 2: Description & Sandbox Paths -->
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"
                                                               IsVisible="{Binding Description, Converter={StaticResource NullOrEmptyToBoolConverter}}" />
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="6,2" Margin="0,0,8,4">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="📁 Sandbox: " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                <TextBlock Text="{Binding EffectiveProfilePath}" FontFamily="Consolas, Monaco, monospace" FontSize="10.5" Foreground="{DynamicResource BrushMonoPath}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="6,2" Margin="0,0,8,4">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="📂 Workspace: " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                <TextBlock Text="{Binding DisplayWorkspace}" FontFamily="Consolas, Monaco, monospace" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- Horizontal Accent Line (<hr>) & Diagnostics Fold Toggle Button -->
                                                <Grid Margin="0,4,0,10" ColumnDefinitions="*,Auto,*">
                                                    <Border Grid.Column="0" Height="2" CornerRadius="1"
                                                            Background="{Binding ColorTag, Converter={StaticResource HexBrushConverter}}"
                                                            VerticalAlignment="Center" Opacity="0.85" />
                                                    <Button Grid.Column="1" Command="{Binding ToggleDetailsCommand}"
                                                            IsEnabled="{Binding IsAuthenticated}"
                                                            Classes="outline"
                                                            Padding="12,4" Margin="10,0"
                                                            ToolTip.Tip="{Binding DetailsButtonTooltip}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                            <Path Data="{StaticResource HeroIconShieldCheck}"
                                                                  Stroke="{Binding ColorTag, Converter={StaticResource HexBrushConverter}}"
                                                                  StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DetailsToggleText}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Border Grid.Column="2" Height="2" CornerRadius="1"
                                                            Background="{Binding ColorTag, Converter={StaticResource HexBrushConverter}}"
                                                            VerticalAlignment="Center" Opacity="0.85" />
                                                </Grid>

                                                <!-- Collapsible Details & Diagnostics Section (Default Folded) -->
                                                <StackPanel IsVisible="{Binding IsDetailsExpanded}">
                                                    <!-- Quota Depletion Alert Banner -->
                                                    <Border IsVisible="{Binding IsNearQuotaExhausted}"
                                                            Background="#1DF87171" BorderBrush="#60EF4444" BorderThickness="1"
                                                            CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                                                <TextBlock Text="⚠️" FontSize="12" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding QuotaToastAlertText}" FontSize="11" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center" />
                                                                <TextBlock Text="•" FontSize="11" Foreground="#EF4444" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding ExhaustionForecastText}" FontSize="11" Foreground="#EF4444" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="Suggested: Switch to another swarm account" FontSize="10.5" Foreground="#F87171" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- FOLDABLE SECTION 1: VELOCITY & DEPLETION FORECAST -->
                                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                                                        <StackPanel>
                                                            <!-- Accordion Header Button -->
                                                            <Button Command="{Binding ToggleDailyQuotaSectionCommand}"
                                                                    Background="Transparent" BorderThickness="0" Padding="14,10" HorizontalContentAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding IsDailyQuotaExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="⚡ VELOCITY &amp; DEPLETION FORECAST" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                        <Border Background="{DynamicResource BrushCardBorder}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                            <TextBlock Text="{Binding TierDailySummary}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                        </Border>
                                                                        <Border Background="#15F59E0B" BorderBrush="#30F59E0B" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                            <TextBlock Text="{Binding BurnRateFormatted, StringFormat='{}🔥 {0}'}" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" />
                                                                        </Border>
                                                                        <Border Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding UsagePercentage, StringFormat='{}{0:F1}% used'}" FontSize="10" FontWeight="Bold" Foreground="{Binding DailyUsageBarColor, Converter={StaticResource HexBrushConverter}}" />
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <!-- Right: Reset Countdown -->
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                                                        <TextBlock Text="⏱️ Reset: " FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding QuotaResetCountdown}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Button>

                                                            <!-- Accordion Body -->
                                                            <StackPanel IsVisible="{Binding IsDailyQuotaExpanded}" Margin="14,0,14,12">
                                                                <ProgressBar Value="{Binding UsagePercentage}"
                                                                             Height="7" Minimum="0" Maximum="100"
                                                                             Foreground="{Binding DailyUsageBarColor, Converter={StaticResource HexBrushConverter}}"
                                                                             BorderThickness="0"
                                                                             Margin="0,0,0,8" />
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding HeadroomSummaryText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                        <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                        <TextBlock Text="{Binding SessionsCountText}" FontSize="10.5" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                        <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                        <TextBlock Text="{Binding TodayTokensFormatted}" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                    </WrapPanel>
                                                                    <Border Grid.Column="1" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="5" Padding="8,4" VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                                                            <TextBlock Text="⏳" FontSize="10" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding ExhaustionForecastText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding ExhaustionBadgeColor, Converter={StaticResource HexBrushConverter}}" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- FOLDABLE SECTION 2: ANTIGRAVITY MODEL QUOTAS (/usage Groups) -->
                                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                                                        <StackPanel>
                                                            <!-- Accordion Header Button -->
                                                            <Button Command="{Binding ToggleModelQuotasSectionCommand}"
                                                                    Background="Transparent" BorderThickness="0" Padding="14,10" HorizontalContentAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding IsModelQuotasExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="📊 ANTIGRAVITY MODEL QUOTAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                        <Border Background="#1538BDF8" BorderBrush="#3038BDF8" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                            <TextBlock Text="Gemini, Claude &amp; GPT Limits" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" />
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                                                        <TextBlock Text="Gemini: " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding GeminiWeeklyRemainingPercent, StringFormat='{}{0:F0}%'}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding GeminiWeeklyBarColor, Converter={StaticResource HexBrushConverter}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                        <TextBlock Text="Claude: " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding ClaudeGptWeeklyRemainingPercent, StringFormat='{}{0:F0}%'}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding ClaudeGptWeeklyBarColor, Converter={StaticResource HexBrushConverter}}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Button>

                                                            <!-- Accordion Body -->
                                                            <StackPanel IsVisible="{Binding IsModelQuotasExpanded}" Margin="14,0,14,12">
                                                                <Grid Margin="0,0,0,10" ColumnDefinitions="*,14,*">
                                                                    <!-- Left: Gemini Models Group -->
                                                                    <Border Grid.Column="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                                        <StackPanel>
                                                                            <Grid Margin="0,0,0,4">
                                                                                <TextBlock Text="GEMINI MODELS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                                <Border Background="#153B82F6" BorderBrush="#303B82F6" BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                                                                                    <TextBlock Text="Flash, Pro" FontSize="9.5" FontWeight="SemiBold" Foreground="#3B82F6" />
                                                                                </Border>
                                                                            </Grid>
                                                                            <TextBlock Text="Models within this group: Gemini Flash, Gemini Pro" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8" />

                                                                            <Grid Margin="0,0,0,3">
                                                                                <TextBlock Text="Weekly Limit Remaining" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                                <TextBlock Text="{Binding GeminiWeeklyRemainingPercent, StringFormat='{}{0:F2}%'}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding GeminiWeeklyBarColor, Converter={StaticResource HexBrushConverter}}" HorizontalAlignment="Right" />
                                                                            </Grid>
                                                                            <ProgressBar Value="{Binding GeminiWeeklyRemainingPercent}" Height="5" Minimum="0" Maximum="100"
                                                                                         Foreground="{Binding GeminiWeeklyBarColor, Converter={StaticResource HexBrushConverter}}"
                                                                                         BorderThickness="0" Margin="0,0,0,3" />
                                                                            <TextBlock Text="{Binding GeminiWeeklyRefreshesIn, StringFormat='{}Refreshes in {0}'}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8" />

                                                                            <Grid Margin="0,0,0,3">
                                                                                <TextBlock Text="Five Hour Limit Remaining" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                                <TextBlock Text="{Binding Gemini5HourRemainingPercent, StringFormat='{}{0:F2}%'}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding Gemini5HourBarColor, Converter={StaticResource HexBrushConverter}}" HorizontalAlignment="Right" />
                                                                            </Grid>
                                                                            <ProgressBar Value="{Binding Gemini5HourRemainingPercent}" Height="5" Minimum="0" Maximum="100"
                                                                                         Foreground="{Binding Gemini5HourBarColor, Converter={StaticResource HexBrushConverter}}"
                                                                                         BorderThickness="0" Margin="0,0,0,3" />
                                                                            <TextBlock Text="{Binding Gemini5HourRefreshesIn, StringFormat='{}Refreshes in {0}'}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" />
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <!-- Right: Claude and GPT Models Group -->
                                                                    <Border Grid.Column="2" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                                        <StackPanel>
                                                                            <Grid Margin="0,0,0,4">
                                                                                <TextBlock Text="CLAUDE AND GPT MODELS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                                <Border Background="#158B5CF6" BorderBrush="#308B5CF6" BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                                                                                    <TextBlock Text="Opus, Sonnet, GPT-OSS" FontSize="9.5" FontWeight="SemiBold" Foreground="#8B5CF6" />
                                                                                </Border>
                                                                            </Grid>
                                                                            <TextBlock Text="Models within this group: Claude Opus, Claude Sonnet, GPT-OSS" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8" />

                                                                            <Grid Margin="0,0,0,3">
                                                                                <TextBlock Text="Weekly Limit Remaining" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                                <TextBlock Text="{Binding ClaudeGptWeeklyRemainingPercent, StringFormat='{}{0:F2}%'}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding ClaudeGptWeeklyBarColor, Converter={StaticResource HexBrushConverter}}" HorizontalAlignment="Right" />
                                                                            </Grid>
                                                                            <ProgressBar Value="{Binding ClaudeGptWeeklyRemainingPercent}" Height="5" Minimum="0" Maximum="100"
                                                                                         Foreground="{Binding ClaudeGptWeeklyBarColor, Converter={StaticResource HexBrushConverter}}"
                                                                                         BorderThickness="0" Margin="0,0,0,3" />
                                                                            <TextBlock Text="{Binding ClaudeGptWeeklyRefreshesIn, StringFormat='{}Refreshes in {0}'}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8" />

                                                                            <Grid Margin="0,0,0,3">
                                                                                <TextBlock Text="Five Hour Limit Remaining" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                                <TextBlock Text="{Binding ClaudeGpt5HourRemainingPercent, StringFormat='{}{0:F2}%'}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding ClaudeGpt5HourBarColor, Converter={StaticResource HexBrushConverter}}" HorizontalAlignment="Right" />
                                                                            </Grid>
                                                                            <ProgressBar Value="{Binding ClaudeGpt5HourRemainingPercent}" Height="5" Minimum="0" Maximum="100"
                                                                                         Foreground="{Binding ClaudeGpt5HourBarColor, Converter={StaticResource HexBrushConverter}}"
                                                                                         BorderThickness="0" Margin="0,0,0,3" />
                                                                            <TextBlock Text="{Binding ClaudeGpt5HourRefreshesIn, StringFormat='{}Refreshes in {0}'}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>

                                                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="5" Padding="10,7">
                                                                    <Grid ColumnDefinitions="Auto,*">
                                                                        <Border Grid.Column="0" Width="3" Background="#8B5CF6" CornerRadius="1.5" Margin="0,0,8,0" />
                                                                        <TextBlock Grid.Column="1" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" LineHeight="14">
                                                                            Within each group, models share a weekly limit and a 5-hour limit. Quota is consumed proportionally to token cost. The 5-hour limit smooths out aggregate demand to fairly distribute capacity, while weekly limit reflects your subscription tier.
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- FOLDABLE SECTION 3: PROFILE DOCTOR -->
                                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                                                        <StackPanel>
                                                            <Border Padding="14,10">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Path Data="{StaticResource HeroIconShieldCheck}" Stroke="#3B82F6" StrokeThickness="1.75" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="PROFILE DOCTOR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                        <Border Background="{DynamicResource BrushCardBorder}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                            <TextBlock Text="CLI &amp; Profile Diagnostics" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                        </Border>
                                                                        <Border Background="{Binding DoctorSummaryColor, Converter={StaticResource HexBrushConverter}}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding DoctorSummaryPill}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                                        <Button Command="{Binding RunDoctorCommand}"
                                                                                IsEnabled="{Binding !IsDoctorRunning}"
                                                                                Classes="outline" Padding="10,4"
                                                                                ToolTip.Tip="Audit 5 system checkpoints: CLI version, OAuth tokens, stuck lock files, trusted workspaces, and /usage schema">
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                                                <Path Data="{StaticResource HeroIconShieldCheck}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.75" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                                                                <TextBlock Text="{Binding DoctorButtonText}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button Command="{Binding ToggleDoctorReportCommand}"
                                                                                IsVisible="{Binding HasDoctorReport}"
                                                                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrushTextMuted}" Padding="4,2">
                                                                            <TextBlock Text="{Binding IsDoctorReportExpanded, Converter={StaticResource BoolToChevronConverter}}" FontWeight="Bold" FontSize="12" />
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>

                                                            <StackPanel IsVisible="{Binding IsDoctorReportExpanded}" Margin="14,0,14,12">
                                                                 <ItemsControl ItemsSource="{Binding DoctorReport.Checks}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="services:DoctorCheckItem">
                                                                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,0,0,6">
                                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                                    <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                                        <TextBlock Text="{Binding Message}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1,0,0" TextWrapping="Wrap" />
                                                                                    </StackPanel>
                                                                                    <Border Grid.Column="2" Background="{Binding StatusBadgeColor, Converter={StaticResource HexBrushConverter}}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding Status}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                                    </Border>
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <WrapPanel Margin="0,4,0,0">
                                                                    <Button Command="{Binding CleanLocksCommand}"
                                                                            IsVisible="{Binding DoctorReport.LockFilesCount, Converter={StaticResource IntToBoolConverter}}"
                                                                            Classes="dangerOutline" Padding="10,5" Margin="0,0,8,4"
                                                                            ToolTip.Tip="Clean up all stuck .lock files left in this account sandbox">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                            <TextBlock Text="🧹 Clear " />
                                                                            <TextBlock Text="{Binding DoctorReport.LockFilesCount}" />
                                                                            <TextBlock Text=" Stuck Lock(s)" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button Command="{Binding TrustWorkspaceCommand}"
                                                                            Classes="outline" Padding="10,5" Margin="0,0,8,4"
                                                                            ToolTip.Tip="Register workspace directory to ~/.gemini/settings.json trustedWorkspaces">
                                                                        <TextBlock Text="🛡️ Register Workspace as Trusted" />
                                                                    </Button>
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Row 4: Action Toolbar -->
                                                <StackPanel>
                                                    <!-- State 1: When NeedsLogin is True -> Dedicated Authentication CTA Card -->
                                                    <Border IsVisible="{Binding NeedsLogin}"
                                                            Background="#12F59E0B" BorderBrush="#40F59E0B" BorderThickness="1"
                                                            CornerRadius="8" Padding="14,12" Margin="0,4,0,10">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <TextBlock Text="🔒" FontSize="13" VerticalAlignment="Center" />
                                                                    <TextBlock Text="Account Requires Authentication" FontWeight="Bold" FontSize="12.5" Foreground="#F59E0B" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <TextBlock Text="This sandbox profile has not completed Google Antigravity login. Authenticate to unlock CLI sessions, model quotas, and swarm dispatch."
                                                                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                                                <Button Command="{Binding AuthenticateCommand}"
                                                                        CommandParameter="{Binding $parent[Window].((vm:AvaloniaMainViewModel)DataContext).SelectedTerminal}"
                                                                        Classes="primary" Padding="16,8"
                                                                        ToolTip.Tip="Launch interactive browser login flow to authenticate this sandbox">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                                        <TextBlock Text="🔑" FontSize="12" VerticalAlignment="Center" />
                                                                        <TextBlock Text="Authenticate Account" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Command="{Binding SingleSyncCommand}"
                                                                        Classes="outline" Padding="12,8"
                                                                        ToolTip.Tip="Check if login was completed and refresh account credentials">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                                        <Path Data="{StaticResource HeroIconArrowPath}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.75" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                                                        <TextBlock Text="Check Auth" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <!-- State 2: When IsAuthenticated is True -> Start Conversation / Launch -->
                                                    <Grid Margin="0,0,0,8" ColumnDefinitions="*,Auto" IsVisible="{Binding IsAuthenticated}">
                                                        <!-- Session Selector with Dropdown Flyout -->
                                                        <Border Grid.Column="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="6,3" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <Grid ColumnDefinitions="Auto,*">
                                                                <TextBlock Grid.Column="0" Text="💬 Start:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="4,0,8,0" />
                                                                <Button Grid.Column="1"
                                                                        Background="Transparent" BorderThickness="0" Padding="6,4"
                                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                                    <Grid ColumnDefinitions="*,Auto">
                                                                        <TextBlock Grid.Column="0"
                                                                                    Text="{Binding SelectedSession.DisplayText, FallbackValue='🆕 Start Fresh Session (New Chat)'}"
                                                                                    FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"
                                                                                    TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="1" Text="▾" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="8,0,4,0" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                    <Button.Flyout>
                                                                        <Flyout Placement="Bottom">
                                                                            <Border Background="{DynamicResource BrushPopupBg}"
                                                                                    BorderBrush="{DynamicResource BrushCardBorder}"
                                                                                    BorderThickness="1" CornerRadius="8" Padding="8"
                                                                                    MinWidth="340" MaxWidth="520" MaxHeight="360">
                                                                                <StackPanel Spacing="8">
                                                                                    <!-- Search Box -->
                                                                                    <TextBox Text="{Binding SessionSearchText, Mode=TwoWay}"
                                                                                             PlaceholderText="Type to filter past conversations..."
                                                                                             FontSize="11" />
                                                                                    <!-- List of filtered sessions -->
                                                                                    <ScrollViewer MaxHeight="260">
                                                                                        <StackPanel>
                                                                                            <ItemsControl ItemsSource="{Binding FilteredSessions}">
                                                                                                <ItemsControl.ItemTemplate>
                                                                                                    <DataTemplate DataType="models:ConversationSessionItem">
                                                                                                        <Button Command="{Binding $parent[Border].((vm:AvaloniaProfileItemViewModel)DataContext).SelectSessionCommand}"
                                                                                                                CommandParameter="{Binding}"
                                                                                                                Background="Transparent" BorderThickness="0"
                                                                                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                                                                Padding="8,6">
                                                                                                            <TextBlock Text="{Binding DisplayText}" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                                                                                                        </Button>
                                                                                                    </DataTemplate>
                                                                                                </ItemsControl.ItemTemplate>
                                                                                            </ItemsControl>
                                                                                            <TextBlock Text="No conversations match search query"
                                                                                                       FontSize="11" Foreground="{DynamicResource BrushTextMuted}"
                                                                                                       HorizontalAlignment="Center" Margin="12,16"
                                                                                                       IsVisible="{Binding HasNoMatchingSessions}" />
                                                                                        </StackPanel>
                                                                                    </ScrollViewer>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </Flyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Launch / Start Conversation Button -->
                                                        <Button Grid.Column="1" Command="{Binding LaunchCommand}"
                                                                CommandParameter="{Binding $parent[Window].((vm:AvaloniaMainViewModel)DataContext).SelectedTerminal}"
                                                                Classes="primary" Padding="18,8"
                                                                ToolTip.Tip="Launch Antigravity CLI session with chosen session mode">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                                                <Path Data="{StaticResource HeroIconPlay}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                                                <TextBlock Text="Start Conversation" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Row 4b: Utility Actions Outline Row -->
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <!-- Left Actions: Copy CLI, Open Folder, Import Chat -->
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                                            <Button Command="{Binding CopyCliSnippetCommand}"
                                                                    CommandParameter="{Binding $parent[Window].((vm:AvaloniaMainViewModel)DataContext).SelectedTerminal}"
                                                                    IsEnabled="{Binding IsAuthenticated}"
                                                                    Classes="outline" Padding="12,7"
                                                                    ToolTip.Tip="Copy isolated terminal launch command to clipboard">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                                    <Path Data="{StaticResource HeroIconClipboard}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.75" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                                                    <TextBlock Text="Copy CLI" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Command="{Binding OpenProfileFolderCommand}"
                                                                    Classes="outline" Padding="12,7"
                                                                    ToolTip.Tip="Open isolated profile sandbox directory">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                                    <Path Data="{StaticResource HeroIconFolder}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.75" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                                                    <TextBlock Text="Open Folder" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Command="{Binding RequestImportChatCommand}"
                                                                    Classes="outline" Padding="12,7"
                                                                    ToolTip.Tip="Import past chat conversations from another account into this profile">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                                    <Path Data="{StaticResource HeroIconArrowsRightLeft}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.75" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                                                    <TextBlock Text="Import Chat" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>

                                                        <!-- Right Actions: Duplicate, Edit Profile, Delete -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                                            <Button Command="{Binding RequestDuplicateCommand}"
                                                                    Classes="outline" Padding="12,7"
                                                                    ToolTip.Tip="Duplicate profile and clone settings">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                                    <Path Data="{StaticResource HeroIconDocumentDuplicate}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.75" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                                                    <TextBlock Text="Duplicate" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Command="{Binding RequestEditCommand}"
                                                                    Classes="outline" Padding="12,7"
                                                                    ToolTip.Tip="Edit profile settings and preferences">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                                    <Path Data="{StaticResource HeroIconPencil}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.75" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                                                    <TextBlock Text="Edit Profile" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Command="{Binding RequestDeleteCommand}"
                                                                    IsVisible="{Binding CanDelete}"
                                                                    Classes="dangerOutline" Padding="12,7"
                                                                    ToolTip.Tip="Remove profile from manager">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                                    <Path Data="{StaticResource HeroIconTrash}" Stroke="#EF4444" StrokeThickness="1.75" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                                                    <TextBlock Text="Delete" FontWeight="Bold" FontSize="11" Foreground="#EF4444" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                            </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Bottom Breathing Room Spacer -->
                            <Border Height="60" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ====================================================== -->
                <!-- PAGE 2: SWARM FLEET VIEW                               -->
                <!-- ====================================================== -->
                <ScrollViewer Grid.Row="2"
                              IsVisible="{Binding CurrentPage, Converter={StaticResource EqualityConverter}, ConverterParameter=Swarm}"
                              Padding="28">
                    <StackPanel Spacing="20" MaxWidth="920" HorizontalAlignment="Center">
                        <!-- Swarm Header Card -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="24">
                            <StackPanel Spacing="10">
                                <TextBlock Text="🚀 Swarm Multi-Session Multiplexer" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="Execute automated workflows simultaneously across multiple sandboxed accounts. Compare different models in parallel with isolated environment variables."
                                           FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Execution Mode Settings -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Window Layout Mode" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <RadioButton GroupName="SwarmLayout" Content="Split Panes (wt.exe ; split-pane)" IsChecked="True" />
                                    <RadioButton GroupName="SwarmLayout" Content="Separate Tabs" />
                                    <RadioButton GroupName="SwarmLayout" Content="Separate Windows" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Account Worker Fleet Selection Card -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="👥 Swarm Worker Fleet Selection" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="Select which accounts participate in simultaneous multi-session terminal execution" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Content="☑️ Select All" Command="{Binding SelectAllSwarmCommand}" CommandParameter="{x:True}" Classes="outline" Padding="10,5" FontSize="11" />
                                        <Button Content="⬜ Deselect All" Command="{Binding SelectAllSwarmCommand}" CommandParameter="{x:False}" Classes="outline" Padding="10,5" FontSize="11" />
                                    </StackPanel>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Profiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:AvaloniaProfileItemViewModel">
                                            <Border Background="{DynamicResource BrushSurface}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForSwarm, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <Border Grid.Column="1" Width="32" Height="32" CornerRadius="16" Background="{Binding ColorTag, Converter={StaticResource HexBrushConverter}}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name[0]}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
                                                            <Border IsVisible="{Binding IsDefaultPrimary}" Background="{DynamicResource BrushAccent}" CornerRadius="3" Padding="4,1">
                                                                <TextBlock Text="Default" FontSize="9.5" FontWeight="Bold" Foreground="#0B0F19" />
                                                            </Border>
                                                            <Border Background="{Binding Tier, Converter={StaticResource TierBrushConverter}}" CornerRadius="3" Padding="4,1">
                                                                <TextBlock Text="{Binding Tier}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding AuthStatus.AccountEmail, FallbackValue='Pending OAuth'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="3" Background="{DynamicResource BrushBg}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="12,0">
                                                        <TextBlock Text="{Binding PreferredModel}" FontSize="11" Foreground="{DynamicResource BrushAccent}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="4" Text="{Binding AuthStatus.GeminiWeeklyRemainingPercent, StringFormat='{}{0:F0}% Quota'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Big Swarm Launch Action -->
                        <Button Command="{Binding LaunchSwarmCommand}"
                                Background="{DynamicResource BrushEmerald}"
                                Foreground="#FFFFFF"
                                FontSize="16"
                                FontWeight="Bold"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="20,16"
                                CornerRadius="8">
                            <TextBlock Text="🚀 Launch Swarm for All Selected Accounts" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================================================== -->
                <!-- PAGE: SWARM CHAT & PROJECT ORCHESTRATOR (/dispatcher)          -->
                <!-- ============================================================== -->
                <ScrollViewer Grid.Row="2"
                              IsVisible="{Binding CurrentPage, Converter={StaticResource EqualityConverter}, ConverterParameter=Dispatcher}"
                              Padding="28">
                    <StackPanel Spacing="20" MaxWidth="1050" HorizontalAlignment="Center">
                        <!-- Swarm Chat Header Card -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="24">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="⚡ Swarm Worker &amp; Project Orchestrator" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource BrushWarningAlertBg}" BorderBrush="{DynamicResource BrushWarningAlertBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="EXPERIMENTAL" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushWarningAlertText}" />
                                        </Border>
                                        <Border Background="{DynamicResource BrushBadgeBg}" BorderBrush="{DynamicResource BrushBadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="MULTI-PROJECT" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushBadgeText}" />
                                        </Border>
                                        <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="INTER-CLI BUS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Autonomous multi-agent project collaboration, shared blackboard architecture, inter-worker telemetry bus, and coordinated git worktree execution."
                                               FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding OpenCreateProjectDialogCommand}" Background="#3B82F6" Foreground="#FFFFFF" Padding="14,8" CornerRadius="6" VerticalAlignment="Center">
                                    <TextBlock Text="➕ New Project" FontWeight="Bold" FontSize="12" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- EMPTY STATE: No Swarm Projects Configured -->
                        <Border IsVisible="{Binding HasProjects, Converter={x:Static BoolConverters.Not}}"
                                Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1"
                                CornerRadius="12" Padding="40,48">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="580" Spacing="16">
                                <TextBlock Text="💬" FontSize="42" HorizontalAlignment="Center" />
                                <TextBlock Text="No Swarm Projects Configured" FontSize="19" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" />
                                <TextBlock Text="To dispatch and orchestrate autonomous AI worker swarms, create a project context first. Each project isolates repositories, tech stacks, and worker sandbox workspaces with a shared .swarm/ communication bus."
                                           FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" TextAlignment="Center" />
                                <Button Command="{Binding OpenCreateProjectDialogCommand}"
                                        Background="#3B82F6" Foreground="#FFFFFF" Padding="22,12" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center" CornerRadius="8">
                                    <TextBlock Text="➕ Create First Swarm Project" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- ACTIVE PROJECT CONTAINER -->
                        <StackPanel IsVisible="{Binding HasProjects}" Spacing="16">
                            <!-- Project Context & Selector Bar -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1"
                                    CornerRadius="10" Padding="18,16">
                                <StackPanel Spacing="12">
                                    <!-- Row 1: Project Selector & Context Badges -->
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Text="📁 Project:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                                                  MinWidth="260" Padding="10,6" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate DataType="models:SwarmProject">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <!-- Tech Stack Badge -->
                                        <Border Background="{DynamicResource BrushBadgeBg}" BorderBrush="{DynamicResource BrushBadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding SelectedProject.TechStack, FallbackValue='Rust'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushBadgeText}" />
                                        </Border>
                                        <!-- Worktree Branch Badge -->
                                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="6,3" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding SelectedProject.DefaultBranch, StringFormat='🌿 {0}'}" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                        </Border>
                                    </WrapPanel>

                                    <!-- Row 2: Project Path & Description -->
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedProject.RootDirectory, FallbackValue='No root path'}"
                                                   FontFamily="Cascadia Code, Consolas, Courier New, monospace" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedProject.Description}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                    </WrapPanel>

                                    <!-- Row 3: Dedicated Action Buttons Toolbar -->
                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <WrapPanel VerticalAlignment="Center">
                                            <Button Command="{Binding OpenCreateProjectDialogCommand}" Classes="outline" Padding="12,6" Margin="0,0,8,0" ToolTip.Tip="Create new swarm project">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource HeroIconPlus}" Stroke="{DynamicResource BrushTextPrimary}" StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,1,0,0" />
                                                    <TextBlock Text="New Project" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding OpenEditProjectDialogCommand}" Classes="outline" Padding="12,6" Margin="0,0,8,0" ToolTip.Tip="Edit project configuration">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource HeroIconPencil}" Stroke="{DynamicResource BrushTextPrimary}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,1,0,0" />
                                                    <TextBlock Text="Edit Project" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding OpenProjectFolderCommand}" Classes="outline" Padding="12,6" Margin="0,0,8,0" ToolTip.Tip="Open project root in File Explorer">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource HeroIconFolder}" Stroke="{DynamicResource BrushTextPrimary}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,1,0,0" />
                                                    <TextBlock Text="Open Folder" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding DeleteProjectCommand}" Background="{DynamicResource BrushErrorAlertBg}" Foreground="{DynamicResource BrushErrorAlertText}" Padding="12,6" ToolTip.Tip="Delete this project">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource HeroIconTrash}" Stroke="{DynamicResource BrushErrorAlertText}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,1,0,0" />
                                                    <TextBlock Text="Delete Project" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Navigation Tab Bar (Feed, Tasks & Dispatch, Worktree Tree, Workflow Topology) -->
                            <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1"
                                    CornerRadius="8" Padding="4">
                                <Grid ColumnDefinitions="*,*,*,*">
                                    <Button Grid.Column="0" Content="💬 Swarm Worker Feed" Command="{Binding SetProjectTabCommand}" CommandParameter="0"
                                            Padding="12,8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Background="{Binding SelectedProjectTabIndex, Converter={StaticResource ActiveTabBgConverter}, ConverterParameter=0}"
                                            Foreground="{Binding SelectedProjectTabIndex, Converter={StaticResource ActiveTabFgConverter}, ConverterParameter=0}" />
                                    <Button Grid.Column="1" Content="🎯 Tasks &amp; Fleet Dispatch" Command="{Binding SetProjectTabCommand}" CommandParameter="1"
                                            Padding="12,8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Background="{Binding SelectedProjectTabIndex, Converter={StaticResource ActiveTabBgConverter}, ConverterParameter=1}"
                                            Foreground="{Binding SelectedProjectTabIndex, Converter={StaticResource ActiveTabFgConverter}, ConverterParameter=1}" />
                                    <Button Grid.Column="2" Content="🌳 Worktree Isolation Tree" Command="{Binding SetProjectTabCommand}" CommandParameter="2"
                                            Padding="12,8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Background="{Binding SelectedProjectTabIndex, Converter={StaticResource ActiveTabBgConverter}, ConverterParameter=2}"
                                            Foreground="{Binding SelectedProjectTabIndex, Converter={StaticResource ActiveTabFgConverter}, ConverterParameter=2}" />
                                    <Button Grid.Column="3" Content="⚡ Live Workflow Topology" Command="{Binding SetProjectTabCommand}" CommandParameter="3"
                                            Padding="12,8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Background="{Binding SelectedProjectTabIndex, Converter={StaticResource ActiveTabBgConverter}, ConverterParameter=3}"
                                            Foreground="{Binding SelectedProjectTabIndex, Converter={StaticResource ActiveTabFgConverter}, ConverterParameter=3}" />
                                </Grid>
                            </Border>

                            <!-- ============================================================== -->
                            <!-- TAB 0: SWARM CHAT & AGGREGATOR FEED                            -->
                            <!-- ============================================================== -->
                            <StackPanel IsVisible="{Binding SelectedProjectTabIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=0}" Spacing="16">
                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1"
                                        CornerRadius="10" Padding="20">
                                    <StackPanel Spacing="14">
                                        <!-- Feed Header -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="💬 Live Swarm Chat &amp; Inter-Agent Message Bus" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Synchronized real-time telemetry from .swarm/bus.jsonl, user broadcasts, and agent actions" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="8,4">
                                                    <TextBlock Text="{Binding SwarmChatMessages.Count, StringFormat='{}{0} Messages'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" />
                                                </Border>
                                                <Button Content="📋 Blackboard" Command="{Binding OpenProjectBlackboardCommand}" Classes="outline" Padding="10,5" FontSize="11" ToolTip.Tip="Open shared architecture blackboard (.swarm/blackboard.md)" />
                                                <Button Content="🔄 Refresh Feed" Command="{Binding RefreshSwarmChatMessagesCommand}" Classes="outline" Padding="10,5" FontSize="11" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Messages Scroll Area -->
                                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="14" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" MinHeight="260" MaxHeight="520">
                                            <ScrollViewer>
                                                <StackPanel Spacing="8">
                                                    <!-- Empty Chat Notice -->
                                                    <Border IsVisible="{Binding HasSwarmChatMessages, Converter={x:Static BoolConverters.Not}}"
                                                            Padding="30" HorizontalAlignment="Center">
                                                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                                                            <TextBlock Text="💬 No messages recorded yet." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                                            <TextBlock Text="Dispatch the swarm or use the broadcast bar below to send instructions to the agents." FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Message Bubbles -->
                                                    <ItemsControl ItemsSource="{Binding SwarmChatMessages}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="models:SwarmChatMessage">
                                                                <Border Background="{Binding Type, Converter={StaticResource SwarmMsgBgConverter}}"
                                                                        BorderBrush="{Binding Type, Converter={StaticResource SwarmMsgBorderConverter}}"
                                                                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                                        <!-- Sender Avatar with Profile Picture & Fallback -->
                                                                        <Grid Grid.Column="0" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Top">
                                                                            <Border Width="34" Height="34" CornerRadius="17"
                                                                                    Background="{Binding SenderColor, Converter={StaticResource HexBrushConverter}}">
                                                                                <TextBlock Text="{Binding AvatarInitial}" FontWeight="Bold" FontSize="13.5" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>

                                                                            <Image Width="34" Height="34"
                                                                                   Source="{Binding AvatarUrl, Converter={StaticResource PathToBitmapConverter}}"
                                                                                   Stretch="UniformToFill"
                                                                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                                                                   IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                                <Image.Clip>
                                                                                    <EllipseGeometry Rect="0,0,34,34" />
                                                                                </Image.Clip>
                                                                            </Image>
                                                                            <Ellipse Width="34" Height="34"
                                                                                     Stroke="{Binding SenderColor, Converter={StaticResource HexBrushConverter}}"
                                                                                     StrokeThickness="1.2"
                                                                                     IsHitTestVisible="False"
                                                                                     IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                        </Grid>

                                                                        <!-- Content Body -->
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                                            <WrapPanel VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding SenderName}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                                <!-- Differentiated Role Badge -->
                                                                                <Border Background="{Binding SenderRole, Converter={StaticResource RoleToBgConverter}}"
                                                                                        BorderBrush="{Binding SenderRole, Converter={StaticResource RoleToBorderConverter}}"
                                                                                        BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding SenderRole}" FontSize="10" FontWeight="Bold"
                                                                                               Foreground="{Binding SenderRole, Converter={StaticResource RoleToFgConverter}}" />
                                                                                </Border>
                                                                                <!-- Target Badge if direct message -->
                                                                                <Border IsVisible="{Binding TargetWorker, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                                        Background="{DynamicResource BrushSurface}" CornerRadius="3" Padding="5,1.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding TargetWorker, StringFormat='🎯 @{0}'}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" />
                                                                                </Border>
                                                                            </WrapPanel>
                                                                            <TextBlock Text="{Binding Content}" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap" />
                                                                        </StackPanel>

                                                                        <!-- Timestamp -->
                                                                        <TextBlock Grid.Column="2" Text="{Binding TimestampFormatted}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Top" Margin="8,0,0,0" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>

                                        <!-- Broadcast Chat Input Bar -->
                                        <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <!-- Target Worker Selection -->
                                                <ComboBox Grid.Column="0" ItemsSource="{Binding ChatTargetWorkers}" SelectedItem="{Binding SelectedChatTargetWorker}"
                                                          MinWidth="180" Padding="8,6" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip.Tip="Send broadcast to all workers or target a specific agent" />
                                                <!-- Input TextBox -->
                                                <TextBox Grid.Column="1" Text="{Binding SwarmChatInputText, Mode=TwoWay}"
                                                         Padding="10,8" Margin="0,0,8,0" VerticalAlignment="Center" PlaceholderText="Broadcast instruction to swarm workers..." />
                                                <!-- Send Button -->
                                                <Button Grid.Column="2" Command="{Binding SendSwarmChatMessageCommand}"
                                                        Background="#3B82F6" Foreground="#FFFFFF" Padding="16,8" CornerRadius="6" VerticalAlignment="Center">
                                                    <TextBlock Text="🚀 Broadcast" FontWeight="Bold" FontSize="11.5" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============================================================== -->
                            <!-- TAB 1: TASKS & FLEET DISPATCH SETTINGS                         -->
                            <!-- ============================================================== -->
                            <StackPanel IsVisible="{Binding SelectedProjectTabIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=1}" Spacing="20">
                                <!-- Hardware Sentinel & Pre-flight Health Guard -->
                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="🛡️ Pre-flight Resource &amp; Safety Sentinels" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Hardware availability, storage limits, and Git Worktree capability checks" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="🔍 Check Resources" Command="{Binding CheckPreflightCommand}" Classes="outline" Padding="12,6" FontSize="12" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*,*">
                                            <Border Grid.Column="0" Background="{DynamicResource BrushSurface}" CornerRadius="6" Padding="14,10" Margin="0,0,8,0">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="Disk Free Space" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                    <TextBlock Text="{Binding PreflightResult.AvailableDiskGb, StringFormat='{}{0:F1} GB Free'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="{DynamicResource BrushSurface}" CornerRadius="6" Padding="14,10" Margin="0,0,8,0">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="System Memory" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                    <TextBlock Text="{Binding PreflightResult.AvailableMemoryGb, StringFormat='{}{0:F1} GB Available'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{DynamicResource BrushSurface}" CornerRadius="6" Padding="14,10">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="Git Repository Status" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                    <TextBlock Text="{Binding PreflightResult.CurrentBranch, FallbackValue='Git Detected'}" FontSize="15" FontWeight="Bold" Foreground="#A855F7" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Warning Sentinel Alert -->
                                        <Border IsVisible="{Binding PreflightResult.WarningMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                Background="{DynamicResource BrushWarningAlertBg}" BorderBrush="{DynamicResource BrushWarningAlertBorder}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="⚠️" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PreflightResult.WarningMessage}" FontSize="12" Foreground="{DynamicResource BrushWarningAlertText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Error Sentinel Alert -->
                                        <Border IsVisible="{Binding PreflightResult.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                Background="{DynamicResource BrushErrorAlertBg}" BorderBrush="{DynamicResource BrushErrorAlertBorder}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="❌" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PreflightResult.ErrorMessage}" FontSize="12" Foreground="{DynamicResource BrushErrorAlertText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Dispatch Configuration & Workspace Definition -->
                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20">
                                    <StackPanel Spacing="16">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="🎯 Dispatch Configuration &amp; Task Definition" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Command="{Binding ToggleProjectContextCommand}" Classes="outline" Padding="8,4" CornerRadius="6" ToolTip.Tip="Fold / Unfold Task Definition">
                                                <TextBlock Text="{Binding IsProjectContextExpanded, Converter={StaticResource BoolToChevronConverter}}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                            </Button>
                                        </Grid>

                                        <StackPanel IsVisible="{Binding IsProjectContextExpanded}" Spacing="16">
                                        <!-- Target Workspace -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Target Repository Directory:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBox Grid.Column="0" Text="{Binding FleetWorkspacePath}" PlaceholderText="Enter or paste absolute Git repository path (e.g. D:\Works\Project\MyApp)..." Padding="10,8" Margin="0,0,8,0" />
                                                <Button Grid.Column="1" Command="{Binding BrowseFleetWorkspaceFolderCommand}" Classes="outline" CornerRadius="6" Padding="12,8">
                                                    <TextBlock Text="Browse Folder..." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                                </Button>
                                            </Grid>

                                            <!-- Execution Mode & Tool Permission Sentinel -->
                                            <Border Background="{DynamicResource BrushSurface}" CornerRadius="6" Padding="12,10" Margin="0,8,0,0" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="Execution Mode:" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                                            <RadioButton Content="🖥️ Visible Terminal Windows" IsChecked="{Binding IsTerminalMode}" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" ToolTip.Tip="Interactive terminal windows: watch and interact with CLI sessions in real-time" />
                                                            <RadioButton Content="⚡ Silent Background (Headless)" IsChecked="{Binding IsSilentMode}" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" ToolTip.Tip="Headless execution: silent background execution with real-time telemetry streamed into task cards" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding FleetDangerouslySkipPermissions}" Content="Auto-approve tool permissions (--dangerously-skip-permissions)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" ToolTip.Tip="Essential for automated headless execution to prevent tool prompt timeouts and headless denial" />
                                                </Grid>
                                            </Border>

                                            <CheckBox IsChecked="{Binding UseGitWorktrees}" Content="Isolate workers in linked Git Worktrees (.worktrees/worker-*) to avoid .git/index.lock contention" FontSize="12" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Quick Objective Suggestion Chips -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Quick Objective Suggestions &amp; Templates:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                            <WrapPanel>
                                                <Button Content="🚀 Full-Stack Feature" Command="{Binding ApplyObjectiveSuggestionCommand}" CommandParameter="fullstack" Classes="outline"
                                                        Padding="10,5" FontSize="11" Margin="0,0,6,6" ToolTip.Tip="JWT Auth + Backend API + Frontend UI + Test Suite" />
                                                <Button Content="🛡️ Security Audit &amp; Fix" Command="{Binding ApplyObjectiveSuggestionCommand}" CommandParameter="security" Classes="outline"
                                                        Padding="10,5" FontSize="11" Margin="0,0,6,6" ToolTip.Tip="OWASP scan, input sanitation, CVE review" />
                                                <Button Content="🧪 Tests &amp; Benchmarks" Command="{Binding ApplyObjectiveSuggestionCommand}" CommandParameter="tests" Classes="outline"
                                                        Padding="10,5" FontSize="11" Margin="0,0,6,6" ToolTip.Tip="Unit tests, integration test suite, and performance benchmarks" />
                                                <Button Content="📚 Docs &amp; OpenAPI Spec" Command="{Binding ApplyObjectiveSuggestionCommand}" CommandParameter="docs" Classes="outline"
                                                        Padding="10,5" FontSize="11" Margin="0,0,6,6" ToolTip.Tip="Swagger / OpenAPI spec, architecture docs, and onboarding" />
                                                <Button Content="⚡ Performance Refactor" Command="{Binding ApplyObjectiveSuggestionCommand}" CommandParameter="refactor" Classes="outline"
                                                        Padding="10,5" FontSize="11" Margin="0,0,6,6" ToolTip.Tip="Profile bottlenecks, memory optimization, and modular refactoring" />
                                                <Button Content="Clear" Command="{Binding ClearObjectiveCommand}" Classes="outline"
                                                        Padding="8,5" FontSize="11" Margin="0,0,6,6" ToolTip.Tip="Clear objective text" />
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Task Objective Prompt -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Task Objective Prompt (Single Input -> Tailored Multi-Worker Execution):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                            <TextBox Text="{Binding FleetTaskObjective}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" Padding="10,8"
                                                     PlaceholderText="Describe the objective to accomplish (e.g. 'Implement a clean payment gateway webhook with signature validation, mock testing, and OpenAPI documentation')..." />
                                        </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Target Fleet Workers Selection -->
                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="👥 Participating Fleet Workers" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Workers selected below will receive tailored sub-task prompts in isolated environments" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Button Content="☑️ Select All" Command="{Binding SelectAllSwarmCommand}" CommandParameter="{x:True}" Classes="outline" Padding="8,4" FontSize="11" IsVisible="{Binding IsProjectTasksExpanded}" />
                                                <Button Content="⬜ Deselect All" Command="{Binding SelectAllSwarmCommand}" CommandParameter="{x:False}" Classes="outline" Padding="8,4" FontSize="11" IsVisible="{Binding IsProjectTasksExpanded}" />
                                                <Button Command="{Binding ToggleProjectTasksCommand}" Classes="outline" Padding="8,4" CornerRadius="6" ToolTip.Tip="Fold / Unfold Participating Workers">
                                                    <TextBlock Text="{Binding IsProjectTasksExpanded, Converter={StaticResource BoolToChevronConverter}}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Profiles}" IsVisible="{Binding IsProjectTasksExpanded}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:AvaloniaProfileItemViewModel">
                                                    <Border Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                            <!-- Checkbox Selection -->
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForSwarm, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                                            <!-- Avatar / Google Account Profile Picture -->
                                                            <Grid Grid.Column="1" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                                                <!-- Image Avatar -->
                                                                <Image Width="36" Height="36"
                                                                       Source="{Binding AvatarUrl, Converter={StaticResource PathToBitmapConverter}}"
                                                                       Stretch="UniformToFill"
                                                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                                                       IsVisible="{Binding HasAvatarUrl}">
                                                                    <Image.Clip>
                                                                        <EllipseGeometry Rect="0,0,36,36" />
                                                                    </Image.Clip>
                                                                </Image>
                                                                <Ellipse Width="36" Height="36"
                                                                         Stroke="{Binding ColorTag, Converter={StaticResource HexBrushConverter}}"
                                                                         StrokeThickness="1.5"
                                                                         IsHitTestVisible="False"
                                                                         IsVisible="{Binding HasAvatarUrl}" />

                                                                <!-- Initials Circle Fallback -->
                                                                <Border Width="36" Height="36" CornerRadius="18"
                                                                        Background="{Binding ColorTag, Converter={StaticResource HexBrushConverter}}"
                                                                        IsVisible="{Binding HasAvatarUrl, Converter={x:Static BoolConverters.Not}}">
                                                                    <TextBlock Text="{Binding AvatarInitial}" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>

                                                                <!-- Authentic Status Indicator Dot -->
                                                                <Border Width="11" Height="11" CornerRadius="5.5"
                                                                        Background="{DynamicResource BrushSurface}"
                                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                        Margin="0,0,-1,-1" Padding="1.5">
                                                                    <Ellipse Fill="{Binding StatusBadgeColor, Converter={StaticResource HexBrushConverter}}" />
                                                                </Border>
                                                            </Grid>

                                                            <!-- Identity & Context Details -->
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                                <!-- Row 1: Profile Name, Tier Badge, Status Badge, Model Badge -->
                                                                <WrapPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                                    <!-- Tier Badge -->
                                                                    <Border CornerRadius="4" Padding="6,1.5" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                            Background="{Binding TierBadgeBackground, Converter={StaticResource HexBrushConverter}}">
                                                                        <TextBlock Text="{Binding TierBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                    </Border>

                                                                    <!-- Status Badge -->
                                                                    <Border CornerRadius="4" Padding="6,1.5" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                            Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                            <Ellipse Width="6" Height="6" Fill="{Binding StatusBadgeColor, Converter={StaticResource HexBrushConverter}}" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <!-- Model Badge -->
                                                                    <Border CornerRadius="4" Padding="6,1.5" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                            Background="{DynamicResource BrushBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                                        <TextBlock Text="{Binding PreferredModel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </WrapPanel>

                                                                <!-- Row 2: Account Email & Domain Role Subtitle -->
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                                                    <TextBlock Text="{Binding AccountEmail, FallbackValue='No email'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                    <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                    <TextBlock Text="{Binding Description, FallbackValue='General Fleet Worker'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Quota & Window Telemetry Pill -->
                                                            <Border Grid.Column="3" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                                                                <StackPanel HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding TodayQuotaFormatted}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushEmerald}" HorizontalAlignment="Right" />
                                                                    <TextBlock Text="{Binding WeeklyRemainingFormatted}" FontSize="9.5" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" Margin="0,1,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Live Dispatch Progress Panel -->
                                <Border IsVisible="{Binding IsFleetDispatching}"
                                        Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1.5"
                                        CornerRadius="10" Padding="18">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="⚡" FontSize="13" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DispatchProgressStage, FallbackValue='Dispatching Swarm Fleet...'}"
                                                           FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding DispatchProgressPercent, StringFormat='{}{0}%'}"
                                                       FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Progress Bar -->
                                        <ProgressBar Value="{Binding DispatchProgressPercent}" Minimum="0" Maximum="100" Height="6"
                                                     Foreground="{DynamicResource BrushAccent}" Background="{DynamicResource BrushSurface}"
                                                     CornerRadius="3" />

                                        <TextBlock Text="{Binding DispatchProgressDetail, FallbackValue='Configuring worktrees and spawning isolated CLI terminals...'}"
                                                   FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                    </StackPanel>
                                </Border>

                                <!-- Execution Control Bar -->
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <Button Grid.Column="0" Command="{Binding DispatchFleetCommand}"
                                            Background="{DynamicResource BrushEmerald}" Foreground="#FFFFFF"
                                            FontSize="14" FontWeight="Bold" Padding="20,12" CornerRadius="8"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="Dispatch &amp; Launch Swarm Fleet" FontWeight="Bold" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding AbortFleetCommand}"
                                            IsEnabled="{Binding CanAbortFleet}"
                                            Background="#DC2626" Foreground="#FFFFFF"
                                            FontSize="13" FontWeight="SemiBold" Padding="18,12" CornerRadius="8" Margin="0,0,10,0">
                                        <TextBlock Text="Abort Fleet" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding PruneWorktreesCommand}"
                                            Classes="outline"
                                            FontSize="13" Padding="16,12" CornerRadius="8">
                                        <TextBlock Text="Prune Worktrees" FontSize="13" VerticalAlignment="Center" />
                                    </Button>
                                </Grid>

                                <!-- Dispatched Tasks & Reconciliation Panel -->
                                <Border IsVisible="{Binding HasDispatchedTasks}"
                                        Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="📋 Active Swarm Dispatch Tasks" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Real-time telemetry, active tool activities, and isolated workspace management" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="8,3" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                <TextBlock Text="{Binding DispatchedTasks.Count, StringFormat='{}{0} Dispatched'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" />
                                            </Border>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding DispatchedTasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="models:DispatchedWorkerTask">
                                                    <Border Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="16,14" Margin="0,0,0,12" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                        <StackPanel Spacing="10">
                                                            <!-- Header Row: Identity, Badges, Timer & Status -->
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <!-- Profile Avatar / Initial Badge -->
                                                                <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                                                    <Border Background="{Binding ColorTag, Converter={StaticResource HexBrushConverter}}" CornerRadius="18">
                                                                        <TextBlock Text="{Binding AvatarInitial}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <Image Source="{Binding AvatarUrl, Converter={StaticResource PathToBitmapConverter}}"
                                                                           Stretch="UniformToFill" Width="36" Height="36"
                                                                           RenderOptions.BitmapInterpolationMode="HighQuality"
                                                                           IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                        <Image.Clip>
                                                                            <EllipseGeometry Rect="0,0,36,36" />
                                                                        </Image.Clip>
                                                                    </Image>
                                                                    <Ellipse Width="36" Height="36"
                                                                             Stroke="{Binding ColorTag, Converter={StaticResource HexBrushConverter}}"
                                                                             StrokeThickness="1.5"
                                                                             IsHitTestVisible="False"
                                                                             IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                </Grid>

                                                                <!-- Profile Name & Role Info -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                                    <WrapPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding ProfileName}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                                        <Border Background="{DynamicResource BrushBadgeBg}" BorderBrush="{DynamicResource BrushBadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding AssignedRole}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushBadgeText}" />
                                                                        </Border>
                                                                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding ExecutionModeText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                        </Border>
                                                                        <Border IsVisible="{Binding ProcessId, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource BrushCard}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding ProcessId, StringFormat='PID: {0}'}" FontFamily="Cascadia Code, Consolas" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                        </Border>
                                                                    </WrapPanel>
                                                                    <TextBlock Text="{Binding BranchName, StringFormat='🌱 Branch: {0}'}" FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>

                                                                <!-- Right Status & Timer -->
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                    <Border Background="{DynamicResource BrushCard}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding ElapsedTimeFormatted, StringFormat='⏱️ {0}'}" FontFamily="Cascadia Code, Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                    </Border>
                                                                    <Border Background="{Binding StatusColor, Converter={StaticResource HexBrushConverter}}" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Live Real-Time Telemetry Bar ("dia lagi ngapain") -->
                                                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                                                <StackPanel Spacing="2">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <TextBlock Text="⚡ Activity:" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding CurrentActivity, FallbackValue='Initializing...'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding LastOutputLine}" IsVisible="{Binding LastOutputLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" FontFamily="Cascadia Code, Consolas" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Collapsible Console Output Stream -->
                                                            <Border IsVisible="{Binding LastOutputLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                <StackPanel Spacing="4">
                                                                    <Button Command="{Binding ToggleOutputCommand}" Classes="outline" HorizontalAlignment="Left" Padding="8,3" FontSize="10.5" CornerRadius="4">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <TextBlock Text="🖥️ Console Stream Log" FontWeight="SemiBold" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Border IsVisible="{Binding IsOutputExpanded}" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                                                                        <StackPanel Spacing="6">
                                                                            <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Auto">
                                                                                <TextBox Text="{Binding FullOutputLog, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" FontFamily="Cascadia Code, Consolas" FontSize="10.5" TextWrapping="Wrap" />
                                                                            </ScrollViewer>
                                                                            <Button Content="📋 Copy Full Log" Command="{Binding $parent[Window].((vm:AvaloniaMainViewModel)DataContext).CopyTaskLogCommand}" CommandParameter="{Binding .}" Classes="outline" Padding="8,4" FontSize="10.5" HorizontalAlignment="Right" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Footer Path & Action Buttons -->
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" Text="{Binding WorktreePath, StringFormat='📁 {0}'}" FontFamily="Cascadia Code, Consolas" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                    <Button Content="📂 Folder" Command="{Binding $parent[Window].((vm:AvaloniaMainViewModel)DataContext).OpenWorktreeFolderCommand}" CommandParameter="{Binding WorktreePath}" Classes="outline" Padding="8,4" FontSize="10.5" ToolTip.Tip="Open workspace folder in File Explorer" />
                                                                    <Button Content="🔀 Merge" Command="{Binding $parent[Window].((vm:AvaloniaMainViewModel)DataContext).MergeSwarmBranchCommand}" CommandParameter="{Binding BranchName}" Classes="outline" Padding="8,4" FontSize="10.5" ToolTip.Tip="Merge branch changes into base repo" />
                                                                    <Button Content="🛑 Stop Worker" Command="{Binding $parent[Window].((vm:AvaloniaMainViewModel)DataContext).StopWorkerTaskCommand}" CommandParameter="{Binding .}"
                                                                            IsEnabled="{Binding CanStop}"
                                                                            Background="#DC2626" Foreground="#FFFFFF" Padding="8,4" FontSize="10.5" ToolTip.Tip="Terminate this isolated worker process immediately" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============================================================== -->
                            <!-- TAB 2: WORKTREE ISOLATION TREE                                 -->
                            <!-- ============================================================== -->
                            <StackPanel IsVisible="{Binding SelectedProjectTabIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=2}" Spacing="20">
                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="🌳 Git Worktree Branch Isolation Tree" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Live topological visualization of repository root and isolated worker branch sandboxes" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource BrushSurface}" CornerRadius="5" Padding="8,4" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                <TextBlock Text="{Binding WorktreeTreeNodes.Count, StringFormat='{}{0} Branch Nodes'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" />
                                            </Border>
                                        </Grid>

                                        <!-- Tree Container -->
                                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="16,14" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                            <StackPanel Spacing="10">
                                                <!-- Root Repository Node -->
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Grid.Column="0" Background="#3B82F6" CornerRadius="5" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="🏠 " FontSize="11" VerticalAlignment="Center" />
                                                            <TextBlock Text="ROOT REPO" FontWeight="Bold" FontSize="10.5" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PreflightResult.CurrentBranch, StringFormat='Base Branch: {0}', FallbackValue='Base Branch: master'}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" />
                                                        <TextBlock Text="{Binding FleetWorkspacePath, FallbackValue='No workspace selected'}" FontFamily="Cascadia Code, Consolas, Courier New, monospace" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="{DynamicResource BrushCard}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="Shared Object Store" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                                    </Border>
                                                </Grid>

                                                <!-- Branch Nodes -->
                                                <ItemsControl ItemsSource="{Binding WorktreeTreeNodes}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="models:WorktreeTreeNode">
                                                            <Grid ColumnDefinitions="28,*" Margin="12,0,0,10">
                                                                <!-- Tree Connector Visual -->
                                                                <TextBlock Grid.Column="0" Text="└── " FontFamily="Cascadia Code, Consolas, Courier New, monospace" FontSize="15" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center" />

                                                                <!-- Node Card -->
                                                                <Border Grid.Column="1" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                                        <!-- Worker Circular Avatar -->
                                                                        <Grid Grid.Column="0" Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Center">
                                                                            <Border Width="30" Height="30" CornerRadius="15"
                                                                                    Background="{Binding ColorTag, Converter={StaticResource HexBrushConverter}}">
                                                                                <TextBlock Text="{Binding AvatarInitial}" FontWeight="Bold" FontSize="12.5" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>
                                                                            <Image Source="{Binding AvatarUrl, Converter={StaticResource PathToBitmapConverter}}"
                                                                                   Stretch="UniformToFill" Width="30" Height="30"
                                                                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                                                                   IsVisible="{Binding HasAvatarUrl}">
                                                                                <Image.Clip>
                                                                                    <EllipseGeometry Rect="0,0,30,30" />
                                                                                </Image.Clip>
                                                                            </Image>
                                                                            <Ellipse Width="30" Height="30"
                                                                                     Stroke="{Binding ColorTag, Converter={StaticResource HexBrushConverter}}"
                                                                                     StrokeThickness="1.2"
                                                                                     IsHitTestVisible="False"
                                                                                     IsVisible="{Binding HasAvatarUrl}" />
                                                                        </Grid>

                                                                        <!-- Branch & Path Info -->
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                                            <WrapPanel VerticalAlignment="Center">
                                                                                <TextBlock Text="🌱 " FontSize="11" VerticalAlignment="Center" />
                                                                                <TextBlock Text="{Binding BranchName}" FontFamily="Cascadia Code, Consolas, Courier New, monospace" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                                <Border Background="{DynamicResource BrushSurface}" CornerRadius="3" Padding="6,1.5" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                                    <TextBlock Text="{Binding WorkerName, StringFormat='Worker: {0}'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                                </Border>
                                                                                <Border Background="{DynamicResource BrushBadgeBg}" BorderBrush="{DynamicResource BrushBadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="6,1.5" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding Role}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushBadgeText}" />
                                                                                </Border>
                                                                            </WrapPanel>
                                                                            <TextBlock Text="{Binding Path}" FontFamily="Cascadia Code, Consolas, Courier New, monospace" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>

                                                                        <!-- Status Badge -->
                                                                        <Border Grid.Column="2" Background="{Binding StatusColor, Converter={StaticResource HexBrushConverter}}" CornerRadius="4" Padding="10,4" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                            <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Isolation Matrix & Fleet Health Sentinels Section -->
                                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="16,14" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Margin="0,10,0,0">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="🛡️ Worktree Isolation Matrix &amp; Sentinel Diagnostics" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource BrushTextPrimary}" />
                                                        <TextBlock Text="Deterministic boundary enforcement between concurrent git branch sandboxes" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="ACTIVE GUARDS • 4 SENTINELS" FontSize="9.5" FontWeight="Bold" Foreground="#10B981" />
                                                    </Border>
                                                </Grid>

                                                <UniformGrid Columns="4">
                                                    <!-- Sentinel 1 -->
                                                    <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock Text="🔒 Keyring Isolation" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                            <TextBlock Text="Zero auth bleed between worker sandboxes" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- Sentinel 2 -->
                                                    <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock Text="📂 File Lock Guard" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                            <TextBlock Text="Independent .git/index &amp; HEAD per worker" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- Sentinel 3 -->
                                                    <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock Text="⚡ Preflight Checks" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                            <TextBlock Text="Continuous disk &amp; branch readiness audit" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- Sentinel 4 -->
                                                    <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock Text="🧹 Prune Sentinel" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                            <TextBlock Text="Auto-cleanup orphaned git worktrees" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============================================================== -->
                            <!-- TAB 3: LIVE WORKFLOW TOPOLOGY (N8N-STYLE NODE FLOW)            -->
                            <!-- ============================================================== -->
                            <StackPanel IsVisible="{Binding SelectedProjectTabIndex, Converter={StaticResource EqualityConverter}, ConverterParameter=3}" Spacing="20">
                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20">
                                    <StackPanel Spacing="14">
                                        <!-- Header & Status Readout -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="⚡ Real-Time Swarm Workflow Topology" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                                    <Border Background="{DynamicResource BrushBadgeBg}" BorderBrush="{DynamicResource BrushBadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                                                        <TextBlock Text="REACTIVE PIPELINE" FontFamily="Cascadia Code, Consolas, monospace" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushBadgeText}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Visual execution graph &amp; live agent node pipeline — inspired by n8n workflow architecture tailored for autonomous agy-cli agents."
                                                           FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="8,4">
                                                    <TextBlock Text="{Binding DispatchedTasks.Count, StringFormat='{}{0} Execution Nodes'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" />
                                                </Border>
                                                <Border Background="{DynamicResource BrushWarningAlertBg}" BorderBrush="{DynamicResource BrushWarningAlertBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                                    <TextBlock Text="{Binding FleetStatusText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushWarningAlertText}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- n8n Canvas Wrapper with Mesh Grid Background and Drag-To-Move Hand -->
                                        <Border Name="WorkflowCanvasBorder" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1"
                                                CornerRadius="10" MinHeight="420" ClipToBounds="True">
                                            <Panel>
                                                <!-- Mesh Dot Grid Pattern -->
                                                <Border Background="{DynamicResource MeshGridBrush}" Opacity="0.6" />

                                                <!-- Drag-to-Move Pan-enabled ScrollViewer -->
                                                <ScrollViewer Name="WorkflowScrollViewer"
                                                              HorizontalScrollBarVisibility="Auto"
                                                              VerticalScrollBarVisibility="Auto"
                                                              Cursor="Hand"
                                                              PointerPressed="OnWorkflowPointerPressed"
                                                              PointerMoved="OnWorkflowPointerMoved"
                                                              PointerReleased="OnWorkflowPointerReleased"
                                                              PointerWheelChanged="OnWorkflowPointerWheelChanged"
                                                              Padding="30,24">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0" MinWidth="1380">

                                                    <!-- NODE 1: Project Trigger Node (Root Repo Context) -->
                                                    <Border Background="{DynamicResource BrushCard}" BorderBrush="#3B82F6" BorderThickness="2"
                                                            CornerRadius="10" Padding="16" Width="240" VerticalAlignment="Center">
                                                        <StackPanel Spacing="8">
                                                            <!-- Node Header -->
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                                    <Border Width="26" Height="26" CornerRadius="6" Background="#2563EB" VerticalAlignment="Center">
                                                                        <TextBlock Text="📁" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="PROJECT TRIGGER" FontSize="9" FontWeight="Bold" Foreground="#3B82F6" />
                                                                        <TextBlock Text="{Binding SelectedProject.Name, FallbackValue='Active Project'}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <!-- Output Socket Port -->
                                                                <Border Grid.Column="1" Width="10" Height="10" CornerRadius="5" Background="#3B82F6" ToolTip.Tip="Output Port: Dispatches to Workers" VerticalAlignment="Center" />
                                                            </Grid>

                                                            <!-- Node Parameters -->
                                                            <Border Background="{DynamicResource BrushSurface}" CornerRadius="6" Padding="10,8">
                                                                <StackPanel Spacing="3">
                                                                    <TextBlock Text="{Binding SelectedProject.TechStack, StringFormat='⚙️ Stack: {0}'}" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                    <TextBlock Text="{Binding SelectedProject.DefaultBranch, StringFormat='🌿 Base: {0}'}" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                    <TextBlock Text="{Binding SelectedDispatchMode, StringFormat='🎯 Mode: {0}'}" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                </StackPanel>
                                                            </Border>

                                                            <Border Background="{DynamicResource BrushBadgeBg}" BorderBrush="{DynamicResource BrushBadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
                                                                <TextBlock Text="⚡ Trigger: On Dispatch" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushBadgeText}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- CONNECTOR 1: Flow Line (Trigger -> Workers) -->
                                                    <StackPanel VerticalAlignment="Center" Margin="10,0" HorizontalAlignment="Center" Width="80" Spacing="2">
                                                        <TextBlock Text="──────►" FontFamily="Cascadia Code, Consolas, monospace" FontSize="14" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center" />
                                                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Center">
                                                            <TextBlock Text="Dispatch" FontSize="9" Foreground="{DynamicResource BrushTextSecondary}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- NODE 2: Parallel Worker Agents Column -->
                                                    <StackPanel VerticalAlignment="Center" Width="310">
                                                        <!-- If no tasks dispatched yet: Standby Roster Node -->
                                                        <Border IsVisible="{Binding HasDispatchedTasks, Converter={x:Static BoolConverters.Not}}"
                                                                Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1.5"
                                                                CornerRadius="10" Padding="16">
                                                            <StackPanel Spacing="8">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Background="#6B7280" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="WORKER POOL (STANDBY)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                        <TextBlock Text="Awaiting Fleet Launch" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                    </StackPanel>
                                                                    <Border Grid.Column="2" Width="10" Height="10" CornerRadius="5" Background="#6B7280" VerticalAlignment="Center" />
                                                                </Grid>
                                                                <TextBlock Text="Select target workers and click '🚀 Launch Swarm' in Tab 1 to activate live parallel nodes."
                                                                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Dispatched Worker Execution Nodes -->
                                                        <ItemsControl ItemsSource="{Binding DispatchedTasks}" IsVisible="{Binding HasDispatchedTasks}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{DynamicResource BrushCard}" BorderBrush="{Binding StatusColor, Converter={StaticResource HexBrushConverter}}"
                                                                            BorderThickness="1.5" CornerRadius="9" Padding="12,10" Margin="0,0,0,8">
                                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                                            <!-- Input socket pin -->
                                                                            <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="#3B82F6" Margin="0,0,10,0" VerticalAlignment="Center" />

                                                                            <!-- Worker Node Body -->
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                                                <WrapPanel>
                                                                                    <TextBlock Text="{Binding ProfileName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                                    <Border Background="{DynamicResource BrushBadgeBg}" BorderBrush="{DynamicResource BrushBadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding AssignedRole}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushBadgeText}" />
                                                                                    </Border>
                                                                                    <Border Background="{DynamicResource BrushSurface}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding ExecutionModeText}" FontSize="9" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                                    </Border>
                                                                                </WrapPanel>

                                                                                <!-- Live Activity Readout -->
                                                                                <Border Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="7,4">
                                                                                    <TextBlock Text="{Binding CurrentActivity}" FontSize="10.5" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                                                                                </Border>

                                                                                <WrapPanel>
                                                                                    <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding StatusColor, Converter={StaticResource HexBrushConverter}}" Margin="0,0,10,0" />
                                                                                    <TextBlock Text="{Binding ElapsedTimeFormatted, StringFormat='⏱️ {0}'}" FontSize="9.5" FontFamily="Cascadia Code, Consolas, monospace" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                                </WrapPanel>
                                                                            </StackPanel>

                                                                            <!-- Output socket pin -->
                                                                            <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" Background="{Binding StatusColor, Converter={StaticResource HexBrushConverter}}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <!-- CONNECTOR 2: Flow Line (Workers -> Bus Hub) -->
                                                    <StackPanel VerticalAlignment="Center" Margin="10,0" HorizontalAlignment="Center" Width="80" Spacing="2">
                                                        <TextBlock Text="──────►" FontFamily="Cascadia Code, Consolas, monospace" FontSize="14" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" />
                                                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Center">
                                                            <TextBlock Text="Telemetry" FontSize="9" Foreground="{DynamicResource BrushTextSecondary}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- NODE 3: Shared Bus & Blackboard Coordinator Node -->
                                                    <Border Background="{DynamicResource BrushCard}" BorderBrush="#10B981" BorderThickness="2"
                                                            CornerRadius="10" Padding="16" Width="250" VerticalAlignment="Center">
                                                        <StackPanel Spacing="8">
                                                            <!-- Node Header -->
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                                    <Border Width="26" Height="26" CornerRadius="6" Background="#059669" VerticalAlignment="Center">
                                                                        <TextBlock Text="📡" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="AGGREGATOR HUB" FontSize="9" FontWeight="Bold" Foreground="#10B981" />
                                                                        <TextBlock Text="Inter-Agent Bus" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <!-- Output Socket Port -->
                                                                <Border Grid.Column="1" Width="10" Height="10" CornerRadius="5" Background="#10B981" ToolTip.Tip="Output Port: Routes to Worktree Merge" VerticalAlignment="Center" />
                                                            </Grid>

                                                            <!-- Node Parameters -->
                                                            <Border Background="{DynamicResource BrushSurface}" CornerRadius="6" Padding="10,8">
                                                                <StackPanel Spacing="3">
                                                                    <TextBlock Text="{Binding SwarmChatMessages.Count, StringFormat='💬 Messages on Bus: {0}'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                    <TextBlock Text="📋 Blackboard: Active Contracts" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                    <TextBlock Text="⚡ Reactive Stream: Listening" FontSize="10.5" Foreground="#10B981" />
                                                                </StackPanel>
                                                            </Border>

                                                            <Button Content="📋 View Blackboard" Command="{Binding OpenProjectBlackboardCommand}" Classes="outline" Padding="8,4" FontSize="10.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- CONNECTOR 3: Flow Line (Bus -> Worktree Output) -->
                                                    <StackPanel VerticalAlignment="Center" Margin="10,0" HorizontalAlignment="Center" Width="80" Spacing="2">
                                                        <TextBlock Text="──────►" FontFamily="Cascadia Code, Consolas, monospace" FontSize="14" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Center" />
                                                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Center">
                                                            <TextBlock Text="Branches" FontSize="9" Foreground="{DynamicResource BrushTextSecondary}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- NODE 4: Git Worktree & Synthesis Output Node -->
                                                    <Border Background="{DynamicResource BrushCard}" BorderBrush="#8B5CF6" BorderThickness="2"
                                                            CornerRadius="10" Padding="16" Width="240" VerticalAlignment="Center">
                                                        <StackPanel Spacing="8">
                                                            <!-- Node Header -->
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                                    <Border Width="26" Height="26" CornerRadius="6" Background="#7C3AED" VerticalAlignment="Center">
                                                                        <TextBlock Text="🌳" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="OUTPUT SYNTHESIS" FontSize="9" FontWeight="Bold" Foreground="#A78BFA" />
                                                                        <TextBlock Text="Git Worktree Tree" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <!-- Pin -->
                                                                <Border Grid.Column="1" Width="10" Height="10" CornerRadius="5" Background="#8B5CF6" VerticalAlignment="Center" />
                                                            </Grid>

                                                            <!-- Node Parameters -->
                                                            <Border Background="{DynamicResource BrushSurface}" CornerRadius="6" Padding="10,8">
                                                                <StackPanel Spacing="3">
                                                                    <TextBlock Text="{Binding PreflightResult.CurrentBranch, StringFormat='🌿 Target: {0}', FallbackValue='🌿 Target: main'}" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                    <TextBlock Text="{Binding SwarmBranches.Count, StringFormat='🌿 Branches: {0} Allocated'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                    <TextBlock Text="🔒 Zero lock contention" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                </StackPanel>
                                                            </Border>

                                                            <Button Content="🌳 Inspect Tree" Command="{Binding SetProjectTabCommand}" CommandParameter="2" Classes="outline" Padding="8,4" FontSize="10.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>

                                                </StackPanel>
                                            </ScrollViewer>
                                        </Panel>
                                    </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ====================================================== -->
                <!-- PAGE 3: ANALYTICS VIEW                                 -->
                <!-- ====================================================== -->
                <ScrollViewer Grid.Row="2"
                              IsVisible="{Binding CurrentPage, Converter={StaticResource EqualityConverter}, ConverterParameter=Analytics}"
                              Padding="28,24,28,60">
                    <StackPanel Spacing="20" MaxWidth="1040" HorizontalAlignment="Center">
                        <!-- Analytics Header -->
                        <Grid Margin="0,0,0,4">
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Analytics &amp; Telemetry" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="Real-time telemetry, model token consumption, and aggregate swarm performance" FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                <Button Command="{Binding ExportPdfReportCommand}" Classes="primary" Padding="14,7">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                        <Path Data="{StaticResource HeroIconArrowDownTray}" Stroke="#FFFFFF" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,2.5,0,0" />
                                        <TextBlock Text="Download PDF Report" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SyncSwarmCommand}" Classes="outline" Padding="12,7">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                        <Path Data="{StaticResource HeroIconArrowPath}" Stroke="{DynamicResource BrushTextPrimary}" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,1,0,0" />
                                        <TextBlock Text="Recalculate" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Telemetry KPI Summary Row (6 Cards) -->
                        <UniformGrid Columns="6">
                            <!-- Metric 1: Total Tokens -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,6,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="EST. TOKENS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding TotalEstimatedTokens}" FontSize="18" FontWeight="Bold" Foreground="#3B82F6" Margin="0,2,0,0" />
                                    <TextBlock Text="Total consumption" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 2: Input Tokens -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="3,0,3,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="INPUT TOKENS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding EstimatedInputTokens}" FontSize="18" FontWeight="Bold" Foreground="#06B6D4" Margin="0,2,0,0" />
                                    <TextBlock Text="Prompts sent" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 3: Output Tokens -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="3,0,3,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="OUTPUT TOKENS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding EstimatedOutputTokens}" FontSize="18" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,2,0,0" />
                                    <TextBlock Text="AI completions" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 4: Avg Latency -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="3,0,3,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="AVG LATENCY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding AverageLatencyMs}" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0" />
                                    <TextBlock Text="Round-trip time" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 5: Success Rate -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="3,0,3,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="UPTIME / SUCCESS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding SwarmSuccessRate}" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0" />
                                    <TextBlock Text="Execution reliability" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 6: Health Score -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="6,0,0,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="SWARM STATUS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding SwarmHealthScore}" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0" />
                                    <TextBlock Text="Rate-limit safety" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- ============================================================== -->
                        <!-- TALL EXPANSIVE ANALYTICS TELEMETRY CHART (Height 360)          -->
                        <!-- ============================================================== -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <!-- Header Row -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="📈 Real Telemetry Trends &amp; Consumption" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="Multi-dimensional filtering across account sandboxes, LLM models, and authentic prompt activity" FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                    </StackPanel>

                                    <!-- Download PDF Report CTA -->
                                    <Button Grid.Column="1" Command="{Binding ExportPdfReportCommand}" Classes="outline" Padding="12,7" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconArrowDownTray}" Stroke="{DynamicResource BrushTextPrimary}" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,2.5,0,0" />
                                            <TextBlock Text="Download PDF Report" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Dedicated Filter Toolbar Row -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                    <WrapPanel VerticalAlignment="Center">
                                        <!-- Chart Mode Switcher -->
                                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,4,14,4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <Button Content="📊 Bar" Command="{Binding SetChartModeCommand}" CommandParameter="Bar" Classes="outline" Padding="10,5" FontSize="12" />
                                                <Button Content="📈 Line" Command="{Binding SetChartModeCommand}" CommandParameter="Line" Classes="outline" Padding="10,5" FontSize="12" />
                                                <Button Content="🏔️ Area" Command="{Binding SetChartModeCommand}" CommandParameter="Area" Classes="outline" Padding="10,5" FontSize="12" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Zoom Controls -->
                                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,4,14,4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Content="➖" Command="{Binding ChartZoomOutCommand}" Classes="outline" Padding="7,4" FontSize="11" ToolTip.Tip="Zoom Out" />
                                                <TextBlock Text="{Binding ChartZoomText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="4,0" />
                                                <Button Content="➕" Command="{Binding ChartZoomInCommand}" Classes="outline" Padding="7,4" FontSize="11" ToolTip.Tip="Zoom In" />
                                                <Button Content="100%" Command="{Binding ChartZoomResetCommand}" Classes="outline" Padding="6,4" FontSize="10" ToolTip.Tip="Reset Zoom (100%)" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Account Filter -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,14,4" Spacing="6">
                                            <TextBlock Text="Account:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding AccountFilterOptions}" SelectedItem="{Binding SelectedAccountFilter}" Width="140" />
                                        </StackPanel>

                                        <!-- Period Filter -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,14,4" Spacing="6">
                                            <TextBlock Text="Period:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding TimeframeOptions}" SelectedItem="{Binding SelectedTimeframe}" Width="130" />
                                        </StackPanel>

                                        <!-- Model Filter -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,14,4" Spacing="6">
                                            <TextBlock Text="Model:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding ModelFilterOptions}" SelectedItem="{Binding SelectedModelFilter}" Width="180" />
                                        </StackPanel>

                                        <!-- Tier Filter -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4" Spacing="6">
                                            <TextBlock Text="Tier:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding TierFilterOptions}" SelectedItem="{Binding SelectedTierFilter}" Width="110" />
                                        </StackPanel>
                                    </WrapPanel>
                                </Border>

                                <!-- Visual Interactive Tall Canvas Area (Height 360) -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="14,14,14,10" Height="360">
                                    <Grid>
                                        <!-- No Data Placeholder (When genuinely 0 prompts) -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !HasChartData}">
                                            <TextBlock Text="📭" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock Text="No Telemetry Activity Recorded" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" />
                                            <TextBlock Text="There are 0 prompt executions matching the selected account sandbox, model, and timeframe." FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Chart with Y-Axis, Horizontal Gridlines, and Horizontal ScrollViewer -->
                                        <Grid IsVisible="{Binding HasChartData}" ColumnDefinitions="42,*">
                                            <!-- Left Y-Axis Scale -->
                                            <Grid Grid.Column="0" Margin="0,18,6,38" RowDefinitions="*,*,*,*">
                                                <TextBlock Grid.Row="0" Text="{Binding YTick100}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="1" Text="{Binding YTick75}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="2" Text="{Binding YTick50}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="3" Text="{Binding YTick25}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="3" Text="{Binding YTick0}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                            </Grid>

                                            <!-- Plot Container (Gridlines + ScrollViewer) -->
                                            <Grid Grid.Column="1">
                                                <!-- Horizontal Background Gridlines & Baseline -->
                                                <Grid Margin="0,18,0,38" RowDefinitions="*,*,*,*">
                                                    <Rectangle Grid.Row="0" VerticalAlignment="Top" Height="1" Fill="{DynamicResource BrushCardBorder}" Opacity="0.45" />
                                                    <Rectangle Grid.Row="1" VerticalAlignment="Top" Height="1" Fill="{DynamicResource BrushCardBorder}" Opacity="0.45" />
                                                    <Rectangle Grid.Row="2" VerticalAlignment="Top" Height="1" Fill="{DynamicResource BrushCardBorder}" Opacity="0.45" />
                                                    <Rectangle Grid.Row="3" VerticalAlignment="Top" Height="1" Fill="{DynamicResource BrushCardBorder}" Opacity="0.45" />
                                                    <Rectangle Grid.Row="3" VerticalAlignment="Bottom" Height="1.5" Fill="{DynamicResource BrushCardBorder}" Opacity="0.8" />
                                                </Grid>

                                                <!-- Horizontal Scrollable Chart Content -->
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                    <Grid MinWidth="{Binding ChartCanvasWidth}" Height="320" HorizontalAlignment="Left">
                                                        <!-- 1. BAR CHART MODE (TALL) -->
                                                        <ItemsControl ItemsSource="{Binding DashboardChartPoints}" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                                      Margin="10,0,10,12"
                                                                      IsVisible="{Binding SelectedChartMode, Converter={StaticResource EqualityConverter}, ConverterParameter=Bar}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="models:ChartDataPoint">
                                                                    <StackPanel Width="76" Margin="6,0" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                                        <ToolTip.Tip>
                                                                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                                                                <StackPanel Spacing="3">
                                                                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                                    <TextBlock Text="{Binding Value, StringFormat='Prompts: {0:N0}'}" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" />
                                                                                    <TextBlock Text="{Binding TokensLabel, StringFormat='Est. Tokens: {0}'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                                    <Border Height="1" Background="{DynamicResource BrushCardBorder}" Margin="0,4" />
                                                                                    <TextBlock Text="{Binding AccountContext, StringFormat='Account: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                    <TextBlock Text="{Binding ModelContext, StringFormat='Model: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </ToolTip.Tip>
                                                                        <TextBlock Text="{Binding Value}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                                                        <TextBlock Text="{Binding TokensLabel}" FontSize="9" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                                        <Border Height="{Binding Height}" Width="{Binding Width}" CornerRadius="5,5,0,0"
                                                                                Background="{Binding BarColor, Converter={StaticResource HexBrushConverter}}"
                                                                                HorizontalAlignment="Center" Cursor="Hand" />
                                                                        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- 2. LINE CHART MODE -->
                                                        <Grid IsVisible="{Binding SelectedChartMode, Converter={StaticResource EqualityConverter}, ConverterParameter=Line}"
                                                              Width="{Binding ChartCanvasWidth}" Height="310" VerticalAlignment="Center">
                                                            <Polyline Points="{Binding LinePoints}" Stroke="#3B82F6" StrokeThickness="3.5" StrokeJoin="Round" Margin="0,15,0,0" />
                                                            <ItemsControl ItemsSource="{Binding DashboardChartPoints}" VerticalAlignment="Bottom" Margin="0,0,0,12">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Rows="1" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="models:ChartDataPoint">
                                                                        <StackPanel HorizontalAlignment="Center">
                                                                            <ToolTip.Tip>
                                                                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                                                                    <StackPanel Spacing="3">
                                                                                        <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                                        <TextBlock Text="{Binding Value, StringFormat='Prompts: {0:N0}'}" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" />
                                                                                        <TextBlock Text="{Binding TokensLabel, StringFormat='Est. Tokens: {0}'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                                        <Border Height="1" Background="{DynamicResource BrushCardBorder}" Margin="0,4" />
                                                                                        <TextBlock Text="{Binding AccountContext, StringFormat='Account: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                        <TextBlock Text="{Binding ModelContext, StringFormat='Model: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </ToolTip.Tip>
                                                                            <TextBlock Text="{Binding Value}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" />
                                                                            <Ellipse Width="10" Height="10" Fill="#3B82F6" Stroke="#FFFFFF" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,4" Cursor="Hand" />
                                                                            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>

                                                        <!-- 3. AREA CHART MODE -->
                                                        <Grid IsVisible="{Binding SelectedChartMode, Converter={StaticResource EqualityConverter}, ConverterParameter=Area}"
                                                              Width="{Binding ChartCanvasWidth}" Height="310" VerticalAlignment="Center">
                                                            <Polygon Points="{Binding AreaPoints}" Fill="#258B5CF6" Stroke="#8B5CF6" StrokeThickness="3.5" Margin="0,15,0,0" />
                                                            <ItemsControl ItemsSource="{Binding DashboardChartPoints}" VerticalAlignment="Bottom" Margin="0,0,0,12">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Rows="1" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="models:ChartDataPoint">
                                                                        <StackPanel HorizontalAlignment="Center">
                                                                            <ToolTip.Tip>
                                                                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                                                                    <StackPanel Spacing="3">
                                                                                        <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                                        <TextBlock Text="{Binding Value, StringFormat='Prompts: {0:N0}'}" FontWeight="SemiBold" FontSize="12" Foreground="#8B5CF6" />
                                                                                        <TextBlock Text="{Binding TokensLabel, StringFormat='Est. Tokens: {0}'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                                        <Border Height="1" Background="{DynamicResource BrushCardBorder}" Margin="0,4" />
                                                                                        <TextBlock Text="{Binding AccountContext, StringFormat='Account: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                        <TextBlock Text="{Binding ModelContext, StringFormat='Model: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </ToolTip.Tip>
                                                                            <TextBlock Text="{Binding Value}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" />
                                                                            <Ellipse Width="9" Height="9" Fill="#8B5CF6" Stroke="#FFFFFF" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,4" Cursor="Hand" />
                                                                            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </Grid>
                                                </ScrollViewer>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Section 1: Model Efficiency Comparison Matrix (Opus & All Models) -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Model Efficiency Comparison Matrix" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="Comparison of inference speed, token output, and error rates across all agy models" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{Binding ToggleAnalyticsEfficiencyCommand}" Classes="outline" Padding="8,4" CornerRadius="6" ToolTip.Tip="Fold / Unfold Model Efficiency">
                                        <TextBlock Text="{Binding IsAnalyticsEfficiencyExpanded, Converter={StaticResource BoolToChevronConverter}}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                    </Button>
                                </Grid>

                                <StackPanel IsVisible="{Binding IsAnalyticsEfficiencyExpanded}" Spacing="10">
                                <!-- Table Header -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="12,8">
                                    <Grid ColumnDefinitions="200,100,110,110,110,90,*">
                                        <TextBlock Grid.Column="0" Text="MODEL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                        <TextBlock Grid.Column="1" Text="RECOMMENDED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                        <TextBlock Grid.Column="2" Text="REQUESTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                        <TextBlock Grid.Column="3" Text="EST. TOKENS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                        <TextBlock Grid.Column="4" Text="AVG SPEED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                        <TextBlock Grid.Column="5" Text="ERROR RATE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                        <TextBlock Grid.Column="6" Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>

                                <!-- Table Rows -->
                                <ItemsControl ItemsSource="{Binding ModelEfficiencies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ModelEfficiencyItem">
                                            <Border BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="12,10">
                                                <Grid ColumnDefinitions="200,100,110,110,110,90,*">
                                                    <TextBlock Grid.Column="0" Text="{Binding ModelName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Tier}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Requests}" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Tokens}" FontSize="12" FontWeight="SemiBold" Foreground="#3B82F6" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{Binding AvgSpeed}" FontSize="12" Foreground="#10B981" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5" Text="{Binding ErrorRate}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="6" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource BrushSurface}">
                                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusColor, Converter={StaticResource HexBrushConverter}}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Section 2: Real 24-Hour Swarm Hourly Activity Heatmap -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="24-Hour Swarm Hourly Activity Heatmap" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="Actual timestamp frequency from local history files across all active instances" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" />
                                    </StackPanel>

                                    <!-- Account Filter for Heatmap -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="0,0,10,0" IsVisible="{Binding IsAnalyticsTrendsExpanded}">
                                        <TextBlock Text="Filter Account:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                        <ComboBox ItemsSource="{Binding HeatmapAccountOptions}" SelectedItem="{Binding SelectedHeatmapAccount}" Width="180" />
                                    </StackPanel>

                                    <Button Grid.Column="2" Command="{Binding ToggleAnalyticsTrendsCommand}" Classes="outline" Padding="8,4" CornerRadius="6" ToolTip.Tip="Fold / Unfold Hourly Activity Heatmap">
                                        <TextBlock Text="{Binding IsAnalyticsTrendsExpanded, Converter={StaticResource BoolToChevronConverter}}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                    </Button>
                                </Grid>

                                <StackPanel IsVisible="{Binding IsAnalyticsTrendsExpanded}" Spacing="14">
                                <!-- 24h KPI Summary Strip -->
                                <UniformGrid Columns="4">
                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,6,0">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="PEAK HOUR" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                            <TextBlock Text="{Binding HeatmapPeakHour}" FontSize="15" FontWeight="Bold" Foreground="#8B5CF6" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="3,0,3,0">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="24H TOTAL TURNS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                            <TextBlock Text="{Binding HeatmapTotal24hPrompts}" FontSize="15" FontWeight="Bold" Foreground="#3B82F6" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="3,0,3,0">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="ACTIVE WINDOW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                            <TextBlock Text="{Binding HeatmapActiveWindow}" FontSize="15" FontWeight="Bold" Foreground="#10B981" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="6,0,0,0">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="AVG HOURLY RATE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                            <TextBlock Text="{Binding HeatmapAveragePerHour}" FontSize="15" FontWeight="Bold" Foreground="#F59E0B" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Heatmap Canvas Surface (Height 280) -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="14,14,14,10" Height="280">
                                    <Grid ColumnDefinitions="38,*">
                                        <!-- Left Y-Axis Scale -->
                                        <Grid Grid.Column="0" Margin="0,12,6,34" RowDefinitions="*,*,*,*,Auto">
                                            <TextBlock Grid.Row="0" Text="{Binding HeatmapYTick100}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <TextBlock Grid.Row="1" Text="{Binding HeatmapYTick75}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <TextBlock Grid.Row="2" Text="{Binding HeatmapYTick50}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <TextBlock Grid.Row="3" Text="{Binding HeatmapYTick25}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <TextBlock Grid.Row="4" Text="{Binding HeatmapYTick0}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                        </Grid>

                                        <!-- Plot Canvas Area with Gridlines and Bars -->
                                        <Grid Grid.Column="1">
                                            <!-- Horizontal Dashed Gridlines -->
                                            <Grid Margin="0,18,0,38" RowDefinitions="*,*,*,*">
                                                <Border Grid.Row="0" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,1,0,0" Opacity="0.5" />
                                                <Border Grid.Row="1" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,1,0,0" Opacity="0.5" />
                                                <Border Grid.Row="2" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,1,0,0" Opacity="0.5" />
                                                <Border Grid.Row="3" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,1,0,0" Opacity="0.5" />
                                            </Grid>

                                            <!-- 24-Hour Bars Stack -->
                                            <ItemsControl ItemsSource="{Binding HourlyHeatmap}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:HourlyActivityItem">
                                                        <StackPanel Width="32" Margin="3,0" VerticalAlignment="Bottom" Cursor="Hand">
                                                            <ToolTip.Tip>
                                                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                                                                    <TextBlock Text="{Binding Tooltip}" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                </Border>
                                                            </ToolTip.Tip>

                                                            <!-- Prompt count label shown if > 0 -->
                                                            <TextBlock Text="{Binding PromptCount}"
                                                                       IsVisible="{Binding PromptCount, Converter={StaticResource IntToBoolConverter}}"
                                                                       FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"
                                                                       HorizontalAlignment="Center" Margin="0,0,0,4" />

                                                            <!-- Heatmap Bar -->
                                                            <Border Height="{Binding Height}" Width="20" CornerRadius="4,4,0,0"
                                                                    Background="{Binding Color, Converter={StaticResource HexBrushConverter}}"
                                                                    HorizontalAlignment="Center" />

                                                            <!-- Hour Label (X-Axis) -->
                                                            <TextBlock Text="{Binding HourLabel}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource BrushTextMuted}"
                                                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Grid>
                                </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Section 3: Swarm Fleet Intelligence & CLI Capabilities -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <!-- Section Header -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="🚀 " FontSize="16" VerticalAlignment="Center" />
                                            <TextBlock Text="Swarm Fleet Intelligence &amp; CLI Capabilities" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="CLI model fleet orchestration, aggregate swarm pool capacity, and verified agy v1.2.12 capabilities" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="#10B981" />
                                            <TextBlock Text="CLI v1.2.12 Engine Synchronized" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 1. Swarm Aggregate Quota & Burn-Rate Hero Strip -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18,14">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="1.2*,1*,1*,1.8*">
                                            <!-- Stat 1: Total Swarm Daily Pool -->
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0" Spacing="2">
                                                <TextBlock Text="TOTAL SWARM DAILY POOL" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                                <TextBlock Text="{Binding SwarmDailyCapacityTotal, StringFormat='{}{0:N0} prompts/day'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Capacity across all active accounts" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" />
                                            </StackPanel>

                                            <!-- Stat 2: Total Prompts Consumed Today -->
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0" Spacing="2">
                                                <TextBlock Text="SWARM PROMPTS TODAY" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                                <TextBlock Text="{Binding SwarmTodayPromptsTotal, StringFormat='{}{0:N0} prompts'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" />
                                                <TextBlock Text="{Binding SwarmPoolRemainingPercent, StringFormat='{}{0:F1}% pool remaining'}" FontSize="10.5" Foreground="#10B981" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <!-- Stat 3: Swarm Aggregate Burn-Rate -->
                                            <StackPanel Grid.Column="2" Margin="0,0,12,0" Spacing="2">
                                                <TextBlock Text="AGGREGATE BURN-RATE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                                <TextBlock Text="{Binding SwarmAggregateBurnRate, StringFormat='{}{0:F1} p/hr'}" FontSize="15" FontWeight="Bold" Foreground="#F59E0B" />
                                                <TextBlock Text="Combined swarm burn-rate" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" />
                                            </StackPanel>

                                            <!-- Stat 4: Exhaustion Forecast -->
                                            <Border Grid.Column="3" Background="#103B82F6" BorderBrush="#253B82F6" BorderThickness="1" CornerRadius="6" Padding="12,8" VerticalAlignment="Center">
                                                <StackPanel Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="⚡ " FontSize="11" VerticalAlignment="Center" />
                                                        <TextBlock Text="SWARM EXHAUSTION FORECAST" FontSize="10" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SwarmExhaustionForecast}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Progress Bar for Aggregate Swarm Capacity -->
                                        <ProgressBar Value="{Binding SwarmTodayPromptsTotal, Mode=OneWay}"
                                                     Maximum="{Binding SwarmDailyCapacityTotal, Mode=OneWay}"
                                                     Height="6" Minimum="0"
                                                     Background="{DynamicResource BrushProgressTrack}"
                                                     Foreground="{DynamicResource BrushAccent}"
                                                     CornerRadius="3" />
                                    </StackPanel>
                                </Border>

                                <!-- 2. Fleet Model Engines (agy models) -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Active Fleet Engine Models (agy models)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                    <ItemsControl ItemsSource="{Binding SwarmFleetModels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:SwarmFleetModelItem">
                                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <!-- Left: Family Accent Bar -->
                                                        <Border Grid.Column="0" Width="4" CornerRadius="2"
                                                                Background="{Binding FamilyColor, Converter={StaticResource HexBrushConverter}}"
                                                                Margin="0,0,14,0" VerticalAlignment="Stretch" />

                                                        <!-- Middle: Model Info, Badges, Assigned Accounts -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5" Margin="0,0,16,0">
                                                            <WrapPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                                                <!-- Family Pill -->
                                                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                                        Background="{Binding FamilyColor, Converter={StaticResource HexBrushConverter}}" Opacity="0.9">
                                                                    <TextBlock Text="{Binding Family}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                </Border>

                                                                <!-- Reasoning Tier Pill -->
                                                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                                    <TextBlock Text="{Binding ReasoningTier}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                </Border>

                                                                <!-- Context Limit Pill -->
                                                                <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                                    <TextBlock Text="{Binding ContextLimitLabel}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" />
                                                                </Border>
                                                            </WrapPanel>

                                                            <!-- Assigned Swarm Accounts with WrapPanel protection -->
                                                            <WrapPanel VerticalAlignment="Center" Margin="0,2,0,0">
                                                                <TextBlock Text="Connected accounts: " FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                <TextBlock Text="{Binding AssignedAccountsList}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                            </WrapPanel>
                                                        </StackPanel>

                                                        <!-- Right: Pool Capacity, Burn Rate & Status Badge -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="14">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                                                <TextBlock Text="{Binding PoolCapacityLabel}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Right" />
                                                                <TextBlock Text="{Binding BurnRateLabel, StringFormat='Burn rate: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" />
                                                            </StackPanel>

                                                            <Border CornerRadius="5" Padding="10,4" VerticalAlignment="Center"
                                                                    Background="{Binding StatusBadgeBg, Converter={StaticResource HexBrushConverter}}"
                                                                    BorderBrush="{Binding StatusBadgeColor, Converter={StaticResource HexBrushConverter}}"
                                                                    BorderThickness="1">
                                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Bold"
                                                                           Foreground="{Binding StatusBadgeColor, Converter={StaticResource HexBrushConverter}}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 3. Verified AGY Subcommands Matrix -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Verified agy CLI Official Capabilities" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                    <ItemsControl ItemsSource="{Binding SwarmCliCapabilities}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:SwarmCliCapabilityItem">
                                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4">
                                                    <StackPanel Spacing="8">
                                                        <!-- Top: Monospace Command Tag + Status -->
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <Border Grid.Column="0" Background="{DynamicResource BrushBadgeBg}" BorderBrush="{DynamicResource BrushBadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Command}" FontFamily="Consolas, Cascadia Code, monospace" Foreground="{DynamicResource BrushBadgeText}" FontWeight="Bold" FontSize="11" />
                                                            </Border>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                                <Border Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock Text="{Binding Status}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding StatusColor, Converter={StaticResource HexBrushConverter}}" />
                                                                </Border>
                                                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock Text="{Binding BadgeText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Bottom: Title + Description -->
                                                        <StackPanel Spacing="3">
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" />
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Executive Telemetry Reports Card -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel Spacing="16">
                                <!-- Row 1: Header Title & Description -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="📑 Executive Telemetry Reports" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="Export authentic logs, telemetry metrics, and agent turn history to PDF document or Excel spreadsheet" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="A4 Print Ready • High Contrast" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    </Border>
                                </Grid>

                                <!-- Row 2: Dedicated Action Button Row -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                    <WrapPanel VerticalAlignment="Center">
                                        <Button Command="{Binding ExportPdfReportCommand}" Padding="16,8" Classes="primary" Margin="0,0,10,0" ToolTip.Tip="Generate and save an executive audit PDF report via Edge headless engine">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="7">
                                                <Path Data="{StaticResource HeroIconArrowDownTray}" Stroke="#FFFFFF" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,2.5,0,0" />
                                                <TextBlock Text="Download PDF Report" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ExportLogsExcelCommand}" Padding="16,8" Classes="emerald" Margin="0,0,10,0" ToolTip.Tip="Export authentic CSV/Excel spreadsheet of all interaction logs">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="7">
                                                <Path Data="{StaticResource HeroIconArrowDownTray}" Stroke="#FFFFFF" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,2.5,0,0" />
                                                <TextBlock Text="Export to Excel (.xlsx)" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding SyncSwarmCommand}" Padding="14,8" Classes="outline" ToolTip.Tip="Re-scan and synchronize local logs and quota buckets">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="7">
                                                <Path Data="{StaticResource HeroIconArrowPath}" Stroke="{DynamicResource BrushTextPrimary}" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,1,0,0" />
                                                <TextBlock Text="Refresh Telemetry" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ====================================================== -->
                <!-- PAGE 4: MCP TOOLS VIEW                                 -->
                <!-- ====================================================== -->
                <ScrollViewer Grid.Row="2"
                              IsVisible="{Binding CurrentPage, Converter={StaticResource EqualityConverter}, ConverterParameter=Mcp}"
                              Padding="28">
                    <StackPanel Spacing="16" MaxWidth="920" HorizontalAlignment="Center">
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="🧩 Model Context Protocol (MCP) Tools" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="Per-worker stdio tool discovery. Profiles inherit global presets from ~/.gemini/config/mcp_config.json with per-sandbox overrides."
                                           FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding McpServers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:McpServerConfig">
                                    <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                                <Border Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Command}" FontSize="11" FontFamily="Consolas, Monaco, monospace" Foreground="{DynamicResource BrushAccent}" />
                                                </Border>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="10,6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Tools.Count, StringFormat='{}{0} tools discovered'}" FontSize="11.5" Foreground="{DynamicResource BrushEmerald}" FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ====================================================== -->
                <!-- PAGE 5: DOCUMENTATION VIEW                             -->
                <!-- ====================================================== -->
                <ScrollViewer Grid.Row="2"
                              IsVisible="{Binding CurrentPage, Converter={StaticResource EqualityConverter}, ConverterParameter=Docs}"
                              Padding="28">
                    <StackPanel Spacing="16" MaxWidth="920" HorizontalAlignment="Center">
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="22">
                            <StackPanel Spacing="10">
                                <TextBlock Text="📖 Architecture &amp; Technical Reference" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="Comprehensive technical specifications for multi-account sandboxing, keyring decoupling, Profile Doctor diagnostics, and CLI orchestration."
                                           FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Doc Specs Grid -->
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,8,12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="🏛️ System Architecture" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" />
                                    <TextBlock Text="Process sandboxing, environment variable virtualization, and process tree architecture." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                                    <Button Content="🌐 Open Spec in Browser" Command="{Binding OpenDocInBrowserCommand}" CommandParameter="Architecture" Classes="outline" Padding="12,6" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="8,0,0,12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="🩺 Profile Doctor" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" />
                                    <TextBlock Text="5-checkpoint automated health audit, process lock cleaner, and workspace trust engine." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                                    <Button Content="🌐 Open Spec in Browser" Command="{Binding OpenDocInBrowserCommand}" CommandParameter="ProfileDoctor" Classes="outline" Padding="12,6" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,8,12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="⚡ CLI Reference" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" />
                                    <TextBlock Text="Antigravity CLI command mapping, 0-turn /usage extraction, and launcher scripts." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                                    <Button Content="🌐 Open Spec in Browser" Command="{Binding OpenDocInBrowserCommand}" CommandParameter="CliReference" Classes="outline" Padding="12,6" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="8,0,0,12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="💬 Chat Migration Guide" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" />
                                    <TextBlock Text="Cross-account conversation transfer with 100% credential segregation." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                                    <Button Content="🌐 Open Spec in Browser" Command="{Binding OpenDocInBrowserCommand}" CommandParameter="ChatMigration" Classes="outline" Padding="12,6" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,8,12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="🚀 Swarm Workflows" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" />
                                    <TextBlock Text="Terminal multiplexing state machine, split-pane layout algorithms, and process lifecycle." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                                    <Button Content="🌐 Open Spec in Browser" Command="{Binding OpenDocInBrowserCommand}" CommandParameter="SwarmWorkflow" Classes="outline" Padding="12,6" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="8,0,0,12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="🩺 Troubleshooting" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" />
                                    <TextBlock Text="10 common CLI initialization issues, BOM crash fixes, and lock resolutions." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                                    <Button Content="🌐 Open Spec in Browser" Command="{Binding OpenDocInBrowserCommand}" CommandParameter="Troubleshooting" Classes="outline" Padding="12,6" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="3" Grid.Column="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,8,12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="🐧 Cross-Platform Roadmap" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" />
                                    <TextBlock Text="Linux Wayland/X11 and macOS Metal feasibility and Avalonia UI migration roadmap." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                                    <Button Content="🌐 Open Spec in Browser" Command="{Binding OpenDocInBrowserCommand}" CommandParameter="CrossPlatform" Classes="outline" Padding="12,6" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="3" Grid.Column="1" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="8,0,0,12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="⚖️ Terms of Service &amp; Risks" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" />
                                    <TextBlock Text="Google Terms of Service, Generative AI policies, and developer safety principles." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                                    <Button Content="🌐 Open Spec in Browser" Command="{Binding OpenDocInBrowserCommand}" CommandParameter="ToSRisks" Classes="outline" Padding="12,6" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="4" Grid.Column="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,8,12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Fleet Prompt Dispatcher [EXP]" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushAccent}" />
                                    <TextBlock Text="Git worktree orchestration, multi-worker prompt dispersion, and out-of-resources handling." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                                    <Button Content="🌐 Open Spec in Browser" Command="{Binding OpenDocInBrowserCommand}" CommandParameter="FleetDispatcher" Classes="outline" Padding="12,6" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

                <!-- ====================================================== -->
                <!-- PAGE 6: LOGS VIEW                                      -->
                <!-- ====================================================== -->
                <Grid Grid.Row="2"
                      IsVisible="{Binding CurrentPage, Converter={StaticResource EqualityConverter}, ConverterParameter=Logs}"
                      RowDefinitions="Auto,Auto,*">
                    <!-- Top Action Header Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource BrushSurface}" Padding="24,16" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="14">
                            <!-- Title & Subtitle Row -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="📜 Real-Time Execution Logs" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource BrushBadgeBg}" BorderBrush="{DynamicResource BrushBadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FilteredLogEntries.Count, StringFormat='{}{0} Log Entries'}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Authentic event bus, terminal orchestration output, and system diagnostics recorded daily (agyswarm_YYYY-MM-DD.log)" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                            </Grid>

                            <!-- Dedicated Action Toolbar Row -->
                            <WrapPanel VerticalAlignment="Center">
                                <Button Command="{Binding RefreshLogsCommand}" Classes="outline" Padding="14,8" Margin="0,0,8,0" ToolTip.Tip="Re-read current day's log file">
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconArrowPath}" Stroke="{DynamicResource BrushTextPrimary}" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,1,0,0" />
                                        <TextBlock Text="Refresh Logs" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ClearLogsCommand}" Classes="outline" Padding="14,8" Margin="0,0,8,0" ToolTip.Tip="Clear in-memory buffer and truncate today's log file">
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconTrash}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,1,0,0" />
                                        <TextBlock Text="Clear Buffer" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding PruneFileLogsCommand}" Classes="outline" Padding="14,8" Margin="0,0,8,0" ToolTip.Tip="Clean up older log files (>7 days) on disk to save space">
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconShieldCheck}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,1,0,0" />
                                        <TextBlock Text="Prune Files (>7d)" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenLogsFolderCommand}" Classes="outline" Padding="14,8" Margin="0,0,8,0" ToolTip.Tip="Open the physical logs directory in file explorer">
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconFolder}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,1,0,0" />
                                        <TextBlock Text="Open Logs Folder" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExportLogsExcelAsync}" Classes="emerald" Padding="16,8" ToolTip.Tip="Prompt save dialog and export logs to Excel spreadsheet">
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconArrowDownTray}" Stroke="#FFFFFF" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,2.5,0,0" />
                                        <TextBlock Text="Export to Excel (.xlsx)" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Filter & Search Bar Row -->
                    <Border Grid.Row="1" Background="{DynamicResource BrushSurfaceHover}" Padding="24,10" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <!-- Search Box -->
                            <Grid Grid.Column="0" ColumnDefinitions="Auto,*" Margin="0,0,16,0" VerticalAlignment="Center">
                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,0">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Path Grid.Column="0" Data="{StaticResource HeroIconMagnifyingGlass}" Stroke="{DynamicResource BrushTextMuted}" StrokeThickness="1.7" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Grid.Column="1" Text="{Binding LogSearchQuery, Mode=TwoWay}"
                                                 PlaceholderText="Search logs by keyword, exception, message, timestamp..."
                                                 Background="Transparent" BorderThickness="0" Padding="0,7" FontSize="12" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Level Filter Controls -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Level Filter:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding LogLevelFilterOptions}" SelectedItem="{Binding SelectedLogLevelFilter}" Width="120" VerticalAlignment="Center" Padding="8,5" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Logs Table Area -->
                    <Border Grid.Row="2" Background="{DynamicResource BrushCard}" Padding="24,16">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Table Header -->
                            <Border Grid.Row="0" Background="{DynamicResource BrushSurface}" CornerRadius="6,6,0,0" Padding="14,8" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1,1,1,0">
                                <Grid ColumnDefinitions="110,95,*">
                                    <TextBlock Grid.Column="0" Text="TIMESTAMP" FontFamily="Cascadia Code, Consolas, monospace" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <TextBlock Grid.Column="1" Text="LEVEL" FontFamily="Cascadia Code, Consolas, monospace" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <TextBlock Grid.Column="2" Text="DIAGNOSTIC LOG MESSAGE" FontFamily="Cascadia Code, Consolas, monospace" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" />
                                </Grid>
                            </Border>

                            <!-- Scrollable Log List -->
                            <Border Grid.Row="1" Background="{DynamicResource BrushSurface}" CornerRadius="0,0,6,6" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                <ScrollViewer Padding="10">
                                    <StackPanel Spacing="3">
                                        <!-- Empty Notice -->
                                        <Border IsVisible="{Binding !FilteredLogEntries.Count}" Padding="40" HorizontalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center" Spacing="6">
                                                <TextBlock Text="🔍 No matching log entries found." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Adjust your search query or log level filter, or click 'Refresh' to re-read files." FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Log Rows -->
                                        <ItemsControl ItemsSource="{Binding FilteredLogEntries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="models:LogEntryItem">
                                                    <Border Padding="6,5" CornerRadius="4" Margin="0,1">
                                                        <Grid ColumnDefinitions="110,95,*">
                                                            <!-- Timestamp -->
                                                            <TextBlock Grid.Column="0" Text="{Binding TimestampFormatted}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />

                                                            <!-- Level Badge -->
                                                            <Border Grid.Column="1" HorizontalAlignment="Left"
                                                                    Background="{Binding Level, Converter={StaticResource LogLevelToBgConverter}}"
                                                                    BorderBrush="{Binding Level, Converter={StaticResource LogLevelToBorderConverter}}"
                                                                    BorderThickness="1" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Level}" FontSize="9.5" FontWeight="Bold"
                                                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToFgConverter}}" />
                                                            </Border>

                                                            <!-- Message -->
                                                            <SelectableTextBlock Grid.Column="2" Text="{Binding Message}"
                                                                                 FontFamily="Cascadia Code, Consolas, monospace"
                                                                                 FontSize="11.5"
                                                                                 Foreground="{DynamicResource BrushTextPrimary}"
                                                                                 TextWrapping="Wrap"
                                                                                 VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ====================================================== -->
                <!-- PAGE 7: SETTINGS VIEW                                  -->
                <!-- ====================================================== -->
                <ScrollViewer Grid.Row="2"
                              IsVisible="{Binding CurrentPage, Converter={StaticResource EqualityConverter}, ConverterParameter=Settings}"
                              Padding="28,24,28,60">
                    <StackPanel Spacing="16" MaxWidth="840" HorizontalAlignment="Center">
                        <TextBlock Text="Settings &amp; Preferences" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" />
                        <TextBlock Text="Configure terminal launcher, desktop window lifecycle, audio feedback, and telemetry sync"
                                   FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,16" HorizontalAlignment="Center" />

                        <!-- Group 1: Language & Locale -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🌐 " FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Language &amp; Locale" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Select your preferred application display language." FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" />
                                <ComboBox ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding SelectedLanguageOption}"
                                          DisplayMemberBinding="{Binding DisplayName}"
                                          Width="260"
                                          HorizontalAlignment="Left"
                                          Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Group 2: Appearance & Color Palette -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🎨 " FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Theme Appearance &amp; Color Palette" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Choose your preferred color palette. Surface contrasts, glowing badges, and borders are mathematically calibrated for maximum readability across Windows, Linux, and macOS." FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" />

                                <!-- 5 Rich Theme Palette Cards Grid -->
                                <UniformGrid Columns="2" Margin="0,4,0,0">
                                    <!-- Card 1: System (Auto OS) -->
                                    <Button Command="{Binding SetThemeCommand}" CommandParameter="System"
                                            Classes="outline" Margin="0,0,6,10" Padding="14,12" HorizontalContentAlignment="Stretch">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Ellipse Width="14" Height="14" Fill="#0F1115" Stroke="#334155" StrokeThickness="1.5" Margin="0,0,4,0" />
                                                <Ellipse Width="14" Height="14" Fill="#FFFFFF" Stroke="#94A3B8" StrokeThickness="1.5" Margin="0,0,4,0" />
                                                <Ellipse Width="14" Height="14" Fill="#38BDF8" Margin="0,0,4,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="🖥️ System (Auto OS)" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Syncs with OS dark/light mode" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Card 2: Obsidian Dark -->
                                    <Button Command="{Binding SetThemeCommand}" CommandParameter="Dark"
                                            Classes="outline" Margin="6,0,0,10" Padding="14,12" HorizontalContentAlignment="Stretch">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Ellipse Width="14" Height="14" Fill="#090D16" Stroke="#1E293B" StrokeThickness="1.5" Margin="0,0,4,0" />
                                                <Ellipse Width="14" Height="14" Fill="#1E293B" Margin="0,0,4,0" />
                                                <Ellipse Width="14" Height="14" Fill="#38BDF8" Margin="0,0,4,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="🌙 Obsidian Dark" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Deep midnight navy with electric cyan" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Card 3: Daylight Clean -->
                                    <Button Command="{Binding SetThemeCommand}" CommandParameter="Light"
                                            Classes="outline" Margin="0,0,6,10" Padding="14,12" HorizontalContentAlignment="Stretch">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Ellipse Width="14" Height="14" Fill="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1.5" Margin="0,0,4,0" />
                                                <Ellipse Width="14" Height="14" Fill="#FFFFFF" Stroke="#CBD5E1" StrokeThickness="1.5" Margin="0,0,4,0" />
                                                <Ellipse Width="14" Height="14" Fill="#0284C7" Margin="0,0,4,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="☀️ Daylight Clean" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Crisp white surface with cerulean blue" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Card 4: Cyberpunk Neon -->
                                    <Button Command="{Binding SetThemeCommand}" CommandParameter="Cyberpunk"
                                            Classes="outline" Margin="6,0,0,10" Padding="14,12" HorizontalContentAlignment="Stretch">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Ellipse Width="14" Height="14" Fill="#0C0A1D" Stroke="#2D1B4E" StrokeThickness="1.5" Margin="0,0,4,0" />
                                                <Ellipse Width="14" Height="14" Fill="#1A1435" Margin="0,0,4,0" />
                                                <Ellipse Width="14" Height="14" Fill="#EC4899" Margin="0,0,4,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="🔮 Cyberpunk Neon" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Neon pink, ultraviolet &amp; cyber blue" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Card 5: Matrix Emerald -->
                                    <Button Command="{Binding SetThemeCommand}" CommandParameter="Matrix"
                                            Classes="outline" Margin="0,0,6,0" Padding="14,12" HorizontalContentAlignment="Stretch">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Ellipse Width="14" Height="14" Fill="#05130B" Stroke="#0B2B18" StrokeThickness="1.5" Margin="0,0,4,0" />
                                                <Ellipse Width="14" Height="14" Fill="#0B2014" Margin="0,0,4,0" />
                                                <Ellipse Width="14" Height="14" Fill="#10B981" Margin="0,0,4,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="📟 Matrix Emerald" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Terminal phosphor green with CRT glow" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Group 3: Terminal Launcher & Execution -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="💻 " FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Terminal Launcher &amp; Execution" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Preferred Terminal -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Preferred Terminal Emulator" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <TextBlock Text="Select which console window launches the isolated agy sessions." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                                    <ComboBox SelectedItem="{Binding SelectedTerminal}" Width="260" HorizontalAlignment="Left" Margin="0,2,0,0">
                                        <models:TerminalType>WindowsTerminal</models:TerminalType>
                                        <models:TerminalType>PowerShell</models:TerminalType>
                                        <models:TerminalType>CommandPrompt</models:TerminalType>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Swarm Mode -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Swarm Window Arrangement" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <TextBlock Text="Choose how multiple parallel workers are arranged when Launch Swarm is clicked." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                                    <ComboBox SelectedItem="{Binding SelectedSwarmMode}" Width="260" HorizontalAlignment="Left" Margin="0,2,0,0">
                                        <models:SwarmLaunchMode>SplitPanes</models:SwarmLaunchMode>
                                        <models:SwarmLaunchMode>SeparateTabs</models:SwarmLaunchMode>
                                        <models:SwarmLaunchMode>SeparateWindows</models:SwarmLaunchMode>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Custom agy executable path -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Antigravity CLI Binary Path" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <TextBlock Text="Automatically discovered or custom path to the 'agy' executable." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <TextBox Grid.Column="0" Text="{Binding DetectedAgyPath, Mode=TwoWay}" PlaceholderText="Default: auto-detected from system PATH" Margin="0,0,8,0" />
                                        <Button Grid.Column="1" Command="{Binding BrowseCliBinaryPathCommand}" Classes="outline" Padding="12,6" ToolTip.Tip="Browse for agy CLI binary file">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Path Data="{StaticResource HeroIconFolder}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="📁 Browse..." FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Group 4: System Tray & Window Lifecycle -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🛡️ " FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="System Tray &amp; Window Lifecycle" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Window Close [✕] Behavior" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <TextBlock Text="Choose what happens when the titlebar close button [✕] is clicked." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />

                                    <StackPanel Margin="0,4,0,0" Spacing="8">
                                        <RadioButton GroupName="CloseActionGroup"
                                                     IsChecked="{Binding CloseToTray, Mode=TwoWay}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                <TextBlock Text="📥 Minimize to System Tray" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text=" (Runs silently in background with tray icon &amp; periodic sync)" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="CloseActionGroup"
                                                     IsChecked="{Binding ExitOnClose, Mode=TwoWay}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                <TextBlock Text="🛑 Exit Application Completely" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text=" (Closes all background threads and terminates swarm immediately)" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" />
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource BrushCardBorder}" Margin="0,4" />

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Window Minimize [🗕] Behavior" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <CheckBox IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                                              Content="Minimize button [🗕] hides window to system tray instead of taskbar" Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Group 5: Audio Feedback & Haptics -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🎵 " FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Audio Feedback &amp; Haptics" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>

                                <CheckBox IsChecked="{Binding SoundEnabled}"
                                          Content="Enable synthesized audio tones on user transactions (clicks, launches, chimes)" />

                                <CheckBox IsChecked="{Binding AutoSyncAudioEnabled}"
                                          Content="Play subtle droplet chime when periodic auto-sync completes in background" />

                                <StackPanel Spacing="8" Margin="0,4,0,0">
                                    <TextBlock Text="Test Sound Effects:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Command="{Binding TestQuotaAlertCommand}" Classes="dangerOutline" Content="🚨 Quota Exhausted Alert" Padding="12,6" />
                                        <Button Command="{Binding SyncSwarmCommand}" Classes="outline" Content="🔄 Sync Droplet Chime" Padding="12,6" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Group 6: About & Open Source Credits -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⭐ " FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="About &amp; Open Source Credits" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="Agy CLI Account Swarm is a high-performance, open-source orchestration tool for Google Antigravity CLI users."
                                           FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" LineHeight="18" />

                                <Border Background="{DynamicResource BrushSurface}" CornerRadius="6" Padding="14" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Created &amp; Maintained by:" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                                            <TextBlock Text="RifkyA911 (https://github.com/RifkyA911)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,2" />
                                            <TextBlock Text="Licensed under MIT License — Open for community contributions &amp; portfolio showcase." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                            <Button Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/RifkyA911" Classes="primary" Content="GitHub Profile" Padding="12,6" />
                                            <Button Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/RifkyA911/agy-cli-account-swarm" Classes="outline" Content="Repository" Padding="12,6" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Group 7: Periodic Auto-Sync & Diagnostics Loop -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🔄 " FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Periodic Swarm &amp; MCP Auto-Sync" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Automatically recalculate real token consumption, probe active model presence, and scan MCP tool servers in the background."
                                           FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" />
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                    <TextBlock Text="Auto-Sync Interval:" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding AutoSyncOptions}" SelectedItem="{Binding AutoSyncInterval}" Width="180" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Group 8: Storage & Diagnostics -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="📁 " FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Storage &amp; Diagnostics" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Profiles and application settings are persisted in local app data:" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                    <Button Content="Open AppData Folder" Command="{Binding OpenAppDataFolderCommand}" Classes="outline" Padding="14,7" />
                                    <Button Content="Open Application Log" Command="{Binding OpenLogFileCommand}" Classes="outline" Padding="14,7" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Bottom Breathing Room Spacer -->
                        <Border Height="40" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ====================================================== -->
                <!-- PAGE 8: ABOUT VIEW                                     -->
                <!-- ====================================================== -->
                <ScrollViewer Grid.Row="2"
                              IsVisible="{Binding CurrentPage, Converter={StaticResource EqualityConverter}, ConverterParameter=About}"
                              Padding="28">
                    <StackPanel Spacing="20" MaxWidth="760" HorizontalAlignment="Center">
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="28">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="⚡" FontSize="28" />
                                    <StackPanel>
                                        <TextBlock Text="Agy CLI Account Swarm" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="Version 0.9.7-beta • Avalonia Cross-Platform Edition" FontSize="13" Foreground="{DynamicResource BrushAccent}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="A high-performance desktop orchestrator &amp; sandbox session manager for Google Antigravity CLI (agy). Run multiple agent sessions concurrently with strictly isolated accounts, authentic real-time telemetry, session turn tracking, and workspace sandboxing."
                                           FontSize="13.5" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" LineHeight="22" />

                                <Border Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="14" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Architectural Highlights:" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="• Cross-Platform: Engineered with Avalonia UI for Windows, Linux, and macOS." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                        <TextBlock Text="• Zero Synthetic Data: Telemetry parsed strictly from authentic local CLI commands and disk logs." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                        <TextBlock Text="• Keyring Decoupling: File-based OAuth token isolation via virtualized network indicators." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                        <TextBlock Text="• Built-in Profile Doctor: 5-checkpoint automated health audit &amp; stuck lock cleaner." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Licensed under the MIT License • Copyright (c) 2026 RifkyA911" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============================================================== -->
        <!-- SWARM PROJECT CREATE / EDIT MODAL DIALOG                       -->
        <!-- ============================================================== -->
        <Border Background="#D9000000"
                ZIndex="998"
                IsVisible="{Binding IsProjectDialogOpen}">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{DynamicResource BrushCard}"
                        BorderBrush="{DynamicResource BrushCardBorder}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="28,24"
                        Width="640"
                        MaxHeight="700">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding ProjectDialogTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="Configure workspace roots, default tech stack, and assign participating worker profiles" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Command="{Binding CancelProjectDialogCommand}" Classes="outline" Padding="8,4" FontSize="13" />
                        </Grid>

                        <!-- Scrollable Form Fields -->
                        <ScrollViewer Grid.Row="1" Margin="0,0,-8,0" Padding="0,0,8,0">
                            <StackPanel Spacing="12">
                                <!-- Project Name -->
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Project Name:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <TextBox Text="{Binding ProjectDialogName, Mode=TwoWay}" Padding="10,8" />
                                </StackPanel>

                                <!-- Description -->
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Project Purpose &amp; Description:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <TextBox Text="{Binding ProjectDialogDescription, Mode=TwoWay}" Padding="10,8" />
                                </StackPanel>

                                <!-- Tech Stack & Default Branch -->
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,8,0">
                                        <TextBlock Text="Target Tech Stack:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                        <ComboBox ItemsSource="{Binding TechStackOptions}" SelectedItem="{Binding ProjectDialogTechStack, Mode=TwoWay}" HorizontalAlignment="Stretch" Padding="10,6" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock Text="Default Base Branch:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                        <TextBox Text="{Binding ProjectDialogDefaultBranch, Mode=TwoWay}" Padding="10,8" />
                                    </StackPanel>
                                </Grid>

                                <!-- Root Repository Directory -->
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Project Root Directory:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding ProjectDialogRootDirectory, Mode=TwoWay}" Padding="10,8" Margin="0,0,8,0" />
                                        <Button Grid.Column="1" Command="{Binding BrowseProjectDialogFolderCommand}" Classes="outline" Padding="12,8">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="📁 Browse Folder..." FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- Git Worktrees Toggle -->
                                <CheckBox IsChecked="{Binding ProjectDialogUseGitWorktrees, Mode=TwoWay}" Content="Enable Git Worktree Branch Isolation for workers" FontSize="11.5" />

                                <!-- Default Objective -->
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Default Swarm Objective (Optional Template):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <TextBox Text="{Binding ProjectDialogDefaultObjective, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Padding="10,8" />
                                </StackPanel>

                                <!-- Assigned Worker Accounts -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Assigned Worker Accounts:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <Border Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="10" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" MaxHeight="160">
                                        <ScrollViewer>
                                            <ItemsControl ItemsSource="{Binding ProjectDialogWorkers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="models:ProjectWorkerSelectionItem">
                                                        <Border Background="{DynamicResource BrushCard}" CornerRadius="6" Padding="8,6" Margin="0,0,0,6" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                <!-- Avatar -->
                                                                <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="{Binding ColorTag, Converter={StaticResource HexBrushConverter}}" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding AvatarInitial}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                    <TextBlock Text="{Binding AccountEmail}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                </StackPanel>
                                                                <Border Grid.Column="3" Background="{DynamicResource BrushSurface}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Tier}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer Actions -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
                            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelProjectDialogCommand}" Classes="outline" Padding="16,8" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="💾 Save Project" Command="{Binding SaveProjectDialogCommand}" Background="#3B82F6" Foreground="#FFFFFF" Padding="18,8" FontWeight="Bold" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- 2-SECOND WELCOME OVERLAY / SPLASH SCREEN                       -->
        <!-- ============================================================== -->
        <Border Background="#F2090D16"
                IsVisible="{Binding IsWelcomeOverlayVisible}"
                ZIndex="9999"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4" />
                </Transitions>
            </Border.Transitions>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Spacing="24">
                    <!-- Glowing App Icon & Swarm Orb -->
                    <Grid Width="110" Height="110" HorizontalAlignment="Center">
                        <Ellipse Width="110" Height="110" Fill="#153B82F6" />
                        <Ellipse Width="86" Height="86" Fill="#253B82F6" />
                        <Border Width="64" Height="64" CornerRadius="32" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="/Assets/favicon.ico" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Title & Tagline -->
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <TextBlock Text="Google Antigravity CLI Swarm"
                                   FontSize="24"
                                   FontWeight="ExtraBold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Multi-Account Sandbox Orchestrator &amp; Telemetry Fleet"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Animated Loading Indeterminate Bar -->
                    <StackPanel HorizontalAlignment="Center" Width="260" Spacing="8">
                        <ProgressBar IsIndeterminate="True" Height="4" CornerRadius="2"
                                     Foreground="#3B82F6" Background="#1E293B" />
                        <TextBlock Text="Initializing Fleet &amp; Quota Telemetry..."
                                   FontSize="11"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

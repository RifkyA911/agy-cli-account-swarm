# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.cs text eol=crlf diff=csharp
*.xaml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf

# Config & Docs
*.json text eol=crlf
*.md text eol=crlf
*.yml text eol=crlf
*.yaml text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.dll binary
*.exe binary

<Window x:Class="AgyAccountSwarm.Views.ImportChatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AgyAccountSwarm.ViewModels"
        Title="Import Chat Conversations"
        Icon="../Resources/favicon.ico"
        Height="620" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Dialog Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Import Chat History"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}" />
                        <TextBlock Text="Migrate conversation sessions and transcripts from another account into this profile."
                                   FontSize="12"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="#1A3B82F6"
                            BorderBrush="#403B82F6"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Target: " FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                            <TextBlock Text="{Binding TargetProfile.Name}" FontSize="11" FontWeight="Bold" Foreground="#3B82F6" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Source Account Selector Bar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource BrushCard}"
                    BorderBrush="{DynamicResource BrushCardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Source Account:"
                               FontWeight="SemiBold"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding SourceProfiles}"
                              SelectedItem="{Binding SelectedSourceProfile}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource ModernComboBox}"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0">
                        <Button Content="Select All"
                                Command="{Binding SelectAllCommand}"
                                Style="{StaticResource ModernButton}"
                                Padding="10,5"
                                FontSize="11"
                                Margin="0,0,6,0" />
                        <Button Content="Deselect All"
                                Command="{Binding DeselectAllCommand}"
                                Style="{StaticResource ModernButton}"
                                Padding="10,5"
                                FontSize="11" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Conversations List -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushCard}"
                    BorderBrush="{DynamicResource BrushCardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,14">
                <Grid>
                    <!-- Loading Indicator -->
                    <TextBlock Text="Scanning conversations..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}" />

                    <!-- Empty notice -->
                    <TextBlock Text="No conversations found in selected source account."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Visibility="{Binding Conversations.Count, Converter={StaticResource EmptyToVisConverter}}" />

                    <!-- List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Conversations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="10,8"
                                            CornerRadius="6"
                                            Background="{DynamicResource BrushSurface}"
                                            BorderBrush="{DynamicResource BrushCardBorder}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox -->
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0" />

                                            <!-- Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayPrompt}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding ConversationId}"
                                                               FontSize="10"
                                                               FontFamily="Consolas"
                                                               Foreground="{DynamicResource BrushTextSecondary}"
                                                               Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding Workspace}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource BrushTextSecondary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="250" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Timestamp -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Safe Local Operation Banner -->
            <Border Grid.Row="3"
                    Background="#1010B981"
                    BorderBrush="#3010B981"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔒" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="100% Local File Transfer: Chat sessions and transcripts are copied exclusively on your local disk between sandboxes. Credentials and Google auth tokens are never copied or merged."
                               FontSize="10.5"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Bottom Action Row -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Text -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Cancel Button -->
                <Button Grid.Column="1"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource ModernButton}"
                        Padding="18,8"
                        Margin="0,0,10,0" />

                <!-- Import Button -->
                <Button Grid.Column="2"
                        Command="{Binding ImportCommand}"
                        IsEnabled="{Binding IsTransferring, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource PrimaryButton}"
                        Padding="20,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource HeroIconArrowsRightLeft}"
                              Stroke="#FFFFFF"
                              StrokeThickness="2"
                              Width="13" Height="13"
                              Stretch="Uniform"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Transfer Selected Chats" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>

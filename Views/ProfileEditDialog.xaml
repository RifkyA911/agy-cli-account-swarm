<Window x:Class="AgyAccountSwarm.Views.ProfileEditDialog"
        x:Name="RootDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AgyAccountSwarm.ViewModels"
        Title="{Binding DialogTitle}"
        Icon="../Resources/favicon.ico"
        Height="700" Width="740"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Dialog Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{Binding DialogTitle}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource BrushTextPrimary}" />
                <TextBlock Text="Configure profile credentials, subscription tier, and CLI preferences."
                           FontSize="12"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Default Profile Banner -->
                    <Border Background="#1510B981"
                            BorderBrush="#4010B981"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,0,0,16"
                            Visibility="{Binding IsDefaultProfile, Converter={StaticResource BoolToVisConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔒" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="System Primary Account (Default ~/.gemini)" FontWeight="Bold" FontSize="12" Foreground="#10B981" />
                                <TextBlock Text="This profile is linked directly to your operating system's primary Google Antigravity identity. Profile path redirection is locked to ensure CLI ecosystem interoperability."
                                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Validation Error Banner -->
                    <Border Background="#331418"
                            BorderBrush="{DynamicResource BrushDanger}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,0,16"
                            Visibility="{Binding ValidationError, Converter={StaticResource NullOrEmptyToVisConverter}, ConverterParameter=False}">
                        <TextBlock Text="{Binding ValidationError}"
                                   Foreground="#F87171"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </Border>

                    <!-- Profile Name -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Profile Name *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                        <TextBlock Text="• Locked for primary system profile"
                                   Visibility="{Binding IsDefaultProfile, Converter={StaticResource BoolToVisConverter}}"
                                   FontSize="10.5" FontWeight="SemiBold" Foreground="#10B981" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEditName}"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,6,0,14" />

                    <!-- Description (2-Row Height with TextWrapping) -->
                    <TextBlock Text="Description / Notes" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="56"
                             Height="56"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,6,0,14" />

                    <!-- Dynamic Quota & Tier Information (Detected Dynamically by System Session) -->
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushCardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Subscription Tier &amp; Daily Quota" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                    <Border Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ Dynamic By Session" FontSize="10" FontWeight="Bold" Foreground="#10B981" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Detected automatically from active Google account tokens &amp; authentic CLI /usage telemetry."
                                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Tier: " FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                                        <TextBlock Text="{Binding TierSummaryText}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Quota: " FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                                        <TextBlock Text="{Binding QuotaSummaryText}" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Target / Preferred Model Selection -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Target / Preferred Model" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                        <ComboBox ItemsSource="{Binding ModelOptions}"
                                  SelectedItem="{Binding PreferredModel, Mode=TwoWay}"
                                  Style="{StaticResource ModernComboBox}"
                                  Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Color Accent Selection -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Color Accent" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding SelectedColor, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedColor}" FontSize="10" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding ColorPresets}" Margin="0,0,0,14">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding ElementName=RootDialog, Path=DataContext.SelectColorCommand}"
                                        CommandParameter="{Binding}"
                                        Width="32" Height="32"
                                        Margin="0,0,8,6"
                                        Cursor="Hand"
                                        ToolTip="{Binding Name}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <!-- Outer active ring when selected -->
                                                <Ellipse Width="32" Height="32"
                                                         Stroke="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                         StrokeThickness="2"
                                                         Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}" />
                                                <!-- Inner color circle -->
                                                <Ellipse Width="24" Height="24"
                                                         Fill="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"
                                                         Stroke="#1E293B"
                                                         StrokeThickness="1" />
                                                <!-- Checkmark icon when selected -->
                                                <Path Data="M 11,16 L 14,19 L 21,12"
                                                      Stroke="#FFFFFF"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Workspace Folder -->
                    <TextBlock Text="Default Workspace / Project Directory" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                    <Grid Margin="0,6,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding DefaultWorkspace, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" />
                        <Button Grid.Column="1"
                                Content="Browse..."
                                Click="BrowseWorkspace_Click"
                                Style="{StaticResource ModernButton}"
                                Margin="8,0,0,0"
                                Padding="12,6" />
                    </Grid>

                    <!-- Custom Profile Directory -->
                    <TextBlock Text="Custom Isolated Home Directory (Optional)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBlock Text="Locked to %USERPROFILE% for System Primary Account"
                               Visibility="{Binding IsDefaultProfile, Converter={StaticResource BoolToVisConverter}}"
                               FontSize="11" Foreground="#10B981" Margin="0,2,0,4" />
                    <TextBlock Text="Leave empty to use default ~/.gemini-profiles/{Name}"
                               Visibility="{Binding IsDefaultProfile, Converter={StaticResource InverseBoolToVisConverter}}"
                               FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,4" />
                    <Grid Margin="0,2,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding CustomProfilePath, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditProfilePath}"
                                 Style="{StaticResource ModernTextBox}" />
                        <Button Grid.Column="1"
                                Content="Browse..."
                                Click="BrowseProfileDir_Click"
                                IsEnabled="{Binding CanEditProfilePath}"
                                Style="{StaticResource ModernButton}"
                                Margin="8,0,0,0"
                                Padding="12,6" />
                    </Grid>

                    <!-- Extra Arguments -->
                    <TextBlock Text="Extra agy CLI Flags (Optional)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBlock Text="e.g. --dangerously-skip-permissions --model 'Gemini 3.8 Flash'" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,4" />
                    <TextBox Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,2,0,14" />

                    <!-- Swarm Checkbox -->
                    <CheckBox IsChecked="{Binding IsSelectedForSwarm}"
                              Style="{StaticResource ModernCheckBox}"
                              Content="Include in Swarm Launch (Multi-session)"
                              Margin="0,4,0,8" />
                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource ModernButton}"
                        Margin="0,0,8,0"
                        Width="90" />
                <Button Content="Save Profile"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="110" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

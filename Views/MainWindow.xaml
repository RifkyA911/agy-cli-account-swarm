                                        <TextBlock Text="Concurrent Swarm Execution" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Spawn orchestrated multi-account worker swarms in parallel using Windows Terminal Split Panes, Tabs, or Independent Conhost windows. Full process tree lifecycle monitoring with 1-click stop."
                                               FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" LineHeight="17" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Pillar 4 -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="10,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#15F59E0B" BorderBrush="#30F59E0B" BorderThickness="1" Margin="0,0,10,0">
                                            <Path Data="{StaticResource HeroIconArrowsRightLeft}" Stroke="#F59E0B" StrokeThickness="1.75" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Chat Migration &amp; Import" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Seamlessly clone and import past conversations between sandboxed accounts on your local disk. Designed to prioritize Google Terms of Service compliance: operates strictly on local disk, keeping tokens and telemetry isolated without upstream transfer."
                                               FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" LineHeight="17" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Project Scope Notice -->
                        <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="📌 Application Scope &amp; Architecture Roadmap" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
                                <TextBlock Text="• This repository is exclusively dedicated to the graphical desktop orchestrator (GUI-Only). A headless automation CLI will be published in a companion project under the name 'agy-swarm'."
                                           FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2" />
                                <TextBlock Text="• Fully compatible with Antigravity CLI v1.2+ on Windows 10 / 11."
                                           FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2" />
                                <TextBlock Text="• Cross-platform compatibility documentation and scripts are provided for Linux / macOS environments."
                                           FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2" />
                            </StackPanel>
                        </Border>

                        <!-- Credits & Maintainer -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Creator &amp; Maintainer" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="RifkyA911" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,2" />
                                    <TextBlock Text="Repository: https://github.com/RifkyA911/agy-cli-account-swarm" FontSize="11.5" Foreground="#3B82F6" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding OpenGitHubRepoCommand}" Style="{StaticResource PrimaryButton}" Padding="16,8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⭐ Star on GitHub" FontWeight="Bold" FontSize="11.5" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Bottom Spacer -->
                        <Border Height="60" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============================================================== -->
        <!-- SWARM PROJECT CREATE / EDIT MODAL DIALOG OVERLAY               -->
        <!-- ============================================================== -->
        <Border Background="#D9000000"
                Panel.ZIndex="998"
                Visibility="{Binding IsProjectDialogOpen, Converter={StaticResource BoolToVisConverter}}">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{DynamicResource BrushCard}"
                        BorderBrush="{DynamicResource BrushCardBorder}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="28,24"
                        Width="640"
                        MaxHeight="700">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding ProjectDialogTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="Configure workspace roots, default tech stack, and assign participating worker profiles" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Command="{Binding CancelProjectDialogCommand}" Style="{StaticResource ModernButton}" Padding="8,4" FontSize="13" />
                        </Grid>

                        <!-- Scrollable Form Fields -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                            <StackPanel>
                                <!-- Project Name -->
                                <TextBlock Text="Project Name:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding ProjectDialogName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8" Margin="0,0,0,12" />

                                <!-- Description -->
                                <TextBlock Text="Project Purpose &amp; Description:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding ProjectDialogDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8" Margin="0,0,0,12" />

                                <!-- Tech Stack & Default Branch -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Target Tech Stack:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,5" />
                                        <ComboBox ItemsSource="{Binding TechStackOptions}" SelectedItem="{Binding ProjectDialogTechStack}" Style="{StaticResource ModernComboBox}" Padding="10,6" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Default Base Branch:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding ProjectDialogDefaultBranch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8" />
                                    </StackPanel>
                                </Grid>

                                <!-- Root Repository Directory -->
                                <TextBlock Text="Project Root Directory:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,5" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding ProjectDialogRootDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Command="{Binding BrowseProjectDialogFolderCommand}" Style="{StaticResource SecondaryButton}" Padding="12,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconFolder}" Stroke="{DynamicResource BrushTextPrimary}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Browse Folder..." FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Git Worktrees Toggle -->
                                <CheckBox IsChecked="{Binding ProjectDialogUseGitWorktrees}" Content="Enable Git Worktree Branch Isolation for workers" FontSize="11.5" Margin="0,0,0,12" />

                                <!-- Default Objective -->
                                <TextBlock Text="Default Swarm Objective (Optional Template):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding ProjectDialogDefaultObjective, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Style="{StaticResource ModernTextBox}" Padding="10,8" Margin="0,0,0,14" />

                                <!-- Assigned Worker Accounts -->
                                <TextBlock Text="Assigned Worker Accounts:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6" />
                                <Border Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="10" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" MaxHeight="160">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ProjectDialogWorkers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource BrushCard}" CornerRadius="6" Padding="8,6" Margin="0,0,0,6" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <!-- Avatar -->
                                                            <Grid Grid.Column="1" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                <Ellipse Width="24" Height="24" Fill="{Binding ColorTag, Converter={StaticResource HexToBrushConverter}}" />
                                                                <TextBlock Text="{Binding AvatarInitial}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Grid>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                <TextBlock Text="{Binding AccountEmail}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                            </StackPanel>
                                                            <Border Grid.Column="3" Background="{DynamicResource BrushSurface}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Tier}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer Actions -->
                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelProjectDialogCommand}" Style="{StaticResource SecondaryButton}" Padding="16,8" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="💾 Save Project" Command="{Binding SaveProjectDialogCommand}" Style="{StaticResource PrimaryButton}" Background="#3B82F6" Padding="18,8" FontWeight="Bold" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- FLUID 3-SECOND CAT GREETING OVERLAY (Starts up gracefully)      -->
        <!-- ============================================================== -->
        <Border Background="#E60A0C10"
                Panel.ZIndex="999"
                Cursor="Hand"
                Visibility="{Binding IsWelcomeOverlayVisible, Converter={StaticResource BoolToVisConverter}}">
            <Border.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding DismissWelcomeOverlayCommand}" />
            </Border.InputBindings>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{DynamicResource BrushCard}"
                        BorderBrush="{DynamicResource BrushCardBorder}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="36,28"
                        Width="440">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Cute Vector Cat Illustration -->
                        <Canvas Width="100" Height="90" Margin="0,0,0,16">
                            <!-- Cat Face / Head -->
                            <Path Data="M 15,35 Q 20,10 32,25 Q 50,22 68,25 Q 80,10 85,35 Q 92,60 80,75 Q 50,88 20,75 Q 8,60 15,35 Z"
                                  Fill="#3B82F6" Stroke="#60A5FA" StrokeThickness="2" />

                            <!-- Cat Left Ear Inner -->
                            <Path Data="M 23,30 Q 25,18 32,25 Z" Fill="#F472B6" />

                            <!-- Cat Right Ear Inner -->
                            <Path Data="M 77,30 Q 75,18 68,25 Z" Fill="#F472B6" />

                            <!-- Eyes -->
                            <Ellipse Canvas.Left="33" Canvas.Top="42" Width="8" Height="10" Fill="#FFFFFF" />
                            <Ellipse Canvas.Left="35" Canvas.Top="44" Width="4" Height="6" Fill="#0F172A" />

                            <Ellipse Canvas.Left="59" Canvas.Top="42" Width="8" Height="10" Fill="#FFFFFF" />
                            <Ellipse Canvas.Left="61" Canvas.Top="44" Width="4" Height="6" Fill="#0F172A" />

                            <!-- Nose & Smiling Mouth -->
                            <Path Data="M 48,55 L 52,55 L 50,58 Z" Fill="#F472B6" />
                            <Path Data="M 44,60 Q 50,64 50,60 Q 50,64 56,60" Stroke="#FFFFFF" StrokeThickness="1.5" Fill="Transparent" />

                            <!-- Cute Cheeks -->
                            <Ellipse Canvas.Left="26" Canvas.Top="54" Width="8" Height="5" Fill="#F472B6" Opacity="0.5" />
                            <Ellipse Canvas.Left="66" Canvas.Top="54" Width="8" Height="5" Fill="#F472B6" Opacity="0.5" />

                            <!-- Whiskers -->
                            <Line X1="10" Y1="50" X2="24" Y2="52" Stroke="#93C5FD" StrokeThickness="1.5" />
                            <Line X1="10" Y1="58" X2="24" Y2="56" Stroke="#93C5FD" StrokeThickness="1.5" />
                            <Line X1="90" Y1="50" X2="76" Y2="52" Stroke="#93C5FD" StrokeThickness="1.5" />
                            <Line X1="90" Y1="58" X2="76" Y2="56" Stroke="#93C5FD" StrokeThickness="1.5" />

                            <!-- Waving Paws -->
                            <Ellipse Canvas.Left="22" Canvas.Top="72" Width="16" Height="14" Fill="#60A5FA" />
                            <Ellipse Canvas.Left="62" Canvas.Top="72" Width="16" Height="14" Fill="#60A5FA" />
                        </Canvas>

                        <!-- Greeting Title -->
                        <TextBlock Text="Meow! Welcome back"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   HorizontalAlignment="Center" />

                        <!-- Subtitle -->
                        <TextBlock Text="Antigravity CLI Account Swarm initialized."
                                   FontSize="13"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,16" />

                        <!-- Status pill -->
                        <Border Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushCardBorder}"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="14,6"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="All isolated environments ready" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                            </StackPanel>
                        </Border>

                        <!-- Dismiss hint -->
                        <TextBlock Text="Click anywhere to continue"
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

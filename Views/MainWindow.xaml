<Window x:Class="AgyAccountSwarm.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AgyAccountSwarm.ViewModels"
        xmlns:models="clr-namespace:AgyAccountSwarm.Models"
        Title="Agy Account Swarm — Antigravity CLI Manager"
        Height="700" Width="1040"
        MinHeight="580" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBg}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header & Top Stats -->
            <RowDefinition Height="Auto" />
            <!-- Action / Search Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Notification Banner -->
            <RowDefinition Height="Auto" />
            <!-- Profiles List Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Strip -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header & Quick Stats -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushCardBorder}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Branding & Subtitle -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#2563EB" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                            <TextBlock Text="AGY" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" />
                        </Border>
                        <TextBlock Text="Account Swarm"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center" />
                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0" Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Concurrent multi-account runner &amp; environment isolator for Antigravity CLI"
                               FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Right: Stats Chips -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Total Profiles -->
                    <Border Background="#14161C" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="TOTAL PROFILES" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="{Binding TotalCount}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Authenticated -->
                    <Border Background="#14161C" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="AUTHENTICATED" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" />
                            <TextBlock Text="{Binding AuthenticatedCount}" FontSize="16" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Needs Login -->
                    <Border Background="#14161C" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="NEEDS LOGIN" FontSize="10" FontWeight="SemiBold" Foreground="#F59E0B" />
                            <TextBlock Text="{Binding NeedsLoginCount}" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Swarm Ready -->
                    <Border Background="#14161C" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,8">
                        <StackPanel>
                            <TextBlock Text="SWARM TARGETS" FontSize="10" FontWeight="SemiBold" Foreground="#3B82F6" />
                            <TextBlock Text="{Binding SelectedSwarmCount}" FontSize="16" FontWeight="Bold" Foreground="#3B82F6" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Action / Search Toolbar -->
        <Border Grid.Row="1"
                Background="#111317"
                BorderBrush="{StaticResource BrushCardBorder}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}"
                         ToolTip="Filter profiles by name, notes, or Google email..." />

                <!-- Middle space -->

                <!-- Right Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh Auth"
                            Command="{Binding RefreshAllAuthCommand}"
                            Style="{StaticResource ModernButton}"
                            Margin="0,0,8,0"
                            ToolTip="Re-inspect all profile directories for OAuth tokens and Google accounts" />

                    <Button Content="+ New Profile"
                            Command="{Binding AddProfileCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,12,0" />

                    <!-- Launch Swarm CTA -->
                    <Button Command="{Binding LaunchSwarmCommand}"
                            Style="{StaticResource SwarmButton}"
                            Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ Launch Swarm" FontWeight="Bold" />
                            <TextBlock Text=" (" FontWeight="Bold" />
                            <TextBlock Text="{Binding SelectedSwarmCount}" FontWeight="Bold" />
                            <TextBlock Text=")" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Notification Message Banner -->
        <Border Grid.Row="2"
                Background="#1E293B"
                BorderBrush="#3B82F6"
                BorderThickness="0,0,0,1"
                Padding="24,8"
                Visibility="{Binding NotificationMessage, Converter={StaticResource NullOrEmptyToVisConverter}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="ℹ️ " VerticalAlignment="Center" />
                <TextBlock Text="{Binding NotificationMessage}"
                           Foreground="#93C5FD"
                           FontWeight="SemiBold"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 4. Profile Cards List Area -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <ItemsControl ItemsSource="{Binding FilteredProfiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Individual Account Profile Card -->
                        <Border Background="{StaticResource BrushCard}"
                                BorderBrush="{StaticResource BrushCardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,12"
                                Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Swarm Checkbox -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Color Accent Line -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Main Profile Info -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Action Buttons -->
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Swarm Checkbox -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelectedForSwarm}"
                                          Style="{StaticResource ModernCheckBox}"
                                          Margin="0,0,14,0"
                                          VerticalAlignment="Center"
                                          ToolTip="Select this profile for Swarm Launch" />

                                <!-- Column 1: Color Bar Indicator -->
                                <Border Grid.Column="1"
                                        Width="4"
                                        CornerRadius="2"
                                        Background="{Binding ColorTag, Converter={StaticResource HexToBrushConverter}}"
                                        Margin="0,0,16,0" />

                                <!-- Column 2: Profile Details -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Profile Name -->
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTextPrimary}" />

                                        <!-- Status Badge -->
                                        <Border CornerRadius="4"
                                                Padding="8,2"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="#1C212B">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7"
                                                         Fill="{Binding StatusBadgeColor, Converter={StaticResource HexToBrushConverter}}"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StatusBadgeText}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTextPrimary}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Description -->
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="12"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               Margin="0,3,0,6"
                                               Visibility="{Binding Description, Converter={StaticResource NullOrEmptyToVisConverter}}" />

                                    <!-- Paths Info -->
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="Profile Dir: "
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}" />
                                        <TextBlock Text="{Binding EffectiveProfilePath}"
                                                   FontFamily="{StaticResource FontMono}"
                                                   FontSize="11"
                                                   Foreground="#93C5FD" />
                                        
                                        <TextBlock Text="  •  Workspace: "
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding DisplayWorkspace}"
                                                   FontFamily="{StaticResource FontMono}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushTextSecondary}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Column 3: Actions -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Launch Button -->
                                    <Button Command="{Binding LaunchCommand}"
                                            CommandParameter="{Binding DataContext.SelectedTerminal, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="14,6"
                                            Margin="0,0,8,0"
                                            ToolTip="Launch Antigravity CLI session in selected terminal">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▶ Launch agy" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Copy CLI Command -->
                                    <Button Command="{Binding CopyCliSnippetCommand}"
                                            CommandParameter="{Binding DataContext.SelectedTerminal, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource ModernButton}"
                                            Content="📋 Copy"
                                            Margin="0,0,6,0"
                                            ToolTip="Copy isolated terminal launch command to clipboard" />

                                    <!-- Open Profile Folder -->
                                    <Button Command="{Binding OpenProfileFolderCommand}"
                                            Style="{StaticResource ModernButton}"
                                            Content="📁 Folder"
                                            Margin="0,0,6,0"
                                            ToolTip="Open profile directory in Windows Explorer" />

                                    <!-- Edit -->
                                    <Button Command="{Binding RequestEditCommand}"
                                            Style="{StaticResource ModernButton}"
                                            Content="✏️"
                                            Margin="0,0,6,0"
                                            ToolTip="Edit profile settings" />

                                    <!-- Delete -->
                                    <Button Command="{Binding RequestDeleteCommand}"
                                            Style="{StaticResource DangerButton}"
                                            Content="🗑️"
                                            ToolTip="Remove profile" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 5. Bottom Status Strip -->
        <Border Grid.Row="4"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushCardBorder}"
                BorderThickness="0,1,0,0"
                Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- agy detected status -->
                    <ColumnDefinition Width="*" />
                    <!-- Terminal selector -->
                    <ColumnDefinition Width="Auto" />
                    <!-- App data folder -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Detected agy path -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             Fill="{Binding IsAgyInstalled, Converter={StaticResource BoolToVisConverter}}"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#10B981" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAgyInstalled}" Value="False">
                                        <Setter Property="Fill" Value="#EF4444" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="Antigravity CLI: " FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                    <TextBlock Text="{Binding DetectedAgyPath, FallbackValue='Not found in PATH'}"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="11"
                               Foreground="{StaticResource BrushTextSecondary}" />
                </StackPanel>

                <!-- Center: Terminal selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="Launch Terminal: " FontSize="12" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox SelectedValue="{Binding SelectedTerminal}"
                              Style="{StaticResource ModernComboBox}"
                              Width="180">
                        <models:TerminalType>WindowsTerminal</models:TerminalType>
                        <models:TerminalType>PowerShell</models:TerminalType>
                        <models:TerminalType>CommandPrompt</models:TerminalType>
                    </ComboBox>
                </StackPanel>

                <!-- Right: Config folder link -->
                <Button Grid.Column="2"
                        Content="Open AppData"
                        Command="{Binding OpenAppDataFolderCommand}"
                        Style="{StaticResource ModernButton}"
                        Padding="10,4"
                        FontSize="11"
                        ToolTip="Open %APPDATA%\AgyAccountSwarm" />
            </Grid>
        </Border>
    </Grid>
</Window>

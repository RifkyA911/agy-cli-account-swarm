                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="24H TOTAL TURNS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                            <TextBlock Text="{Binding HeatmapTotal24hPrompts}" FontSize="15" FontWeight="Bold" Foreground="#3B82F6" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="ACTIVE WINDOW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                            <TextBlock Text="{Binding HeatmapActiveWindow}" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="AVG HOURLY RATE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                            <TextBlock Text="{Binding HeatmapAveragePerHour}" FontSize="15" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Heatmap Canvas Surface (Height 280 with Y-Axis and Headroom) -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="14,14,14,10" Height="280">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Left Y-Axis Scale -->
                                            <ColumnDefinition Width="38" />
                                            <!-- Heatmap Plot Area -->
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Y-Axis Labels -->
                                        <Grid Grid.Column="0" Margin="0,12,6,34">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding HeatmapYTick100}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <TextBlock Grid.Row="1" Text="{Binding HeatmapYTick75}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <TextBlock Grid.Row="2" Text="{Binding HeatmapYTick50}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <TextBlock Grid.Row="3" Text="{Binding HeatmapYTick25}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <TextBlock Grid.Row="4" Text="{Binding HeatmapYTick0}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                        </Grid>

                                        <!-- Plot Canvas Area with Gridlines and Bars -->
                                        <Grid Grid.Column="1">
                                            <!-- Horizontal Dashed Gridlines -->
                                            <Grid Margin="0,18,0,38">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,1,0,0" Opacity="0.5" />
                                                <Border Grid.Row="1" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,1,0,0" Opacity="0.5" />
                                                <Border Grid.Row="2" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,1,0,0" Opacity="0.5" />
                                                <Border Grid.Row="3" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,1,0,0" Opacity="0.5" />
                                            </Grid>

                                            <!-- 24-Hour Bars Stack -->
                                            <ItemsControl ItemsSource="{Binding HourlyHeatmap}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Width="32" Margin="3,0" VerticalAlignment="Bottom" Cursor="Hand">
                                                            <StackPanel.ToolTip>
                                                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                                                                    <TextBlock Text="{Binding Tooltip}" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                </Border>
                                                            </StackPanel.ToolTip>

                                                            <!-- Prompt count label shown if > 0 (always safely below the ceiling!) -->
                                                            <TextBlock Text="{Binding PromptCount}"
                                                                       Visibility="{Binding PromptCount, Converter={StaticResource IntToVisConverter}}"
                                                                       FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"
                                                                       HorizontalAlignment="Center" Margin="0,0,0,4" />

                                                            <!-- Heatmap Bar -->
                                                            <Border Height="{Binding Height}" Width="20" CornerRadius="4,4,0,0"
                                                                    Background="{Binding Color, Converter={StaticResource HexToBrushConverter}}"
                                                                    HorizontalAlignment="Center" />

                                                            <!-- Hour Label (X-Axis) -->
                                                            <TextBlock Text="{Binding HourLabel}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource BrushTextMuted}"
                                                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Section 3: Account Quota & Health Status (Revamped Spacious Layout) -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="{Binding Strings[Analytics_AccountHealth]}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <TextBlock Text="Detailed quota allocation, real-time rate limit consumption &amp; health telemetry" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding SwarmHealthRecords}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <!-- Row 1: Identity & Badges & Reset Countdown -->
                                                        <RowDefinition Height="Auto" />
                                                        <!-- Row 2: Full Width Progress Bar & Usage Metrics -->
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Row 1: Identity & Status -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Left: Avatar + Names + Badges -->
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- Mini Avatar Initial Badge -->
                                                            <Border Width="34" Height="34" CornerRadius="17"
                                                                    Background="{Binding TierColor, Converter={StaticResource HexToBrushConverter}}"
                                                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding AvatarInitial}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>

                                                            <!-- Name & Email -->
                                                            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                                                <TextBlock Text="{Binding AccountName}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                <TextBlock Text="{Binding AccountEmail}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,1,0,0" />
                                                            </StackPanel>

                                                            <!-- Tier Badge -->
                                                            <Border CornerRadius="5" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                    Background="{Binding TierColor, Converter={StaticResource HexToBrushConverter}}">
                                                                <TextBlock Text="{Binding Tier}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                            </Border>

                                                            <!-- Model Badge -->
                                                            <Border CornerRadius="5" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                    Background="{DynamicResource BrushModelBadgeBg}"
                                                                    BorderBrush="{DynamicResource BrushModelBadgeBorder}" BorderThickness="1">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="🧠 " FontSize="10" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding CurrentModel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushModelBadgeText}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Health Status Badge -->
                                                            <Border CornerRadius="5" Padding="9,3" VerticalAlignment="Center"
                                                                    Background="{Binding StatusColor, Converter={StaticResource HexToBrushConverter}}">
                                                                <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Right: Reset Countdown -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding QuotaResetCountdown}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding WeeklySummary}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Row 2: Full-Width Usage Meter & Detailed Prompt Count -->
                                                    <Grid Grid.Row="1">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid Grid.Row="0" Margin="0,0,0,5">
                                                            <TextBlock Text="{Binding TodayQuotaFormatted}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Left" />
                                                            <TextBlock Text="{Binding UsagePercent, StringFormat='{}{0:F1}% of daily quota consumed'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" />
                                                        </Grid>

                                                        <ProgressBar Grid.Row="1" Value="{Binding UsagePercent, Mode=OneWay}" Height="7"
                                                                     Minimum="0" Maximum="100" Background="{DynamicResource BrushProgressTrack}"
                                                                     Foreground="{Binding StatusColor, Converter={StaticResource HexToBrushConverter}}"
                                                                     BorderThickness="0" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Bottom Breathing Room Spacer -->
                        <Border Height="60" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================================================== -->
                <!-- VIEW 4: MCP TOOLS (/mcp)                                       -->
                <!-- ============================================================== -->
                <Grid Grid.Row="1"
                      Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Mcp}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="24,12">
                        <Grid>
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Strings[Mcp_Title]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="{Binding Strings[Mcp_Subtitle]}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding LoadMcpServersCommand}" Style="{StaticResource ModernButton}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔄 " />
                                        <TextBlock Text="{Binding Strings[Mcp_Reload]}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding McpServers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                        <Border Background="{DynamicResource BrushBadgeBg}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                                        </Border>
                                                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ToolsCount, StringFormat='{}{0} tools discovered'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,8" />
                                                    <Border Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="10,6" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Arguments}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushMonoPath}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ============================================================== -->
                <!-- VIEW 5: DOCUMENTATION (/docs)                                  -->
                <!-- ============================================================== -->
                <Grid Grid.Row="1"
                      Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Docs}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Docs Header Tabs -->
                    <Border Grid.Row="0" Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="24,12">
                        <Grid>
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Strings[Docs_Title]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="{Binding Strings[Docs_Subtitle]}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Architecture" Command="{Binding SelectDocTabCommand}" CommandParameter="Architecture" Style="{StaticResource ModernButton}" Margin="0,0,4,0" Padding="10,5" />
                                <Button Content="Swarm Workflow" Command="{Binding SelectDocTabCommand}" CommandParameter="SwarmWorkflow" Style="{StaticResource ModernButton}" Margin="0,0,4,0" Padding="10,5" />
                                <Button Content="Data &amp; Configs" Command="{Binding SelectDocTabCommand}" CommandParameter="DataStorage" Style="{StaticResource ModernButton}" Margin="0,0,4,0" Padding="10,5" />
                                <Button Content="MCP Guide" Command="{Binding SelectDocTabCommand}" CommandParameter="McpGuide" Style="{StaticResource ModernButton}" Padding="10,5" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Docs Content Area -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                        <StackPanel MaxWidth="920" HorizontalAlignment="Center">
                            <!-- TAB 1: Architecture -->
                            <StackPanel Visibility="{Binding SelectedDocTab, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Architecture}">
                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="System Architecture &amp; Process Isolation" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10" />
                                        <TextBlock Text="Agy CLI Account Swarm is designed to completely sandbox separate Google / Gemini AI accounts on a single Windows machine without cross-contaminating OAuth credentials, memory caches, or rate limits." FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,14" />

                                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="6" Padding="16" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="Core Architectural Components:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8" />
                                                <TextBlock Text="• Virtual User Profile Directory (%USERPROFILE% and %HOME% redirected per worker)" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2" />
                                                <TextBlock Text="• Dedicated .gemini/ directory per worker containing antigravity-oauth-token &amp; history.jsonl" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2" />
                                                <TextBlock Text="• Multi-session Terminal Multiplexer supporting Windows Terminal Split Panes or separate tabs" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2" />
                                                <TextBlock Text="• Background Rate-Limit Sentinel tracking real turn counts against subscription quotas" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2" />
                                                <TextBlock Text="• Model Context Protocol (MCP) Tool Bridge communicating via stdio IPC" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2" />
                                            </StackPanel>
                                        </Border>

                                        <Button Content="🌐 Open Interactive Architecture Spec in Browser" Command="{Binding OpenDocInBrowserCommand}" CommandParameter="Architecture" Style="{StaticResource PrimaryButton}" Padding="14,8" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- TAB 2: Swarm Workflow -->
                            <StackPanel Visibility="{Binding SelectedDocTab, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=SwarmWorkflow}">
                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Parallel Swarm Launch Workflow" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10" />
                                        <TextBlock Text="When you trigger '⚡ Launch Swarm', the application executes the following deterministic lifecycle:" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,14" />
                                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="6" Padding="16" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="1. Directory Preparation: Creates isolated profile folder if non-existent." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4" />
                                                <TextBlock Text="2. Script Injection: Writes isolated 'run-agy.cmd' configuring clean USERPROFILE environment variables." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4" />
                                                <TextBlock Text="3. Process Invocation: Spawns Windows Terminal (wt.exe) with split-pane or new-tab arguments." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4" />
                                                <TextBlock Text="4. Telemetry Loop: Polls real history.jsonl updates and refreshes active model session telemetry." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4" />
                                            </StackPanel>
                                        </Border>

                                        <Button Content="🌐 Open Interactive Swarm Lifecycle in Browser" Command="{Binding OpenDocInBrowserCommand}" CommandParameter="SwarmWorkflow" Style="{StaticResource PrimaryButton}" Padding="14,8" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- TAB 3: Data & Configs -->
                            <StackPanel Visibility="{Binding SelectedDocTab, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=DataStorage}">
                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Local Storage &amp; Database Layout" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10" />
                                        <TextBlock Text="No external cloud database is required. All state is maintained locally in human-readable JSON files:" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,14" />
                                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="%APPDATA%\AgyAccountSwarm\profiles.json -> List of account profiles &amp; tiers" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushMonoPath}" Margin="0,3" />
                                                <TextBlock Text="%APPDATA%\AgyAccountSwarm\settings.json -> Terminal &amp; language preferences" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushMonoPath}" Margin="0,3" />
                                                <TextBlock Text="%APPDATA%\AgyAccountSwarm\app.log -> High-precision diagnostic execution logs" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushMonoPath}" Margin="0,3" />
                                                <TextBlock Text="~/.gemini-profiles/{id}/.gemini/ -> Isolated Google auth tokens &amp; history.jsonl" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushMonoPath}" Margin="0,3" />
                                            </StackPanel>
                                        </Border>

                                        <Button Content="🌐 Open Database Schemas &amp; DDL/DML Reference in Browser" Command="{Binding OpenDocInBrowserCommand}" CommandParameter="DataStorage" Style="{StaticResource PrimaryButton}" Padding="14,8" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- TAB 4: MCP Guide -->
                            <StackPanel Visibility="{Binding SelectedDocTab, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=McpGuide}">
                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="Model Context Protocol (MCP) Guide" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10" />
                                        <TextBlock Text="Antigravity AI utilizes the open Model Context Protocol to dynamically discover tools from external language servers, database connectors, and web services. MCP servers run via standard IO (stdio) and expose callable JSON schemas." FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,14" />

                                        <Button Content="🌐 Open Complete MCP Protocol Specification in Browser" Command="{Binding OpenDocInBrowserCommand}" CommandParameter="McpGuide" Style="{StaticResource PrimaryButton}" Padding="14,8" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ============================================================== -->
                <!-- VIEW 6: LOGS (/logs)                                           -->
                <!-- ============================================================== -->
                <Grid Grid.Row="1"
                      Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Logs}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="24,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding LogSearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" ToolTip="Filter log lines..." />
                            <ComboBox Grid.Column="1" SelectedValue="{Binding SelectedLogLevel}" Style="{StaticResource ModernComboBox}" Margin="10,0,0,0">
                                <ComboBoxItem Content="ALL" />
                                <ComboBoxItem Content="INFO" />
                                <ComboBoxItem Content="WARN" />
                                <ComboBoxItem Content="ERROR" />
                            </ComboBox>

                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Content="Refresh" Command="{Binding LoadLogsCommand}" Style="{StaticResource ModernButton}" Margin="0,0,8,0" />
                                <Button Content="Copy Logs" Command="{Binding CopyLogsCommand}" Style="{StaticResource ModernButton}" Margin="0,0,8,0" />
                                <Button Content="Open in Editor" Command="{Binding OpenLogFileCommand}" Style="{StaticResource ModernButton}" Margin="0,0,8,0" />
                                <Button Content="Clear" Command="{Binding ClearLogsCommand}" Style="{StaticResource DangerButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBox Grid.Row="1"
                             Text="{Binding LogContent, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="{StaticResource FontMono}"
                             FontSize="12"
                             Background="{DynamicResource BrushBg}"
                             Foreground="{DynamicResource BrushTextPrimary}"
                             BorderThickness="0"
                             Padding="20"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </Grid>

                <!-- ============================================================== -->
                <!-- VIEW 7: SETTINGS (/settings) - CENTERED MODERN CARDS           -->
                <!-- ============================================================== -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,24,24,60"
                              Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Settings}">
                    <!-- Centered Settings Cards Stack -->
                    <StackPanel MaxWidth="840" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Strings[Settings_Title]}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Strings[Settings_Subtitle]}"
                                   FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,20" HorizontalAlignment="Center" />

                        <!-- Group 1: Language & Locale -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="🌐 " FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Strings[Settings_Language]}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Select your preferred application display language." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,12" />
                                <ComboBox ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding SelectedLanguageOption}"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource ModernComboBox}"
                                          Width="260"
                                          HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <!-- Group: Appearance & Color Palette -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="🎨 " FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Theme Appearance &amp; Color Palette" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Choose your preferred color palette. Surface contrasts, glowing badges, and borders are mathematically calibrated for maximum readability." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,16" />

                                <!-- 5 Rich Theme Palette Cards Grid -->
                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                    <!-- Card 1: System (Auto OS) -->
                                    <Button Command="{Binding SetThemeCommand}" CommandParameter="System"
                                            Style="{StaticResource ModernButton}" Margin="0,0,8,12" Padding="14,12" HorizontalContentAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Ellipse Width="14" Height="14" Fill="#0F1115" Stroke="#334155" StrokeThickness="1.5" Margin="0,0,4,0" />
                                                <Ellipse Width="14" Height="14" Fill="#FFFFFF" Stroke="#94A3B8" StrokeThickness="1.5" Margin="0,0,4,0" />
                                                <Ellipse Width="14" Height="14" Fill="#38BDF8" Margin="0,0,4,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="🖥️ System (Auto OS)" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Syncs with Windows dark/light mode" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Card 2: Obsidian Dark -->
                                    <Button Command="{Binding SetThemeCommand}" CommandParameter="Dark"
                                            Style="{StaticResource ModernButton}" Margin="0,0,0,12" Padding="14,12" HorizontalContentAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Ellipse Width="14" Height="14" Fill="#090D16" Stroke="#1E293B" StrokeThickness="1.5" Margin="0,0,4,0" />
                                                <Ellipse Width="14" Height="14" Fill="#1E293B" Margin="0,0,4,0" />
                                                <Ellipse Width="14" Height="14" Fill="#38BDF8" Margin="0,0,4,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="🌙 Obsidian Dark" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Deep midnight navy with electric cyan" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Card 3: Daylight Clean -->
                                    <Button Command="{Binding SetThemeCommand}" CommandParameter="Light"
                                            Style="{StaticResource ModernButton}" Margin="0,0,8,12" Padding="14,12" HorizontalContentAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Ellipse Width="14" Height="14" Fill="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1.5" Margin="0,0,4,0" />
                                                <Ellipse Width="14" Height="14" Fill="#FFFFFF" Stroke="#CBD5E1" StrokeThickness="1.5" Margin="0,0,4,0" />
                                                <Ellipse Width="14" Height="14" Fill="#0284C7" Margin="0,0,4,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="☀️ Daylight Clean" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Crisp white surface with cerulean blue" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Card 4: Cyberpunk Neon -->
                                    <Button Command="{Binding SetThemeCommand}" CommandParameter="Cyberpunk"
                                            Style="{StaticResource ModernButton}" Margin="0,0,0,12" Padding="14,12" HorizontalContentAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Ellipse Width="14" Height="14" Fill="#0C0A1D" Stroke="#2D1B4E" StrokeThickness="1.5" Margin="0,0,4,0" />
                                                <Ellipse Width="14" Height="14" Fill="#1A1435" Margin="0,0,4,0" />
                                                <Ellipse Width="14" Height="14" Fill="#EC4899" Margin="0,0,4,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="🔮 Cyberpunk Neon" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Neon pink, ultraviolet &amp; cyber blue" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Card 5: Matrix Emerald -->
                                    <Button Command="{Binding SetThemeCommand}" CommandParameter="Matrix"
                                            Style="{StaticResource ModernButton}" Margin="0,0,8,0" Padding="14,12" HorizontalContentAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Ellipse Width="14" Height="14" Fill="#05130B" Stroke="#0B2B18" StrokeThickness="1.5" Margin="0,0,4,0" />
                                                <Ellipse Width="14" Height="14" Fill="#0B2014" Margin="0,0,4,0" />
                                                <Ellipse Width="14" Height="14" Fill="#10B981" Margin="0,0,4,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="📟 Matrix Emerald" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Terminal phosphor green with CRT glow" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Group 2: Terminal Launcher & Execution -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="💻 " FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Strings[Settings_TerminalGroup]}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Preferred Terminal -->
                                <TextBlock Text="Preferred Terminal Emulator" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                <TextBlock Text="Select which console window launches the isolated agy sessions." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,6" />
                                <ComboBox SelectedValue="{Binding SelectedTerminal}" Style="{StaticResource ModernComboBox}" Width="260" HorizontalAlignment="Left" Margin="0,0,0,14">
                                    <models:TerminalType>WindowsTerminal</models:TerminalType>
                                    <models:TerminalType>PowerShell</models:TerminalType>
                                    <models:TerminalType>CommandPrompt</models:TerminalType>
                                </ComboBox>

                                <!-- Swarm Mode -->
                                <TextBlock Text="Swarm Window Arrangement" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                <TextBlock Text="Choose how multiple parallel workers are arranged when Launch Swarm is clicked." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,6" />
                                <ComboBox SelectedValue="{Binding SelectedSwarmMode}" Style="{StaticResource ModernComboBox}" Width="260" HorizontalAlignment="Left" Margin="0,0,0,14">
                                    <models:SwarmLaunchMode>SplitPanes</models:SwarmLaunchMode>
                                    <models:SwarmLaunchMode>SeparateTabs</models:SwarmLaunchMode>
                                    <models:SwarmLaunchMode>SeparateWindows</models:SwarmLaunchMode>
                                </ComboBox>

                                <!-- Custom agy executable path -->
                                <TextBlock Text="Antigravity CLI Binary Path" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                <TextBlock Text="Automatically discovered or custom path to the 'agy' executable." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,6" />
                                <TextBox Text="{Binding DetectedAgyPath}" Style="{StaticResource ModernTextBox}" />
                            </StackPanel>
                        </Border>

                        <!-- Group 3: System Tray & Window Lifecycle -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="🛡️ " FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Strings[Settings_TrayGroup]}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="Window Close [✕] Behavior" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                                <TextBlock Text="Choose what happens when the titlebar close button [✕] is clicked." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8" />

                                <StackPanel Margin="0,0,0,14">
                                    <RadioButton GroupName="CloseActionGroup"
                                                 IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                                                 Style="{StaticResource ModernRadioButton}"
                                                 Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📥 Minimize to System Tray" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                            <TextBlock Text=" (Runs silently in background with tray icon &amp; periodic sync)" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="CloseActionGroup"
                                                 IsChecked="{Binding ExitOnClose, Mode=TwoWay}"
                                                 Style="{StaticResource ModernRadioButton}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🛑 Exit Application Completely" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                            <TextBlock Text=" (Closes all background threads and terminates swarm immediately)" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>

                                <Separator Background="{DynamicResource BrushBorder}" Margin="0,0,0,12" />

                                <TextBlock Text="Window Minimize [🗕] Behavior" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                                <CheckBox IsChecked="{Binding MinimizeToTray}" Style="{StaticResource ModernCheckBox}"
                                          Content="Minimize button [🗕] hides window to system tray instead of taskbar" Margin="0,4,0,6" />
                            </StackPanel>
                        </Border>

                        <!-- Group 4: Audio Feedback & Haptics -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="🎵 " FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Strings[Settings_AudioGroup]}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>

                                <CheckBox IsChecked="{Binding SoundEnabled}" Style="{StaticResource ModernCheckBox}"
                                          Content="Enable synthesized audio tones on user transactions (clicks, launches, chimes)" Margin="0,0,0,8" />

                                <CheckBox IsChecked="{Binding AutoSyncAudioEnabled}" Style="{StaticResource ModernCheckBox}"
                                          Content="Play subtle droplet chime when periodic auto-sync completes in background" Margin="0,0,0,14" />

                                <TextBlock Text="Test Sound Effects:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding ReplayWelcomeCommand}" Style="{StaticResource ModernButton}" Content="🐱 Fluffy Purr (Welcome)" Margin="0,0,8,0" Padding="12,6" />
                                    <Button Command="{Binding TestQuotaAlertCommand}" Style="{StaticResource DangerButton}" Content="🚨 Quota Exhausted Alert" Margin="0,0,8,0" Padding="12,6" />
                                    <Button Command="{Binding SyncSwarmCommand}" Style="{StaticResource ModernButton}" Content="🔄 Sync Droplet Chime" Padding="12,6" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Group 5: About & Open Source Credits -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="⭐ " FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Strings[Settings_AboutGroup]}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="Agy CLI Account Swarm is a high-performance, open-source orchestration tool for Google Antigravity CLI users."
                                           FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" LineHeight="18" Margin="0,0,0,12" />

                                <Border Background="{DynamicResource BrushSurface}" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Created &amp; Maintained by:" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                                            <TextBlock Text="RifkyA911 (https://github.com/RifkyA911)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,4" />
                                            <TextBlock Text="Licensed under MIT License — Open for community contributions &amp; portfolio showcase." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Button Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/RifkyA911" Style="{StaticResource PrimaryButton}" Content="GitHub Profile" Padding="12,6" Margin="0,0,8,0" />
                                            <Button Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/RifkyA911/agy-cli-account-swarm" Style="{StaticResource ModernButton}" Content="Repository" Padding="12,6" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Group 6: Periodic Auto-Sync & Diagnostics Loop -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="🔄 " FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Periodic Swarm &amp; MCP Auto-Sync" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Automatically recalculate real token consumption, probe active model presence, and scan MCP tool servers in the background."
                                           FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Auto-Sync Interval:" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ComboBox ItemsSource="{Binding AutoSyncOptions}" SelectedItem="{Binding AutoSyncInterval}" Style="{StaticResource ModernComboBox}" Width="180" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Group 7: Storage & Diagnostics -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="📁 " FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Strings[Settings_StorageGroup]}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Profiles and application settings are persisted in local app data:" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Open AppData Folder" Command="{Binding OpenAppDataFolderCommand}" Style="{StaticResource ModernButton}" Margin="0,0,10,0" Padding="14,7" />
                                    <Button Content="Open Application Log" Command="{Binding OpenLogFileCommand}" Style="{StaticResource ModernButton}" Padding="14,7" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Bottom Breathing Room Spacer -->
                        <Border Height="60" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============================================================== -->
        <!-- FLUID 3-SECOND CAT GREETING OVERLAY (Starts up gracefully)      -->
        <!-- ============================================================== -->
        <Border Background="#E60A0C10"
                Panel.ZIndex="999"
                Cursor="Hand"
                Visibility="{Binding IsWelcomeOverlayVisible, Converter={StaticResource BoolToVisConverter}}">
            <Border.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding DismissWelcomeOverlayCommand}" />
            </Border.InputBindings>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{DynamicResource BrushCard}"
                        BorderBrush="{DynamicResource BrushCardBorder}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="36,28"
                        Width="440">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Cute Vector Cat Illustration -->
                        <Canvas Width="100" Height="90" Margin="0,0,0,16">
                            <!-- Cat Face / Head -->
                            <Path Data="M 15,35 Q 20,10 32,25 Q 50,22 68,25 Q 80,10 85,35 Q 92,60 80,75 Q 50,88 20,75 Q 8,60 15,35 Z"
                                  Fill="#3B82F6" Stroke="#60A5FA" StrokeThickness="2" />

                            <!-- Cat Left Ear Inner -->
                            <Path Data="M 23,30 Q 25,18 32,25 Z" Fill="#F472B6" />

                            <!-- Cat Right Ear Inner -->
                            <Path Data="M 77,30 Q 75,18 68,25 Z" Fill="#F472B6" />

                            <!-- Eyes -->
                            <Ellipse Canvas.Left="33" Canvas.Top="42" Width="8" Height="10" Fill="#FFFFFF" />
                            <Ellipse Canvas.Left="35" Canvas.Top="44" Width="4" Height="6" Fill="#0F172A" />

                            <Ellipse Canvas.Left="59" Canvas.Top="42" Width="8" Height="10" Fill="#FFFFFF" />
                            <Ellipse Canvas.Left="61" Canvas.Top="44" Width="4" Height="6" Fill="#0F172A" />

                            <!-- Nose & Smiling Mouth -->
                            <Path Data="M 48,55 L 52,55 L 50,58 Z" Fill="#F472B6" />
                            <Path Data="M 44,60 Q 50,64 50,60 Q 50,64 56,60" Stroke="#FFFFFF" StrokeThickness="1.5" Fill="Transparent" />

                            <!-- Cute Cheeks -->
                            <Ellipse Canvas.Left="26" Canvas.Top="54" Width="8" Height="5" Fill="#F472B6" Opacity="0.5" />
                            <Ellipse Canvas.Left="66" Canvas.Top="54" Width="8" Height="5" Fill="#F472B6" Opacity="0.5" />

                            <!-- Whiskers -->
                            <Line X1="10" Y1="50" X2="24" Y2="52" Stroke="#93C5FD" StrokeThickness="1.5" />
                            <Line X1="10" Y1="58" X2="24" Y2="56" Stroke="#93C5FD" StrokeThickness="1.5" />
                            <Line X1="90" Y1="50" X2="76" Y2="52" Stroke="#93C5FD" StrokeThickness="1.5" />
                            <Line X1="90" Y1="58" X2="76" Y2="56" Stroke="#93C5FD" StrokeThickness="1.5" />

                            <!-- Waving Paws -->
                            <Ellipse Canvas.Left="22" Canvas.Top="72" Width="16" Height="14" Fill="#60A5FA" />
                            <Ellipse Canvas.Left="62" Canvas.Top="72" Width="16" Height="14" Fill="#60A5FA" />
                        </Canvas>

                        <!-- Greeting Title -->
                        <TextBlock Text="Meow! Welcome back"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   HorizontalAlignment="Center" />

                        <!-- Subtitle -->
                        <TextBlock Text="Antigravity CLI Account Swarm initialized."
                                   FontSize="13"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,16" />

                        <!-- Status pill -->
                        <Border Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushCardBorder}"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="14,6"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="All isolated environments ready" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                            </StackPanel>
                        </Border>

                        <!-- Dismiss hint -->
                        <TextBlock Text="Click anywhere to continue"
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextMuted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

                                            <ComboBox ItemsSource="{Binding TierFilterOptions}"
                                                      SelectedItem="{Binding SelectedTierFilter}"
                                                      Style="{StaticResource ModernComboBox}"
                                                      Width="110" />
                                        </StackPanel>
                                    </WrapPanel>
                                </Border>

                                <!-- Visual Interactive Tall Canvas Area (Height 360) -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="14,14,14,10" Height="360">
                                    <Grid>
                                        <!-- No Data Placeholder (When genuinely 0 prompts) -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasChartData, Converter={StaticResource InverseBoolToVisConverter}}">
                                            <TextBlock Text="📭" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock Text="No Telemetry Activity Recorded" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" />
                                            <TextBlock Text="There are 0 prompt executions matching the selected account sandbox, model, and timeframe." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Chart with Y-Axis, Horizontal Gridlines, and Horizontal ScrollViewer -->
                                        <Grid Visibility="{Binding HasChartData, Converter={StaticResource BoolToVisConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <!-- Left Y-Axis Scale -->
                                                <ColumnDefinition Width="42" />
                                                <!-- Plot Canvas & ScrollViewer Area -->
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Y-Axis Labels -->
                                            <Grid Grid.Column="0" Margin="0,18,6,38">

<Window x:Class="AgyAccountSwarm.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AgyAccountSwarm.ViewModels"
        xmlns:models="clr-namespace:AgyAccountSwarm.Models"
        Title="Agy CLI Account Swarm — Antigravity CLI Orchestrator (MIT Open Source)"
        Icon="../Resources/favicon.ico"
        Height="760" Width="1240"
        MinHeight="640" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Window.Resources>
        <LinearGradientBrush x:Key="AreaChartGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#708B5CF6" Offset="0.0" />
            <GradientStop Color="#203B82F6" Offset="0.75" />
            <GradientStop Color="#000F1115" Offset="1.0" />
        </LinearGradientBrush>
    </Window.Resources>

    <Grid>
        <!-- ============================================================== -->
        <!-- MAIN APP LAYOUT (Sidebar + Main Content Area)                 -->
        <!-- ============================================================== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar Navigation -->
                <ColumnDefinition Width="{Binding SidebarColumnWidth}" />
                <!-- Main Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- 1. LEFT SIDEBAR NAVIGATION                 -->
            <!-- ========================================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushCardBorder}"
                    BorderThickness="0,0,1,0"
                    Padding="10,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- App Logo, Title & Sidebar Toggle -->
                        <RowDefinition Height="Auto" />
                        <!-- Navigation Menu -->
                        <RowDefinition Height="*" />
                        <!-- Bottom Controls: Sound, Theme, Status -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header / Branding & Collapse Toggle -->
                    <Grid Grid.Row="0" Margin="4,0,4,22">
                        <!-- Expanded Header -->
                        <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="../Resources/favicon.ico" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Agy CLI Swarm"
                                               FontSize="14.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource BrushTextPrimary}" />
                                    <TextBlock Text="Account Orchestrator"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource BrushTextMuted}" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding ToggleSidebarCommand}"
                                    Style="{StaticResource ModernButton}"
                                    Padding="6,5"
                                    ToolTip="Collapse Sidebar">
                                <Path Data="{StaticResource HeroIconBars3}"
                                      Stroke="{DynamicResource BrushTextSecondary}"
                                      StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                            </Button>
                        </Grid>

                        <!-- Collapsed Header -->
                        <Button Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisConverter}}"
                                Command="{Binding ToggleSidebarCommand}"
                                Style="{StaticResource ModernButton}"
                                Padding="8,6"
                                HorizontalAlignment="Center"
                                ToolTip="Expand Sidebar">
                            <StackPanel HorizontalAlignment="Center">
                                <Image Source="../Resources/favicon.ico" Width="24" Height="24" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <Path Data="{StaticResource HeroIconBars3}"
                                      Stroke="{DynamicResource BrushTextSecondary}"
                                      StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Navigation Menu Items -->
                    <StackPanel Grid.Row="1">
                        <!-- /dashboard -->
                        <Border Background="{Binding CurrentPage, Converter={StaticResource PageToActiveBgConverter}, ConverterParameter=Dashboard}"
                                BorderBrush="{Binding CurrentPage, Converter={StaticResource PageToActiveBorderConverter}, ConverterParameter=Dashboard}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,4">
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                    Style="{StaticResource SidebarButton}"
                                    ToolTip="{Binding Strings[Nav_Dashboard]}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                            Background="#3B82F6" Margin="0,0,8,0"
                                            Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Dashboard}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconSquares2x2}"
                                              Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Dashboard}"
                                              StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="17" Height="17" Stretch="Uniform" Margin="2,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Strings[Nav_Dashboard]}"
                                                   FontSize="13"
                                                   FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Dashboard}"
                                                   Foreground="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Dashboard}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- /accounts -->
                        <Border Background="{Binding CurrentPage, Converter={StaticResource PageToActiveBgConverter}, ConverterParameter=Accounts}"
                                BorderBrush="{Binding CurrentPage, Converter={StaticResource PageToActiveBorderConverter}, ConverterParameter=Accounts}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,4">
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Accounts"
                                    Style="{StaticResource SidebarButton}"
                                    ToolTip="{Binding Strings[Nav_Accounts]}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                            Background="#3B82F6" Margin="0,0,8,0"
                                            Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Accounts}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconUsers}"
                                              Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Accounts}"
                                              StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="17" Height="17" Stretch="Uniform" Margin="2,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Strings[Nav_Accounts]}"
                                                   FontSize="13"
                                                   FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Accounts}"
                                                   Foreground="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Accounts}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource BrushBadgeBg}"
                                            BorderBrush="{DynamicResource BrushBadgeBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10" Padding="8,2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}">
                                        <TextBlock Text="{Binding TotalCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushBadgeText}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- /analytic -->
                        <Border Background="{Binding CurrentPage, Converter={StaticResource PageToActiveBgConverter}, ConverterParameter=Analytics}"
                                BorderBrush="{Binding CurrentPage, Converter={StaticResource PageToActiveBorderConverter}, ConverterParameter=Analytics}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,4">
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Analytics"
                                    Style="{StaticResource SidebarButton}"
                                    ToolTip="{Binding Strings[Nav_Analytics]}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                            Background="#3B82F6" Margin="0,0,8,0"
                                            Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Analytics}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconChartBar}"
                                              Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Analytics}"
                                              StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="17" Height="17" Stretch="Uniform" Margin="2,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Strings[Nav_Analytics]}"
                                                   FontSize="13"
                                                   FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Analytics}"
                                                   Foreground="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Analytics}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- /mcp -->
                        <Border Background="{Binding CurrentPage, Converter={StaticResource PageToActiveBgConverter}, ConverterParameter=Mcp}"
                                BorderBrush="{Binding CurrentPage, Converter={StaticResource PageToActiveBorderConverter}, ConverterParameter=Mcp}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,4">
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Mcp"
                                    Style="{StaticResource SidebarButton}"
                                    ToolTip="{Binding Strings[Nav_Mcp]}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                            Background="#3B82F6" Margin="0,0,8,0"
                                            Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Mcp}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconCpuChip}"
                                              Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Mcp}"
                                              StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="17" Height="17" Stretch="Uniform" Margin="2,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Strings[Nav_Mcp]}"
                                                   FontSize="13"
                                                   FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Mcp}"
                                                   Foreground="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Mcp}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource BrushBadgeBg}"
                                            BorderBrush="{DynamicResource BrushBadgeBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10" Padding="8,2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}">
                                        <TextBlock Text="{Binding McpServersCount}" FontSize="11" FontWeight="Bold" Foreground="#3B82F6" />
                                    </Border>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- /docs -->
                        <Border Background="{Binding CurrentPage, Converter={StaticResource PageToActiveBgConverter}, ConverterParameter=Docs}"
                                BorderBrush="{Binding CurrentPage, Converter={StaticResource PageToActiveBorderConverter}, ConverterParameter=Docs}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,4">
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Docs"
                                    Style="{StaticResource SidebarButton}"
                                    ToolTip="{Binding Strings[Nav_Docs]}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                            Background="#3B82F6" Margin="0,0,8,0"
                                            Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Docs}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconBookOpen}"
                                              Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Docs}"
                                              StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="17" Height="17" Stretch="Uniform" Margin="2,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Strings[Nav_Docs]}"
                                                   FontSize="13"
                                                   FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Docs}"
                                                   Foreground="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Docs}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- /logs -->
                        <Border Background="{Binding CurrentPage, Converter={StaticResource PageToActiveBgConverter}, ConverterParameter=Logs}"
                                BorderBrush="{Binding CurrentPage, Converter={StaticResource PageToActiveBorderConverter}, ConverterParameter=Logs}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,4">
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Logs"
                                    Style="{StaticResource SidebarButton}"
                                    ToolTip="{Binding Strings[Nav_Logs]}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                            Background="#3B82F6" Margin="0,0,8,0"
                                            Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Logs}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconCommandLine}"
                                              Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Logs}"
                                              StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="17" Height="17" Stretch="Uniform" Margin="2,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Strings[Nav_Logs]}"
                                                   FontSize="13"
                                                   FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Logs}"
                                                   Foreground="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Logs}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- /settings -->
                        <Border Background="{Binding CurrentPage, Converter={StaticResource PageToActiveBgConverter}, ConverterParameter=Settings}"
                                BorderBrush="{Binding CurrentPage, Converter={StaticResource PageToActiveBorderConverter}, ConverterParameter=Settings}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,4">
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                    Style="{StaticResource SidebarButton}"
                                    ToolTip="{Binding Strings[Nav_Settings]}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                            Background="#3B82F6" Margin="0,0,8,0"
                                            Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Settings}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconCog6Tooth}"
                                              Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Settings}"
                                              StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="17" Height="17" Stretch="Uniform" Margin="2,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Strings[Nav_Settings]}"
                                                   FontSize="13"
                                                   FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Settings}"
                                                   Foreground="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Settings}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>
                    </StackPanel>

                    <!-- Bottom Sidebar Controls -->
                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <Separator Background="{DynamicResource BrushCardBorder}" Margin="0,0,0,12" />

                        <!-- Expanded Bottom Controls -->
                        <StackPanel Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}">
                            <!-- Language Selector Dropdown -->
                            <Border Margin="0,0,0,6">
                                <ComboBox ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding SelectedLanguageOption}"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource ModernComboBox}"
                                          HorizontalAlignment="Stretch"
                                          ToolTip="Select Application Display Language" />
                            </Border>

                            <!-- Theme Appearance Palette Dropdown -->
                            <Border Margin="0,0,0,6">
                                <ComboBox ItemsSource="{Binding ThemeOptions}"
                                          SelectedItem="{Binding SelectedThemeOption}"
                                          Style="{StaticResource ModernComboBox}"
                                          HorizontalAlignment="Stretch"
                                          ToolTip="Select Theme Appearance Color Palette" />
                            </Border>

                            <!-- Sound Toggle -->
                            <Button Command="{Binding ToggleSoundCommand}"
                                    Style="{StaticResource SidebarButton}"
                                    Padding="8,6"
                                    Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔊 " FontSize="12" />
                                    <TextBlock Text="{Binding Strings[Label_Sound]}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <TextBlock Text=": " FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <TextBlock Text="ON" FontWeight="Bold" FontSize="12" Foreground="#10B981" Visibility="{Binding SoundEnabled, Converter={StaticResource BoolToVisConverter}}" />
                                    <TextBlock Text="MUTED" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Visibility="{Binding SoundEnabled, Converter={StaticResource InverseBoolToVisConverter}}" />
                                </StackPanel>
                            </Button>

                            <!-- CLI Status Pill -->
                            <Border Background="{DynamicResource BrushCard}"
                                    BorderBrush="{DynamicResource BrushCardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#10B981" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAgyInstalled}" Value="False">
                                                        <Setter Property="Fill" Value="#EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="CLI: " FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding Strings[Label_CliReady]}" FontSize="11" FontWeight="Bold" Foreground="#10B981" Visibility="{Binding IsAgyInstalled, Converter={StaticResource BoolToVisConverter}}" />
                                    <TextBlock Text="{Binding Strings[Label_CliMissing]}" FontSize="11" FontWeight="Bold" Foreground="#EF4444" Visibility="{Binding IsAgyInstalled, Converter={StaticResource InverseBoolToVisConverter}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Collapsed Bottom Controls (Compact Icon-Only) -->
                        <StackPanel Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisConverter}}" HorizontalAlignment="Center">
                            <Button Command="{Binding ToggleSoundCommand}"
                                    Style="{StaticResource ModernButton}"
                                    Padding="7,6"
                                    Margin="0,0,0,8"
                                    ToolTip="{Binding SoundEnabled, StringFormat='{}Sound: {0}'}">
                                <TextBlock Text="🔊" FontSize="13" />
                            </Button>
                            <Border Background="{DynamicResource BrushCard}"
                                    BorderBrush="{DynamicResource BrushCardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Width="26" Height="26"
                                    HorizontalAlignment="Center"
                                    ToolTip="Antigravity CLI Status">
                                <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#10B981" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAgyInstalled}" Value="False">
                                                    <Setter Property="Fill" Value="#EF4444" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- 2. MAIN CONTENT AREA                       -->
            <!-- ========================================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Top Toolbar & Alert Banners -->
                    <RowDefinition Height="Auto" />
                    <!-- Views Container -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Toolbar -->
                <StackPanel Grid.Row="0">
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushCardBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="24,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Current Page Title & Status -->
                                <ColumnDefinition Width="*" />
                                <!-- Action Buttons: Refresh/Sync & Swarm Launch -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Title based on navigation & Live Sync Dot -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentPage}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource BrushTextPrimary}" />
                                    <!-- Open Source MIT Badge (NO PRO!) -->
                                    <Border Background="{DynamicResource BrushBadgeBg}"
                                            BorderBrush="{DynamicResource BrushBadgeBorder}"
                                            BorderThickness="1"
                                            CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Strings[App_VersionBadge]}" Foreground="{DynamicResource BrushBadgeText}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>

                                    <!-- Live Pulsing Green Sync Dot -->
                                    <Grid Width="14" Height="14" Margin="12,0,4,0" VerticalAlignment="Center">
                                        <Ellipse Width="12" Height="12" Fill="#10B981" Opacity="0.3">
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.7" To="0.0" Duration="0:0:1.6" AutoReverse="False" />
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1.0" To="2.0" Duration="0:0:1.6" AutoReverse="False" />
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="1.0" To="2.0" Duration="0:0:1.6" AutoReverse="False" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform CenterX="6" CenterY="6" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse Width="6" Height="6" Fill="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Auto-Sync Status Badge -->
                                    <Border Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="SUCCESS • AUTO-SYNC ACTIVE" Foreground="#10B981" FontSize="10" FontWeight="Bold" />
                                    </Border>

                                    <!-- Last Synced Tag -->
                                    <Border Background="{DynamicResource BrushSurfaceHover}"
                                            BorderBrush="{DynamicResource BrushCardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LastSyncedAtText}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Strings[App_Subtitle]}"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Right CTA: Refresh/Sync and Launch Swarm -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Refresh / Sync Swarm Button -->
                                <Button Command="{Binding SyncSwarmCommand}"
                                        Style="{StaticResource ModernButton}"
                                        Padding="12,8"
                                        Margin="0,0,8,0"
                                        ToolTip="Check profile tokens, detect model sessions, and verify quota limits">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconArrowPath}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                              StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Strings[Btn_SyncSwarm]}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Launch Swarm Button -->
                                <Button Command="{Binding LaunchSwarmCommand}"
                                        Style="{StaticResource SwarmButton}"
                                        Padding="14,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconBolt}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Strings[Btn_LaunchSwarm]}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Text=" (" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedSwarmCount}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Text=")" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Quota Exhausted Warning Banner -->
                    <Border Background="{DynamicResource BrushQuotaExhaustedBg}"
                            BorderBrush="{DynamicResource BrushQuotaExhaustedBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="24,9"
                            Visibility="{Binding HasActiveQuotaAlert, Converter={StaticResource BoolToVisConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🚨 " FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding QuotaAlertMessage}"
                                           Foreground="{DynamicResource BrushQuotaExhaustedText}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{Binding Strings[Btn_Dismiss]}"
                                    Command="{Binding DismissQuotaAlertCommand}"
                                    Style="{StaticResource ModernButton}"
                                    Padding="10,4"
                                    FontSize="11" />
                        </Grid>
                    </Border>

                    <!-- Normal Notification Toast Banner -->
                    <Border Background="{DynamicResource BrushAlertBg}"
                            BorderBrush="{DynamicResource BrushAlertBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="24,8"
                            Visibility="{Binding NotificationMessage, Converter={StaticResource NullOrEmptyToVisConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="ℹ️ " VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NotificationMessage}"
                                       Foreground="{DynamicResource BrushAlertText}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============================================================== -->
                <!-- VIEW 1: DASHBOARD (/dashboard)                                 -->
                <!-- ============================================================== -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,24,24,60"
                              Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Dashboard}">
                    <StackPanel>
                        <!-- Top KPI Metrics Row -->
                        <UniformGrid Columns="5" Margin="0,0,0,20">
                            <!-- Card 1: Total Profiles -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings[Card_TotalAccounts]}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Strings[Card_TotalAccounts_Sub]}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Authenticated -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings[Card_Authenticated]}" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" />
                                    <TextBlock Text="{Binding AuthenticatedCount}" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Strings[Card_Authenticated_Sub]}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Swarm Targets -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings[Card_SwarmTargets]}" FontSize="10" FontWeight="SemiBold" Foreground="#3B82F6" />
                                    <TextBlock Text="{Binding SelectedSwarmCount}" FontSize="22" FontWeight="Bold" Foreground="#3B82F6" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Strings[Card_SwarmTargets_Sub]}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Total Prompts -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings[Card_TotalPrompts]}" FontSize="10" FontWeight="SemiBold" Foreground="#8B5CF6" />
                                    <TextBlock Text="{Binding TotalInteractionsCount}" FontSize="22" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Strings[Card_TotalPrompts_Sub]}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 5: Estimated Tokens -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings[Card_EstTokens]}" FontSize="10" FontWeight="SemiBold" Foreground="#F59E0B" />
                                    <TextBlock Text="{Binding TotalEstimatedTokens}" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Strings[Card_EstTokens_Sub]}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- ========================================== -->
                        <!-- DASHBOARD CHART (Bar, Line, Area Modes)    -->
                        <!-- ========================================== -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <!-- Chart Title & Action Row (Row 0) -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Chart Title & Subtitle -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Strings[Chart_Title]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="{Binding Strings[Chart_Subtitle]}" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Header Action Button -->
                                    <Button Grid.Column="1" Command="{Binding ExportPdfReportCommand}"
                                            Style="{StaticResource ModernButton}"
                                            Padding="12,7"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📥 " FontSize="12" />
                                            <TextBlock Text="Download PDF Report" FontWeight="SemiBold" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Dedicated Filter Toolbar Row (Row 1) -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                    <WrapPanel VerticalAlignment="Center">
                                        <!-- Chart Mode Switcher -->
                                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="📊 Bar" Command="{Binding SetChartModeCommand}" CommandParameter="Bar"
                                                        Style="{StaticResource ModernButton}" Padding="10,5" FontSize="12" Margin="0,0,2,0" />
                                                <Button Content="📈 Line" Command="{Binding SetChartModeCommand}" CommandParameter="Line"
                                                        Style="{StaticResource ModernButton}" Padding="10,5" FontSize="12" Margin="0,0,2,0" />
                                                <Button Content="🏔️ Area" Command="{Binding SetChartModeCommand}" CommandParameter="Area"
                                                        Style="{StaticResource ModernButton}" Padding="10,5" FontSize="12" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Zoom Controls -->
                                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="➖" Command="{Binding ChartZoomOutCommand}" Style="{StaticResource ModernButton}" Padding="7,4" FontSize="11" ToolTip="Zoom Out" Margin="0,0,2,0" />
                                                <TextBlock Text="{Binding ChartZoomText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="6,0" />
                                                <Button Content="➕" Command="{Binding ChartZoomInCommand}" Style="{StaticResource ModernButton}" Padding="7,4" FontSize="11" ToolTip="Zoom In" Margin="2,0,2,0" />
                                                <Button Content="100%" Command="{Binding ChartZoomResetCommand}" Style="{StaticResource ModernButton}" Padding="6,4" FontSize="10" ToolTip="Reset Zoom (100%)" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Account Filter -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="Account:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ComboBox ItemsSource="{Binding AccountFilterOptions}"
                                                      SelectedItem="{Binding SelectedAccountFilter}"
                                                      Style="{StaticResource ModernComboBox}"
                                                      Width="140" />
                                        </StackPanel>

                                        <!-- Period Filter -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Strings[Chart_Filter_Period]}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ComboBox ItemsSource="{Binding TimeframeOptions}"
                                                      SelectedItem="{Binding SelectedTimeframe}"
                                                      Style="{StaticResource ModernComboBox}"
                                                      Width="130" />
                                        </StackPanel>

                                        <!-- Model Filter -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Strings[Chart_Filter_Model]}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ComboBox ItemsSource="{Binding ModelFilterOptions}"
                                                      SelectedItem="{Binding SelectedModelFilter}"
                                                      Style="{StaticResource ModernComboBox}"
                                                      Width="180" />
                                        </StackPanel>

                                        <!-- Tier Filter -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Strings[Chart_Filter_Tier]}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ComboBox ItemsSource="{Binding TierFilterOptions}"
                                                      SelectedItem="{Binding SelectedTierFilter}"
                                                      Style="{StaticResource ModernComboBox}"
                                                      Width="110" />
                                        </StackPanel>
                                    </WrapPanel>
                                </Border>

                                <!-- Visual Interactive Chart Canvas Area (Height 340) -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="14,14,14,10" Height="340">
                                    <Grid>
                                        <!-- No Data Placeholder (When genuinely 0 prompts) -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasChartData, Converter={StaticResource InverseBoolToVisConverter}}">
                                            <TextBlock Text="📭" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding Strings[Chart_NoData]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Switch account or timeframe filter above to view historical prompt sessions." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Chart with Y-Axis, Horizontal Gridlines, and Horizontal ScrollViewer -->
                                        <Grid Visibility="{Binding HasChartData, Converter={StaticResource BoolToVisConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <!-- Left Y-Axis Scale -->
                                                <ColumnDefinition Width="42" />
                                                <!-- Plot Canvas & ScrollViewer Area -->
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Y-Axis Labels -->
                                            <Grid Grid.Column="0" Margin="0,18,6,38">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding YTick100}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="1" Text="{Binding YTick75}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="2" Text="{Binding YTick50}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="3" Text="{Binding YTick25}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="3" Text="{Binding YTick0}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                            </Grid>

                                            <!-- Plot Container (Gridlines + ScrollViewer) -->
                                            <Grid Grid.Column="1">
                                                <!-- Horizontal Background Gridlines & Baseline -->
                                                <Grid Margin="0,18,0,38">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Rectangle Grid.Row="0" VerticalAlignment="Top" Height="1" Fill="{DynamicResource BrushCardBorder}" Opacity="0.45" StrokeDashArray="3 3" />
                                                    <Rectangle Grid.Row="1" VerticalAlignment="Top" Height="1" Fill="{DynamicResource BrushCardBorder}" Opacity="0.45" StrokeDashArray="3 3" />
                                                    <Rectangle Grid.Row="2" VerticalAlignment="Top" Height="1" Fill="{DynamicResource BrushCardBorder}" Opacity="0.45" StrokeDashArray="3 3" />
                                                    <Rectangle Grid.Row="3" VerticalAlignment="Top" Height="1" Fill="{DynamicResource BrushCardBorder}" Opacity="0.45" StrokeDashArray="3 3" />
                                                    <Rectangle Grid.Row="3" VerticalAlignment="Bottom" Height="1.5" Fill="{DynamicResource BrushCardBorder}" Opacity="0.8" />
                                                </Grid>

                                                <!-- Horizontal Scrollable Chart Content -->
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                              PreviewMouseWheel="ChartScrollViewer_PreviewMouseWheel">
                                                    <Grid MinWidth="{Binding ChartCanvasWidth}" Height="300" HorizontalAlignment="Left">
                                                        <!-- 1. BAR CHART MODE -->
                                                        <ItemsControl ItemsSource="{Binding DashboardChartPoints}" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                                      Margin="10,0,10,12"
                                                                      Visibility="{Binding SelectedChartMode, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Bar}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Width="76" Margin="6,0" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                                        <StackPanel.ToolTip>
                                                                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                                                                <StackPanel>
                                                                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" />
                                                                                    <TextBlock Text="{Binding Value, StringFormat='Prompts: {0:N0}'}" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" />
                                                                                    <TextBlock Text="{Binding TokensLabel, StringFormat='Est. Tokens: {0}'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,4" />
                                                                                    <Separator Background="{DynamicResource BrushCardBorder}" Margin="0,4" />
                                                                                    <TextBlock Text="{Binding AccountContext, StringFormat='Account: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                    <TextBlock Text="{Binding ModelContext, StringFormat='Model: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </StackPanel.ToolTip>
                                                                        <TextBlock Text="{Binding Value}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                                                        <TextBlock Text="{Binding TokensLabel}" FontSize="9" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                                        <Border Height="{Binding Height}" Width="{Binding Width}" CornerRadius="4,4,0,0"
                                                                                Background="{Binding BarColor, Converter={StaticResource HexToBrushConverter}}"
                                                                                HorizontalAlignment="Center" Cursor="Hand" />
                                                                        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- 2. LINE CHART MODE -->
                                                        <Grid Visibility="{Binding SelectedChartMode, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Line}"
                                                              Width="{Binding ChartCanvasWidth}" Height="290" VerticalAlignment="Center">
                                                            <Canvas Width="{Binding ChartCanvasWidth}" Height="230" VerticalAlignment="Top" Margin="0,15,0,0">
                                                                <Polyline Points="{Binding LinePoints}" Stroke="#3B82F6" StrokeThickness="3.5" StrokeLineJoin="Round" />
                                                            </Canvas>
                                                            <ItemsControl ItemsSource="{Binding DashboardChartPoints}" VerticalAlignment="Bottom" Margin="0,0,0,12">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Rows="1" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel HorizontalAlignment="Center">
                                                                            <StackPanel.ToolTip>
                                                                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                                                                    <StackPanel>
                                                                                        <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" />
                                                                                        <TextBlock Text="{Binding Value, StringFormat='Prompts: {0:N0}'}" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" />
                                                                                        <TextBlock Text="{Binding TokensLabel, StringFormat='Est. Tokens: {0}'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,4" />
                                                                                        <Separator Background="{DynamicResource BrushCardBorder}" Margin="0,4" />
                                                                                        <TextBlock Text="{Binding AccountContext, StringFormat='Account: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                        <TextBlock Text="{Binding ModelContext, StringFormat='Model: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </StackPanel.ToolTip>
                                                                            <TextBlock Text="{Binding Value}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" />
                                                                            <Ellipse Width="10" Height="10" Fill="#3B82F6" Stroke="#FFFFFF" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,4" Cursor="Hand" />
                                                                            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>

                                                        <!-- 3. AREA CHART MODE -->
                                                        <Grid Visibility="{Binding SelectedChartMode, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Area}"
                                                              Width="{Binding ChartCanvasWidth}" Height="290" VerticalAlignment="Center">
                                                            <Canvas Width="{Binding ChartCanvasWidth}" Height="230" VerticalAlignment="Top" Margin="0,15,0,0">
                                                                <Polygon Points="{Binding AreaPoints}" Fill="{StaticResource AreaChartGradient}" />
                                                                <Polyline Points="{Binding LinePoints}" Stroke="#8B5CF6" StrokeThickness="3.5" StrokeLineJoin="Round" />
                                                            </Canvas>
                                                            <ItemsControl ItemsSource="{Binding DashboardChartPoints}" VerticalAlignment="Bottom" Margin="0,0,0,12">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Rows="1" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel HorizontalAlignment="Center">
                                                                            <StackPanel.ToolTip>
                                                                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                                                                    <StackPanel>
                                                                                        <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" />
                                                                                        <TextBlock Text="{Binding Value, StringFormat='Prompts: {0:N0}'}" FontWeight="SemiBold" FontSize="12" Foreground="#8B5CF6" />
                                                                                        <TextBlock Text="{Binding TokensLabel, StringFormat='Est. Tokens: {0}'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,4" />
                                                                                        <Separator Background="{DynamicResource BrushCardBorder}" Margin="0,4" />
                                                                                        <TextBlock Text="{Binding AccountContext, StringFormat='Account: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                        <TextBlock Text="{Binding ModelContext, StringFormat='Model: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </StackPanel.ToolTip>
                                                                            <TextBlock Text="{Binding Value}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" />
                                                                            <Ellipse Width="9" Height="9" Fill="#8B5CF6" Stroke="#FFFFFF" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,4" Cursor="Hand" />
                                                                            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </Grid>
                                                </ScrollViewer>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Swarm Quick Launch Orchestrator Card -->
                        <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="⚡ Concurrent Swarm Orchestrator" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                    <TextBlock Text="Launch multiple Antigravity AI accounts in parallel. Each session is completely isolated with its own credentials and workspace directory."
                                               FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,12" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Launch Mode: " FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox SelectedValue="{Binding SelectedSwarmMode}" Style="{StaticResource ModernComboBox}" Width="160">
                                            <models:SwarmLaunchMode>SplitPanes</models:SwarmLaunchMode>
                                            <models:SwarmLaunchMode>SeparateTabs</models:SwarmLaunchMode>
                                            <models:SwarmLaunchMode>SeparateWindows</models:SwarmLaunchMode>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding LaunchSwarmCommand}" Style="{StaticResource SwarmButton}" Padding="20,12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡ Run Swarm Now" FontWeight="Bold" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Active Swarm Accounts Grid Preview -->
                        <TextBlock Text="Active Account Swarm Workers" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Color Accent Indicator -->
                                            <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{Binding ColorTag, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,12,0" />

                                            <!-- Info & Telemetry Column -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <!-- Row 1: Avatar, Name, Tier, Status, Model & Quota Badges -->
                                                <WrapPanel VerticalAlignment="Center">
                                                    <!-- Circular Cropped Avatar directly to left of Account Name -->
                                                    <Grid Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <!-- Online Profile Picture inside Ellipse -->
                                                        <Ellipse Width="34" Height="34"
                                                                 Stroke="{Binding ColorTag, Converter={StaticResource HexToBrushConverter}}"
                                                                 StrokeThickness="2"
                                                                 Visibility="{Binding HasAvatarUrl, Converter={StaticResource BoolToVisConverter}}">
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
                                                            </Ellipse.Fill>
                                                        </Ellipse>

                                                        <!-- Fallback Google Circular Initial Badge -->
                                                        <Border Width="34" Height="34" CornerRadius="17"
                                                                Background="{Binding ColorTag, Converter={StaticResource HexToBrushConverter}}"
                                                                Visibility="{Binding HasAvatarUrl, Converter={StaticResource InverseBoolToVisConverter}}">
                                                            <TextBlock Text="{Binding AvatarInitial}" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>

                                                        <!-- Mini Google 'G' Accent Dot -->
                                                        <Border Width="12" Height="12" CornerRadius="6"
                                                                Background="#FFFFFF" BorderBrush="#4285F4" BorderThickness="1"
                                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                Margin="0,0,-1,-1">
                                                            <TextBlock Text="G" FontSize="7.5" FontWeight="Bold" Foreground="#4285F4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Profile Name -->
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                                    <!-- Tier Badge -->
                                                    <Border CornerRadius="6" Padding="10,3" Margin="0,0,8,0" VerticalAlignment="Center"
                                                            Background="{Binding TierBadgeBackground, Converter={StaticResource HexToBrushConverter}}">
                                                        <TextBlock Text="{Binding TierBadgeText}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                    </Border>

                                                    <!-- Status Badge -->
                                                    <Border CornerRadius="6" Padding="9,3" Margin="0,0,8,0" VerticalAlignment="Center" Background="{DynamicResource BrushSurface}"
                                                            BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBadgeColor, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Model Badge -->
                                                    <Border CornerRadius="6" Padding="9,3" Margin="0,0,8,0" VerticalAlignment="Center"
                                                            Background="{DynamicResource BrushModelBadgeBg}"
                                                            BorderBrush="{DynamicResource BrushModelBadgeBorder}"
                                                            BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🧠 " FontSize="10.5" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding CurrentModel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushModelBadgeText}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Quota Status Badge -->
                                                    <Border CornerRadius="6" Padding="9,3" VerticalAlignment="Center"
                                                            Background="{Binding QuotaStatusColor, Converter={StaticResource HexToBrushConverter}}">
                                                        <TextBlock Text="{Binding QuotaStatusText}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Row 2: Activity Meter (Responsive WrapPanel) -->
                                                <WrapPanel Margin="0,6,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding UsageLabel}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,4" />
                                                    <Border Background="#1538BDF8" BorderBrush="#3038BDF8" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,10,4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SessionUsageLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" />
                                                    </Border>
                                                    <ProgressBar Value="{Binding UsagePercentage, Mode=OneWay}" Height="6" Width="140"
                                                                 Background="{DynamicResource BrushProgressTrack}"
                                                                 Foreground="{Binding DailyUsageBarColor, Converter={StaticResource HexToBrushConverter}}"
                                                                 BorderThickness="0" VerticalAlignment="Center" Margin="0,0,12,4" />
                                                    <TextBlock Text="{Binding QuotaResetCountdown}" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,0,4" />
                                                </WrapPanel>

                                                <!-- Row 3: Antigravity Model Quotas Preview (Gemini & Claude Groups) -->
                                                <WrapPanel Margin="0,4,0,0" VerticalAlignment="Center">
                                                    <!-- Gemini Group -->
                                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="7,2.5" Margin="0,0,8,4">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Gemini: " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                            <TextBlock Text="{Binding GeminiWeeklyRemainingPercent, StringFormat='{}W: {0:F0}%'}" FontSize="10" FontWeight="Bold" Foreground="{Binding GeminiWeeklyBarColor, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding Gemini5HourRemainingPercent, StringFormat='{}5h: {0:F0}%'}" FontSize="10" FontWeight="Bold" Foreground="{Binding Gemini5HourBarColor, Converter={StaticResource HexToBrushConverter}}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Claude / GPT Group -->
                                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="7,2.5" Margin="0,0,8,4">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Claude/GPT: " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                            <TextBlock Text="{Binding ClaudeGptWeeklyRemainingPercent, StringFormat='{}W: {0:F0}%'}" FontSize="10" FontWeight="Bold" Foreground="{Binding ClaudeGptWeeklyBarColor, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding ClaudeGpt5HourRemainingPercent, StringFormat='{}5h: {0:F0}%'}" FontSize="10" FontWeight="Bold" Foreground="{Binding ClaudeGpt5HourBarColor, Converter={StaticResource HexToBrushConverter}}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Weekly Remaining Quota Summary -->
                                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="7,2.5" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding WeeklyRemainingLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Quick Launch Action -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding LaunchCommand}"
                                                        CommandParameter="{Binding DataContext.SelectedTerminal, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource HeroIconPlay}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Launch" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding OpenProfileFolderCommand}" Style="{StaticResource ModernButton}" Padding="8,6" ToolTip="Open Profile Folder">
                                                    <Path Data="{StaticResource HeroIconFolder}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" StrokeThickness="1.75" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bottom Breathing Room Spacer -->
                        <Border Height="60" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================================================== -->
                <!-- VIEW 2: ACCOUNTS (/accounts)                                   -->
                <!-- ============================================================== -->
                <Grid Grid.Row="1"
                      Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Accounts}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Accounts Toolbar -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BrushSurfaceHover}"
                            BorderBrush="{DynamicResource BrushCardBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="24,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Search -->
                            <TextBox Grid.Column="0"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     ToolTip="{Binding Strings[Accounts_SearchPlaceholder]}" />

                            <!-- Center options -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                <Button Content="{Binding Strings[Accounts_SelectAll]}"
                                        Command="{Binding ToggleSelectAllSwarmCommand}"
                                        Style="{StaticResource ModernButton}"
                                        Padding="10,5"
                                        FontSize="11" />
                            </StackPanel>

                            <!-- Right Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding AddProfileCommand}"
                                        Style="{StaticResource PrimaryButton}" Padding="14,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconPlus}"
                                              Stroke="#FFFFFF" StrokeThickness="2.2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Strings[Accounts_NewProfile]}" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Accounts Cards List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16,24,60">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding FilteredProfiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushCard}"
                                            BorderBrush="{DynamicResource BrushCardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Margin="0,0,0,16"
                                            Padding="18,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Checkbox & Color Accent Bar -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- Card Multi-Row Content Body -->
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Column 0: Checkbox & Accent Bar -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <CheckBox IsChecked="{Binding IsSelectedForSwarm}"
                                                          Style="{StaticResource ModernCheckBox}"
                                                          Margin="0,0,10,0"
                                                          VerticalAlignment="Center"
                                                          ToolTip="Include profile in Swarm Launch" />
                                                <Border Width="4" Height="74"
                                                        CornerRadius="2"
                                                        Background="{Binding ColorTag, Converter={StaticResource HexToBrushConverter}}" />
                                            </StackPanel>

                                            <!-- Column 1: Multi-Row Content Body -->
                                            <StackPanel Grid.Column="1">
                                                <!-- Row 1: Avatar (Circular Cropped), Profile Name, Tier Badge, Status Badge, Model Badge, Quota Health -->
                                                <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                                                    <!-- Circular Google Avatar placed immediately to the left of the Account Name -->
                                                    <Grid Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <!-- Online Google Profile Picture (if available) clipped inside Ellipse -->
                                                        <Ellipse Width="38" Height="38"
                                                                 Stroke="{Binding ColorTag, Converter={StaticResource HexToBrushConverter}}"
                                                                 StrokeThickness="2"
                                                                 Visibility="{Binding HasAvatarUrl, Converter={StaticResource BoolToVisConverter}}">
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
                                                            </Ellipse.Fill>
                                                        </Ellipse>

                                                        <!-- Fallback Google Circular Initial Badge -->
                                                        <Border Width="38" Height="38" CornerRadius="19"
                                                                Background="{Binding ColorTag, Converter={StaticResource HexToBrushConverter}}"
                                                                Visibility="{Binding HasAvatarUrl, Converter={StaticResource InverseBoolToVisConverter}}">
                                                            <TextBlock Text="{Binding AvatarInitial}"
                                                                       FontWeight="Bold" FontSize="16"
                                                                       Foreground="#FFFFFF"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>

                                                        <!-- Mini Google 'G' Accent Dot in bottom right -->
                                                        <Border Width="13" Height="13" CornerRadius="6.5"
                                                                Background="#FFFFFF"
                                                                BorderBrush="#4285F4" BorderThickness="1.2"
                                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                Margin="0,0,-1,-1">
                                                            <TextBlock Text="G" FontSize="8" FontWeight="Bold" Foreground="#4285F4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Profile Name -->
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                                    <!-- Tier Badge -->
                                                    <Border CornerRadius="6" Padding="10,3" Margin="0,0,8,0" VerticalAlignment="Center"
                                                            Background="{Binding TierBadgeBackground, Converter={StaticResource HexToBrushConverter}}">
                                                        <TextBlock Text="{Binding TierBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                    </Border>

                                                    <!-- Status Badge (Logged in email or Needs Login) -->
                                                    <Border CornerRadius="6" Padding="9,3" Margin="0,0,8,0" VerticalAlignment="Center"
                                                            Background="{DynamicResource BrushSurface}"
                                                            BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBadgeColor, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Model Badge -->
                                                    <Border CornerRadius="6" Padding="9,3" Margin="0,0,8,0" VerticalAlignment="Center"
                                                            Background="{DynamicResource BrushModelBadgeBg}"
                                                            BorderBrush="{DynamicResource BrushModelBadgeBorder}" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🧠 " FontSize="10" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding CurrentModel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushModelBadgeText}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Quota Health Badge -->
                                                    <Border CornerRadius="6" Padding="9,3" VerticalAlignment="Center"
                                                            Background="{Binding QuotaStatusColor, Converter={StaticResource HexToBrushConverter}}">
                                                        <TextBlock Text="{Binding QuotaStatusText}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Row 2: Description (if any) & Sandbox Paths -->
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"
                                                               Visibility="{Binding Description, Converter={StaticResource NullOrEmptyToVisConverter}}" />
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="6,2" Margin="0,0,8,4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="📁 Sandbox: " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                <TextBlock Text="{Binding EffectiveProfilePath}" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{DynamicResource BrushMonoPath}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="6,2" Margin="0,0,8,4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="📂 Workspace: " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                <TextBlock Text="{Binding DisplayWorkspace}" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- ============================================================== -->
                                                <!-- FOLDABLE SECTION 1: DAILY RATE LIMIT & SESSION ACTIVITY       -->
                                                <!-- ============================================================== -->
                                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <!-- Accordion Header Button -->
                                                        <Button Command="{Binding ToggleDailyQuotaSectionCommand}"
                                                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="14,10" HorizontalContentAlignment="Stretch">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding IsDailyQuotaExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                                                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="⚡ DAILY RATE LIMIT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                    <Border Background="{DynamicResource BrushCardBorder}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                        <TextBlock Text="{Binding TierDailySummary}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                    </Border>
                                                                    <Border Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding UsagePercentage, StringFormat='{}{0:F1}% used'}" FontSize="10" FontWeight="Bold" Foreground="{Binding DailyUsageBarColor, Converter={StaticResource HexToBrushConverter}}" />
                                                                    </Border>
                                                                </StackPanel>

                                                                <!-- Right: Reset Countdown -->
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="⏱️ Reset: " FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding QuotaResetCountdown}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>

                                                        <!-- Accordion Body (Collapsible) -->
                                                        <StackPanel Visibility="{Binding IsDailyQuotaExpanded, Converter={StaticResource BoolToVisConverter}}" Margin="14,0,14,12">
                                                            <!-- Full-width Progress Bar with Dynamic Color (Green / Yellow / Red) -->
                                                            <ProgressBar Value="{Binding UsagePercentage, Mode=OneWay}"
                                                                         Height="7" Minimum="0" Maximum="100"
                                                                         Background="{DynamicResource BrushProgressTrack}"
                                                                         Foreground="{Binding DailyUsageBarColor, Converter={StaticResource HexToBrushConverter}}"
                                                                         BorderThickness="0"
                                                                         Margin="0,0,0,8" />

                                                            <!-- Prompts Today & Tokens Breakdown + Session Badge -->
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding TodayQuotaFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                    <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                    <TextBlock Text="{Binding TodayTokensFormatted}" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                                                </WrapPanel>
                                                                <Border Grid.Column="1" Background="#1838BDF8" BorderBrush="#4038BDF8" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding SessionUsageLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8" />
                                                                </Border>
                                                            </Grid>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- ============================================================== -->
                                                <!-- FOLDABLE SECTION 2: ANTIGRAVITY MODEL QUOTAS (/usage Groups)  -->
                                                <!-- ============================================================== -->
                                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <!-- Accordion Header Button -->
                                                        <Button Command="{Binding ToggleModelQuotasSectionCommand}"
                                                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="14,10" HorizontalContentAlignment="Stretch">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding IsModelQuotasExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                                                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="📊 ANTIGRAVITY MODEL QUOTAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                    <Border Background="#1538BDF8" BorderBrush="#3038BDF8" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                        <TextBlock Text="Gemini, Claude &amp; GPT Limits" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" />
                                                                    </Border>
                                                                </StackPanel>

                                                                <!-- Right: Quick Summary Pill -->
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="Gemini: " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding GeminiWeeklyRemainingPercent, StringFormat='{}{0:F0}%'}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding GeminiWeeklyBarColor, Converter={StaticResource HexToBrushConverter}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                    <TextBlock Text="Claude: " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding ClaudeGptWeeklyRemainingPercent, StringFormat='{}{0:F0}%'}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding ClaudeGptWeeklyBarColor, Converter={StaticResource HexToBrushConverter}}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>

                                                        <!-- Accordion Body (Collapsible) -->
                                                        <StackPanel Visibility="{Binding IsModelQuotasExpanded, Converter={StaticResource BoolToVisConverter}}" Margin="14,0,14,12">
                                                            <Grid Margin="0,0,0,10">
                                                                <Grid.ColumnDefinitions>
                                                                    <!-- Left: Gemini Models Group -->
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="14" />
                                                                    <!-- Right: Claude and GPT Models Group -->
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Group 1: GEMINI MODELS -->
                                                                <Border Grid.Column="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                                    <StackPanel>
                                                                        <!-- Group Header -->
                                                                        <Grid Margin="0,0,0,4">
                                                                            <TextBlock Text="GEMINI MODELS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                            <Border Background="#153B82F6" BorderBrush="#303B82F6" BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                                                                                <TextBlock Text="Flash, Pro" FontSize="9.5" FontWeight="SemiBold" Foreground="#3B82F6" />
                                                                            </Border>
                                                                        </Grid>
                                                                        <TextBlock Text="Models within this group: Gemini Flash, Gemini Pro" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8" />

                                                                        <!-- Metric 1: Weekly Limit Remaining -->
                                                                        <Grid Margin="0,0,0,3">
                                                                            <TextBlock Text="Weekly Limit Remaining" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                            <TextBlock Text="{Binding GeminiWeeklyRemainingPercent, StringFormat='{}{0:F2}%'}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding GeminiWeeklyBarColor, Converter={StaticResource HexToBrushConverter}}" HorizontalAlignment="Right" />
                                                                        </Grid>
                                                                        <ProgressBar Value="{Binding GeminiWeeklyRemainingPercent, Mode=OneWay}" Height="5" Minimum="0" Maximum="100"
                                                                                     Background="{DynamicResource BrushProgressTrack}" Foreground="{Binding GeminiWeeklyBarColor, Converter={StaticResource HexToBrushConverter}}"
                                                                                     BorderThickness="0" Margin="0,0,0,3" />
                                                                        <TextBlock Text="{Binding GeminiWeeklyRefreshesIn, StringFormat='{}Refreshes in {0}'}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8" />

                                                                        <!-- Metric 2: Five Hour Limit Remaining -->
                                                                        <Grid Margin="0,0,0,3">
                                                                            <TextBlock Text="Five Hour Limit Remaining" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                            <TextBlock Text="{Binding Gemini5HourRemainingPercent, StringFormat='{}{0:F2}%'}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding Gemini5HourBarColor, Converter={StaticResource HexToBrushConverter}}" HorizontalAlignment="Right" />
                                                                        </Grid>
                                                                        <ProgressBar Value="{Binding Gemini5HourRemainingPercent, Mode=OneWay}" Height="5" Minimum="0" Maximum="100"
                                                                                     Background="{DynamicResource BrushProgressTrack}" Foreground="{Binding Gemini5HourBarColor, Converter={StaticResource HexToBrushConverter}}"
                                                                                     BorderThickness="0" Margin="0,0,0,3" />
                                                                        <TextBlock Text="{Binding Gemini5HourRefreshesIn, StringFormat='{}Refreshes in {0}'}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" />
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Group 2: CLAUDE AND GPT MODELS -->
                                                                <Border Grid.Column="2" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                                    <StackPanel>
                                                                        <!-- Group Header -->
                                                                        <Grid Margin="0,0,0,4">
                                                                            <TextBlock Text="CLAUDE AND GPT MODELS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                            <Border Background="#158B5CF6" BorderBrush="#308B5CF6" BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                                                                                <TextBlock Text="Opus, Sonnet, GPT-OSS" FontSize="9.5" FontWeight="SemiBold" Foreground="#8B5CF6" />
                                                                            </Border>
                                                                        </Grid>
                                                                        <TextBlock Text="Models within this group: Claude Opus, Claude Sonnet, GPT-OSS" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8" />

                                                                        <!-- Metric 1: Weekly Limit Remaining -->
                                                                        <Grid Margin="0,0,0,3">
                                                                            <TextBlock Text="Weekly Limit Remaining" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                            <TextBlock Text="{Binding ClaudeGptWeeklyRemainingPercent, StringFormat='{}{0:F2}%'}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding ClaudeGptWeeklyBarColor, Converter={StaticResource HexToBrushConverter}}" HorizontalAlignment="Right" />
                                                                        </Grid>
                                                                        <ProgressBar Value="{Binding ClaudeGptWeeklyRemainingPercent, Mode=OneWay}" Height="5" Minimum="0" Maximum="100"
                                                                                     Background="{DynamicResource BrushProgressTrack}" Foreground="{Binding ClaudeGptWeeklyBarColor, Converter={StaticResource HexToBrushConverter}}"
                                                                                     BorderThickness="0" Margin="0,0,0,3" />
                                                                        <TextBlock Text="{Binding ClaudeGptWeeklyRefreshesIn, StringFormat='{}Refreshes in {0}'}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8" />

                                                                        <!-- Metric 2: Five Hour Limit Remaining -->
                                                                        <Grid Margin="0,0,0,3">
                                                                            <TextBlock Text="Five Hour Limit Remaining" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                            <TextBlock Text="{Binding ClaudeGpt5HourRemainingPercent, StringFormat='{}{0:F2}%'}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding ClaudeGpt5HourBarColor, Converter={StaticResource HexToBrushConverter}}" HorizontalAlignment="Right" />
                                                                        </Grid>
                                                                        <ProgressBar Value="{Binding ClaudeGpt5HourRemainingPercent, Mode=OneWay}" Height="5" Minimum="0" Maximum="100"
                                                                                     Background="{DynamicResource BrushProgressTrack}" Foreground="{Binding ClaudeGpt5HourBarColor, Converter={StaticResource HexToBrushConverter}}"
                                                                                     BorderThickness="0" Margin="0,0,0,3" />
                                                                        <TextBlock Text="{Binding ClaudeGpt5HourRefreshesIn, StringFormat='{}Refreshes in {0}'}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>

                                                            <!-- Explanatory Note Callout (Authentic agy cli text) -->
                                                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="5" Padding="10,7">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Width="3" Background="#8B5CF6" CornerRadius="1.5" Margin="0,0,8,0" />
                                                                    <TextBlock Grid.Column="1" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" LineHeight="14">
                                                                        Within each group, models share a weekly limit and a 5-hour limit. Quota is consumed proportionally to token cost. The 5-hour limit smooths out aggregate demand to fairly distribute capacity, while weekly limit reflects your subscription tier.
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- ============================================================== -->
                                                <!-- FOLDABLE SECTION 3: CLI INSPECTOR & TELEMETRY                 -->
                                                <!-- ============================================================== -->
                                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <!-- Accordion Header Button -->
                                                        <Button Command="{Binding ToggleCliInspectorSectionCommand}"
                                                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="14,10" HorizontalContentAlignment="Stretch">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding IsCliInspectorExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                                                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="🔬 CLI INSPECTOR &amp; TELEMETRY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                    <Border Background="#158B5CF6" BorderBrush="#308B5CF6" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                        <TextBlock Text="/usage &amp; /context" FontSize="9.5" FontWeight="SemiBold" Foreground="#8B5CF6" />
                                                                    </Border>
                                                                </StackPanel>

                                                                <!-- Action Buttons: /usage and /context -->
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Command="{Binding ToggleUsageInspectionCommand}"
                                                                            Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1"
                                                                            Foreground="{DynamicResource BrushTextPrimary}" FontSize="10" FontWeight="SemiBold" Padding="8,3" Margin="0,0,6,0" Cursor="Hand"
                                                                            ToolTip="View authentic AGY CLI /usage report">
                                                                        <TextBlock Text="📊 /usage" />
                                                                    </Button>
                                                                    <Button Command="{Binding ToggleContextInspectionCommand}"
                                                                            Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1"
                                                                            Foreground="{DynamicResource BrushTextPrimary}" FontSize="10" FontWeight="SemiBold" Padding="8,3" Cursor="Hand"
                                                                            ToolTip="View authentic AGY CLI /context capacity &amp; thread status">
                                                                        <TextBlock Text="🧠 /context" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>

                                                        <!-- Accordion Body (Collapsible) -->
                                                        <StackPanel Visibility="{Binding IsCliInspectorExpanded, Converter={StaticResource BoolToVisConverter}}" Margin="14,0,14,12">
                                                            <!-- 2-Box Metric Strip: /usage Overview & /context Window -->
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="10" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Box 1: /usage Telemetry -->
                                                                <Border Grid.Column="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                                    <StackPanel>
                                                                        <Grid Margin="0,0,0,4">
                                                                            <TextBlock Text="📊 /usage (Session &amp; Token Activity)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                            <TextBlock Text="{Binding UsagePercentage, StringFormat='{}{0:F1}% today'}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" />
                                                                        </Grid>
                                                                        <WrapPanel Margin="0,0,0,3">
                                                                            <TextBlock Text="Daily Tokens: " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                            <TextBlock Text="{Binding TodayTokensFormatted}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                        </WrapPanel>
                                                                        <WrapPanel>
                                                                            <TextBlock Text="Active Thread: " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                            <TextBlock Text="{Binding SessionUsageLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" />
                                                                        </WrapPanel>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Box 2: /context Capacity -->
                                                                <Border Grid.Column="2" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                                    <StackPanel>
                                                                        <Grid Margin="0,0,0,4">
                                                                            <TextBlock Text="🧠 /context (Model Window &amp; Memory)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                            <TextBlock Text="{Binding ContextWindowLabel}" FontSize="9.5" FontWeight="SemiBold" Foreground="#8B5CF6" HorizontalAlignment="Right" />
                                                                        </Grid>
                                                                        <ProgressBar Value="{Binding ContextUsagePercentage, Mode=OneWay}" Height="4" Minimum="0" Maximum="100"
                                                                                     Background="{DynamicResource BrushProgressTrack}" Foreground="#8B5CF6" BorderThickness="0" Margin="0,0,0,4" />
                                                                        <Grid>
                                                                            <TextBlock Text="{Binding ContextUsageSummary}" FontSize="9.5" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Left" />
                                                                            <TextBlock Text="{Binding ContextHeadroomSummary}" FontSize="9.5" Foreground="#10B981" HorizontalAlignment="Right" />
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>

                                                            <!-- Expandable Monospace CLI Terminal Inspector Drawer -->
                                                            <Border Visibility="{Binding IsInspectorOpen, Converter={StaticResource BoolToVisConverter}}"
                                                                    Background="#0D1117" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6"
                                                                    Padding="12,10" Margin="0,4,0,0">
                                                                <StackPanel>
                                                                    <Grid Margin="0,0,0,6">
                                                                        <TextBlock Text="{Binding InspectorTitle}" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="Bold" Foreground="#58A6FF" VerticalAlignment="Center" />
                                                                        <Button Command="{Binding CloseInspectorCommand}"
                                                                                Background="Transparent" BorderThickness="0" Foreground="#8B949E" FontSize="11" FontWeight="Bold"
                                                                                HorizontalAlignment="Right" Cursor="Hand" Padding="4,0" ToolTip="Close inspector">
                                                                            <TextBlock Text="✕ Close" />
                                                                        </Button>
                                                                    </Grid>
                                                                    <TextBox Text="{Binding InspectorContent, Mode=OneWay}" IsReadOnly="True"
                                                                             FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#C9D1D9" Background="Transparent"
                                                                             BorderThickness="0" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Row 4: Action Toolbar (Separated cleanly, never cramped!) -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left Actions: Session Resume/New Chat Selector + Launch, Copy, Open Folder -->
                                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <!-- Session Selector: New Chat / Continue Recent / Resume Specific with ModernComboBox -->
                                                        <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,8,4" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="💬 Start:" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="2,0,6,0" />
                                                                <ComboBox ItemsSource="{Binding AvailableSessions}" SelectedItem="{Binding SelectedSession}"
                                                                          Style="{StaticResource ModernComboBox}"
                                                                          Width="220" Height="28" VerticalAlignment="Center" FontSize="10.5"
                                                                          ToolTip="Select whether to start a new chat, continue most recent, or resume a specific past conversation">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding DisplayText}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </StackPanel>
                                                        </Border>

                                                        <Button Command="{Binding LaunchCommand}"
                                                                CommandParameter="{Binding DataContext.SelectedTerminal, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Style="{StaticResource PrimaryButton}" Padding="16,7" Margin="0,0,8,4"
                                                                ToolTip="Launch Antigravity CLI session with chosen session mode">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource HeroIconPlay}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="Launch agy" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Command="{Binding CopyCliSnippetCommand}"
                                                                CommandParameter="{Binding DataContext.SelectedTerminal, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Style="{StaticResource ModernButton}" Padding="12,7" Margin="0,0,8,4"
                                                                ToolTip="Copy isolated terminal launch command">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource HeroIconClipboard}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" StrokeThickness="1.75" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="Copy CLI" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Command="{Binding OpenProfileFolderCommand}" Style="{StaticResource ModernButton}" Padding="12,7" Margin="0,0,8,4" ToolTip="Open profile directory">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource HeroIconFolder}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" StrokeThickness="1.75" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="Open Folder" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Command="{Binding RequestDuplicateCommand}" Style="{StaticResource ModernButton}" Padding="12,7" Margin="0,0,8,4" ToolTip="Duplicate profile and copy all chat history and settings">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource HeroIconDocumentDuplicate}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" StrokeThickness="1.75" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding DataContext.Strings[Accounts_Duplicate], RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </WrapPanel>

                                                    <!-- Right Actions: Edit, Delete -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Command="{Binding RequestEditCommand}" Style="{StaticResource ModernButton}" Padding="12,7" Margin="0,0,8,4" ToolTip="Edit profile settings">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource HeroIconPencil}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" StrokeThickness="1.75" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="Edit Profile" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Command="{Binding RequestDeleteCommand}" Style="{StaticResource DangerButton}" Padding="12,7" Margin="0,0,0,4" ToolTip="Remove profile">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource HeroIconTrash}" Stroke="#FFFFFF" StrokeThickness="1.75" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="Delete" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bottom Breathing Room Spacer -->
                        <Border Height="60" />
                    </StackPanel>
                </ScrollViewer>
                </Grid>

                <!-- ============================================================== -->
                <!-- VIEW 3: ANALYTICS (/analytic)                                  -->
                <!-- ============================================================== -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,24,24,60"
                              Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Analytics}">
                    <StackPanel>
                        <!-- Analytics Header -->
                        <Grid Margin="0,0,0,16">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Strings[Analytics_Title]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="{Binding Strings[Analytics_Subtitle]}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding ExportPdfReportCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Padding="14,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconArrowDownTray}" Stroke="#FFFFFF" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Download PDF Report" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SyncSwarmCommand}" Style="{StaticResource ModernButton}" Padding="12,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconArrowPath}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Strings[Analytics_Recalculate]}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Telemetry KPI Summary Row -->
                        <UniformGrid Columns="6" Margin="0,0,0,20">
                            <!-- Metric 1: Total Tokens -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="EST. TOKENS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding TotalEstimatedTokens}" FontSize="18" FontWeight="Bold" Foreground="#3B82F6" Margin="0,3,0,0" />
                                    <TextBlock Text="Total consumption" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 2: Input Tokens -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="INPUT TOKENS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding EstimatedInputTokens}" FontSize="18" FontWeight="Bold" Foreground="#06B6D4" Margin="0,3,0,0" />
                                    <TextBlock Text="Prompts sent" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 3: Output Tokens -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="OUTPUT TOKENS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding EstimatedOutputTokens}" FontSize="18" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,3,0,0" />
                                    <TextBlock Text="AI completions" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 4: Avg Latency -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="AVG LATENCY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding AverageLatencyMs}" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,3,0,0" />
                                    <TextBlock Text="Round-trip time" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 5: Success Rate -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="UPTIME / SUCCESS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />

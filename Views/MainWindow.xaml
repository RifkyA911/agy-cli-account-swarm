<Window x:Class="AgyAccountSwarm.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AgyAccountSwarm.ViewModels"
        xmlns:models="clr-namespace:AgyAccountSwarm.Models"
        Title="Agy CLI Account Swarm — Antigravity CLI Orchestrator"
        Icon="../Resources/favicon.ico"
        Height="760" Width="1240"
        MinHeight="640" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource BrushBg}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Window.Resources>
        <LinearGradientBrush x:Key="AreaChartGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#708B5CF6" Offset="0.0" />
            <GradientStop Color="#203B82F6" Offset="0.75" />
            <GradientStop Color="#000F1115" Offset="1.0" />
        </LinearGradientBrush>
    </Window.Resources>

    <Grid>
        <!-- ============================================================== -->
        <!-- MAIN APP LAYOUT (Sidebar + Main Content Area)                 -->
        <!-- ============================================================== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar Navigation -->
                <ColumnDefinition Width="{Binding SidebarColumnWidth}" />
                <!-- Main Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- 1. LEFT SIDEBAR NAVIGATION                 -->
            <!-- ========================================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushCardBorder}"
                    BorderThickness="0,0,1,0"
                    Padding="6,18"
                    ClipToBounds="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- App Logo, Title & Sidebar Toggle -->
                        <RowDefinition Height="Auto" />
                        <!-- Navigation Menu -->
                        <RowDefinition Height="*" />
                        <!-- Bottom Controls: Sound, Theme, Status -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header / Branding & Collapse Toggle -->
                    <Grid Grid.Row="0" Margin="4,0,4,22">
                        <!-- Expanded Header -->
                        <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="../Resources/favicon.ico" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Agy CLI Swarm"
                                               FontSize="14.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource BrushTextPrimary}" />
                                    <TextBlock Text="Account Orchestrator"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource BrushTextMuted}" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding ToggleSidebarCommand}"
                                    Style="{StaticResource ModernButton}"
                                    Padding="6,5"
                                    ToolTip="Collapse Sidebar">
                                <Path Data="{StaticResource HeroIconBars3}"
                                      Stroke="{DynamicResource BrushTextSecondary}"
                                      StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                            </Button>
                        </Grid>

                        <!-- Collapsed Header: Dedicated Logo (not a button) and separate Toggle Button below it -->
                        <StackPanel Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisConverter}}"
                                    HorizontalAlignment="Center">
                            <Image Source="../Resources/favicon.ico" Width="26" Height="26" Margin="0,0,0,10" HorizontalAlignment="Center" />
                            <Button Command="{Binding ToggleSidebarCommand}"
                                    Style="{StaticResource ModernButton}"
                                    Padding="6,6"
                                    HorizontalAlignment="Center"
                                    ToolTip="Expand Sidebar">
                                <Path Data="{StaticResource HeroIconBars3}"
                                      Stroke="{DynamicResource BrushTextSecondary}"
                                      StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Navigation Menu Items -->
                    <StackPanel Grid.Row="1">
                        <!-- /dashboard -->
                        <Border BorderThickness="1" CornerRadius="8" Margin="0,0,0,4"
                                Background="{Binding CurrentPage, Converter={StaticResource PageToActiveBgConverter}, ConverterParameter=Dashboard}"
                                BorderBrush="{Binding CurrentPage, Converter={StaticResource PageToActiveBorderConverter}, ConverterParameter=Dashboard}">
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                    Style="{StaticResource SidebarButton}"
                                    Padding="8,10"
                                    ToolTip="{Binding Strings[Nav_Dashboard]}">
                                <Grid HorizontalAlignment="Stretch">
                                    <!-- Expanded View -->
                                    <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                                Background="#3B82F6" Margin="0,0,8,0"
                                                Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Dashboard}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconSquares2x2}"
                                                  Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Dashboard}"
                                                  StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="17" Height="17" Stretch="Uniform" Margin="2,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Strings[Nav_Dashboard]}"
                                                       FontSize="13"
                                                       FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Dashboard}"
                                                       Foreground="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Dashboard}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Collapsed View -->
                                    <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisConverter}}" Height="28" Width="44" HorizontalAlignment="Center" ClipToBounds="False">
                                        <Path Data="{StaticResource HeroIconSquares2x2}"
                                              Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Dashboard}"
                                              StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- /accounts -->
                        <Border BorderThickness="1" CornerRadius="8" Margin="0,0,0,4"
                                Background="{Binding CurrentPage, Converter={StaticResource PageToActiveBgConverter}, ConverterParameter=Accounts}"
                                BorderBrush="{Binding CurrentPage, Converter={StaticResource PageToActiveBorderConverter}, ConverterParameter=Accounts}">
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Accounts"
                                    Style="{StaticResource SidebarButton}"
                                    Padding="8,10"
                                    ToolTip="{Binding Strings[Nav_Accounts]}">
                                <Grid HorizontalAlignment="Stretch">
                                    <!-- Expanded View -->
                                    <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                                Background="#3B82F6" Margin="0,0,8,0"
                                                Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Accounts}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconUsers}"
                                                  Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Accounts}"
                                                  StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="17" Height="17" Stretch="Uniform" Margin="2,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Strings[Nav_Accounts]}"
                                                       FontSize="13"
                                                       FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Accounts}"
                                                       Foreground="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Accounts}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{DynamicResource BrushBadgeBg}"
                                                BorderBrush="{DynamicResource BrushBadgeBorder}"
                                                BorderThickness="1"
                                                CornerRadius="10" Padding="8,2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushBadgeText}" />
                                        </Border>
                                    </Grid>

                                    <!-- Collapsed View -->
                                    <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisConverter}}" Height="28" Width="44" HorizontalAlignment="Center" ClipToBounds="False">
                                        <Path Data="{StaticResource HeroIconUsers}"
                                              Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Accounts}"
                                              StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource BrushBadgeBg}" BorderBrush="{DynamicResource BrushBadgeBorder}" BorderThickness="1"
                                                CornerRadius="7" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0" ClipToBounds="False">
                                            <TextBlock Text="{Binding TotalCount}" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource BrushBadgeText}" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- /dispatcher (Swarm Chat) -->
                        <Border BorderThickness="1" CornerRadius="8" Margin="0,0,0,4"
                                Background="{Binding CurrentPage, Converter={StaticResource PageToActiveBgConverter}, ConverterParameter=Dispatcher}"
                                BorderBrush="{Binding CurrentPage, Converter={StaticResource PageToActiveBorderConverter}, ConverterParameter=Dispatcher}">
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Dispatcher"
                                    Style="{StaticResource SidebarButton}"
                                    Padding="8,10"
                                    ToolTip="Swarm Chat &amp; Multi-Agent Project Aggregator">
                                <Grid HorizontalAlignment="Stretch">
                                    <!-- Expanded View -->
                                    <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                                Background="#3B82F6" Margin="0,0,8,0"
                                                Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Dispatcher}" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconChatBubbleOvalLeftEllipsis}"
                                                  Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Dispatcher}"
                                                  StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,9,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Swarm Chat"
                                                       Foreground="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Dispatcher}"
                                                       FontSize="12.5" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{DynamicResource BrushWarningAlertBg}" BorderBrush="{DynamicResource BrushWarningAlertBorder}" BorderThickness="1"
                                                CornerRadius="7" Padding="5,1.5" VerticalAlignment="Center">
                                            <TextBlock Text="SWARM" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource BrushWarningAlertText}" />
                                        </Border>
                                    </Grid>

                                    <!-- Collapsed View -->
                                    <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisConverter}}" Height="28" Width="44" HorizontalAlignment="Center" ClipToBounds="False">
                                        <Path Data="{StaticResource HeroIconChatBubbleOvalLeftEllipsis}"
                                              Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Dispatcher}"
                                              StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource BrushWarningAlertBg}" BorderBrush="{DynamicResource BrushWarningAlertBorder}" BorderThickness="1"
                                                CornerRadius="7" Padding="3,1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0" ClipToBounds="False">
                                            <TextBlock Text="SWARM" FontSize="6.5" FontWeight="Bold" Foreground="{DynamicResource BrushWarningAlertText}" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- /analytic -->
                        <Border BorderThickness="1" CornerRadius="8" Margin="0,0,0,4"
                                Background="{Binding CurrentPage, Converter={StaticResource PageToActiveBgConverter}, ConverterParameter=Analytics}"
                                BorderBrush="{Binding CurrentPage, Converter={StaticResource PageToActiveBorderConverter}, ConverterParameter=Analytics}">
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Analytics"
                                    Style="{StaticResource SidebarButton}"
                                    Padding="8,10"
                                    ToolTip="{Binding Strings[Nav_Analytics]}">
                                <Grid HorizontalAlignment="Stretch">
                                    <!-- Expanded View -->
                                    <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                                Background="#3B82F6" Margin="0,0,8,0"
                                                Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Analytics}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconChartBar}"
                                                  Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Analytics}"
                                                  StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="17" Height="17" Stretch="Uniform" Margin="2,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Strings[Nav_Analytics]}"
                                                       FontSize="13"
                                                       FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Analytics}"
                                                       Foreground="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Analytics}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Collapsed View -->
                                    <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisConverter}}" Height="28" Width="44" HorizontalAlignment="Center" ClipToBounds="False">
                                        <Path Data="{StaticResource HeroIconChartBar}"
                                              Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Analytics}"
                                              StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- /mcp -->
                        <Border BorderThickness="1" CornerRadius="8" Margin="0,0,0,4"
                                Background="{Binding CurrentPage, Converter={StaticResource PageToActiveBgConverter}, ConverterParameter=Mcp}"
                                BorderBrush="{Binding CurrentPage, Converter={StaticResource PageToActiveBorderConverter}, ConverterParameter=Mcp}">
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Mcp"
                                    Style="{StaticResource SidebarButton}"
                                    Padding="8,10"
                                    ToolTip="{Binding Strings[Nav_Mcp]}">
                                <Grid HorizontalAlignment="Stretch">
                                    <!-- Expanded View -->
                                    <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                                Background="#3B82F6" Margin="0,0,8,0"
                                                Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Mcp}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconCpuChip}"
                                                  Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Mcp}"
                                                  StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="17" Height="17" Stretch="Uniform" Margin="2,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Strings[Nav_Mcp]}"
                                                       FontSize="13"
                                                       FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Mcp}"
                                                       Foreground="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Mcp}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{DynamicResource BrushBadgeBg}"
                                                BorderBrush="{DynamicResource BrushBadgeBorder}"
                                                BorderThickness="1"
                                                CornerRadius="10" Padding="8,2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding McpServersCount}" FontSize="11" FontWeight="Bold" Foreground="#3B82F6" />
                                        </Border>
                                    </Grid>

                                    <!-- Collapsed View -->
                                    <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisConverter}}" Height="28" Width="44" HorizontalAlignment="Center" ClipToBounds="False">
                                        <Path Data="{StaticResource HeroIconCpuChip}"
                                              Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Mcp}"
                                              StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource BrushBadgeBg}" BorderBrush="{DynamicResource BrushBadgeBorder}" BorderThickness="1"
                                                CornerRadius="7" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0" ClipToBounds="False">
                                            <TextBlock Text="{Binding McpServersCount}" FontSize="8.5" FontWeight="Bold" Foreground="#3B82F6" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- /docs -->
                        <Border BorderThickness="1" CornerRadius="8" Margin="0,0,0,4"
                                Background="{Binding CurrentPage, Converter={StaticResource PageToActiveBgConverter}, ConverterParameter=Docs}"
                                BorderBrush="{Binding CurrentPage, Converter={StaticResource PageToActiveBorderConverter}, ConverterParameter=Docs}">
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Docs"
                                    Style="{StaticResource SidebarButton}"
                                    Padding="8,10"
                                    ToolTip="{Binding Strings[Nav_Docs]}">
                                <Grid HorizontalAlignment="Stretch">
                                    <!-- Expanded View -->
                                    <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                                Background="#3B82F6" Margin="0,0,8,0"
                                                Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Docs}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconBookOpen}"
                                                  Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Docs}"
                                                  StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="17" Height="17" Stretch="Uniform" Margin="2,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Strings[Nav_Docs]}"
                                                       FontSize="13"
                                                       FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Docs}"
                                                       Foreground="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Docs}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Collapsed View -->
                                    <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisConverter}}" Height="28" Width="44" HorizontalAlignment="Center" ClipToBounds="False">
                                        <Path Data="{StaticResource HeroIconBookOpen}"
                                              Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Docs}"
                                              StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- /logs -->
                        <Border BorderThickness="1" CornerRadius="8" Margin="0,0,0,4"
                                Background="{Binding CurrentPage, Converter={StaticResource PageToActiveBgConverter}, ConverterParameter=Logs}"
                                BorderBrush="{Binding CurrentPage, Converter={StaticResource PageToActiveBorderConverter}, ConverterParameter=Logs}">
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Logs"
                                    Style="{StaticResource SidebarButton}"
                                    Padding="8,10"
                                    ToolTip="{Binding Strings[Nav_Logs]}">
                                <Grid HorizontalAlignment="Stretch">
                                    <!-- Expanded View -->
                                    <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                                Background="#3B82F6" Margin="0,0,8,0"
                                                Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Logs}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconCommandLine}"
                                                  Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Logs}"
                                                  StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="17" Height="17" Stretch="Uniform" Margin="2,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Strings[Nav_Logs]}"
                                                       FontSize="13"
                                                       FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Logs}"
                                                       Foreground="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Logs}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Collapsed View -->
                                    <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisConverter}}" Height="28" Width="44" HorizontalAlignment="Center" ClipToBounds="False">
                                        <Path Data="{StaticResource HeroIconCommandLine}"
                                              Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Logs}"
                                              StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- /settings -->
                        <Border BorderThickness="1" CornerRadius="8" Margin="0,0,0,4"
                                Background="{Binding CurrentPage, Converter={StaticResource PageToActiveBgConverter}, ConverterParameter=Settings}"
                                BorderBrush="{Binding CurrentPage, Converter={StaticResource PageToActiveBorderConverter}, ConverterParameter=Settings}">
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                    Style="{StaticResource SidebarButton}"
                                    Padding="8,10"
                                    ToolTip="{Binding Strings[Nav_Settings]}">
                                <Grid HorizontalAlignment="Stretch">
                                    <!-- Expanded View -->
                                    <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                                Background="#3B82F6" Margin="0,0,8,0"
                                                Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Settings}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconCog6Tooth}"
                                                  Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Settings}"
                                                  StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="17" Height="17" Stretch="Uniform" Margin="2,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Strings[Nav_Settings]}"
                                                       FontSize="13"
                                                       FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=Settings}"
                                                       Foreground="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Settings}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Collapsed View -->
                                    <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisConverter}}" Height="28" Width="44" HorizontalAlignment="Center" ClipToBounds="False">
                                        <Path Data="{StaticResource HeroIconCog6Tooth}"
                                              Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=Settings}"
                                              StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- /about -->
                        <Border BorderThickness="1" CornerRadius="8" Margin="0,0,0,4"
                                Background="{Binding CurrentPage, Converter={StaticResource PageToActiveBgConverter}, ConverterParameter=About}"
                                BorderBrush="{Binding CurrentPage, Converter={StaticResource PageToActiveBorderConverter}, ConverterParameter=About}">
                            <Button Command="{Binding NavigateCommand}" CommandParameter="About"
                                    Style="{StaticResource SidebarButton}"
                                    Padding="8,10"
                                    ToolTip="{Binding Strings[Nav_About]}">
                                <Grid HorizontalAlignment="Stretch">
                                    <!-- Expanded View -->
                                    <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="3.5" Height="18" CornerRadius="1.75"
                                                Background="#3B82F6" Margin="0,0,8,0"
                                                Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=About}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconInformationCircle}"
                                                  Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=About}"
                                                  StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="17" Height="17" Stretch="Uniform" Margin="2,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Strings[Nav_About]}"
                                                       FontSize="13"
                                                       FontWeight="{Binding CurrentPage, Converter={StaticResource PageToFontWeightConverter}, ConverterParameter=About}"
                                                       Foreground="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=About}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Collapsed View -->
                                    <Grid Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisConverter}}" Height="28" Width="44" HorizontalAlignment="Center" ClipToBounds="False">
                                        <Path Data="{StaticResource HeroIconInformationCircle}"
                                              Stroke="{Binding CurrentPage, Converter={StaticResource PageToActiveTextConverter}, ConverterParameter=About}"
                                              StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Button>
                        </Border>
                    </StackPanel>

                    <!-- Bottom Sidebar Controls -->
                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <Separator Background="{DynamicResource BrushCardBorder}" Margin="0,0,0,12" />

                        <!-- Expanded Bottom Controls -->
                        <StackPanel Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}">
                            <!-- Language Selector Dropdown -->
                            <Border Margin="0,0,0,6">
                                <ComboBox ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding SelectedLanguageOption}"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource ModernComboBox}"
                                          HorizontalAlignment="Stretch"
                                          ToolTip="Select Application Display Language" />
                            </Border>

                            <!-- Theme Appearance Palette Dropdown -->
                            <Border Margin="0,0,0,6">
                                <ComboBox ItemsSource="{Binding ThemeOptions}"
                                          SelectedItem="{Binding SelectedThemeOption}"
                                          Style="{StaticResource ModernComboBox}"
                                          HorizontalAlignment="Stretch"
                                          ToolTip="Select Theme Appearance Color Palette" />
                            </Border>

                            <!-- Sound Toggle -->
                            <Button Command="{Binding ToggleSoundCommand}"
                                    Style="{StaticResource SidebarButton}"
                                    Padding="8,6"
                                    Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔊 " FontSize="12" />
                                    <TextBlock Text="{Binding Strings[Label_Sound]}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <TextBlock Text=": " FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <TextBlock Text="ON" FontWeight="Bold" FontSize="12" Foreground="#10B981" Visibility="{Binding SoundEnabled, Converter={StaticResource BoolToVisConverter}}" />
                                    <TextBlock Text="MUTED" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Visibility="{Binding SoundEnabled, Converter={StaticResource InverseBoolToVisConverter}}" />
                                </StackPanel>
                            </Button>

                            <!-- CLI Status Pill -->
                            <Border Background="{DynamicResource BrushCard}"
                                    BorderBrush="{DynamicResource BrushCardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#10B981" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAgyInstalled}" Value="False">
                                                        <Setter Property="Fill" Value="#EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="CLI: " FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding Strings[Label_CliReady]}" FontSize="11" FontWeight="Bold" Foreground="#10B981" Visibility="{Binding IsAgyInstalled, Converter={StaticResource BoolToVisConverter}}" />
                                    <TextBlock Text="{Binding Strings[Label_CliMissing]}" FontSize="11" FontWeight="Bold" Foreground="#EF4444" Visibility="{Binding IsAgyInstalled, Converter={StaticResource InverseBoolToVisConverter}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Collapsed Bottom Controls (Compact Icon-Only) -->
                        <StackPanel Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisConverter}}" HorizontalAlignment="Center">
                            <Button Command="{Binding ToggleSoundCommand}"
                                    Style="{StaticResource ModernButton}"
                                    Padding="7,6"
                                    Margin="0,0,0,8"
                                    ToolTip="{Binding SoundEnabled, StringFormat='{}Sound: {0}'}">
                                <TextBlock Text="🔊" FontSize="13" />
                            </Button>
                            <Border Background="{DynamicResource BrushCard}"
                                    BorderBrush="{DynamicResource BrushCardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Width="26" Height="26"
                                    HorizontalAlignment="Center"
                                    ToolTip="Antigravity CLI Status">
                                <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#10B981" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAgyInstalled}" Value="False">
                                                    <Setter Property="Fill" Value="#EF4444" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- 2. MAIN CONTENT AREA                       -->
            <!-- ========================================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Top Toolbar & Alert Banners -->
                    <RowDefinition Height="Auto" />
                    <!-- Views Container -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Toolbar -->
                <StackPanel Grid.Row="0">
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushCardBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="24,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Current Page Title & Status -->
                                <ColumnDefinition Width="*" />
                                <!-- Action Buttons: Refresh/Sync & Swarm Launch -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Title based on navigation & Live Sync Dot -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentPage}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource BrushTextPrimary}" />
                                    <!-- Open Source MIT Badge (NO PRO!) -->
                                    <Border Background="{DynamicResource BrushBadgeBg}"
                                            BorderBrush="{DynamicResource BrushBadgeBorder}"
                                            BorderThickness="1"
                                            CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Strings[App_VersionBadge]}" Foreground="{DynamicResource BrushBadgeText}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>

                                    <!-- Live Pulsing Green Sync Dot -->
                                    <Grid Width="14" Height="14" Margin="12,0,4,0" VerticalAlignment="Center">
                                        <Ellipse Width="12" Height="12" Fill="#10B981" Opacity="0.3">
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.7" To="0.0" Duration="0:0:1.6" AutoReverse="False" />
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1.0" To="2.0" Duration="0:0:1.6" AutoReverse="False" />
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="1.0" To="2.0" Duration="0:0:1.6" AutoReverse="False" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform CenterX="6" CenterY="6" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse Width="6" Height="6" Fill="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Auto-Sync Status Badge -->
                                    <Border Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="SUCCESS • AUTO-SYNC ACTIVE" Foreground="#10B981" FontSize="10" FontWeight="Bold" />
                                    </Border>

                                    <!-- Last Synced Tag -->
                                    <Border Background="{DynamicResource BrushSurfaceHover}"
                                            BorderBrush="{DynamicResource BrushCardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LastSyncedAtText}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Strings[App_Subtitle]}"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Right CTA: Refresh/Sync and Launch Swarm -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Refresh / Sync Swarm Button -->
                                <Button Command="{Binding SyncSwarmCommand}"
                                        Style="{StaticResource ModernButton}"
                                        Padding="12,8"
                                        Margin="0,0,8,0"
                                        ToolTip="Check profile tokens, detect model sessions, and verify quota limits">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconArrowPath}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                              StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Strings[Btn_SyncSwarm]}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Launch Swarm Button (When Swarm is Idle) -->
                                <Button Command="{Binding LaunchSwarmCommand}"
                                        Style="{StaticResource SwarmButton}"
                                        Padding="14,8"
                                        Visibility="{Binding IsSwarmRunning, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconBolt}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Strings[Btn_LaunchSwarm]}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Text=" (" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedSwarmCount}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Text=")" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Stop Swarm Button (When Swarm is Active) -->
                                <Button Command="{Binding StopSwarmCommand}"
                                        Style="{StaticResource DangerButton}"
                                        Padding="14,8"
                                        Visibility="{Binding IsSwarmRunning, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconStop}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Stop Swarm" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Text=" (" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedSwarmCount}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Text=" Active)" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Quota Exhausted Warning Banner -->
                    <Border Background="{DynamicResource BrushQuotaExhaustedBg}"
                            BorderBrush="{DynamicResource BrushQuotaExhaustedBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="24,9"
                            Visibility="{Binding HasActiveQuotaAlert, Converter={StaticResource BoolToVisConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🚨 " FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding QuotaAlertMessage}"
                                           Foreground="{DynamicResource BrushQuotaExhaustedText}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{Binding Strings[Btn_Dismiss]}"
                                    Command="{Binding DismissQuotaAlertCommand}"
                                    Style="{StaticResource ModernButton}"
                                    Padding="10,4"
                                    FontSize="11" />
                        </Grid>
                    </Border>

                    <!-- Normal Notification Toast Banner -->
                    <Border Background="{DynamicResource BrushAlertBg}"
                            BorderBrush="{DynamicResource BrushAlertBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="24,8"
                            Visibility="{Binding NotificationMessage, Converter={StaticResource NullOrEmptyToVisConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="ℹ️ " VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NotificationMessage}"
                                       Foreground="{DynamicResource BrushAlertText}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============================================================== -->
                <!-- VIEW 1: DASHBOARD (/dashboard)                                 -->
                <!-- ============================================================== -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,24,24,60"
                              PreviewMouseWheel="GlobalScrollViewer_PreviewMouseWheel"
                              Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Dashboard}">
                    <StackPanel>
                        <!-- Top KPI Metrics Row -->
                        <UniformGrid Columns="5" Margin="0,0,0,20">
                            <!-- Card 1: Total Profiles -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings[Card_TotalAccounts]}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Strings[Card_TotalAccounts_Sub]}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Authenticated -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings[Card_Authenticated]}" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" />
                                    <TextBlock Text="{Binding AuthenticatedCount}" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Strings[Card_Authenticated_Sub]}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Swarm Targets -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings[Card_SwarmTargets]}" FontSize="10" FontWeight="SemiBold" Foreground="#3B82F6" />
                                    <TextBlock Text="{Binding SelectedSwarmCount}" FontSize="22" FontWeight="Bold" Foreground="#3B82F6" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Strings[Card_SwarmTargets_Sub]}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Saved Sessions Detected -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings[Card_ActiveSessions]}" FontSize="10" FontWeight="SemiBold" Foreground="#8B5CF6" />
                                    <TextBlock Text="{Binding TotalSavedSessionsCount}" FontSize="22" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Strings[Card_ActiveSessions_Sub]}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 5: MCP Tools Active -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{Binding Strings[Card_McpTools]}" FontSize="10" FontWeight="SemiBold" Foreground="#F59E0B" />
                                    <TextBlock Text="{Binding McpToolsTotalCount}" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Strings[Card_McpTools_Sub]}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- ========================================== -->
                        <!-- DASHBOARD CHART (Bar, Line, Area Modes)    -->
                        <!-- ========================================== -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <!-- Chart Title & Action Row (Row 0) -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Chart Title & Subtitle -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Strings[Chart_Title]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="{Binding Strings[Chart_Subtitle]}" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Header Action Button -->
                                    <Button Grid.Column="1" Command="{Binding ExportPdfReportCommand}"
                                            Style="{StaticResource ModernButton}"
                                            Padding="12,7"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📥 " FontSize="12" />
                                            <TextBlock Text="Download PDF Report" FontWeight="SemiBold" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Dedicated Filter Toolbar Row (Row 1) -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                    <WrapPanel VerticalAlignment="Center">
                                        <!-- Chart Mode Switcher -->
                                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="📊 Bar" Command="{Binding SetChartModeCommand}" CommandParameter="Bar"
                                                        Style="{StaticResource ModernButton}" Padding="10,5" FontSize="12" Margin="0,0,2,0" />
                                                <Button Content="📈 Line" Command="{Binding SetChartModeCommand}" CommandParameter="Line"
                                                        Style="{StaticResource ModernButton}" Padding="10,5" FontSize="12" Margin="0,0,2,0" />
                                                <Button Content="🏔️ Area" Command="{Binding SetChartModeCommand}" CommandParameter="Area"
                                                        Style="{StaticResource ModernButton}" Padding="10,5" FontSize="12" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Zoom Controls -->
                                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="➖" Command="{Binding ChartZoomOutCommand}" Style="{StaticResource ModernButton}" Padding="7,4" FontSize="11" ToolTip="Zoom Out" Margin="0,0,2,0" />
                                                <TextBlock Text="{Binding ChartZoomText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="6,0" />
                                                <Button Content="➕" Command="{Binding ChartZoomInCommand}" Style="{StaticResource ModernButton}" Padding="7,4" FontSize="11" ToolTip="Zoom In" Margin="2,0,2,0" />
                                                <Button Content="100%" Command="{Binding ChartZoomResetCommand}" Style="{StaticResource ModernButton}" Padding="6,4" FontSize="10" ToolTip="Reset Zoom (100%)" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Account Filter -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="Account:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ComboBox ItemsSource="{Binding AccountFilterOptions}"
                                                      SelectedItem="{Binding SelectedAccountFilter}"
                                                      Style="{StaticResource ModernComboBox}"
                                                      Width="140" />
                                        </StackPanel>

                                        <!-- Period Filter -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Strings[Chart_Filter_Period]}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ComboBox ItemsSource="{Binding TimeframeOptions}"
                                                      SelectedItem="{Binding SelectedTimeframe}"
                                                      Style="{StaticResource ModernComboBox}"
                                                      Width="130" />
                                        </StackPanel>

                                        <!-- Model Filter -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Strings[Chart_Filter_Model]}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ComboBox ItemsSource="{Binding ModelFilterOptions}"
                                                      SelectedItem="{Binding SelectedModelFilter}"
                                                      Style="{StaticResource ModernComboBox}"
                                                      Width="180" />
                                        </StackPanel>

                                        <!-- Tier Filter -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Strings[Chart_Filter_Tier]}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ComboBox ItemsSource="{Binding TierFilterOptions}"
                                                      SelectedItem="{Binding SelectedTierFilter}"
                                                      Style="{StaticResource ModernComboBox}"
                                                      Width="110" />
                                        </StackPanel>
                                    </WrapPanel>
                                </Border>

                                <!-- Visual Interactive Chart Canvas Area (Height 340) -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="14,14,14,10" Height="340">
                                    <Grid>
                                        <!-- No Data Placeholder (When genuinely 0 prompts) -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasChartData, Converter={StaticResource InverseBoolToVisConverter}}">
                                            <TextBlock Text="📭" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding Strings[Chart_NoData]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Switch account or timeframe filter above to view historical prompt sessions." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Chart with Y-Axis, Horizontal Gridlines, and Horizontal ScrollViewer -->
                                        <Grid Visibility="{Binding HasChartData, Converter={StaticResource BoolToVisConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <!-- Left Y-Axis Scale -->
                                                <ColumnDefinition Width="42" />
                                                <!-- Plot Canvas & ScrollViewer Area -->
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Y-Axis Labels -->
                                            <Grid Grid.Column="0" Margin="0,18,6,38">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding YTick100}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="1" Text="{Binding YTick75}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="2" Text="{Binding YTick50}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="3" Text="{Binding YTick25}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="3" Text="{Binding YTick0}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                            </Grid>

                                            <!-- Plot Container (Gridlines + ScrollViewer) -->
                                            <Grid Grid.Column="1">
                                                <!-- Horizontal Background Gridlines & Baseline -->
                                                <Grid Margin="0,18,0,38">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Rectangle Grid.Row="0" VerticalAlignment="Top" Height="1" Fill="{DynamicResource BrushCardBorder}" Opacity="0.45" StrokeDashArray="3 3" />
                                                    <Rectangle Grid.Row="1" VerticalAlignment="Top" Height="1" Fill="{DynamicResource BrushCardBorder}" Opacity="0.45" StrokeDashArray="3 3" />
                                                    <Rectangle Grid.Row="2" VerticalAlignment="Top" Height="1" Fill="{DynamicResource BrushCardBorder}" Opacity="0.45" StrokeDashArray="3 3" />
                                                    <Rectangle Grid.Row="3" VerticalAlignment="Top" Height="1" Fill="{DynamicResource BrushCardBorder}" Opacity="0.45" StrokeDashArray="3 3" />
                                                    <Rectangle Grid.Row="3" VerticalAlignment="Bottom" Height="1.5" Fill="{DynamicResource BrushCardBorder}" Opacity="0.8" />
                                                </Grid>

                                                <!-- Horizontal Scrollable Chart Content -->
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                              PreviewMouseWheel="ChartScrollViewer_PreviewMouseWheel">
                                                    <Grid MinWidth="{Binding ChartCanvasWidth}" Height="300" HorizontalAlignment="Left">
                                                        <!-- 1. BAR CHART MODE -->
                                                        <ItemsControl ItemsSource="{Binding DashboardChartPoints}" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                                      Margin="10,0,10,12"
                                                                      Visibility="{Binding SelectedChartMode, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Bar}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Width="76" Margin="6,0" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                                        <StackPanel.ToolTip>
                                                                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                                                                <StackPanel>
                                                                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" />
                                                                                    <TextBlock Text="{Binding Value, StringFormat='Prompts: {0:N0}'}" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" />
                                                                                    <TextBlock Text="{Binding TokensLabel, StringFormat='Est. Tokens: {0}'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,4" />
                                                                                    <Separator Background="{DynamicResource BrushCardBorder}" Margin="0,4" />
                                                                                    <TextBlock Text="{Binding AccountContext, StringFormat='Account: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                    <TextBlock Text="{Binding ModelContext, StringFormat='Model: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </StackPanel.ToolTip>
                                                                        <TextBlock Text="{Binding Value}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                                                        <TextBlock Text="{Binding TokensLabel}" FontSize="9" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                                        <Border Height="{Binding Height}" Width="{Binding Width}" CornerRadius="4,4,0,0"
                                                                                Background="{Binding BarColor, Converter={StaticResource HexToBrushConverter}}"
                                                                                HorizontalAlignment="Center" Cursor="Hand" />
                                                                        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- 2. LINE CHART MODE -->
                                                        <Grid Visibility="{Binding SelectedChartMode, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Line}"
                                                              Width="{Binding ChartCanvasWidth}" Height="290" VerticalAlignment="Center">
                                                            <Canvas Width="{Binding ChartCanvasWidth}" Height="230" VerticalAlignment="Top" Margin="0,15,0,0">
                                                                <Polyline Points="{Binding LinePoints}" Stroke="#3B82F6" StrokeThickness="3.5" StrokeLineJoin="Round" />
                                                            </Canvas>
                                                            <ItemsControl ItemsSource="{Binding DashboardChartPoints}" VerticalAlignment="Bottom" Margin="0,0,0,12">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Rows="1" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel HorizontalAlignment="Center">
                                                                            <StackPanel.ToolTip>
                                                                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                                                                    <StackPanel>
                                                                                        <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" />
                                                                                        <TextBlock Text="{Binding Value, StringFormat='Prompts: {0:N0}'}" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" />
                                                                                        <TextBlock Text="{Binding TokensLabel, StringFormat='Est. Tokens: {0}'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,4" />
                                                                                        <Separator Background="{DynamicResource BrushCardBorder}" Margin="0,4" />
                                                                                        <TextBlock Text="{Binding AccountContext, StringFormat='Account: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                        <TextBlock Text="{Binding ModelContext, StringFormat='Model: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </StackPanel.ToolTip>
                                                                            <TextBlock Text="{Binding Value}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" />
                                                                            <Ellipse Width="10" Height="10" Fill="#3B82F6" Stroke="#FFFFFF" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,4" Cursor="Hand" />
                                                                            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>

                                                        <!-- 3. AREA CHART MODE -->
                                                        <Grid Visibility="{Binding SelectedChartMode, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Area}"
                                                              Width="{Binding ChartCanvasWidth}" Height="290" VerticalAlignment="Center">
                                                            <Canvas Width="{Binding ChartCanvasWidth}" Height="230" VerticalAlignment="Top" Margin="0,15,0,0">
                                                                <Polygon Points="{Binding AreaPoints}" Fill="{StaticResource AreaChartGradient}" />
                                                                <Polyline Points="{Binding LinePoints}" Stroke="#8B5CF6" StrokeThickness="3.5" StrokeLineJoin="Round" />
                                                            </Canvas>
                                                            <ItemsControl ItemsSource="{Binding DashboardChartPoints}" VerticalAlignment="Bottom" Margin="0,0,0,12">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Rows="1" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel HorizontalAlignment="Center">
                                                                            <StackPanel.ToolTip>
                                                                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                                                                    <StackPanel>
                                                                                        <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" />
                                                                                        <TextBlock Text="{Binding Value, StringFormat='Prompts: {0:N0}'}" FontWeight="SemiBold" FontSize="12" Foreground="#8B5CF6" />
                                                                                        <TextBlock Text="{Binding TokensLabel, StringFormat='Est. Tokens: {0}'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,4" />
                                                                                        <Separator Background="{DynamicResource BrushCardBorder}" Margin="0,4" />
                                                                                        <TextBlock Text="{Binding AccountContext, StringFormat='Account: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                        <TextBlock Text="{Binding ModelContext, StringFormat='Model: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </StackPanel.ToolTip>
                                                                            <TextBlock Text="{Binding Value}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" />
                                                                            <Ellipse Width="9" Height="9" Fill="#8B5CF6" Stroke="#FFFFFF" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,4" Cursor="Hand" />
                                                                            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </Grid>
                                                </ScrollViewer>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Swarm Quick Launch Orchestrator Card -->
                        <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="⚡ Concurrent Swarm Orchestrator" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                    <TextBlock Text="Launch multiple Antigravity AI accounts in parallel. Each session is completely isolated with its own credentials and workspace directory."
                                               FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,12" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Launch Mode: " FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox SelectedValue="{Binding SelectedSwarmMode}" Style="{StaticResource ModernComboBox}" Width="160">
                                            <models:SwarmLaunchMode>SplitPanes</models:SwarmLaunchMode>
                                            <models:SwarmLaunchMode>SeparateTabs</models:SwarmLaunchMode>
                                            <models:SwarmLaunchMode>SeparateWindows</models:SwarmLaunchMode>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding LaunchSwarmCommand}" Style="{StaticResource SwarmButton}" Padding="20,12" VerticalAlignment="Center"
                                        Visibility="{Binding IsSwarmRunning, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡ Run Swarm Now" FontWeight="Bold" FontSize="13" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Command="{Binding StopSwarmCommand}" Style="{StaticResource DangerButton}" Padding="20,12" VerticalAlignment="Center"
                                        Visibility="{Binding IsSwarmRunning, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⏹ Stop Swarm Execution" FontWeight="Bold" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Active Swarm Accounts Grid Preview -->
                        <TextBlock Text="Active Account Swarm Workers" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Color Accent Indicator -->
                                            <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{Binding ColorTag, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,12,0" />

                                            <!-- Info & Telemetry Column -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <!-- Row 1: Avatar, Name, Tier, Status, Model & Quota Badges -->
                                                <WrapPanel VerticalAlignment="Center">
                                                    <!-- Circular Cropped Avatar directly to left of Account Name -->
                                                    <Grid Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <!-- Online Profile Picture inside Ellipse -->
                                                        <Ellipse Width="40" Height="40"
                                                                 Stroke="{Binding ColorTag, Converter={StaticResource HexToBrushConverter}}"
                                                                 StrokeThickness="2"
                                                                 RenderOptions.BitmapScalingMode="HighQuality"
                                                                 RenderOptions.ClearTypeHint="Enabled"
                                                                 Visibility="{Binding HasAvatarUrl, Converter={StaticResource BoolToVisConverter}}">
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding AvatarImageSource}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                            </Ellipse.Fill>
                                                        </Ellipse>

                                                        <!-- Fallback Google Circular Initial Badge -->
                                                        <Border Width="40" Height="40" CornerRadius="20"
                                                                Background="{Binding ColorTag, Converter={StaticResource HexToBrushConverter}}"
                                                                Visibility="{Binding HasAvatarUrl, Converter={StaticResource InverseBoolToVisConverter}}">
                                                            <TextBlock Text="{Binding AvatarInitial}" FontWeight="Bold" FontSize="17" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>

                                                        <!-- Mini Google 'G' Accent Dot -->
                                                        <Border Width="13" Height="13" CornerRadius="6.5"
                                                                Background="#FFFFFF" BorderBrush="#4285F4" BorderThickness="1.2"
                                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                Margin="0,0,-1,-1">
                                                            <TextBlock Text="G" FontSize="8" FontWeight="Bold" Foreground="#4285F4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Profile Name -->
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                                    <!-- Tier Badge -->
                                                    <Border CornerRadius="6" Padding="10,3" Margin="0,0,8,0" VerticalAlignment="Center"
                                                            Background="{Binding TierBadgeBackground, Converter={StaticResource HexToBrushConverter}}">
                                                        <TextBlock Text="{Binding TierBadgeText}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                    </Border>

                                                    <!-- Status Badge -->
                                                    <Border CornerRadius="6" Padding="9,3" Margin="0,0,8,0" VerticalAlignment="Center" Background="{DynamicResource BrushSurface}"
                                                            BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBadgeColor, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Model Badge -->
                                                    <Border CornerRadius="6" Padding="9,3" Margin="0,0,8,0" VerticalAlignment="Center"
                                                            Background="{DynamicResource BrushModelBadgeBg}"
                                                            BorderBrush="{DynamicResource BrushModelBadgeBorder}"
                                                            BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🧠 " FontSize="10.5" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding CurrentModel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushModelBadgeText}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Quota Status Badge -->
                                                    <Border CornerRadius="6" Padding="9,3" VerticalAlignment="Center"
                                                            Background="{Binding QuotaStatusColor, Converter={StaticResource HexToBrushConverter}}">
                                                        <TextBlock Text="{Binding QuotaStatusText}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Row 2: Activity Meter (Responsive WrapPanel) -->
                                                <WrapPanel Margin="0,6,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding UsageLabel}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,4" />
                                                    <Border Background="#1538BDF8" BorderBrush="#3038BDF8" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,10,4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SessionUsageLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" />
                                                    </Border>
                                                    <ProgressBar Value="{Binding UsagePercentage, Mode=OneWay}" Height="6" Width="140"
                                                                 Background="{DynamicResource BrushProgressTrack}"
                                                                 Foreground="{Binding DailyUsageBarColor, Converter={StaticResource HexToBrushConverter}}"
                                                                 BorderThickness="0" VerticalAlignment="Center" Margin="0,0,12,4" />
                                                    <TextBlock Text="{Binding QuotaResetCountdown}" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,0,4" />
                                                </WrapPanel>

                                                <!-- Row 3: Antigravity Model Quotas Preview (Gemini & Claude Groups) -->
                                                <WrapPanel Margin="0,4,0,0" VerticalAlignment="Center">
                                                    <!-- Gemini Group -->
                                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="7,2.5" Margin="0,0,8,4">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Gemini: " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                            <TextBlock Text="{Binding GeminiWeeklyRemainingPercent, StringFormat='{}W: {0:F0}%'}" FontSize="10" FontWeight="Bold" Foreground="{Binding GeminiWeeklyBarColor, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding Gemini5HourRemainingPercent, StringFormat='{}5h: {0:F0}%'}" FontSize="10" FontWeight="Bold" Foreground="{Binding Gemini5HourBarColor, Converter={StaticResource HexToBrushConverter}}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Claude / GPT Group -->
                                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="7,2.5" Margin="0,0,8,4">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Claude/GPT: " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                            <TextBlock Text="{Binding ClaudeGptWeeklyRemainingPercent, StringFormat='{}W: {0:F0}%'}" FontSize="10" FontWeight="Bold" Foreground="{Binding ClaudeGptWeeklyBarColor, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding ClaudeGpt5HourRemainingPercent, StringFormat='{}5h: {0:F0}%'}" FontSize="10" FontWeight="Bold" Foreground="{Binding ClaudeGpt5HourBarColor, Converter={StaticResource HexToBrushConverter}}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Weekly Remaining Quota Summary -->
                                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="7,2.5" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding WeeklyRemainingLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Quick Launch Action -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding LaunchCommand}"
                                                        CommandParameter="{Binding DataContext.SelectedTerminal, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource HeroIconPlay}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Launch" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding OpenProfileFolderCommand}" Style="{StaticResource ModernButton}" Padding="8,6" ToolTip="Open Profile Folder">
                                                    <Path Data="{StaticResource HeroIconFolder}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" StrokeThickness="1.75" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bottom Breathing Room Spacer -->
                        <Border Height="60" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================================================== -->
                <!-- VIEW 2: ACCOUNTS (/accounts)                                   -->
                <!-- ============================================================== -->
                <Grid Grid.Row="1"
                      Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Accounts}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Accounts Toolbar -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BrushSurfaceHover}"
                            BorderBrush="{DynamicResource BrushCardBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="24,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Far-Left: Filters Toggle Button & Popup (Col 0) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Button x:Name="AccountsFilterButton"
                                        Command="{Binding ToggleAccountsFilterPopupCommand}"
                                        Style="{StaticResource ModernButton}"
                                        Padding="11,6"
                                        FontSize="11">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconFunnel}"
                                              Stroke="{Binding HasActiveAccountsFilters, Converter={StaticResource BoolToFilterAccentConverter}}"
                                              StrokeThickness="1.75"
                                              Width="12" Height="12"
                                              Stretch="Uniform"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="Filters" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <!-- Active filter badge -->
                                        <Border Background="#3B82F6"
                                                CornerRadius="8"
                                                Padding="5,1"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasActiveAccountsFilters, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="{Binding ActiveAccountsFilterCount}"
                                                       FontSize="9.5"
                                                       FontWeight="Bold"
                                                       Foreground="#FFFFFF" />
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <!-- Filters Popup -->
                                <Popup PlacementTarget="{Binding ElementName=AccountsFilterButton}"
                                       Placement="Bottom"
                                       IsOpen="{Binding IsAccountsFilterPopupOpen}"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Slide">
                                    <Border Background="{DynamicResource BrushCard}"
                                            BorderBrush="{DynamicResource BrushCardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16"
                                            Margin="0,6,0,0"
                                            Width="300">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.35" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <!-- Title & Reset -->
                                            <Grid Margin="0,0,0,12">
                                                <TextBlock Text="Filter &amp; Sort Accounts"
                                                           FontWeight="Bold"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           VerticalAlignment="Center" />
                                                <Button Command="{Binding ResetAccountsFiltersCommand}"
                                                        HorizontalAlignment="Right"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="4,2"
                                                        Cursor="Hand">
                                                    <TextBlock Text="Reset"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="#3B82F6" />
                                                </Button>
                                            </Grid>

                                            <!-- Filter: Subscription Tier -->
                                            <TextBlock Text="Subscription Tier"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextMuted}"
                                                       Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding AccountsTierFilterOptions}"
                                                      SelectedItem="{Binding AccountsTierFilter}"
                                                      Style="{StaticResource ModernComboBox}"
                                                      Height="30"
                                                      FontSize="11"
                                                      Margin="0,0,0,10" />

                                            <!-- Filter: Account Health / Status -->
                                            <TextBlock Text="Status / Quota Health"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextMuted}"
                                                       Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding AccountsHealthFilterOptions}"
                                                      SelectedItem="{Binding AccountsHealthFilter}"
                                                      Style="{StaticResource ModernComboBox}"
                                                      Height="30"
                                                      FontSize="11"
                                                      Margin="0,0,0,10" />

                                            <!-- Sort Order -->
                                            <TextBlock Text="Sort By"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextMuted}"
                                                       Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding AccountsSortOptions}"
                                                      SelectedItem="{Binding AccountsSortBy}"
                                                      Style="{StaticResource ModernComboBox}"
                                                      Height="30"
                                                      FontSize="11"
                                                      Margin="0,0,0,14" />

                                            <!-- Done / Apply Button -->
                                            <Button Command="{Binding CloseAccountsFilterPopupCommand}"
                                                    Content="Close"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Padding="0,6"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>

                            <!-- Search (Col 1) -->
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     ToolTip="{Binding Strings[Accounts_SearchPlaceholder]}" />

                            <!-- Select All (Col 2) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                <Button Content="{Binding Strings[Accounts_SelectAll]}"
                                        Command="{Binding ToggleSelectAllSwarmCommand}"
                                        Style="{StaticResource ModernButton}"
                                        Padding="11,6"
                                        FontSize="11" />
                            </StackPanel>

                            <!-- Right Actions: New Profile (Col 3) -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding AddProfileCommand}"
                                        Style="{StaticResource PrimaryButton}" Padding="14,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconPlus}"
                                              Stroke="#FFFFFF" StrokeThickness="2.2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Strings[Accounts_NewProfile]}" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Accounts Cards List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16,24,60"
                                  PreviewMouseWheel="AccountsScrollViewer_PreviewMouseWheel">
                        <StackPanel>

                            <ItemsControl ItemsSource="{Binding FilteredProfiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushCard}"
                                            BorderBrush="{DynamicResource BrushCardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Margin="0,0,0,16"
                                            Padding="18,16">
                                        <StackPanel>
                                            <!-- Row 1: Profile Header + Top-Right Swarm Checkbox (3-Column Clean Layout) -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Col 0: Dedicated Circular Avatar (48x48) -->
                                                <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Top">
                                                    <!-- Online Google Profile Picture (if available) clipped inside Ellipse -->
                                                    <Ellipse Width="48" Height="48"
                                                             Stroke="{Binding ColorTag, Converter={StaticResource HexToBrushConverter}}"
                                                             StrokeThickness="2"
                                                             RenderOptions.BitmapScalingMode="HighQuality"
                                                             RenderOptions.ClearTypeHint="Enabled"
                                                             Visibility="{Binding HasAvatarUrl, Converter={StaticResource BoolToVisConverter}}">
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding AvatarImageSource}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>

                                                    <!-- Fallback Google Circular Initial Badge -->
                                                    <Border Width="48" Height="48" CornerRadius="24"
                                                            Background="{Binding ColorTag, Converter={StaticResource HexToBrushConverter}}"
                                                            Visibility="{Binding HasAvatarUrl, Converter={StaticResource InverseBoolToVisConverter}}">
                                                        <TextBlock Text="{Binding AvatarInitial}"
                                                                   FontWeight="Bold" FontSize="19"
                                                                   Foreground="#FFFFFF"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Online / Offline Swarm Status Indicator Dot -->
                                                    <Border Width="14" Height="14" CornerRadius="7"
                                                            Background="{Binding SwarmStatusColor, Converter={StaticResource HexToBrushConverter}}"
                                                            BorderBrush="{DynamicResource BrushCard}" BorderThickness="2"
                                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                            Margin="0,0,-1,-1"
                                                            ToolTip="{Binding SwarmStatusTooltip}" />
                                                </Grid>

                                                <!-- Col 1: Identity & Badges in Structured Multi-Row Layout -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <!-- Row 1a: Name, Primary Default, Tier & Quota Health -->
                                                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,5">
                                                        <!-- Profile Name -->
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,10,2" />

                                                        <!-- System Primary Profile Badge -->
                                                        <Border CornerRadius="6" Padding="8,3" Margin="0,0,8,2" VerticalAlignment="Center"
                                                                Background="#1510B981" BorderBrush="#3510B981" BorderThickness="1"
                                                                Visibility="{Binding IsDefaultProfile, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="Primary Default" FontSize="10.5" FontWeight="Bold" Foreground="#10B981" />
                                                        </Border>

                                                        <!-- Tier Badge -->
                                                        <Border CornerRadius="6" Padding="10,3" Margin="0,0,8,2" VerticalAlignment="Center"
                                                                Background="{Binding TierBadgeBackground, Converter={StaticResource HexToBrushConverter}}">
                                                            <TextBlock Text="{Binding TierBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                        </Border>

                                                        <!-- Quota Health Badge -->
                                                        <Border CornerRadius="6" Padding="9,3" Margin="0,0,8,2" VerticalAlignment="Center"
                                                                Background="{Binding QuotaStatusColor, Converter={StaticResource HexToBrushConverter}}">
                                                            <TextBlock Text="{Binding QuotaStatusText}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                                        </Border>
                                                    </WrapPanel>

                                                    <!-- Row 1b: Account Status Email & Model Badge -->
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <!-- Status Badge (Logged in email or Needs Login) -->
                                                        <Border CornerRadius="6" Padding="9,3" Margin="0,0,8,2" VerticalAlignment="Center"
                                                                Background="{DynamicResource BrushSurface}"
                                                                BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse Width="8" Height="8" Fill="{Binding StatusBadgeColor, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Model Badge -->
                                                        <Border CornerRadius="6" Padding="9,3" Margin="0,0,8,2" VerticalAlignment="Center"
                                                                Background="{DynamicResource BrushModelBadgeBg}"
                                                                BorderBrush="{DynamicResource BrushModelBadgeBorder}" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="🧠 " FontSize="10" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding CurrentModel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushModelBadgeText}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- Col 2: Top-Right Quick Sync Button & Swarm Checkbox Pill -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
                                                    <!-- Small Quick Sync Button for this account -->
                                                    <Button Command="{Binding SingleSyncCommand}"
                                                            Style="{StaticResource ModernButton}"
                                                            Padding="7,4" Margin="0,0,6,0"
                                                            ToolTip="Refresh credentials, tokens, and live quota telemetry for this account">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource HeroIconArrowPath}"
                                                                  Stroke="{DynamicResource BrushTextSecondary}"
                                                                  StrokeThickness="1.75" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="Sync" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Swarm Checkbox Pill -->
                                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="9,4" VerticalAlignment="Center" ToolTip="Include profile in Swarm Launch (⚡ Launch Swarm)">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <CheckBox IsChecked="{Binding IsSelectedForSwarm}"
                                                                      Style="{StaticResource ModernCheckBox}"
                                                                      Margin="0,0,6,0"
                                                                      VerticalAlignment="Center" />
                                                            <TextBlock Text="Swarm" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 2: Description & Sandbox Paths -->
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"
                                                           Visibility="{Binding Description, Converter={StaticResource NullOrEmptyToVisConverter}}" />
                                                <WrapPanel VerticalAlignment="Center">
                                                    <Border Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="6,2" Margin="0,0,8,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📁 Sandbox: " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                            <TextBlock Text="{Binding EffectiveProfilePath}" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{DynamicResource BrushMonoPath}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="6,2" Margin="0,0,8,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📂 Workspace: " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                            <TextBlock Text="{Binding DisplayWorkspace}" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Horizontal Accent Line (<hr>) & Diagnostics Fold Toggle Button -->
                                            <Grid Margin="0,4,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Height="2" CornerRadius="1"
                                                        Background="{Binding ColorTag, Converter={StaticResource HexToBrushConverter}}"
                                                        VerticalAlignment="Center" Opacity="0.85" />
                                                <Button Grid.Column="1" Command="{Binding ToggleDetailsCommand}"
                                                        Style="{StaticResource ModernButton}"
                                                        Background="{DynamicResource BrushSurface}"
                                                        BorderBrush="{DynamicResource BrushCardBorder}"
                                                        BorderThickness="1"
                                                        Padding="12,4" Margin="10,0" Cursor="Hand"
                                                        ToolTip="Toggle expandable detailed quota analytics, token burn-rate, and Profile Doctor">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource HeroIconShieldCheck}"
                                                              Stroke="{Binding ColorTag, Converter={StaticResource HexToBrushConverter}}"
                                                              StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DetailsToggleText}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Border Grid.Column="2" Height="2" CornerRadius="1"
                                                        Background="{Binding ColorTag, Converter={StaticResource HexToBrushConverter}}"
                                                        VerticalAlignment="Center" Opacity="0.85" />
                                            </Grid>

                                            <!-- Collapsible Details & Diagnostics Section (Default Folded) -->
                                            <StackPanel Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BoolToVisConverter}}">

                                            <!-- Quota Depletion / Toast Warning Banner (if near exhaustion <= 20% or exhausted) -->
                                            <Border Visibility="{Binding IsNearQuotaExhausted, Converter={StaticResource BoolToVisConverter}}"
                                                    Background="#1DF87171" BorderBrush="#60EF4444" BorderThickness="1"
                                                    CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="⚠️ " FontSize="12" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding QuotaToastAlertText}" FontSize="11" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center" />
                                                        <TextBlock Text=" • " FontSize="11" Foreground="#EF4444" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ExhaustionForecastText}" FontSize="11" Foreground="#EF4444" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="Suggested: Switch to another swarm account" FontSize="10.5" Foreground="#F87171" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <!-- ============================================================== -->
                                            <!-- FOLDABLE SECTION 1: VELOCITY & DEPLETION FORECAST              -->
                                            <!-- ============================================================== -->
                                            <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <!-- Accordion Header Button -->
                                                    <Button Command="{Binding ToggleDailyQuotaSectionCommand}"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="14,10" HorizontalContentAlignment="Stretch">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding IsDailyQuotaExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                                                           FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="⚡ VELOCITY &amp; DEPLETION FORECAST" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                <Border Background="{DynamicResource BrushCardBorder}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding TierDailySummary}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                </Border>
                                                                <Border Background="#15F59E0B" BorderBrush="#30F59E0B" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding BurnRateFormatted, StringFormat='{}🔥 {0}'}" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" />
                                                                </Border>
                                                                <Border Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding UsagePercentage, StringFormat='{}{0:F1}% used'}" FontSize="10" FontWeight="Bold" Foreground="{Binding DailyUsageBarColor, Converter={StaticResource HexToBrushConverter}}" />
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- Right: Reset Countdown -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="⏱️ Reset: " FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding QuotaResetCountdown}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>

                                                    <!-- Accordion Body (Collapsible) -->
                                                    <StackPanel Visibility="{Binding IsDailyQuotaExpanded, Converter={StaticResource BoolToVisConverter}}" Margin="14,0,14,12">
                                                        <!-- Full-width Progress Bar with Dynamic Color (Green / Yellow / Red) -->
                                                        <ProgressBar Value="{Binding UsagePercentage, Mode=OneWay}"
                                                                     Height="7" Minimum="0" Maximum="100"
                                                                     Background="{DynamicResource BrushProgressTrack}"
                                                                     Foreground="{Binding DailyUsageBarColor, Converter={StaticResource HexToBrushConverter}}"
                                                                     BorderThickness="0"
                                                                     Margin="0,0,0,8" />

                                                        <!-- Meaningful Headroom, Sessions, Tokens, and Velocity -->
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding HeadroomSummaryText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding SessionsCountText}" FontSize="10.5" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding TodayTokensFormatted}" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            </WrapPanel>
                                                            <Border Grid.Column="1" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="5" Padding="8,4" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="⏳ " FontSize="10" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding ExhaustionForecastText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding ExhaustionBadgeColor, Converter={StaticResource HexToBrushConverter}}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                                <!-- ============================================================== -->
                                                <!-- FOLDABLE SECTION 2: ANTIGRAVITY MODEL QUOTAS (/usage Groups)  -->
                                                <!-- ============================================================== -->
                                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <!-- Accordion Header Button -->
                                                        <Button Command="{Binding ToggleModelQuotasSectionCommand}"
                                                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="14,10" HorizontalContentAlignment="Stretch">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding IsModelQuotasExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                                                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="📊 ANTIGRAVITY MODEL QUOTAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                    <Border Background="#1538BDF8" BorderBrush="#3038BDF8" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                        <TextBlock Text="Gemini, Claude &amp; GPT Limits" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" />
                                                                    </Border>
                                                                </StackPanel>

                                                                <!-- Right: Quick Summary Pill -->
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="Gemini: " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding GeminiWeeklyRemainingPercent, StringFormat='{}{0:F0}%'}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding GeminiWeeklyBarColor, Converter={StaticResource HexToBrushConverter}}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                    <TextBlock Text="Claude: " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding ClaudeGptWeeklyRemainingPercent, StringFormat='{}{0:F0}%'}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding ClaudeGptWeeklyBarColor, Converter={StaticResource HexToBrushConverter}}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>

                                                        <!-- Accordion Body (Collapsible) -->
                                                        <StackPanel Visibility="{Binding IsModelQuotasExpanded, Converter={StaticResource BoolToVisConverter}}" Margin="14,0,14,12">
                                                            <Grid Margin="0,0,0,10">
                                                                <Grid.ColumnDefinitions>
                                                                    <!-- Left: Gemini Models Group -->
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="14" />
                                                                    <!-- Right: Claude and GPT Models Group -->
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Group 1: GEMINI MODELS -->
                                                                <Border Grid.Column="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                                    <StackPanel>
                                                                        <!-- Group Header -->
                                                                        <Grid Margin="0,0,0,4">
                                                                            <TextBlock Text="GEMINI MODELS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                            <Border Background="#153B82F6" BorderBrush="#303B82F6" BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                                                                                <TextBlock Text="Flash, Pro" FontSize="9.5" FontWeight="SemiBold" Foreground="#3B82F6" />
                                                                            </Border>
                                                                        </Grid>
                                                                        <TextBlock Text="Models within this group: Gemini Flash, Gemini Pro" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8" />

                                                                        <!-- Metric 1: Weekly Limit Remaining -->
                                                                        <Grid Margin="0,0,0,3">
                                                                            <TextBlock Text="Weekly Limit Remaining" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                            <TextBlock Text="{Binding GeminiWeeklyRemainingPercent, StringFormat='{}{0:F2}%'}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding GeminiWeeklyBarColor, Converter={StaticResource HexToBrushConverter}}" HorizontalAlignment="Right" />
                                                                        </Grid>
                                                                        <ProgressBar Value="{Binding GeminiWeeklyRemainingPercent, Mode=OneWay}" Height="5" Minimum="0" Maximum="100"
                                                                                     Background="{DynamicResource BrushProgressTrack}" Foreground="{Binding GeminiWeeklyBarColor, Converter={StaticResource HexToBrushConverter}}"
                                                                                     BorderThickness="0" Margin="0,0,0,3" />
                                                                        <TextBlock Text="{Binding GeminiWeeklyRefreshesIn, StringFormat='{}Refreshes in {0}'}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8" />

                                                                        <!-- Metric 2: Five Hour Limit Remaining -->
                                                                        <Grid Margin="0,0,0,3">
                                                                            <TextBlock Text="Five Hour Limit Remaining" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                            <TextBlock Text="{Binding Gemini5HourRemainingPercent, StringFormat='{}{0:F2}%'}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding Gemini5HourBarColor, Converter={StaticResource HexToBrushConverter}}" HorizontalAlignment="Right" />
                                                                        </Grid>
                                                                        <ProgressBar Value="{Binding Gemini5HourRemainingPercent, Mode=OneWay}" Height="5" Minimum="0" Maximum="100"
                                                                                     Background="{DynamicResource BrushProgressTrack}" Foreground="{Binding Gemini5HourBarColor, Converter={StaticResource HexToBrushConverter}}"
                                                                                     BorderThickness="0" Margin="0,0,0,3" />
                                                                        <TextBlock Text="{Binding Gemini5HourRefreshesIn, StringFormat='{}Refreshes in {0}'}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" />
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Group 2: CLAUDE AND GPT MODELS -->
                                                                <Border Grid.Column="2" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                                    <StackPanel>
                                                                        <!-- Group Header -->
                                                                        <Grid Margin="0,0,0,4">
                                                                            <TextBlock Text="CLAUDE AND GPT MODELS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                            <Border Background="#158B5CF6" BorderBrush="#308B5CF6" BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                                                                                <TextBlock Text="Opus, Sonnet, GPT-OSS" FontSize="9.5" FontWeight="SemiBold" Foreground="#8B5CF6" />
                                                                            </Border>
                                                                        </Grid>
                                                                        <TextBlock Text="Models within this group: Claude Opus, Claude Sonnet, GPT-OSS" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8" />

                                                                        <!-- Metric 1: Weekly Limit Remaining -->
                                                                        <Grid Margin="0,0,0,3">
                                                                            <TextBlock Text="Weekly Limit Remaining" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                            <TextBlock Text="{Binding ClaudeGptWeeklyRemainingPercent, StringFormat='{}{0:F2}%'}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding ClaudeGptWeeklyBarColor, Converter={StaticResource HexToBrushConverter}}" HorizontalAlignment="Right" />
                                                                        </Grid>
                                                                        <ProgressBar Value="{Binding ClaudeGptWeeklyRemainingPercent, Mode=OneWay}" Height="5" Minimum="0" Maximum="100"
                                                                                     Background="{DynamicResource BrushProgressTrack}" Foreground="{Binding ClaudeGptWeeklyBarColor, Converter={StaticResource HexToBrushConverter}}"
                                                                                     BorderThickness="0" Margin="0,0,0,3" />
                                                                        <TextBlock Text="{Binding ClaudeGptWeeklyRefreshesIn, StringFormat='{}Refreshes in {0}'}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8" />

                                                                        <!-- Metric 2: Five Hour Limit Remaining -->
                                                                        <Grid Margin="0,0,0,3">
                                                                            <TextBlock Text="Five Hour Limit Remaining" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                            <TextBlock Text="{Binding ClaudeGpt5HourRemainingPercent, StringFormat='{}{0:F2}%'}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding ClaudeGpt5HourBarColor, Converter={StaticResource HexToBrushConverter}}" HorizontalAlignment="Right" />
                                                                        </Grid>
                                                                        <ProgressBar Value="{Binding ClaudeGpt5HourRemainingPercent, Mode=OneWay}" Height="5" Minimum="0" Maximum="100"
                                                                                     Background="{DynamicResource BrushProgressTrack}" Foreground="{Binding ClaudeGpt5HourBarColor, Converter={StaticResource HexToBrushConverter}}"
                                                                                     BorderThickness="0" Margin="0,0,0,3" />
                                                                        <TextBlock Text="{Binding ClaudeGpt5HourRefreshesIn, StringFormat='{}Refreshes in {0}'}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>

                                                            <!-- Explanatory Note Callout (Authentic agy cli text) -->
                                                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="5" Padding="10,7">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Width="3" Background="#8B5CF6" CornerRadius="1.5" Margin="0,0,8,0" />
                                                                    <TextBlock Grid.Column="1" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" LineHeight="14">
                                                                        Within each group, models share a weekly limit and a 5-hour limit. Quota is consumed proportionally to token cost. The 5-hour limit smooths out aggregate demand to fairly distribute capacity, while weekly limit reflects your subscription tier.
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- ============================================================== -->
                                                <!-- FOLDABLE SECTION 3: PROFILE DOCTOR (Cek Kesehatan Jeroan AGY) -->
                                                <!-- ============================================================== -->
                                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <!-- Accordion Header Bar -->
                                                        <Border Padding="14,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource HeroIconShieldCheck}" Stroke="#3B82F6" StrokeThickness="1.75" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="PROFILE DOCTOR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                    <Border Background="{DynamicResource BrushCardBorder}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                        <TextBlock Text="CLI &amp; Profile Diagnostics" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                    </Border>
                                                                    <Border Background="{Binding DoctorSummaryColor, Converter={StaticResource HexToBrushConverter}}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DoctorSummaryPill}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                    </Border>
                                                                </StackPanel>

                                                                <!-- Right: Doctor Action Button & Chevron -->
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Command="{Binding RunDoctorCommand}"
                                                                            IsEnabled="{Binding IsDoctorRunning, Converter={StaticResource InverseBoolConverter}}"
                                                                            Style="{StaticResource ModernButton}" Padding="10,4" Margin="0,0,6,0" Cursor="Hand"
                                                                            ToolTip="Audit 5 system checkpoints: CLI version, OAuth tokens, stuck lock files, trusted workspaces, and /usage schema">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Path Data="{StaticResource HeroIconShieldCheck}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" StrokeThickness="1.75" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding DoctorButtonText}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button Command="{Binding ToggleDoctorReportCommand}"
                                                                            Visibility="{Binding HasDoctorReport, Converter={StaticResource BoolToVisConverter}}"
                                                                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrushTextMuted}" Cursor="Hand" Padding="4,2">
                                                                        <TextBlock Text="{Binding IsDoctorReportExpanded, Converter={StaticResource BoolToChevronConverter}}" FontWeight="Bold" FontSize="12" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Expanded Diagnostic Checklist -->
                                                        <StackPanel Visibility="{Binding IsDoctorReportExpanded, Converter={StaticResource BoolToVisConverter}}" Margin="14,0,14,12">
                                                            <ItemsControl ItemsSource="{Binding DoctorReport.Checks}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,0,0,6">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                                    <TextBlock Text="{Binding Message}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,1,0,0" TextWrapping="Wrap" />
                                                                                </StackPanel>
                                                                                <Border Grid.Column="2" Background="{Binding StatusBadgeColor, Converter={StaticResource HexToBrushConverter}}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding Status}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Quick Actions: Clean Locks & Trust Workspace -->
                                                            <WrapPanel Margin="0,4,0,0">
                                                                <Button Command="{Binding CleanLocksCommand}"
                                                                        Visibility="{Binding DoctorReport.LockFilesCount, Converter={StaticResource IntToVisConverter}}"
                                                                        Style="{StaticResource DangerButton}" Padding="10,5" Margin="0,0,8,4" Cursor="Hand"
                                                                        ToolTip="Clean up all stuck .lock files left in this account sandbox">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="🧹 Clear " />
                                                                        <TextBlock Text="{Binding DoctorReport.LockFilesCount}" />
                                                                        <TextBlock Text=" Stuck Lock(s)" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Command="{Binding TrustWorkspaceCommand}"
                                                                        Style="{StaticResource ModernButton}" Padding="10,5" Margin="0,0,8,4" Cursor="Hand"
                                                                        ToolTip="Register workspace directory to ~/.gemini/settings.json trustedWorkspaces">
                                                                    <TextBlock Text="🛡️ Register Workspace as Trusted" />
                                                                </Button>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                                <!-- Row 4: Action Toolbar (2-Row Layout: Row 1 = Session + Start, Row 2 = Actions) -->
                                                <StackPanel>
                                                    <!-- Row 4a: Start Conversation / Launch -->
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Session Selector with In-Popup Search Filter & Smooth Scrolling -->
                                                        <Border Grid.Column="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="6,3" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="💬 Start:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="4,0,8,0" />

                                                                <!-- Dropdown Trigger Button -->
                                                                <ToggleButton x:Name="SessionDropdownBtn" Grid.Column="1"
                                                                              IsChecked="{Binding IsSessionDropdownOpen, Mode=TwoWay}"
                                                                              Height="28" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="4,0"
                                                                              ToolTip="Click to select past conversation or start fresh">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="6,4">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Grid.Column="0"
                                                                                               Text="{Binding SelectedSession.DisplayText, FallbackValue='🆕 Start Fresh Session (New Chat)'}"
                                                                                               FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"
                                                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                                    <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource BrushTextMuted}" StrokeThickness="1.5"
                                                                                          Width="8" Height="5" Stretch="Uniform" VerticalAlignment="Center" Margin="8,0,4,0" />
                                                                                </Grid>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource BrushHover}" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                </ToggleButton>

                                                                <!-- Searchable Dropdown Popup -->
                                                                <Popup x:Name="SessionPopup"
                                                                       PlacementTarget="{Binding ElementName=SessionDropdownBtn}"
                                                                       Placement="Bottom"
                                                                       IsOpen="{Binding IsChecked, ElementName=SessionDropdownBtn, Mode=TwoWay}"
                                                                       StaysOpen="False"
                                                                       AllowsTransparency="True"
                                                                       PopupAnimation="Slide"
                                                                       VerticalOffset="4"
                                                                       DataContext="{Binding}">
                                                                    <Border x:Name="SessionPopupRoot"
                                                                            DataContext="{Binding DataContext, ElementName=SessionPopup}"
                                                                            Background="{DynamicResource BrushPopupBg}"
                                                                            BorderBrush="{DynamicResource BrushCardBorder}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="8"
                                                                            Padding="8"
                                                                            MinWidth="340"
                                                                            MaxWidth="520"
                                                                            MaxHeight="360">
                                                                        <Border.Effect>
                                                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35" Direction="270" Color="#000000" />
                                                                        </Border.Effect>
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="*" />
                                                                            </Grid.RowDefinitions>

                                                                            <!-- Search Input Row Inside Popup -->
                                                                            <Border Grid.Row="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}"
                                                                                    BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Path Grid.Column="0" Data="{StaticResource HeroIconMagnifyingGlass}" Stroke="{DynamicResource BrushTextMuted}"
                                                                                          StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                                    <TextBox Grid.Column="1"
                                                                                             Text="{Binding SessionSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                                                             FontSize="11" BorderThickness="0" Background="Transparent"
                                                                                             Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"
                                                                                             ToolTip="Type to filter past conversations..." />
                                                                                    <Button Grid.Column="2" Command="{Binding ClearSessionSearchCommand}"
                                                                                            Visibility="{Binding SessionSearchText.Length, Converter={StaticResource IntToVisConverter}}"
                                                                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2" Margin="2,0,0,0"
                                                                                            ToolTip="Clear search">
                                                                                        <Path Data="M 0,0 L 7,7 M 7,0 L 0,7" Stroke="{DynamicResource BrushTextMuted}" StrokeThickness="1.5"
                                                                                              Width="7" Height="7" Stretch="Uniform" />
                                                                                    </Button>
                                                                                </Grid>
                                                                            </Border>

                                                                            <!-- Filtered Conversations List with Smooth Scrolling -->
                                                                            <ScrollViewer Grid.Row="1" MaxHeight="280" CanContentScroll="False"
                                                                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                                                <StackPanel>
                                                                                    <ItemsControl ItemsSource="{Binding FilteredSessions}">
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate>
                                                                                                <Button Command="{Binding DataContext.SelectSessionCommand, ElementName=SessionPopupRoot}"
                                                                                                        CommandParameter="{Binding}"
                                                                                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                                                        HorizontalContentAlignment="Stretch" Padding="8,6" Margin="0,1">
                                                                                                    <Button.Template>
                                                                                                        <ControlTemplate TargetType="Button">
                                                                                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                                                                <Grid>
                                                                                                                    <Grid.ColumnDefinitions>
                                                                                                                        <ColumnDefinition Width="*" />
                                                                                                                        <ColumnDefinition Width="Auto" />
                                                                                                                    </Grid.ColumnDefinitions>
                                                                                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayText}" FontSize="11"
                                                                                                                               Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                                                                    <Path x:Name="CheckIcon" Grid.Column="1" Data="M 1,4 L 4,7 L 9,1" Stroke="#10B981" StrokeThickness="2"
                                                                                                                          Width="9" Height="7" Stretch="Uniform" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                                                                                                </Grid>
                                                                                                            </Border>
                                                                                                            <ControlTemplate.Triggers>
                                                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushHover}" />
                                                                                                                </Trigger>
                                                                                                            </ControlTemplate.Triggers>
                                                                                                        </ControlTemplate>
                                                                                                    </Button.Template>
                                                                                                </Button>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>

                                                                                    <!-- Empty State text if no conversations match filter -->
                                                                                    <TextBlock Text="No conversations match search query"
                                                                                               FontSize="11" Foreground="{DynamicResource BrushTextMuted}"
                                                                                               HorizontalAlignment="Center" Margin="12,16"
                                                                                               Visibility="{Binding HasNoMatchingSessions, Converter={StaticResource BoolToVisConverter}}" />
                                                                                </StackPanel>
                                                                            </ScrollViewer>
                                                                        </Grid>
                                                                    </Border>
                                                                </Popup>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Launch / Start Conversation Button -->
                                                        <Button Grid.Column="1" Command="{Binding LaunchCommand}"
                                                                CommandParameter="{Binding DataContext.SelectedTerminal, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Style="{StaticResource PrimaryButton}" Padding="18,8"
                                                                ToolTip="Launch Antigravity CLI session with chosen session mode">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource HeroIconPlay}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="Start Conversation" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Row 4b: One Single Horizontal Row for Utility and Management Actions -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Left Actions: Copy CLI & Open Folder -->
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Command="{Binding CopyCliSnippetCommand}"
                                                                    CommandParameter="{Binding DataContext.SelectedTerminal, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Style="{StaticResource ModernButton}" Padding="12,7" Margin="0,0,8,0"
                                                                    ToolTip="Copy isolated terminal launch command to clipboard">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource HeroIconClipboard}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" StrokeThickness="1.75" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="Copy CLI" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Command="{Binding OpenProfileFolderCommand}" Style="{StaticResource ModernButton}" Padding="12,7" Margin="0,0,8,0" ToolTip="Open isolated profile sandbox directory">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource HeroIconFolder}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" StrokeThickness="1.75" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="Open Folder" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Command="{Binding RequestImportChatCommand}" Style="{StaticResource ModernButton}" Padding="12,7" ToolTip="Import past chat conversations from another account into this profile">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource HeroIconArrowsRightLeft}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" StrokeThickness="1.75" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="Import Chat" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>

                                                        <!-- Right Actions: Duplicate, Edit Profile, Delete (Delete hidden for Default Account) -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Command="{Binding RequestDuplicateCommand}" Style="{StaticResource ModernButton}" Padding="12,7" Margin="0,0,8,0" ToolTip="Duplicate profile and clone settings">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource HeroIconDocumentDuplicate}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" StrokeThickness="1.75" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="Duplicate" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Command="{Binding RequestEditCommand}" Style="{StaticResource ModernButton}" Padding="12,7" Margin="0,0,8,0" ToolTip="Edit profile settings and preferences">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource HeroIconPencil}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" StrokeThickness="1.75" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="Edit Profile" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Command="{Binding RequestDeleteCommand}"
                                                                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisConverter}}"
                                                                    Style="{StaticResource DangerButton}" Padding="12,7" ToolTip="Remove profile from manager">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource HeroIconTrash}" Stroke="#EF4444" StrokeThickness="1.75" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="Delete" FontWeight="Bold" FontSize="11" Foreground="#EF4444" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bottom Breathing Room Spacer -->
                        <Border Height="60" />
                    </StackPanel>
                </ScrollViewer>
                </Grid>

                <!-- ============================================================== -->
                <!-- VIEW: SWARM CHAT & PROJECT ORCHESTRATOR (/dispatcher)             -->
                <!-- ============================================================== -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,24,24,60"
                              PreviewMouseWheel="GlobalScrollViewer_PreviewMouseWheel"
                              Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Dispatcher}">
                    <StackPanel MaxWidth="1050" HorizontalAlignment="Center">
                        <!-- Swarm Chat Header Card -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="24" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="💬 Swarm Chat &amp; Project Orchestrator" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock Text="MULTI-PROJECT" FontSize="9.5" FontWeight="Bold" Foreground="#60A5FA" />
                                        </Border>
                                        <Border Background="{DynamicResource BrushWarningAlertBg}" BorderBrush="{DynamicResource BrushWarningAlertBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="INTER-CLI BUS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushWarningAlertText}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Autonomous multi-agent project collaboration, shared blackboard architecture, inter-worker telemetry bus, and coordinated git worktree execution."
                                               FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding OpenCreateProjectDialogCommand}" Style="{StaticResource PrimaryButton}" Background="#3B82F6" Padding="14,8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕ New Project" FontWeight="Bold" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- EMPTY STATE: No Swarm Projects Configured -->
                        <Border Visibility="{Binding HasProjects, Converter={StaticResource InverseBoolToVisConverter}}"
                                Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1"
                                CornerRadius="12" Padding="40,48" Margin="0,0,0,16">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="580">
                                <Path Data="{StaticResource HeroIconChatBubbleOvalLeftEllipsis}"
                                      Stroke="#3B82F6" StrokeThickness="1.75"
                                      Width="52" Height="52" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,18" />
                                <TextBlock Text="No Swarm Projects Configured" FontSize="19" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="To dispatch and orchestrate autonomous AI worker swarms, create a project context first. Each project isolates repositories, tech stacks, and worker sandbox workspaces with a shared .swarm/ communication bus."
                                           FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,22" />
                                <Button Command="{Binding OpenCreateProjectDialogCommand}" Style="{StaticResource PrimaryButton}"
                                        Background="#3B82F6" Padding="22,12" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕ Create First Swarm Project" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- ACTIVE PROJECT CONTAINER -->
                        <StackPanel Visibility="{Binding HasProjects, Converter={StaticResource BoolToVisConverter}}">
                            <!-- Project Context & Selector Bar -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1"
                                    CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Project Selector & Info -->
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="📁 Project:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name"
                                                      MinWidth="240" Padding="10,6" Style="{StaticResource ModernComboBox}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <!-- Tech Stack Badge -->
                                            <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding SelectedProject.TechStack, FallbackValue='Rust'}" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" />
                                            </Border>
                                            <!-- Worktree Branch Badge -->
                                            <Border Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="6,3" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding SelectedProject.DefaultBranch, StringFormat='🌿 {0}'}" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Project Path & Description -->
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedProject.RootDirectory, FallbackValue='No root path'}"
                                                       FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SelectedProject.Description}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Right: Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="➕ New" Command="{Binding OpenCreateProjectDialogCommand}" Style="{StaticResource ModernButton}" Padding="10,6" FontSize="11.5" Margin="0,0,6,0" ToolTip="Create new swarm project" />
                                        <Button Content="✏️ Edit" Command="{Binding OpenEditProjectDialogCommand}" Style="{StaticResource ModernButton}" Padding="10,6" FontSize="11.5" Margin="0,0,6,0" ToolTip="Edit project configuration" />
                                        <Button Content="📂 Open Folder" Command="{Binding OpenProjectFolderCommand}" Style="{StaticResource ModernButton}" Padding="10,6" FontSize="11.5" Margin="0,0,6,0" ToolTip="Open project root in File Explorer" />
                                        <Button Content="🗑️ Delete" Command="{Binding DeleteProjectCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="11.5" ToolTip="Delete this project" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Navigation Tab Bar (Chat Feed, Tasks & Dispatch, Worktree Tree) -->
                            <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1"
                                    CornerRadius="8" Padding="4" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Margin="2" CornerRadius="6"
                                            Background="{Binding SelectedProjectTabIndex, Converter={StaticResource PageToActiveBgConverter}, ConverterParameter=0}"
                                            BorderBrush="{Binding SelectedProjectTabIndex, Converter={StaticResource TabToActiveBorderConverter}, ConverterParameter=0}"
                                            BorderThickness="1">
                                        <Button Content="💬 Swarm Chat &amp; Aggregator Feed" Command="{Binding SetProjectTabCommand}" CommandParameter="0"
                                                Background="Transparent" BorderThickness="0" Padding="12,9" FontSize="12.5" FontWeight="SemiBold"
                                                Foreground="{Binding SelectedProjectTabIndex, Converter={StaticResource TabToActiveFgConverter}, ConverterParameter=0}" Cursor="Hand" />
                                    </Border>
                                    <Border Grid.Column="1" Margin="2" CornerRadius="6"
                                            Background="{Binding SelectedProjectTabIndex, Converter={StaticResource PageToActiveBgConverter}, ConverterParameter=1}"
                                            BorderBrush="{Binding SelectedProjectTabIndex, Converter={StaticResource TabToActiveBorderConverter}, ConverterParameter=1}"
                                            BorderThickness="1">
                                        <Button Content="🎯 Tasks &amp; Fleet Dispatch" Command="{Binding SetProjectTabCommand}" CommandParameter="1"
                                                Background="Transparent" BorderThickness="0" Padding="12,9" FontSize="12.5" FontWeight="SemiBold"
                                                Foreground="{Binding SelectedProjectTabIndex, Converter={StaticResource TabToActiveFgConverter}, ConverterParameter=1}" Cursor="Hand" />
                                    </Border>
                                    <Border Grid.Column="2" Margin="2" CornerRadius="6"
                                            Background="{Binding SelectedProjectTabIndex, Converter={StaticResource PageToActiveBgConverter}, ConverterParameter=2}"
                                            BorderBrush="{Binding SelectedProjectTabIndex, Converter={StaticResource TabToActiveBorderConverter}, ConverterParameter=2}"
                                            BorderThickness="1">
                                        <Button Content="🌳 Worktree Isolation Tree" Command="{Binding SetProjectTabCommand}" CommandParameter="2"
                                                Background="Transparent" BorderThickness="0" Padding="12,9" FontSize="12.5" FontWeight="SemiBold"
                                                Foreground="{Binding SelectedProjectTabIndex, Converter={StaticResource TabToActiveFgConverter}, ConverterParameter=2}" Cursor="Hand" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- ============================================================== -->
                            <!-- TAB 0: SWARM CHAT & AGGREGATOR FEED                            -->
                            <!-- ============================================================== -->
                            <StackPanel Visibility="{Binding SelectedProjectTabIndex, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=0}">
                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1"
                                        CornerRadius="10" Padding="20" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Feed Header -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="💬 Live Swarm Chat &amp; Inter-Agent Message Bus" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                                                        <TextBlock Text=".swarm/bus.jsonl" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#94A3B8" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Synchronized real-time telemetry, agent directives, shared blackboard contracts, and user broadcasts" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding SwarmChatMessages.Count, StringFormat='{}{0} Messages'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" />
                                                </Border>
                                                <Button Content="🔄 Refresh Feed" Command="{Binding RefreshSwarmChatMessagesCommand}" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Messages Scroll Area -->
                                        <Border Background="#0B0F19" CornerRadius="8" Padding="14" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" MinHeight="280" MaxHeight="520">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <!-- Empty Chat Notice (Shows ONLY when zero messages) -->
                                                    <Border Visibility="{Binding HasSwarmChatMessages, Converter={StaticResource InverseBoolToVisConverter}}"
                                                            Padding="40,30" HorizontalAlignment="Center">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="💬 No messages recorded yet." FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                                            <TextBlock Text="Dispatch the swarm fleet or use the broadcast bar below to send instructions to the agents." FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Message Bubbles -->
                                                    <ItemsControl ItemsSource="{Binding SwarmChatMessages}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{Binding Type, Converter={StaticResource SwarmMsgBgConverter}}"
                                                                        BorderBrush="{Binding Type, Converter={StaticResource SwarmMsgBorderConverter}}"
                                                                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- Sender Avatar -->
                                                                        <Grid Grid.Column="0" Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Top">
                                                                            <Border Background="{Binding SenderColor, Converter={StaticResource HexToBrushConverter}}" CornerRadius="17">
                                                                                <TextBlock Text="{Binding AvatarInitial}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>
                                                                            <Border CornerRadius="17" ClipToBounds="True" Visibility="{Binding AvatarUrl, Converter={StaticResource NotNullOrEmptyToVisConverter}}">
                                                                                <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" Width="34" Height="34" />
                                                                            </Border>
                                                                        </Grid>

                                                                        <!-- Content Body -->
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <WrapPanel Margin="0,0,0,5">
                                                                                <TextBlock Text="{Binding SenderName}" FontWeight="Bold" FontSize="12.5" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                                <!-- Role Badge -->
                                                                                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="3" Padding="6,1.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding SenderRole}" FontSize="10" FontWeight="Bold" Foreground="#93C5FD" />
                                                                                </Border>
                                                                                <!-- Target Badge if direct message -->
                                                                                <Border Visibility="{Binding TargetWorker, Converter={StaticResource NotNullOrEmptyToVisConverter}}"
                                                                                        Background="#1E3A8A" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="3" Padding="6,1.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding TargetWorker, StringFormat='🎯 @{0}'}" FontSize="9.5" FontWeight="Bold" Foreground="#BFDBFE" />
                                                                                </Border>
                                                                            </WrapPanel>
                                                                            <TextBlock Text="{Binding Content}" FontSize="12.5" Foreground="#F1F5F9" TextWrapping="Wrap" LineHeight="18" />
                                                                        </StackPanel>

                                                                        <!-- Timestamp -->
                                                                        <TextBlock Grid.Column="2" Text="{Binding TimestampFormatted}" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Top" Margin="10,2,0,0" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>

                                        <!-- Broadcast Chat Input Bar -->
                                        <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Target Worker Selection -->
                                                <ComboBox Grid.Column="0" ItemsSource="{Binding ChatTargetWorkers}" SelectedItem="{Binding SelectedChatTargetWorker}"
                                                          Style="{StaticResource ModernComboBox}" MinWidth="190" Padding="8,6" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Send broadcast to all workers or target a specific agent" />
                                                <!-- Input TextBox with Enter Key Support -->
                                                <TextBox Grid.Column="1" Text="{Binding SwarmChatInputText, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ModernTextBox}" Padding="10,8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Return" Command="{Binding SendSwarmChatMessageCommand}" />
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                                <!-- Send Button -->
                                                <Button Grid.Column="2" Command="{Binding SendSwarmChatMessageCommand}"
                                                        Style="{StaticResource PrimaryButton}" Background="#3B82F6" Padding="16,8" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🚀 Broadcast" FontWeight="Bold" FontSize="11.5" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============================================================== -->
                            <!-- TAB 1: TASKS & FLEET DISPATCH SETTINGS                         -->
                            <!-- ============================================================== -->
                            <StackPanel Visibility="{Binding SelectedProjectTabIndex, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=1}">
                                <!-- Hardware Sentinel & Pre-flight Health Guard -->
                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="🛡️ Pre-flight Resource &amp; Safety Sentinels" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Hardware availability, storage limits, and Git Worktree capability checks" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="🔍 Check Resources" Command="{Binding CheckPreflightCommand}" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="11.5" />
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource BrushSurface}" CornerRadius="6" Padding="14,10" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="Disk Free Space" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                    <TextBlock Text="{Binding PreflightResult.AvailableDiskGb, StringFormat='{}{0:F1} GB Free'}" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="{DynamicResource BrushSurface}" CornerRadius="6" Padding="14,10" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="System Memory" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                    <TextBlock Text="{Binding PreflightResult.AvailableMemoryGb, StringFormat='{}{0:F1} GB Available'}" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{DynamicResource BrushSurface}" CornerRadius="6" Padding="14,10">
                                                <StackPanel>
                                                    <TextBlock Text="Git Repository Status" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                    <TextBlock Text="{Binding PreflightResult.CurrentBranch, FallbackValue='Git Active'}" FontSize="15" FontWeight="Bold" Foreground="#A855F7" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Warning Alert -->
                                        <Border Visibility="{Binding PreflightResult.WarningMessage, Converter={StaticResource NotNullOrEmptyToVisConverter}}"
                                                Background="{DynamicResource BrushWarningAlertBg}" BorderBrush="{DynamicResource BrushWarningAlertBorder}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,6,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚠️" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding PreflightResult.WarningMessage}" FontSize="11.5" Foreground="{DynamicResource BrushWarningAlertText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Error Alert -->
                                        <Border Visibility="{Binding PreflightResult.ErrorMessage, Converter={StaticResource NotNullOrEmptyToVisConverter}}"
                                                Background="{DynamicResource BrushErrorAlertBg}" BorderBrush="{DynamicResource BrushErrorAlertBorder}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,6,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="❌" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding PreflightResult.ErrorMessage}" FontSize="11.5" Foreground="{DynamicResource BrushErrorAlertText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Task Definition & Configuration -->
                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="🎯 Dispatch Configuration &amp; Task Definition" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,14" />

                                        <!-- Target Workspace -->
                                        <TextBlock Text="Target Repository Directory:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding FleetWorkspacePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="10,8" Margin="0,0,8,0" />
                                            <Button Grid.Column="1" Command="{Binding BrowseFleetWorkspaceFolderCommand}" Style="{StaticResource SecondaryButton}" Padding="12,8">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource HeroIconFolder}" Stroke="{DynamicResource BrushTextPrimary}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Browse Folder..." FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Execution Mode & Tool Permission Sentinel -->
                                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="6" Padding="12,10" Margin="0,0,0,12" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Execution Mode:" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton Content="🖥️ Visible Terminal Windows" IsChecked="{Binding IsTerminalMode}" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,16,0" ToolTip="Interactive terminal windows: watch and interact with CLI sessions in real-time" />
                                                        <RadioButton Content="⚡ Silent Background (Headless)" IsChecked="{Binding IsSilentMode}" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" ToolTip="Headless execution: silent background execution with real-time telemetry streamed into task cards" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding FleetDangerouslySkipPermissions}" Content="Auto-approve tool permissions (--dangerously-skip-permissions)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" ToolTip="Essential for automated headless execution to prevent tool prompt timeouts and headless denial" />
                                            </Grid>
                                        </Border>

                                        <CheckBox IsChecked="{Binding UseGitWorktrees}" Content="Isolate workers in linked Git Worktrees (.worktrees/worker-*) to avoid .git/index.lock contention" FontSize="11.5" Margin="0,0,0,14" />

                                        <!-- Quick Objective Suggestion Chips -->
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="Quick Objective Suggestions &amp; Templates:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6" />
                                            <WrapPanel>
                                                <Button Content="🚀 Full-Stack Feature" Command="{Binding ApplyObjectiveSuggestionCommand}" CommandParameter="fullstack"
                                                        Style="{StaticResource ModernButton}" Padding="10,5" FontSize="11" Margin="0,0,6,6" ToolTip="JWT Auth + Backend API + Frontend UI + Test Suite" />
                                                <Button Content="🛡️ Security Audit &amp; Fix" Command="{Binding ApplyObjectiveSuggestionCommand}" CommandParameter="security"
                                                        Style="{StaticResource ModernButton}" Padding="10,5" FontSize="11" Margin="0,0,6,6" ToolTip="OWASP scan, input sanitation, CVE review" />
                                                <Button Content="🧪 Tests &amp; Benchmarks" Command="{Binding ApplyObjectiveSuggestionCommand}" CommandParameter="tests"
                                                        Style="{StaticResource ModernButton}" Padding="10,5" FontSize="11" Margin="0,0,6,6" ToolTip="Unit tests, integration test suite, and performance benchmarks" />
                                                <Button Content="📚 Docs &amp; OpenAPI Spec" Command="{Binding ApplyObjectiveSuggestionCommand}" CommandParameter="docs"
                                                        Style="{StaticResource ModernButton}" Padding="10,5" FontSize="11" Margin="0,0,6,6" ToolTip="Swagger / OpenAPI spec, architecture docs, and onboarding" />
                                                <Button Content="⚡ Performance Refactor" Command="{Binding ApplyObjectiveSuggestionCommand}" CommandParameter="refactor"
                                                        Style="{StaticResource ModernButton}" Padding="10,5" FontSize="11" Margin="0,0,6,6" ToolTip="Profile bottlenecks, memory optimization, and modular refactoring" />
                                                <Button Content="Clear" Command="{Binding ClearObjectiveCommand}"
                                                        Style="{StaticResource ModernButton}" Padding="8,5" FontSize="11" Margin="0,0,6,6" ToolTip="Clear objective text" />
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Task Objective Prompt -->
                                        <TextBlock Text="Task Objective Prompt (Single Input -> Tailored Multi-Worker Execution):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding FleetTaskObjective, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" Style="{StaticResource ModernTextBox}" Padding="10,8" />
                                    </StackPanel>
                                </Border>

                                <!-- Participating Fleet Workers Selection (Rich Profile Context) -->
                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="👥 Participating Fleet Workers" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Workers selected below will receive tailored sub-task prompts in isolated environments" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="☑️ Select All" Command="{Binding SelectAllSwarmCommand}" CommandParameter="True" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                                                <Button Content="⬜ Deselect All" Command="{Binding SelectAllSwarmCommand}" CommandParameter="False" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" />
                                            </StackPanel>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Profiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Checkbox Selection -->
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForSwarm, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                                            <!-- Avatar / Google Account Profile Picture -->
                                                            <Grid Grid.Column="1" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                                                <Ellipse Width="36" Height="36"
                                                                         Stroke="{Binding ColorTag, Converter={StaticResource HexToBrushConverter}}"
                                                                         StrokeThickness="1.8"
                                                                         RenderOptions.BitmapScalingMode="HighQuality"
                                                                         Visibility="{Binding HasAvatarUrl, Converter={StaticResource BoolToVisConverter}}">
                                                                    <Ellipse.Fill>
                                                                        <ImageBrush ImageSource="{Binding AvatarImageSource}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                    </Ellipse.Fill>
                                                                </Ellipse>

                                                                <Border Width="36" Height="36" CornerRadius="18"
                                                                        Background="{Binding ColorTag, Converter={StaticResource HexToBrushConverter}}"
                                                                        Visibility="{Binding HasAvatarUrl, Converter={StaticResource InverseBoolToVisConverter}}">
                                                                    <TextBlock Text="{Binding AvatarInitial}" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>

                                                                <Border Width="11" Height="11" CornerRadius="5.5"
                                                                        Background="{DynamicResource BrushSurface}"
                                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                        Margin="0,0,-1,-1" Padding="1.5">
                                                                    <Ellipse Fill="{Binding StatusBadgeColor, Converter={StaticResource HexToBrushConverter}}" />
                                                                </Border>
                                                            </Grid>

                                                            <!-- Identity & Context Details -->
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <WrapPanel VerticalAlignment="Center" Margin="0,0,0,3">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                                    <!-- Tier Badge -->
                                                                    <Border CornerRadius="4" Padding="6,1.5" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                            Background="{Binding TierBadgeBackground, Converter={StaticResource HexToBrushConverter}}">
                                                                        <TextBlock Text="{Binding TierBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                    </Border>

                                                                    <!-- Status Badge -->
                                                                    <Border CornerRadius="4" Padding="6,1.5" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                            Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Ellipse Width="6" Height="6" Fill="{Binding StatusBadgeColor, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <!-- Model Badge -->
                                                                    <Border CornerRadius="4" Padding="6,1.5" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                            Background="{DynamicResource BrushModelBadgeBg}" BorderBrush="{DynamicResource BrushModelBadgeBorder}" BorderThickness="1">
                                                                        <TextBlock Text="{Binding CurrentModel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushModelBadgeText}" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </WrapPanel>

                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding AccountEmail, FallbackValue='No email'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,10,0" />
                                                                    <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,10,0" />
                                                                    <TextBlock Text="{Binding Description, FallbackValue='General Fleet Worker'}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Quota & Window Telemetry Pill -->
                                                            <Border Grid.Column="3" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                                                                <StackPanel HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding TodayQuotaFormatted}" FontSize="11.5" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" />
                                                                    <TextBlock Text="{Binding WeeklyRemainingFormatted}" FontSize="9.5" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" Margin="0,1,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Live Dispatch Progress Panel -->
                                <Border Visibility="{Binding IsFleetDispatching, Converter={StaticResource BoolToVisConverter}}"
                                        Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1.5"
                                        CornerRadius="10" Padding="18" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource HeroIconArrowPath}"
                                                      Stroke="{DynamicResource BrushAccent}" StrokeThickness="2"
                                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DispatchProgressStage, FallbackValue='Dispatching Swarm Fleet...'}"
                                                           FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding DispatchProgressPercent, StringFormat='{}{0}%'}"
                                                       FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" />
                                        </Grid>

                                        <ProgressBar Value="{Binding DispatchProgressPercent}" Minimum="0" Maximum="100" Height="6"
                                                     Foreground="{DynamicResource BrushAccent}" Background="{DynamicResource BrushSurface}"
                                                     BorderThickness="0" Margin="0,0,0,8" />

                                        <TextBlock Text="{Binding DispatchProgressDetail, FallbackValue='Configuring worktrees and spawning isolated CLI terminals...'}"
                                                   FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                    </StackPanel>
                                </Border>

                                <!-- Action Control Bar -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding DispatchFleetCommand}"
                                            Style="{StaticResource PrimaryButton}" Background="#059669"
                                            FontSize="14" FontWeight="Bold" Padding="20,12" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource HeroIconChatBubbleOvalLeftEllipsis}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Dispatch &amp; Launch Swarm Fleet" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding AbortFleetCommand}"
                                            Style="{StaticResource SolidDangerButton}" Padding="18,12" FontSize="13" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource HeroIconStop}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Abort Fleet" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding PruneWorktreesCommand}"
                                            Style="{StaticResource SecondaryButton}" Padding="16,12" FontSize="13">
                                        <TextBlock Text="Prune Worktrees" />
                                    </Button>
                                </Grid>

                                <!-- Dispatched Tasks Panel -->
                                <Border Visibility="{Binding HasDispatchedTasks, Converter={StaticResource BoolToVisConverter}}"
                                        Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="📋 Active Swarm Dispatch Tasks" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Real-time telemetry, active tool activities, and isolated workspace management" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="8,3" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                <TextBlock Text="{Binding DispatchedTasks.Count, StringFormat='{}{0} Dispatched'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" />
                                            </Border>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding DispatchedTasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="16,14" Margin="0,0,0,12" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                        <StackPanel>
                                                            <!-- Header Row -->
                                                            <Grid Margin="0,0,0,10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                                                    <Border Background="{Binding ColorTag, Converter={StaticResource HexToBrushConverter}}" CornerRadius="18">
                                                                        <TextBlock Text="{Binding AvatarInitial}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <Border CornerRadius="18" ClipToBounds="True" Visibility="{Binding AvatarUrl, Converter={StaticResource NotNullOrEmptyToVisConverter}}">
                                                                        <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" Width="36" Height="36" />
                                                                    </Border>
                                                                </Grid>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,3">
                                                                        <TextBlock Text="{Binding ProfileName}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                                        <Border Background="{DynamicResource BrushBadgeBg}" BorderBrush="{DynamicResource BrushBadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding AssignedRole}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushBadgeText}" />
                                                                        </Border>
                                                                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding ExecutionModeText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                        </Border>
                                                                        <Border Visibility="{Binding ProcessId, Converter={StaticResource IntToVisConverter}}" Background="{DynamicResource BrushCard}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding ProcessId, StringFormat='PID: {0}'}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                        </Border>
                                                                    </WrapPanel>
                                                                    <TextBlock Text="{Binding BranchName, StringFormat='🌱 Branch: {0}'}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Background="{DynamicResource BrushCard}" CornerRadius="4" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding ElapsedTimeFormatted, StringFormat='⏱️ {0}'}" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                    </Border>
                                                                    <Border Background="{Binding StatusColor, Converter={StaticResource HexToBrushConverter}}" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Activity Bar -->
                                                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
                                                                        <TextBlock Text="⚡ Activity:" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding CurrentActivity, FallbackValue='Initializing...'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Row="1" Text="{Binding LastOutputLine}" Visibility="{Binding LastOutputLine, Converter={StaticResource NotNullOrEmptyToVisConverter}}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                            </Border>

                                                            <!-- Collapsible Console Log -->
                                                            <Border Visibility="{Binding LastOutputLine, Converter={StaticResource NotNullOrEmptyToVisConverter}}" Margin="0,0,0,8">
                                                                <StackPanel>
                                                                    <Button Command="{Binding ToggleOutputCommand}" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" Padding="8,3" FontSize="10.5" Margin="0,0,0,4">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="🖥️ Console Stream Log" FontWeight="SemiBold" Margin="0,0,6,0" />
                                                                            <TextBlock Text="{Binding IsOutputExpanded, Converter={StaticResource BoolToChevronConverter}}" FontFamily="{StaticResource FontMono}" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Border Visibility="{Binding IsOutputExpanded, Converter={StaticResource BoolToVisConverter}}" Background="#090D16" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                                                                        <StackPanel>
                                                                            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                                                                <TextBox Text="{Binding FullOutputLog, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#6EE7B7" FontFamily="{StaticResource FontMono}" FontSize="10.5" TextWrapping="Wrap" />
                                                                            </ScrollViewer>
                                                                            <Button Content="📋 Copy Full Log" Command="{Binding DataContext.CopyTaskLogCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10.5" HorizontalAlignment="Right" Margin="0,6,0,0" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Footer Actions -->
                                                            <Grid Margin="0,4,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding WorktreePath, StringFormat='📁 {0}'}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                    <Button Content="📂 Folder" Command="{Binding DataContext.OpenWorktreeFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding WorktreePath}" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10.5" Margin="0,0,6,0" ToolTip="Open workspace folder in File Explorer" />
                                                                    <Button Content="🔀 Merge" Command="{Binding DataContext.MergeSwarmBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding BranchName}" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10.5" Margin="0,0,6,0" ToolTip="Merge branch changes into base repo" />
                                                                    <Button Content="🛑 Stop Worker" Command="{Binding DataContext.StopWorkerTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding .}" Style="{StaticResource SolidDangerButton}" Padding="8,4" FontSize="10.5" ToolTip="Terminate this isolated worker process immediately" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============================================================== -->
                            <!-- TAB 2: GIT WORKTREE ISOLATION TREE                             -->
                            <!-- ============================================================== -->
                            <StackPanel Visibility="{Binding SelectedProjectTabIndex, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=2}">
                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="🌳 Git Worktree Branch Isolation Tree" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Live topological visualization of repository root and isolated worker branch sandboxes" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource BrushSurface}" CornerRadius="5" Padding="8,4" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                <TextBlock Text="{Binding WorktreeTreeNodes.Count, StringFormat='{}{0} Branch Nodes'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" />
                                            </Border>
                                        </Grid>

                                        <!-- Tree Container -->
                                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="8" Padding="16,14" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                            <StackPanel>
                                                <!-- Root Repository Node -->
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#3B82F6" CornerRadius="5" Padding="8,4" Margin="0,0,10,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🏠 " FontSize="11" VerticalAlignment="Center" />
                                                            <TextBlock Text="ROOT REPO" FontWeight="Bold" FontSize="10.5" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PreflightResult.CurrentBranch, StringFormat='Base Branch: {0}', FallbackValue='Base Branch: master'}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" />
                                                        <TextBlock Text="{Binding FleetWorkspacePath, FallbackValue='No workspace selected'}" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="{DynamicResource BrushCard}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="Shared Object Store" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                                    </Border>
                                                </Grid>

                                                <!-- Branch Nodes -->
                                                <ItemsControl ItemsSource="{Binding WorktreeTreeNodes}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="12,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Text="└── " FontFamily="{StaticResource FontMono}" FontSize="15" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center" />

                                                                <Border Grid.Column="1" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                                <TextBlock Text="🌱 " FontSize="11" VerticalAlignment="Center" />
                                                                                <TextBlock Text="{Binding BranchName}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushAccent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                                <Border Background="{DynamicResource BrushSurface}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding WorkerName, StringFormat='Worker: {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding Path}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <Border Grid.Column="1" Background="{Binding StatusColor, Converter={StaticResource HexToBrushConverter}}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                            <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================================================== -->
                <!-- VIEW 3: ANALYTICS (/analytic)                                  -->
                <!-- ============================================================== -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,24,24,60"
                              PreviewMouseWheel="GlobalScrollViewer_PreviewMouseWheel"
                              Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Analytics}">
                    <StackPanel>
                        <!-- Analytics Header -->
                        <Grid Margin="0,0,0,16">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Strings[Analytics_Title]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="{Binding Strings[Analytics_Subtitle]}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding ExportPdfReportCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Padding="14,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconArrowDownTray}" Stroke="#FFFFFF" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Download PDF Report" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SyncSwarmCommand}" Style="{StaticResource ModernButton}" Padding="12,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource HeroIconArrowPath}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Strings[Analytics_Recalculate]}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Telemetry KPI Summary Row -->
                        <UniformGrid Columns="6" Margin="0,0,0,20">
                            <!-- Metric 1: Total Tokens -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="EST. TOKENS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding TotalEstimatedTokens}" FontSize="18" FontWeight="Bold" Foreground="#3B82F6" Margin="0,3,0,0" />
                                    <TextBlock Text="Total consumption" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 2: Input Tokens -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="INPUT TOKENS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding EstimatedInputTokens}" FontSize="18" FontWeight="Bold" Foreground="#06B6D4" Margin="0,3,0,0" />
                                    <TextBlock Text="Prompts sent" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 3: Output Tokens -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="OUTPUT TOKENS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding EstimatedOutputTokens}" FontSize="18" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,3,0,0" />
                                    <TextBlock Text="AI completions" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 4: Avg Latency -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="AVG LATENCY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding AverageLatencyMs}" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,3,0,0" />
                                    <TextBlock Text="Round-trip time" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 5: Success Rate -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="UPTIME / SUCCESS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding SwarmSuccessRate}" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,3,0,0" />
                                    <TextBlock Text="Execution reliability" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- Metric 6: Health Score -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="SWARM STATUS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding SwarmHealthScore}" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" Margin="0,3,0,0" />
                                    <TextBlock Text="Rate-limit safety" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- ============================================================== -->
                        <!-- TALL EXPANSIVE ANALYTICS TELEMETRY CHART                      -->
                        <!-- ============================================================== -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <!-- Header Row (Row 0) -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="📈 Real Telemetry Trends &amp; Consumption" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="Multi-dimensional filtering across account sandboxes, LLM models, and authentic prompt activity" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Download PDF Report CTA -->
                                    <Button Grid.Column="1" Command="{Binding ExportPdfReportCommand}"
                                            Style="{StaticResource ModernButton}"
                                            Padding="14,8"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📥 " FontSize="13" />
                                            <TextBlock Text="Download PDF Report" FontWeight="SemiBold" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Dedicated Filter Toolbar Row (Row 1) -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                    <WrapPanel VerticalAlignment="Center">
                                        <!-- Chart Mode Switcher -->
                                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="📊 Bar" Command="{Binding SetChartModeCommand}" CommandParameter="Bar"
                                                        Style="{StaticResource ModernButton}" Padding="10,5" FontSize="12" Margin="0,0,2,0" />
                                                <Button Content="📈 Line" Command="{Binding SetChartModeCommand}" CommandParameter="Line"
                                                        Style="{StaticResource ModernButton}" Padding="10,5" FontSize="12" Margin="0,0,2,0" />
                                                <Button Content="🏔️ Area" Command="{Binding SetChartModeCommand}" CommandParameter="Area"
                                                        Style="{StaticResource ModernButton}" Padding="10,5" FontSize="12" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Zoom Controls -->
                                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="➖" Command="{Binding ChartZoomOutCommand}" Style="{StaticResource ModernButton}" Padding="7,4" FontSize="11" ToolTip="Zoom Out" Margin="0,0,2,0" />
                                                <TextBlock Text="{Binding ChartZoomText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="6,0" />
                                                <Button Content="➕" Command="{Binding ChartZoomInCommand}" Style="{StaticResource ModernButton}" Padding="7,4" FontSize="11" ToolTip="Zoom In" Margin="2,0,2,0" />
                                                <Button Content="100%" Command="{Binding ChartZoomResetCommand}" Style="{StaticResource ModernButton}" Padding="6,4" FontSize="10" ToolTip="Reset Zoom (100%)" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Account Filter -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="Account:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ComboBox ItemsSource="{Binding AccountFilterOptions}"
                                                      SelectedItem="{Binding SelectedAccountFilter}"
                                                      Style="{StaticResource ModernComboBox}"
                                                      Width="140" />
                                        </StackPanel>

                                        <!-- Period Filter -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="Period:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ComboBox ItemsSource="{Binding TimeframeOptions}"
                                                      SelectedItem="{Binding SelectedTimeframe}"
                                                      Style="{StaticResource ModernComboBox}"
                                                      Width="130" />
                                        </StackPanel>

                                        <!-- Model Filter -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="Model:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ComboBox ItemsSource="{Binding ModelFilterOptions}"
                                                      SelectedItem="{Binding SelectedModelFilter}"
                                                      Style="{StaticResource ModernComboBox}"
                                                      Width="180" />
                                        </StackPanel>

                                        <!-- Tier Filter -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Tier:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <ComboBox ItemsSource="{Binding TierFilterOptions}"
                                                      SelectedItem="{Binding SelectedTierFilter}"
                                                      Style="{StaticResource ModernComboBox}"
                                                      Width="110" />
                                        </StackPanel>
                                    </WrapPanel>
                                </Border>

                                <!-- Visual Interactive Tall Canvas Area (Height 360) -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="14,14,14,10" Height="360">
                                    <Grid>
                                        <!-- No Data Placeholder (When genuinely 0 prompts) -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasChartData, Converter={StaticResource InverseBoolToVisConverter}}">
                                            <TextBlock Text="📭" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock Text="No Telemetry Activity Recorded" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" />
                                            <TextBlock Text="There are 0 prompt executions matching the selected account sandbox, model, and timeframe." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Chart with Y-Axis, Horizontal Gridlines, and Horizontal ScrollViewer -->
                                        <Grid Visibility="{Binding HasChartData, Converter={StaticResource BoolToVisConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <!-- Left Y-Axis Scale -->
                                                <ColumnDefinition Width="42" />
                                                <!-- Plot Canvas & ScrollViewer Area -->
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Y-Axis Labels -->
                                            <Grid Grid.Column="0" Margin="0,18,6,38">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding YTick100}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="1" Text="{Binding YTick75}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="2" Text="{Binding YTick50}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="3" Text="{Binding YTick25}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="3" Text="{Binding YTick0}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                            </Grid>

                                            <!-- Plot Container (Gridlines + ScrollViewer) -->
                                            <Grid Grid.Column="1">
                                                <!-- Horizontal Background Gridlines & Baseline -->
                                                <Grid Margin="0,18,0,38">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Rectangle Grid.Row="0" VerticalAlignment="Top" Height="1" Fill="{DynamicResource BrushCardBorder}" Opacity="0.45" StrokeDashArray="3 3" />
                                                    <Rectangle Grid.Row="1" VerticalAlignment="Top" Height="1" Fill="{DynamicResource BrushCardBorder}" Opacity="0.45" StrokeDashArray="3 3" />
                                                    <Rectangle Grid.Row="2" VerticalAlignment="Top" Height="1" Fill="{DynamicResource BrushCardBorder}" Opacity="0.45" StrokeDashArray="3 3" />
                                                    <Rectangle Grid.Row="3" VerticalAlignment="Top" Height="1" Fill="{DynamicResource BrushCardBorder}" Opacity="0.45" StrokeDashArray="3 3" />
                                                    <Rectangle Grid.Row="3" VerticalAlignment="Bottom" Height="1.5" Fill="{DynamicResource BrushCardBorder}" Opacity="0.8" />
                                                </Grid>

                                                <!-- Horizontal Scrollable Chart Content -->
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="ChartScrollViewer_PreviewMouseWheel">
                                                    <Grid MinWidth="{Binding ChartCanvasWidth}" Height="320" HorizontalAlignment="Left">
                                                        <!-- 1. BAR CHART MODE (TALL) -->
                                                        <ItemsControl ItemsSource="{Binding DashboardChartPoints}" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                                      Margin="10,0,10,12"
                                                                      Visibility="{Binding SelectedChartMode, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Bar}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Width="76" Margin="6,0" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                                        <StackPanel.ToolTip>
                                                                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                                                                <StackPanel>
                                                                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" />
                                                                                    <TextBlock Text="{Binding Value, StringFormat='Prompts: {0:N0}'}" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" />
                                                                                    <TextBlock Text="{Binding TokensLabel, StringFormat='Est. Tokens: {0}'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,4" />
                                                                                    <Separator Background="{DynamicResource BrushCardBorder}" Margin="0,4" />
                                                                                    <TextBlock Text="{Binding AccountContext, StringFormat='Account: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                    <TextBlock Text="{Binding ModelContext, StringFormat='Model: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </StackPanel.ToolTip>
                                                                        <TextBlock Text="{Binding Value}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                                                        <TextBlock Text="{Binding TokensLabel}" FontSize="9" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                                        <Border Height="{Binding Height}" Width="{Binding Width}" CornerRadius="5,5,0,0"
                                                                                Background="{Binding BarColor, Converter={StaticResource HexToBrushConverter}}"
                                                                                HorizontalAlignment="Center" Cursor="Hand" />
                                                                        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- 2. LINE CHART MODE -->
                                                        <Grid Visibility="{Binding SelectedChartMode, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Line}"
                                                              Width="{Binding ChartCanvasWidth}" Height="310" VerticalAlignment="Center">
                                                            <Canvas Width="{Binding ChartCanvasWidth}" Height="250" VerticalAlignment="Top" Margin="0,15,0,0">
                                                                <Polyline Points="{Binding LinePoints}" Stroke="#3B82F6" StrokeThickness="3.5" StrokeLineJoin="Round" />
                                                            </Canvas>
                                                            <ItemsControl ItemsSource="{Binding DashboardChartPoints}" VerticalAlignment="Bottom" Margin="0,0,0,12">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <UniformGrid Rows="1" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel HorizontalAlignment="Center">
                                                                            <StackPanel.ToolTip>
                                                                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                                                                <StackPanel>
                                                                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" />
                                                                                    <TextBlock Text="{Binding Value, StringFormat='Prompts: {0:N0}'}" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" />
                                                                                    <TextBlock Text="{Binding TokensLabel, StringFormat='Est. Tokens: {0}'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,4" />
                                                                                    <Separator Background="{DynamicResource BrushCardBorder}" Margin="0,4" />
                                                                                    <TextBlock Text="{Binding AccountContext, StringFormat='Account: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                    <TextBlock Text="{Binding ModelContext, StringFormat='Model: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </StackPanel.ToolTip>
                                                                        <TextBlock Text="{Binding Value}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" />
                                                                        <Ellipse Width="10" Height="10" Fill="#3B82F6" Stroke="#FFFFFF" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,4" Cursor="Hand" />
                                                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>

                                                    <!-- 3. AREA CHART MODE -->
                                                    <Grid Visibility="{Binding SelectedChartMode, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Area}"
                                                          Width="{Binding ChartCanvasWidth}" Height="310" VerticalAlignment="Center">
                                                        <Canvas Width="{Binding ChartCanvasWidth}" Height="250" VerticalAlignment="Top" Margin="0,15,0,0">
                                                            <Polygon Points="{Binding AreaPoints}" Fill="{StaticResource AreaChartGradient}" />
                                                            <Polyline Points="{Binding LinePoints}" Stroke="#8B5CF6" StrokeThickness="3.5" StrokeLineJoin="Round" />
                                                        </Canvas>
                                                        <ItemsControl ItemsSource="{Binding DashboardChartPoints}" VerticalAlignment="Bottom" Margin="0,0,0,12">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Rows="1" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel HorizontalAlignment="Center">
                                                                        <StackPanel.ToolTip>
                                                                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                                                                <StackPanel>
                                                                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" />
                                                                                    <TextBlock Text="{Binding Value, StringFormat='Prompts: {0:N0}'}" FontWeight="SemiBold" FontSize="12" Foreground="#8B5CF6" />
                                                                                    <TextBlock Text="{Binding TokensLabel, StringFormat='Est. Tokens: {0}'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,4" />
                                                                                    <Separator Background="{DynamicResource BrushCardBorder}" Margin="0,4" />
                                                                                    <TextBlock Text="{Binding AccountContext, StringFormat='Account: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                    <TextBlock Text="{Binding ModelContext, StringFormat='Model: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </StackPanel.ToolTip>
                                                                        <TextBlock Text="{Binding Value}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" />
                                                                        <Ellipse Width="9" Height="9" Fill="#8B5CF6" Stroke="#FFFFFF" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,4" Cursor="Hand" />
                                                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Grid>
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                            </StackPanel>
                        </Border>

                        <!-- Section 1: Model Efficiency Comparison Matrix (Opus & All Models) -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="{Binding Strings[Analytics_ModelMatrix]}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" />
                                <TextBlock Text="Comparison of inference speed, token output, and error rates across all agy models" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,12" />

                                <!-- Table Header -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="MODEL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                        <TextBlock Grid.Column="1" Text="RECOMMENDED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                        <TextBlock Grid.Column="2" Text="REQUESTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                        <TextBlock Grid.Column="3" Text="EST. TOKENS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                        <TextBlock Grid.Column="4" Text="AVG SPEED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                        <TextBlock Grid.Column="5" Text="ERROR RATE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                        <TextBlock Grid.Column="6" Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>

                                <!-- Table Rows -->
                                <ItemsControl ItemsSource="{Binding ModelEfficiencies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="200" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ModelName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Tier}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Requests}" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Tokens}" FontSize="12" FontWeight="SemiBold" Foreground="#3B82F6" />
                                                    <TextBlock Grid.Column="4" Text="{Binding AvgSpeed}" FontSize="12" Foreground="#10B981" />
                                                    <TextBlock Grid.Column="5" Text="{Binding ErrorRate}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                                    <Border Grid.Column="6" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" Background="{DynamicResource BrushSurface}">
                                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusColor, Converter={StaticResource HexToBrushConverter}}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Section 2: Real 24-Hour Swarm Hourly Activity Heatmap -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Strings[Analytics_HeatmapTitle]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="Actual timestamp frequency from local history files across all active instances" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Account Filter for Heatmap -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Filter Account:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox ItemsSource="{Binding HeatmapAccountOptions}"
                                                  SelectedItem="{Binding SelectedHeatmapAccount}"
                                                  Style="{StaticResource ModernComboBox}"
                                                  Width="180" />
                                    </StackPanel>
                                </Grid>

                                <!-- 24h KPI Summary Strip -->
                                <UniformGrid Columns="4" Margin="0,0,0,16">
                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="PEAK HOUR" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                            <TextBlock Text="{Binding HeatmapPeakHour}" FontSize="15" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="24H TOTAL TURNS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                            <TextBlock Text="{Binding HeatmapTotal24hPrompts}" FontSize="15" FontWeight="Bold" Foreground="#3B82F6" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="ACTIVE WINDOW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                            <TextBlock Text="{Binding HeatmapActiveWindow}" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="AVG HOURLY RATE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                            <TextBlock Text="{Binding HeatmapAveragePerHour}" FontSize="15" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Heatmap Canvas Surface (Height 280 with Y-Axis and Headroom) -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="14,14,14,10" Height="280">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Left Y-Axis Scale -->
                                            <ColumnDefinition Width="38" />
                                            <!-- Heatmap Plot Area -->
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Y-Axis Labels -->
                                        <Grid Grid.Column="0" Margin="0,12,6,34">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding HeatmapYTick100}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <TextBlock Grid.Row="1" Text="{Binding HeatmapYTick75}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <TextBlock Grid.Row="2" Text="{Binding HeatmapYTick50}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <TextBlock Grid.Row="3" Text="{Binding HeatmapYTick25}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <TextBlock Grid.Row="4" Text="{Binding HeatmapYTick0}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                        </Grid>

                                        <!-- Plot Canvas Area with Gridlines and Bars -->
                                        <Grid Grid.Column="1">
                                            <!-- Horizontal Dashed Gridlines -->
                                            <Grid Margin="0,18,0,38">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,1,0,0" Opacity="0.5" />
                                                <Border Grid.Row="1" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,1,0,0" Opacity="0.5" />
                                                <Border Grid.Row="2" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,1,0,0" Opacity="0.5" />
                                                <Border Grid.Row="3" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,1,0,0" Opacity="0.5" />
                                            </Grid>

                                            <!-- 24-Hour Bars Stack -->
                                            <ItemsControl ItemsSource="{Binding HourlyHeatmap}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Width="32" Margin="3,0" VerticalAlignment="Bottom" Cursor="Hand">
                                                            <StackPanel.ToolTip>
                                                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                                                                    <TextBlock Text="{Binding Tooltip}" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" />
                                                                </Border>
                                                            </StackPanel.ToolTip>

                                                            <!-- Prompt count label shown if > 0 (always safely below the ceiling!) -->
                                                            <TextBlock Text="{Binding PromptCount}"
                                                                       Visibility="{Binding PromptCount, Converter={StaticResource IntToVisConverter}}"
                                                                       FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"
                                                                       HorizontalAlignment="Center" Margin="0,0,0,4" />

                                                            <!-- Heatmap Bar -->
                                                            <Border Height="{Binding Height}" Width="20" CornerRadius="4,4,0,0"
                                                                    Background="{Binding Color, Converter={StaticResource HexToBrushConverter}}"
                                                                    HorizontalAlignment="Center" />

                                                            <!-- Hour Label (X-Axis) -->
                                                            <TextBlock Text="{Binding HourLabel}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource BrushTextMuted}"
                                                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Section 3: Swarm Fleet Intelligence & CLI Capabilities (Revamped from Swarm Health) -->
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <!-- Section Header -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🚀 " FontSize="16" VerticalAlignment="Center" />
                                            <TextBlock Text="Swarm Fleet Intelligence &amp; CLI Capabilities" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="CLI model fleet orchestration, aggregate swarm pool capacity, and verified agy v1.2.12 capabilities" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" />
                                            <TextBlock Text="CLI v1.2.12 Engine Synchronized" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 1. Swarm Aggregate Quota & Burn-Rate Hero Strip -->
                                <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1.8*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Stat 1: Total Swarm Daily Pool -->
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="TOTAL SWARM DAILY POOL" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,3" />
                                                <TextBlock Text="{Binding SwarmDailyCapacityTotal, StringFormat='{}{0:N0} prompts/day'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="Capacity across all active accounts" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Stat 2: Total Prompts Consumed Today -->
                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Text="SWARM PROMPTS TODAY" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,3" />
                                                <TextBlock Text="{Binding SwarmTodayPromptsTotal, StringFormat='{}{0:N0} prompts'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" />
                                                <TextBlock Text="{Binding SwarmPoolRemainingPercent, StringFormat='{}{0:F1}% pool remaining'}" FontSize="10.5" Foreground="#10B981" FontWeight="SemiBold" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Stat 3: Swarm Aggregate Burn-Rate -->
                                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                                <TextBlock Text="AGGREGATE BURN-RATE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,3" />
                                                <TextBlock Text="{Binding SwarmAggregateBurnRate, StringFormat='{}{0:F1} p/hr'}" FontSize="15" FontWeight="Bold" Foreground="#F59E0B" />
                                                <TextBlock Text="Combined swarm burn-rate" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Stat 4: Exhaustion Forecast -->
                                            <Border Grid.Column="3" Background="#103B82F6" BorderBrush="#253B82F6" BorderThickness="1" CornerRadius="6" Padding="12,8" VerticalAlignment="Center">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                                                        <TextBlock Text="⚡ " FontSize="11" VerticalAlignment="Center" />
                                                        <TextBlock Text="SWARM EXHAUSTION FORECAST" FontSize="10" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SwarmExhaustionForecast}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Progress Bar for Aggregate Swarm Capacity -->
                                        <Grid Grid.Row="1">
                                            <ProgressBar Value="{Binding SwarmTodayPromptsTotal, Mode=OneWay}"
                                                         Maximum="{Binding SwarmDailyCapacityTotal, Mode=OneWay}"
                                                         Height="6" Minimum="0"
                                                         Background="{DynamicResource BrushProgressTrack}"
                                                         Foreground="{DynamicResource BrushAccent}"
                                                         BorderThickness="0" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- 2. Fleet Model Engines (agy models) -->
                                <TextBlock Text="Active Fleet Engine Models (agy models)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding SwarmFleetModels}" Margin="0,0,0,20">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: Family Accent Bar -->
                                                    <Border Grid.Column="0" Width="4" CornerRadius="2"
                                                            Background="{Binding FamilyColor, Converter={StaticResource HexToBrushConverter}}"
                                                            Margin="0,0,14,0" VerticalAlignment="Stretch" />

                                                    <!-- Middle: Model Info, Badges, Assigned Accounts -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                                            <!-- Family Pill -->
                                                            <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                                    Background="{Binding FamilyColor, Converter={StaticResource HexToBrushConverter}}" Opacity="0.9">
                                                                <TextBlock Text="{Binding Family}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                                            </Border>

                                                            <!-- Reasoning Tier Pill -->
                                                            <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                                <TextBlock Text="{Binding ReasoningTier}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                            </Border>

                                                            <!-- Context Limit Pill -->
                                                            <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                                                                <TextBlock Text="{Binding ContextLimitLabel}" FontSize="9.5" Foreground="{DynamicResource BrushTextMuted}" />
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Assigned Swarm Accounts -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Connected accounts: " FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" />
                                                            <TextBlock Text="{Binding AssignedAccountsList}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Right: Pool Capacity, Burn Rate & Status Badge -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding PoolCapacityLabel}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding BurnRateLabel, StringFormat='Burn rate: {0}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                                        </StackPanel>

                                                        <Border CornerRadius="5" Padding="10,4" VerticalAlignment="Center"
                                                                Background="{Binding StatusBadgeBg, Converter={StaticResource HexToBrushConverter}}"
                                                                BorderBrush="{Binding StatusBadgeColor, Converter={StaticResource HexToBrushConverter}}"
                                                                BorderThickness="1">
                                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{Binding StatusBadgeColor, Converter={StaticResource HexToBrushConverter}}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 3. Verified AGY Subcommands Matrix -->
                                <TextBlock Text="Verified agy CLI Official Capabilities" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding SwarmCliCapabilities}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Top: Monospace Command Tag + Status -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Command}" FontFamily="Consolas, Cascadia Code, monospace" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />
                                                        </Border>

                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Border Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding Status}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding StatusColor, Converter={StaticResource HexToBrushConverter}}" />
                                                            </Border>
                                                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                                <TextBlock Text="{Binding BadgeText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Bottom: Title + Description -->
                                                    <StackPanel Grid.Row="1">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,3" />
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" LineHeight="16" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Bottom Breathing Room Spacer -->
                        <Border Height="60" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================================================== -->
                <!-- VIEW 4: MCP TOOLS (/mcp)                                       -->
                <!-- ============================================================== -->
                <Grid Grid.Row="1"
                      Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Mcp}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="24,12">
                        <Grid>
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Strings[Mcp_Title]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="{Binding Strings[Mcp_Subtitle]}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding LoadMcpServersCommand}" Style="{StaticResource ModernButton}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔄 " />
                                        <TextBlock Text="{Binding Strings[Mcp_Reload]}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24" PreviewMouseWheel="GlobalScrollViewer_PreviewMouseWheel">
                        <StackPanel>
                            <!-- MCP Architecture Scope Clarification Banner -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource BrushSurfaceHover}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="MCP Execution Scope: Per-CLI Instance" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="MCP servers communicate via standard I/O (stdio) child processes spawned by each active agy CLI worker sandbox. The configurations below serve as baseline presets across swarm workers, while each account profile can maintain its own isolated environment." FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="16" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding McpServers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                        <Border Background="{DynamicResource BrushBadgeBg}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                                        </Border>
                                                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ToolsCount, StringFormat='{}{0} tools discovered'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,8" />
                                                    <Border Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="10,6" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Arguments}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushMonoPath}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ============================================================== -->
                <!-- VIEW 5: DOCUMENTATION (/docs)                                  -->
                <!-- ============================================================== -->
                <Grid Grid.Row="1"
                      Visibility="{Binding CurrentPage, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=Docs}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Docs Header Tabs (Responsive Multi-Row Layout) -->
                    <Border Grid.Row="0" Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="24,14,24,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Strings[Docs_Title]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                    <TextBlock Text="{Binding Strings[Docs_Subtitle]}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Architecture" Command="{Binding SelectDocTabCommand}" CommandParameter="Architecture" Style="{StaticResource ModernButton}" Margin="0,0,8,6" Padding="12,6" />

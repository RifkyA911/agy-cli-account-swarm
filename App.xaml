<Application x:Class="AgyAccountSwarm.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AgyAccountSwarm.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <converters:BooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" Invert="True" />
            <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
            <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisConverter" />
            <converters:NullOrEmptyToVisibilityConverter x:Key="NotNullOrEmptyToVisConverter" Invert="False" />
            <converters:NullOrEmptyToVisibilityConverter x:Key="EmptyToVisConverter" Invert="True" />
            <converters:EqualityToVisibilityConverter x:Key="EqualityToVisConverter" />
            <converters:PositiveIntToVisibilityConverter x:Key="IntToVisConverter" />
            <converters:PageToActiveBgConverter x:Key="PageToActiveBgConverter" />
            <converters:PageToActiveBorderConverter x:Key="PageToActiveBorderConverter" />
            <converters:PageToActiveTextConverter x:Key="PageToActiveTextConverter" />
            <converters:PageToFontWeightConverter x:Key="PageToFontWeightConverter" />
            <converters:BooleanToChevronConverter x:Key="BoolToChevronConverter" />
            <converters:BoolToFilterAccentConverter x:Key="BoolToFilterAccentConverter" />
            <converters:PageToActiveBarConverter x:Key="PageToActiveBarConverter" />
            <converters:NullOrEmptyToVisibilityConverter x:Key="StringToVisConverter" Invert="False" />
            <converters:PositiveIntToVisibilityConverter x:Key="NumberToVisConverter" />
        </ResourceDictionary>

    </Application.Resources>
</Application>

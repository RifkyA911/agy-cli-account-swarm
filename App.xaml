<Application x:Class="AgyAccountSwarm.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AgyAccountSwarm.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <converters:BooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" Invert="True" />
            <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
            <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisConverter" />
            <converters:NullOrEmptyToVisibilityConverter x:Key="NotNullOrEmptyToVisConverter" Invert="True" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
